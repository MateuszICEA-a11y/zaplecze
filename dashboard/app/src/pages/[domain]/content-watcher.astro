---
import Layout from '../../layouts/Layout.astro';
import DomainHeader from '../../components/DomainHeader.astro';
import StatCard from '../../components/StatCard.astro';
import TableCard from '../../components/TableCard.astro';
import {
  loadConfig,
  loadSnapshots,
  loadDetails,
  loadContentCatalog,
  latestSnapshot,
  type GscCompareRow,
} from '../../lib/data';
import { fmtDate, fmtInt, fmtNum, fmtPct } from '../../lib/format';

export function getStaticPaths() {
  return loadConfig()
    .domains.filter((domain) => {
      const cfg = domain.content_watcher as { enabled?: boolean } | undefined;
      return cfg?.enabled === true;
    })
    .map((domain) => ({ params: { domain: domain.id }, props: { name: domain.name } }));
}

const { domain } = Astro.params;
const { name } = Astro.props;
const domainConfig = loadConfig().domains.find((item) => item.id === domain)!;
const latest = latestSnapshot(domain!);
const snapshots = loadSnapshots(domain!);
const details = loadDetails(domain!);
const catalog = loadContentCatalog(domainConfig);
const asOf = latest?.date ?? new Date().toISOString().slice(0, 10);
const asOfTime = new Date(`${asOf}T00:00:00Z`).getTime();
const DAY = 86_400_000;

const normPath = (value: string): string => {
  const path = value.replace(/^https?:\/\/[^/]+/i, '').replace(/\/+$/, '');
  return path || '/';
};

const indexingByPath = new Map((details.sources.indexing?.rows ?? []).map((row) => [normPath(row.url), row]));
const senutoByPath = new Map(
  (details.sources.senuto?.urls ?? []).map((row) => [
    normPath(row.url.replace(/^(https?:\/\/)?(www\.)?[^/]+/i, '')),
    row,
  ]),
);
const ga4ByPath = new Map<string, {
  sessions: number;
  engagement_rate: number | null;
  avg_engagement_s: number | null;
}>();
for (const row of details.sources.ga4?.landing_pages?.rows ?? []) {
  const key = normPath(row.path);
  const previous = ga4ByPath.get(key);
  if (!previous) {
    ga4ByPath.set(key, {
      sessions: row.sessions,
      engagement_rate: row.engagement_rate ?? null,
      avg_engagement_s: row.avg_engagement_s ?? null,
    });
    continue;
  }
  const sessions = previous.sessions + row.sessions;
  ga4ByPath.set(key, {
    sessions,
    engagement_rate:
      previous.engagement_rate === null && row.engagement_rate == null
        ? null
        : ((previous.engagement_rate ?? 0) * previous.sessions + (row.engagement_rate ?? 0) * row.sessions) /
          (sessions || 1),
    avg_engagement_s:
      previous.avg_engagement_s === null && row.avg_engagement_s == null
        ? null
        : ((previous.avg_engagement_s ?? 0) * previous.sessions + (row.avg_engagement_s ?? 0) * row.sessions) /
          (sessions || 1),
  });
}
// Frazy Senuto per adres. Wpisów bywa po kilkadziesiąt na URL, więc do
// szczegółów trafia tylko krótka lista: najpierw frazy tuż pod progiem
// (11–30, czyli cel reoptymalizacji), potem najlepsze wolumenowo.
const senutoKeywordsByPath = new Map<string, { keyword: string; position: number; searches: number | null }[]>();
for (const row of details.sources.senuto?.keywords ?? []) {
  if (!row.url || typeof row.position !== 'number') continue;
  const key = normPath(row.url.replace(/^(https?:\/\/)?(www\.)?[^/]+/i, ''));
  const list = senutoKeywordsByPath.get(key) ?? [];
  list.push({ keyword: row.keyword, position: row.position, searches: row.searches });
  senutoKeywordsByPath.set(key, list);
}
const KEYWORDS_SHOWN = 6;
const keywordRank = (position: number): number => (position >= 11 && position <= 30 ? 0 : position <= 10 ? 1 : 2);

const gscCompare = details.sources.gsc?.compare?.qoq;
const compareByPath = new Map<string, GscCompareRow>(
  (gscCompare?.pages ?? []).map((row) => [normPath(row.key), row]),
);

type ScorePart = { key: string; points: number; max: number; available: boolean };

// Etykiety i opisy składowych są takie same dla każdego wpisu, więc jadą do
// przeglądarki raz, obok payloadu z liczbami. `hint` widać zawsze, `formula`
// siedzi w dymku „i".
const SCORE_PART_TEXTS: Record<string, { label: string; hint: string; formula: string }> = {
  loss: {
    label: 'Utrata ruchu',
    hint: 'Search Console: spadek kliknięć i pozycji względem poprzednich 90 dni',
    formula:
      'Ile kliknięć i pozycji wpis stracił przez ostatnie 90 dni. Im większy spadek, tym więcej punktów. ' +
      'Dane: Search Console. Brak danych = wpis nie miał wyświetleń w jednym z porównywanych okresów.',
  },
  potential: {
    label: 'Potencjał',
    hint: 'Search Console, 30 dni: wyświetlenia, pozycja 4–30, niskie CTR',
    formula:
      'Ile wpis może jeszcze zyskać. Punkty rosną, gdy strona ma dużo wyświetleń, stoi tuż za TOP 10 ' +
      'albo jest często pokazywana, a rzadko klikana. Dane: Search Console, ostatnie 30 dni.',
  },
  senuto: {
    label: 'Pokrycie fraz',
    hint: 'Senuto: frazy na pozycjach 11–30 i poza TOP 10',
    formula:
      'Ile fraz stoi tuż pod progiem widoczności – pozycje 11–30 i frazy poza TOP 10. ' +
      'Dane: Senuto. Zero punktów = adres rankuje na jakieś frazy, ale żadna nie jest tuż pod progiem. ' +
      'Brak danych = Senuto nie widzi tego adresu w wynikach wyszukiwania.',
  },
  engagement: {
    label: 'Zaangażowanie',
    hint: 'GA4: engagement rate poniżej 60% (od 10 sesji w górę)',
    formula:
      'Jak słabo wpis angażuje czytelników – im niższy engagement rate, tym więcej punktów. ' +
      'Dane: GA4, liczone od 10 sesji w górę.',
  },
};
const clamp = (value: number, min: number, max: number): number => Math.min(max, Math.max(min, value));

// Kalibracja per domena. Wiek NIE daje punktów – bramkuje wejście do kolejki
// i rozstrzyga remisy. Na dojrzałej domenie (458 wpisów grupa-icea.pl, 428
// starszych niż rok) świeżość jako składowa scoringu robiła z 82% treści
// „kandydatów", a wpis bez danych GSC wypadał wyżej niż wpis z danymi.
const watcherCfg = (domainConfig.content_watcher ?? {}) as { min_age_days?: number };
const minAgeDays = watcherCfg.min_age_days ?? 90;

// Przedziały wieku treści (dni od ostatniej realnej zmiany). Stałe dla obu
// domen – „3 / 6 / 12 miesięcy" to język, w którym rozmawia się o odświeżaniu.
// `label` nazywa akcję (nagłówek karty), `range` opisuje sam przedział i wraca
// w kolumnie Status przy każdym wpisie.
const AGE_BUCKETS = [
  { key: 'm0-3', label: 'Świeże treści', hint: 'aktualne (do 3 mies.)', range: 'do 3 mies.', tone: 'ok', from: 0, to: 90 },
  { key: 'm3-6', label: 'Do przeglądu', hint: 'starzejące się (3–6 mies.)', range: '3–6 mies.', tone: 'mid', from: 90, to: 180 },
  { key: 'm6-12', label: 'Zaplanuj update', hint: 'tracące wartość (6–12 mies.)', range: '6–12 mies.', tone: 'warn', from: 180, to: 365 },
  { key: 'm12+', label: 'Pilny audyt / recykling', hint: 'krytyczne zaległości (ponad 12 mies.)', range: 'ponad 12 mies.', tone: 'err', from: 365, to: Infinity },
] as const;
const ageBucket = (days: number): string =>
  AGE_BUCKETS.find((bucket) => days >= bucket.from && days < bucket.to)?.key ?? 'm12+';

const items = catalog
  .map((content) => {
    const path = normPath(content.url);
    const indexing = indexingByPath.get(path) ?? null;
    const senuto = senutoByPath.get(path) ?? null;
    const ga4 = ga4ByPath.get(path) ?? null;
    const compare = compareByPath.get(path) ?? null;
    const effectiveDate = content.updated_at ?? content.published_at;
    const ageDays = Math.max(0, Math.floor((asOfTime - new Date(`${effectiveDate}T00:00:00Z`).getTime()) / DAY));
    const clicksDelta = compare ? compare.clicks - compare.prev_clicks : null;
    const impressionsDelta = compare ? compare.impressions - compare.prev_impressions : null;
    const positionDelta =
      typeof compare?.position === 'number' && typeof compare.prev_position === 'number'
        ? Math.round((compare.position - compare.prev_position) * 10) / 10
        : null;

    const clickLoss = compare ? Math.max(0, compare.prev_clicks - compare.clicks) : 0;
    const clickLossPct = compare && compare.prev_clicks > 0 ? clickLoss / compare.prev_clicks : 0;
    const positionLoss = Math.max(0, positionDelta ?? 0);
    const lossPoints = Math.min(26, clickLoss * 1.5 + clickLossPct * 16) + Math.min(19, positionLoss * 3.8);

    const impressions = indexing?.impressions ?? 0;
    const bestPosition = indexing?.position ?? senuto?.best_position ?? null;
    const impressionPoints = Math.min(14, Math.log10(impressions + 1) * 4.7);
    const positionPoints =
      typeof bestPosition !== 'number'
        ? 0
        : bestPosition >= 4 && bestPosition <= 10
          ? 11
          : bestPosition <= 20
            ? 17
            : bestPosition <= 30
              ? 11
              : 0;
    const ctrPoints = impressions >= 100 && (indexing?.ctr ?? 100) < 2 ? 7 : 0;
    const potentialPoints = Math.min(35, impressionPoints + positionPoints + ctrPoints);
    const engagementAvailable = Boolean(ga4 && ga4.sessions >= 10 && ga4.engagement_rate !== null);
    const engagementPoints = engagementAvailable
      ? clamp((60 - (ga4?.engagement_rate ?? 60)) / 7.5, 0, 8)
      : 0;
    const senutoAvailable = Boolean(senuto);
    const senutoPoints = !senuto
      ? 0
      : Math.min(
          12,
          (senuto.best_position >= 11 && senuto.best_position <= 30 ? 8 : 0) +
            Math.min(4, Math.max(0, senuto.keywords - senuto.top10) * 0.6),
        );

    const parts: ScorePart[] = [
      { key: 'loss', points: lossPoints, max: 45, available: Boolean(compare) },
      { key: 'potential', points: potentialPoints, max: 35, available: Boolean(indexing) },
      { key: 'senuto', points: senutoPoints, max: 12, available: senutoAvailable },
      { key: 'engagement', points: engagementPoints, max: 8, available: engagementAvailable },
    ];
    // Bez pomiaru z GSC (indeksacja lub porównanie okien) nie ma czego ważyć –
    // taka treść wypada z rankingu zamiast dostawać wynik z resztek składowych.
    const measured = Boolean(indexing) || Boolean(compare);
    // Mianownik jest stały (45+35+12+8 = 100). Normalizacja do dostępnych
    // składowych dawała 100 pkt wpisom, o których wiemy najmniej – im mniej
    // danych, tym wyższy wynik. Brak składowej = brak punktów, nie ulga.
    const rawScore = parts.filter((part) => part.available).reduce((sum, part) => sum + part.points, 0);
    const score = measured ? Math.round(rawScore) : 0;

    const reasons: string[] = [];
    if (clickLoss > 0) reasons.push(`utrata ${fmtInt(clickLoss)} kliknięć`);
    if (positionLoss >= 1) reasons.push(`pozycja spadła o ${fmtNum(positionLoss, 1)}`);
    if (impressions >= 100 && typeof bestPosition === 'number' && bestPosition >= 4 && bestPosition <= 30) {
      reasons.push(`${fmtInt(impressions)} wyświetleń przy pozycji ${fmtNum(bestPosition, 1)}`);
    }
    if (impressions > 0 && typeof bestPosition === 'number' && bestPosition >= 11 && bestPosition <= 20) {
      reasons.push(`pozycja ${fmtNum(bestPosition, 1)} — blisko TOP 10`);
    }
    if (ctrPoints > 0) reasons.push(`CTR ${fmtPct(indexing?.ctr)} mimo ${fmtInt(impressions)} wyświetleń`);
    if (ageDays >= minAgeDays) reasons.push(`bez aktualizacji od ${fmtInt(ageDays)} dni`);
    if (engagementPoints >= 3) reasons.push(`engagement ${fmtPct(ga4?.engagement_rate)}`);

    const indexed = indexing?.indexed ?? null;
    // Stan pomiaru rozdzielony od pilności: wpis poza indeksem albo bez danych
    // GSC nie jest „mniej pilny" – po prostu nie ma czego ważyć, idzie na
    // osobną diagnozę.
    const state = indexed === false ? 'not-indexed' : !measured ? 'no-data' : 'measured';

    return {
      ...content,
      path,
      age_days: ageDays,
      age_bucket: ageBucket(ageDays),
      state,
      effective_date: effectiveDate,
      indexed,
      last_crawl: indexing?.last_crawl ?? null,
      clicks: indexing?.clicks ?? null,
      impressions: indexing?.impressions ?? null,
      ctr: indexing?.ctr ?? null,
      gsc_position: indexing?.position ?? null,
      clicks_delta: clicksDelta,
      impressions_delta: impressionsDelta,
      position_delta: positionDelta,
      ga4_sessions: ga4?.sessions ?? null,
      engagement_rate: ga4?.engagement_rate ?? null,
      avg_engagement_s: ga4?.avg_engagement_s ?? null,
      senuto_position: senuto?.best_position ?? null,
      senuto_keyword: senuto?.best_keyword ?? null,
      senuto_keywords: senuto?.keywords ?? null,
      senuto_top10: senuto?.top10 ?? null,
      senuto_top_keywords: [...(senutoKeywordsByPath.get(path) ?? [])]
        .sort(
          (a, b) =>
            keywordRank(a.position) - keywordRank(b.position) ||
            (b.searches ?? 0) - (a.searches ?? 0) ||
            a.position - b.position,
        )
        .slice(0, KEYWORDS_SHOWN),
      score,
      // Do payloadu idą tylko liczby – etykiety i opisy są stałe dla wszystkich
      // wpisów, więc powielone 604 razy rozdmuchiwały stronę do megabajtów.
      parts: parts.map((part) => ({
        key: part.key,
        points: Math.round(part.points * 10) / 10,
        max: part.max,
        available: part.available,
      })),
      reasons,
    };
  });

// „Niski ranking" liczymy z kliknięć i wyświetleń, nie ze średniej pozycji:
// pozycja jest średnią po frazach, więc wpis może być pierwszy na frazę bez
// popytu i wyglądać świetnie mimo zerowego ruchu. Próg to mediana domeny –
// bezwzględne liczby znaczą co innego na blogu 40-wpisowym i na 604 wpisach.
const median = (values: number[]): number => {
  if (!values.length) return 0;
  const sorted = [...values].sort((a, b) => a - b);
  const middle = Math.floor(sorted.length / 2);
  return sorted.length % 2 ? sorted[middle] : (sorted[middle - 1] + sorted[middle]) / 2;
};
// Mediana liczona z wpisów, które mają jakikolwiek ruch. Na całym katalogu
// wyszłaby zero (połowa treści nie ma ani jednego kliknięcia) i „ma 1 klik"
// znaczyłoby „wyniki OK". Punktem odniesienia jest typowy wpis, który działa.
const measuredItems = items.filter((item) => item.state === 'measured');
const medianClicks = median(measuredItems.map((item) => item.clicks ?? 0).filter((value) => value > 0));
const medianImpressions = median(measuredItems.map((item) => item.impressions ?? 0).filter((value) => value > 0));
const weakTraffic = (item: { clicks: number | null; impressions: number | null }): boolean =>
  (item.clicks ?? 0) < medianClicks && (item.impressions ?? 0) < medianImpressions;

// Macierz pilności: wyniki × wiek. Słabe wyniki eskalują z wiekiem (ponad rok
// bez zmian = krytyczny), dobre wyniki schodzą o jeden stopień – treść, która
// dowozi ruch, nie staje się pilna tylko dlatego, że się zestarzała.
const URGENCY_BY_AGE: Record<string, string> = { 'm12+': 'critical', 'm6-12': 'high', 'm3-6': 'normal', 'm0-3': 'low' };
const DOWNGRADE: Record<string, string> = { critical: 'normal', high: 'low', normal: 'low', low: 'low' };
const withUrgency = items.map((item) => {
  const weak = weakTraffic(item);
  const base = URGENCY_BY_AGE[item.age_bucket] ?? 'low';
  const urgency = item.state !== 'measured' ? 'none' : weak ? base : DOWNGRADE[base];
  return { ...item, weak_traffic: weak, urgency };
});

const URGENCY_RANK: Record<string, number> = { critical: 4, high: 3, normal: 2, low: 1, none: 0 };
const sortedItems = withUrgency.sort(
  (a, b) =>
    URGENCY_RANK[b.urgency] - URGENCY_RANK[a.urgency] ||
    b.score - a.score ||
    b.age_days - a.age_days ||
    a.title.localeCompare(b.title, 'pl'),
);

const byAge = Object.fromEntries(
  AGE_BUCKETS.map((bucket) => [bucket.key, sortedItems.filter((item) => item.age_bucket === bucket.key).length]),
);
const byUrgency = Object.fromEntries(
  ['critical', 'high', 'normal', 'low'].map((key) => [key, sortedItems.filter((item) => item.urgency === key).length]),
);
const notIndexed = sortedItems.filter((item) => item.state === 'not-indexed').length;
const noData = sortedItems.filter((item) => item.state === 'no-data').length;
const withTraffic = sortedItems.filter((item) => (item.clicks ?? 0) > 0 || (item.impressions ?? 0) > 0).length;
const pillars = [...new Set(sortedItems.map((item) => item.pillar))].sort((a, b) => a.localeCompare(b, 'pl'));
const detailPayload = Object.fromEntries(sortedItems.map((item) => [item.id, item]));

const urgencyLabel: Record<string, string> = {
  critical: 'krytyczny',
  high: 'wysoki',
  normal: 'normalny',
  low: 'niski',
  none: 'poza oceną',
};
const stateLabel: Record<string, string> = {
  measured: 'w indeksie',
  'not-indexed': 'poza indeksem',
  'no-data': 'brak pomiaru',
};
const ageLabel: Record<string, string> = Object.fromEntries(
  AGE_BUCKETS.map((bucket) => [bucket.key, `bez zmian ${bucket.range}`]),
);

// Katalog z CMS-a: świeżość liczona z hasha treści, nie z pola `modified`,
// które WordPress podbija przy każdym zapisie (także masowej akcji wtyczki).
const fromCms = (domainConfig.content_watcher as { source?: string } | undefined)?.source === 'wordpress';
const baseline = items.filter((item) => item.hash_baseline).length;
---

<Layout title={`${name} – Content Watcher`}>
  <DomainHeader domain={domain!} name={name} active="content-watcher" latest={latest} themeToggle />

  <div class="cw-note">
    <p>
      Moduł Content Watcher łączy metadane artykułów ze statusem indeksacji oraz danymi z GSC, GA4 i Senuto.
      Wskaźnik priorytetu podpowiada, które teksty warto zweryfikować ręcznie przed ich ponowną optymalizacją
      (integrację z kolejką n8n dodamy w kolejnym etapie).
      {fromCms && <> Baza tekstów jest pobierana przez REST API WordPressa, a treści budujemy z pól ACF.</>}
    </p>
    {fromCms && (
      <p>
        Co ważne, „Data aktualizacji” odzwierciedla rzeczywistą zmianę tekstu weryfikowaną na podstawie sumy
        kontrolnej (tzw. hasha). Ignorujemy dzięki temu systemowe pole <code>modified</code>, które aktualizuje się
        przy każdym kliknięciu „Zapisz” w CMS-ie.
        {baseline > 0 && <> Dla {fmtInt(baseline)} wpisów obecny hash to dopiero stan początkowy – do czasu ich
        pierwszej edycji wyświetlamy tam standardową datę modyfikacji.</>}
      </p>
    )}
  </div>

  <div class="section-head">
    <h2>Stan treści</h2>
    <span class="section-meta">katalog i scoring na {fmtDate(asOf)}</span>
  </div>
  <div class="kwrap rgrid cw-kpis" data-cw-kpis>
    <button type="button" class="cw-kpi" data-dim="age" data-filter="all" aria-pressed="false">
      <StatCard label="Wszystkie publikacje" value={sortedItems.length} emptyDeltaLabel="baza wiedzy" hero />
    </button>
    {AGE_BUCKETS.map((bucket) => (
      <button type="button" class="cw-kpi" data-dim="age" data-filter={bucket.key} data-tone={bucket.tone} aria-pressed="false">
        <StatCard label={bucket.label} value={byAge[bucket.key]} emptyDeltaLabel={bucket.hint} dot="var(--tone-fg)" />
      </button>
    ))}
  </div>

  <div class="section-head">
    <h3>Pilność odświeżenia</h3>
    <span class="section-meta">
      wyniki × wiek · słabe wyniki = kliknięcia i wyświetlenia z 30 dni poniżej mediany domeny
      ({fmtInt(medianClicks)} klik. / {fmtInt(medianImpressions)} wyśw.)
    </span>
  </div>
  <div class="kwrap rgrid cw-kpis cw-kpis-urgency" data-cw-kpis>
    <button type="button" class="cw-kpi" data-dim="urgency" data-filter="critical" data-tone="err" aria-pressed="false">
      <StatCard label="Krytyczny" value={byUrgency.critical} emptyDeltaLabel="słabe wyniki, ponad 12 mies." dot="var(--tone-fg)" />
    </button>
    <button type="button" class="cw-kpi" data-dim="urgency" data-filter="high" data-tone="warn" aria-pressed="false">
      <StatCard label="Wysoki" value={byUrgency.high} emptyDeltaLabel="słabe wyniki, 6–12 mies." dot="var(--tone-fg)" />
    </button>
    <button type="button" class="cw-kpi" data-dim="urgency" data-filter="normal" data-tone="mid" aria-pressed="false">
      <StatCard label="Normalny" value={byUrgency.normal} emptyDeltaLabel="słabe wyniki, 3–6 mies." dot="var(--tone-fg)" />
    </button>
    <button type="button" class="cw-kpi" data-dim="urgency" data-filter="low" data-tone="ok" aria-pressed="false">
      <StatCard label="Niski" value={byUrgency.low} emptyDeltaLabel="świeże lub z ruchem" dot="var(--tone-fg)" />
    </button>
    <button type="button" class="cw-kpi" data-dim="state" data-filter="not-indexed" data-tone="muted" aria-pressed="false">
      <StatCard label="Poza indeksem" value={notIndexed} emptyDeltaLabel="wymaga osobnej diagnozy" dot="var(--tone-fg)" />
    </button>
  </div>

  <div class="section-head cw-list-head">
    <div>
      <h2>Priorytety reoptymalizacji</h2>
      <span class="section-meta">
        Pilność zależy od relacji wyników do wieku wpisu • Wynik (0–100) decyduje o kolejności wpisów o tej samej
        pilności i uwzględnia: utratę ruchu, potencjał, pokrycie fraz oraz zaangażowanie • Obowiązuje
        {' '}{fmtInt(minAgeDays)}-dniowy okres ochronny • Kliknij „Szczegóły”, aby zobaczyć składowe oceny.
      </span>
    </div>
    <div class="cw-automation" title="Automatyzacja zostanie uruchomiona po wdrożeniu kolejki i callbacków n8n">
      <span>Automatyzacja</span><b>OFF</b>
    </div>
  </div>

  <div class="cw-controls">
    <div class="fchips" data-cw-filters>
      <button type="button" class="fchip on" data-dim="state" data-filter="all">
        Wszystkie <span>{sortedItems.length}</span>
      </button>
      <button type="button" class="fchip" data-dim="state" data-filter="traffic">
        Z ruchem <span>{withTraffic}</span>
      </button>
      <button type="button" class="fchip" data-dim="state" data-filter="weak">
        Słabe wyniki <span>{sortedItems.filter((item) => item.state === 'measured' && item.weak_traffic).length}</span>
      </button>
      <button type="button" class="fchip" data-dim="state" data-filter="not-indexed">
        Poza indeksem <span>{notIndexed}</span>
      </button>
      <button type="button" class="fchip" data-dim="state" data-filter="no-data">
        Bez pomiaru <span>{noData}</span>
      </button>
    </div>
    <label class="cw-pillar">
      <span>Filar</span>
      <select data-cw-pillar>
        <option value="all">Wszystkie</option>
        {pillars.map((pillar) => <option value={pillar}>{pillar}</option>)}
      </select>
    </label>
  </div>

  <div data-cw-table>
    <TableCard
      title="Artykuły"
      count={sortedItems.length}
      filter
      pageSize={25}
      empty="Nie znaleziono artykułów w skonfigurowanej kolekcji."
    >
      <table class="data-table cw-table">
        <thead>
          <tr>
            <th class="num">Pilność</th>
            <th>Treść</th>
            <th class="num cw-date-th">Publikacja</th>
            <th class="num cw-date-th">Aktualizacja</th>
            <th class="num">GSC · 30 dni</th>
            <th class="num">Zmiana · 90 dni</th>
            <th class="num">GA4</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          {
            sortedItems.map((item) => (
              <tr
                data-urgency={item.urgency}
                data-age={item.age_bucket}
                data-state={item.state}
                data-weak={item.weak_traffic ? '1' : '0'}
                data-traffic={(item.clicks ?? 0) > 0 || (item.impressions ?? 0) > 0 ? '1' : '0'}
                data-pillar={item.pillar}
                data-score={item.score}
              >
                <td class="num cw-score-cell" data-sort={URGENCY_RANK[item.urgency] * 1000 + item.score} data-label="Pilność">
                  <span class={`cw-urgency ${item.urgency}`}>{urgencyLabel[item.urgency]}</span>
                  <small>{item.state === 'measured' ? `wynik ${item.score}/100` : stateLabel[item.state]}</small>
                </td>
                <td class="grow cw-content" data-label="Treść">
                  <div class="cw-title-row">
                    <a href={item.url} target="_blank" rel="noopener">{item.title}</a>
                    <button type="button" data-cw-detail={item.id}>Szczegóły</button>
                    {fromCms && (
                      <a class="cw-editor-link" href={`/${domain}/content-watcher/edytor/?id=${item.id}`}>
                        Edytor
                      </a>
                    )}
                  </div>
                  <span>{item.path}</span>
                  <small>{item.pillar} · {fmtInt(item.word_count)} słów · {fmtInt(item.headings)} nagłówków</small>
                </td>
                <td class="num cw-date" data-sort={item.published_at.replaceAll('-', '')} data-label="Publikacja">
                  <span class="cw-chip pub">{fmtDate(item.published_at)}</span>
                </td>
                <td class="num cw-date" data-sort={item.effective_date.replaceAll('-', '')} data-label="Aktualizacja">
                  <span
                    class="cw-chip upd"
                    data-age={item.age_bucket}
                    title={item.hash_baseline
                      ? 'Data z pola modified – hash treści jest dopiero punktem odniesienia'
                      : undefined}
                  >
                    {fmtDate(item.updated_at ?? item.published_at)}{item.hash_baseline ? ' ≈' : ''}
                  </span>
                  <small>{fmtInt(item.age_days)} dni temu</small>
                </td>
                <td class="num" data-sort={item.impressions ?? -1} data-label="GSC · 30 dni">
                  <b>{fmtInt(item.clicks)}</b> klik.
                  <small>{fmtInt(item.impressions)} wyśw. · CTR {fmtPct(item.ctr)}</small>
                </td>
                <td class="num" data-sort={item.clicks_delta ?? 0} data-label="Zmiana · 90 dni">
                  <span class:list={['cw-delta', { bad: (item.clicks_delta ?? 0) < 0, good: (item.clicks_delta ?? 0) > 0 }]}>
                    {item.clicks_delta === null ? '–' : `${item.clicks_delta > 0 ? '+' : ''}${fmtInt(item.clicks_delta)} klik.`}
                  </span>
                  <small>
                    {item.position_delta === null
                      ? 'pozycja: –'
                      : `pozycja ${item.position_delta > 0 ? '+' : ''}${fmtNum(item.position_delta, 1)}`}
                  </small>
                </td>
                <td class="num" data-sort={item.ga4_sessions ?? -1} data-label="GA4">
                  <b>{fmtInt(item.ga4_sessions)}</b> sesji
                  <small>eng. {fmtPct(item.engagement_rate)}</small>
                </td>
                <td data-label="Status">
                  <span class={`cw-status ${item.state}`}>{stateLabel[item.state]}</span>
                  <small>
                    {ageLabel[item.age_bucket]}
                    {item.state === 'measured' ? (item.weak_traffic ? ' · słabe wyniki' : ' · wyniki OK') : ''}
                  </small>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </TableCard>
  </div>

  <dialog class="cw-dialog" data-cw-dialog>
    <div class="cw-dialog-head">
      <div>
        <span data-detail-pillar></span>
        <h2 data-detail-title>Szczegóły artykułu</h2>
        <a data-detail-url target="_blank" rel="noopener"></a>
      </div>
      <button type="button" data-detail-close aria-label="Zamknij">×</button>
    </div>
    <div class="cw-dialog-grid">
      <section>
        <h3>Wyniki</h3>
        <dl class="cw-facts">
          <div><dt>Publikacja</dt><dd data-detail-published></dd></div>
          <div><dt>Aktualizacja</dt><dd data-detail-updated></dd></div>
          <div><dt>Wiek treści</dt><dd data-detail-age></dd></div>
          <div><dt>Indeksacja</dt><dd data-detail-indexed></dd></div>
          <div><dt>GSC</dt><dd data-detail-gsc></dd></div>
          <div><dt>Zmiana 90 dni</dt><dd data-detail-change></dd></div>
          <div><dt>GA4</dt><dd data-detail-ga4></dd></div>
          <div><dt>Senuto</dt><dd data-detail-senuto></dd></div>
          <div><dt>Struktura</dt><dd data-detail-structure></dd></div>
          <div><dt>Plik</dt><dd><code data-detail-path></code></dd></div>
        </dl>
        <h3>Dlaczego taki priorytet?</h3>
        <ul class="cw-reasons" data-detail-reasons></ul>
        <h3 data-detail-keywords-head>Na jakie frazy rankuje</h3>
        <div class="cw-keywords" data-detail-keywords></div>
      </section>
      <aside>
        <div class="cw-score-large"><b data-detail-score></b><span>/ 100</span></div>
        <p class="cw-score-note">
          Suma czterech składowych. Mianownik jest stały – brak danych w źródle nie podnosi wyniku, tylko odbiera
          jego maksimum.
        </p>
        <div class="cw-breakdown" data-detail-parts></div>
        <div class="cw-next">
          <strong>Kolejka automatyzacji</strong>
          <p>W etapie 2 ten przycisk wyśle zatwierdzone zadanie do n8n i pokaże tutaj status oraz link do PR.</p>
          <button type="button" disabled>Dodaj do kolejki · etap 2</button>
        </div>
      </aside>
    </div>
  </dialog>

  <script id="content-watcher-data" type="application/json" set:html={JSON.stringify(detailPayload).replace(/</g, '\\u003c')} />
  <script id="content-watcher-parts" type="application/json" set:html={JSON.stringify(SCORE_PART_TEXTS).replace(/</g, '\\u003c')} />

  <script>
    type DetailPart = { key: string; points: number; max: number; available: boolean };
    type PartText = { label: string; hint: string; formula: string };
    type DetailItem = {
      title: string; url: string; pillar: string; content_path: string;
      published_at: string; updated_at: string | null; age_days: number;
      indexed: boolean | null; last_crawl: string | null;
      clicks: number | null; impressions: number | null; ctr: number | null;
      clicks_delta: number | null; position_delta: number | null;
      ga4_sessions: number | null; engagement_rate: number | null;
      senuto_position: number | null; senuto_keywords: number | null; senuto_top10: number | null;
      senuto_top_keywords: { keyword: string; position: number; searches: number | null }[];
      word_count: number; headings: number; internal_links: number; external_links: number;
      score: number; reasons: string[];
      parts: DetailPart[];
    };
    const payloadNode = document.getElementById('content-watcher-data');
    const contentItems = payloadNode?.textContent ? JSON.parse(payloadNode.textContent) as Record<string, DetailItem> : {};
    const partsNode = document.getElementById('content-watcher-parts');
    const partTexts = partsNode?.textContent ? JSON.parse(partsNode.textContent) as Record<string, PartText> : {};
    const dialog = document.querySelector<HTMLDialogElement>('[data-cw-dialog]');
    const pl = new Intl.NumberFormat('pl-PL', { maximumFractionDigits: 1 });
    const date = (value: string | null) =>
      value ? new Date(`${value}T00:00:00Z`).toLocaleDateString('pl-PL', { timeZone: 'UTC' }) : '—';
    const pct = (value: number | null) => value === null ? '—' : `${pl.format(value)}%`;
    const set = (selector: string, value: string) => {
      const node = dialog?.querySelector<HTMLElement>(selector);
      if (node) node.textContent = value;
    };

    document.querySelectorAll<HTMLButtonElement>('[data-cw-detail]').forEach((button) => {
      button.addEventListener('click', () => {
        const item = contentItems[button.dataset.cwDetail ?? ''];
        if (!item || !dialog) return;
        set('[data-detail-pillar]', item.pillar);
        set('[data-detail-title]', item.title);
        const link = dialog.querySelector<HTMLAnchorElement>('[data-detail-url]');
        if (link) { link.href = item.url; link.textContent = new URL(item.url).pathname; }
        set('[data-detail-published]', date(item.published_at));
        set('[data-detail-updated]', date(item.updated_at));
        set('[data-detail-age]', `${pl.format(item.age_days)} dni`);
        set('[data-detail-indexed]', item.indexed === null ? 'brak pomiaru' : item.indexed ? `tak · crawl ${date(item.last_crawl)}` : 'nie');
        set('[data-detail-gsc]', `${pl.format(item.clicks ?? 0)} klik. · ${pl.format(item.impressions ?? 0)} wyśw. · CTR ${pct(item.ctr)}`);
        set('[data-detail-change]', item.clicks_delta === null ? 'brak porównania' : `${item.clicks_delta > 0 ? '+' : ''}${pl.format(item.clicks_delta)} klik. · pozycja ${item.position_delta === null ? '—' : `${item.position_delta > 0 ? '+' : ''}${pl.format(item.position_delta)}`}`);
        set('[data-detail-ga4]', item.ga4_sessions === null ? 'brak danych' : `${pl.format(item.ga4_sessions)} sesji · engagement ${pct(item.engagement_rate)}`);
        set('[data-detail-senuto]', item.senuto_position === null ? 'brak dopasowanych fraz' : `poz. ${pl.format(item.senuto_position)} · ${pl.format(item.senuto_keywords ?? 0)} fraz · ${pl.format(item.senuto_top10 ?? 0)} TOP 10`);
        set('[data-detail-structure]', `${pl.format(item.word_count)} słów · ${pl.format(item.headings)} nagłówków · ${pl.format(item.internal_links)} linków wewn. · ${pl.format(item.external_links)} zewn.`);
        set('[data-detail-path]', item.content_path);
        set('[data-detail-score]', String(item.score));
        const reasons = dialog.querySelector<HTMLElement>('[data-detail-reasons]');
        reasons?.replaceChildren(...(item.reasons.length ? item.reasons : ['Brak silnego sygnału do reoptymalizacji.']).map((reason) => {
          const li = document.createElement('li'); li.textContent = reason; return li;
        }));
        // Frazy Senuto: pierwsze idą te tuż pod progiem (11–30) – to one są
        // celem reoptymalizacji; reszta listy tylko pokazuje kontekst.
        const keywords = dialog.querySelector<HTMLElement>('[data-detail-keywords]');
        const rest = (item.senuto_keywords ?? 0) - item.senuto_top_keywords.length;
        keywords?.replaceChildren(
          ...(item.senuto_top_keywords.length
            ? item.senuto_top_keywords.map((row) => {
                const line = document.createElement('div');
                line.className = 'cw-kw';
                const name = document.createElement('span'); name.textContent = row.keyword;
                const pos = document.createElement('b');
                pos.className = row.position >= 11 && row.position <= 30 ? 'near' : '';
                pos.textContent = `poz. ${pl.format(row.position)}`;
                const vol = document.createElement('small');
                vol.textContent = row.searches === null ? 'brak wolumenu' : `${pl.format(row.searches)} wysz./mies.`;
                line.append(name, pos, vol);
                return line;
              })
            : [Object.assign(document.createElement('p'), {
                className: 'cw-kw-empty',
                textContent: 'Senuto nie widzi tego adresu w wynikach wyszukiwania.',
              })]),
          ...(rest > 0
            ? [Object.assign(document.createElement('p'), {
                className: 'cw-kw-empty',
                textContent: `+ ${pl.format(rest)} kolejnych fraz w Senuto`,
              })]
            : []),
        );
        const parts = dialog.querySelector<HTMLElement>('[data-detail-parts]');
        parts?.replaceChildren(...item.parts.map((part) => {
          const text = partTexts[part.key] ?? { label: part.key, hint: '', formula: '' };
          const row = document.createElement('div');
          row.className = part.available ? 'cw-part' : 'cw-part unavailable';
          const head = document.createElement('div');
          head.className = 'cw-part-head';
          const label = document.createElement('span');
          label.textContent = text.label;
          // Badge „i" z pełnym wzorem – ten sam wzorzec, co w nagłówkach tabel
          // (obsługa otwierania siedzi w globalnym listenerze TableCard).
          const badge = document.createElement('span');
          badge.className = 'info-badge';
          badge.textContent = 'i';
          const tip = document.createElement('span');
          tip.className = 'info-tip';
          tip.textContent = text.formula;
          badge.append(tip);
          label.append(badge);
          const value = document.createElement('strong');
          value.textContent = part.available ? `${pl.format(part.points)} / ${part.max} pkt` : 'brak danych';
          head.append(label, value);
          const track = document.createElement('i');
          const fill = document.createElement('b');
          fill.style.width = `${part.available ? Math.round((part.points / part.max) * 100) : 0}%`;
          track.append(fill);
          const hint = document.createElement('small');
          hint.textContent = text.hint;
          row.append(head, track, hint);
          return row;
        }));
        dialog.showModal();
      });
    });
    dialog?.querySelector<HTMLButtonElement>('[data-detail-close]')?.addEventListener('click', () => dialog.close());
    dialog?.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });

    const tableCard = document.querySelector<HTMLElement>('[data-cw-table] .table-card');
    const pillarSelect = document.querySelector<HTMLSelectElement>('[data-cw-pillar]');
    const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-cw-kpis] button[data-filter], [data-cw-filters] button[data-filter]')];
    // Trzy niezależne wymiary filtra składane iloczynem: wiek treści, pilność
    // i stan pomiaru. Kliknięcie karty przełącza tylko swój wymiar, więc da się
    // zestawić np. „ponad 12 mies." × „krytyczny".
    const active: Record<string, string> = { age: 'all', urgency: 'all', state: 'all' };
    const matchState = (row: HTMLTableRowElement): boolean => {
      const value = active.state;
      if (value === 'all') return true;
      if (value === 'traffic') return row.dataset.traffic === '1';
      if (value === 'weak') return row.dataset.state === 'measured' && row.dataset.weak === '1';
      return row.dataset.state === value;
    };
    const refilter = () => {
      const pillar = pillarSelect?.value ?? 'all';
      tableCard?.dispatchEvent(new CustomEvent('tablecard:refilter', {
        detail: (row: HTMLTableRowElement) =>
          (active.age === 'all' || row.dataset.age === active.age) &&
          (active.urgency === 'all' || row.dataset.urgency === active.urgency) &&
          matchState(row) &&
          (pillar === 'all' || row.dataset.pillar === pillar),
      }));
    };
    const paint = () => {
      buttons.forEach((button) => {
        const dim = button.dataset.dim ?? 'state';
        const on = active[dim] === button.dataset.filter;
        button.classList.toggle('on', on);
        if (button.hasAttribute('aria-pressed')) button.setAttribute('aria-pressed', String(on));
      });
    };
    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        const dim = button.dataset.dim ?? 'state';
        const value = button.dataset.filter ?? 'all';
        if (value === 'all') {
          // „Artykuły" i chip „Wszystkie" to reset całego zestawu, nie jednego wymiaru.
          active.age = 'all'; active.urgency = 'all'; active.state = 'all';
        } else {
          // Ponowny klik w aktywny filtr go zdejmuje – inaczej z „Poza indeksem"
          // nie da się wrócić bez szukania przycisku „Wszystkie".
          active[dim] = active[dim] === value ? 'all' : value;
        }
        paint();
        refilter();
        if (button.closest('[data-cw-kpis]')) {
          document.querySelector('[data-cw-table]')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    });
    pillarSelect?.addEventListener('change', refilter);
    paint();
  </script>
</Layout>

<style>
  .cw-note {
    margin: 18px 0 24px;
    padding: 14px 18px;
    border-left: 2px solid var(--accent-blue);
    background: var(--accent-blue-soft);
    color: var(--ink-muted);
    font-size: .86rem;
    line-height: 1.55;
  }
  .cw-note p { margin: 0; }
  .cw-note p + p { margin-top: 10px; }
  .cw-kpis { grid-template-columns: 1.35fr repeat(4, 1fr); margin-bottom: 28px; }
  .cw-kpis-urgency { grid-template-columns: repeat(5, 1fr); }
  /* Karta KPI jako przycisk filtra: `all: unset` zdejmuje wygląd buttona,
     a StatCard (scoped w komponencie) domykamy przez :global. */
  .cw-kpi { all: unset; display: block; min-width: 0; cursor: pointer; }
  .cw-kpi > :global(.stat-card) { height: 100%; }
  .cw-kpi:focus-visible > :global(.stat-card) { outline: 2px solid var(--accent-blue); outline-offset: 2px; }
  .cw-kpi.on > :global(.stat-card) { border-color: var(--tone-fg, var(--accent-blue)); background: var(--tone-bg, var(--accent-blue-soft)); }
  /* Skala pilności ma czytać się kolorem, nie tylko liczbą: zielony → żółty →
     pomarańczowy → czerwony. Kolor niosą karty wieku i pilności tak samo, bo
     to ta sama oś (świeże = niski priorytet). */
  .cw-kpi[data-tone='ok'] { --tone-fg: var(--status-ok); --tone-bg: var(--status-ok-bg); }
  .cw-kpi[data-tone='mid'] { --tone-fg: var(--status-mid-fg); --tone-bg: var(--status-mid-bg); }
  .cw-kpi[data-tone='warn'] { --tone-fg: var(--status-warn-fg); --tone-bg: var(--status-warn-bg); }
  .cw-kpi[data-tone='err'] { --tone-fg: var(--status-err-fg); --tone-bg: var(--status-err-bg); }
  .cw-kpi[data-tone='muted'] { --tone-fg: var(--ink-faint); --tone-bg: var(--bg-surface-3); }
  .cw-kpi[data-tone] > :global(.stat-card) { border-left: 3px solid var(--tone-fg); }
  .cw-kpi[data-tone] :global(.stat-value) { color: var(--tone-fg); }
  .cw-list-head { align-items: flex-end; }
  .cw-list-head > div:first-child { display: flex; flex-direction: column; gap: 5px; }
  .cw-automation { display: flex; align-items: center; gap: 9px; color: var(--ink-faint); font-size: .76rem; }
  .cw-automation b { padding: 4px 9px; border-radius: 999px; background: var(--bg-surface-3); color: var(--ink-faint); }
  .cw-controls {
    display: flex; align-items: center; justify-content: space-between; gap: 14px; flex-wrap: wrap;
    margin: 12px 0 10px;
  }
  .fchip span { color: var(--ink-faint); margin-left: 3px; }
  .cw-pillar { display: flex; align-items: center; gap: 8px; color: var(--ink-faint); font-size: .76rem; }
  .cw-pillar select {
    border: 1px solid var(--hairline); border-radius: 2px; padding: 6px 28px 6px 9px;
    background: var(--bg-surface-1); color: var(--ink); font: inherit;
  }
  .cw-table { min-width: 980px; }
  .cw-table td { vertical-align: middle; }
  .cw-table small { display: block; color: var(--ink-faint); font-size: .69rem; margin-top: 4px; white-space: nowrap; }
  .cw-score-cell { text-align: left; }
  .cw-urgency {
    display: inline-flex; padding: 4px 9px; border-radius: 999px; background: var(--bg-surface-3);
    color: var(--ink-muted); font-size: .72rem; font-weight: 600; white-space: nowrap;
  }
  .cw-urgency.critical { color: var(--status-err-fg); background: var(--status-err-bg); }
  .cw-urgency.high { color: var(--status-warn-fg); background: var(--status-warn-bg); }
  .cw-urgency.normal { color: var(--status-mid-fg); background: var(--status-mid-bg); }
  .cw-urgency.low { color: var(--status-ok); background: var(--status-ok-bg); }
  .cw-content { min-width: 260px; max-width: 370px; }
  .cw-title-row { display: flex; align-items: flex-start; gap: 9px; }
  .cw-title-row > a { flex: 1; color: var(--ink); font-weight: 600; line-height: 1.3; text-decoration: none; }
  .cw-title-row > a:hover { color: var(--accent-blue); }
  .cw-title-row button {
    border: 0; border-bottom: 1px solid var(--hairline); padding: 1px 0; background: none;
    color: var(--ink-faint); font: inherit; font-size: .68rem; cursor: pointer; white-space: nowrap;
  }
  .cw-title-row button:hover { border-color: var(--accent-blue); color: var(--accent-blue); }
  /* Reguła `.cw-title-row > a { flex: 1 }` dotyczy tytułu wpisu – link do
     edytora musi się z niej wypisać, inaczej rozpycha wiersz. */
  .cw-title-row > a.cw-editor-link {
    flex: 0 0 auto; border-bottom: 1px solid var(--hairline); padding: 1px 0;
    color: var(--ink-faint); font-size: .68rem; font-weight: 600; white-space: nowrap;
  }
  .cw-title-row > a.cw-editor-link:hover { border-color: var(--accent-blue); color: var(--accent-blue); }
  .cw-content > span { display: block; color: var(--ink-faint); font-size: .7rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  /* Daty w dwóch osobnych, sortowalnych kolumnach. Chip aktualizacji nosi
     kolor kubełka wieku – ten sam podział, co karty u góry strony. */
  .cw-date-th, .cw-date { text-align: left; }
  .cw-date small { white-space: nowrap; }
  .cw-chip {
    display: inline-block; padding: 4px 9px; border-radius: 2px; font-size: .74rem;
    font-variant-numeric: tabular-nums; white-space: nowrap;
  }
  .cw-chip.pub { background: var(--bg-surface-3); color: var(--ink-muted); }
  .cw-chip.upd { font-weight: 600; }
  .cw-chip.upd[data-age='m0-3'] { color: var(--status-ok); background: var(--status-ok-bg); }
  .cw-chip.upd[data-age='m3-6'] { color: var(--status-mid-fg); background: var(--status-mid-bg); }
  .cw-chip.upd[data-age='m6-12'] { color: var(--status-warn-fg); background: var(--status-warn-bg); }
  .cw-chip.upd[data-age='m12+'] { color: var(--status-err-fg); background: var(--status-err-bg); }
  .cw-delta.bad { color: var(--status-err-fg); font-weight: 600; }
  .cw-delta.good { color: var(--status-ok); font-weight: 600; }
  .cw-status {
    display: inline-flex; padding: 4px 9px; border-radius: 999px; background: var(--bg-surface-3);
    color: var(--ink-muted); font-size: .72rem; font-weight: 600; white-space: nowrap;
  }
  .cw-status.not-indexed { color: var(--status-err-fg); background: var(--status-err-bg); }
  .cw-status.no-data { color: var(--ink-faint); background: var(--bg-surface-3); }
  .cw-next button {
    border: 1px solid var(--hairline); border-radius: 2px; background: var(--bg-surface-2); color: var(--ink);
    font: inherit; font-size: .74rem; font-weight: 600; padding: 6px 10px; cursor: pointer; white-space: nowrap;
  }
  .cw-dialog {
    width: min(1000px, calc(100vw - 32px)); max-height: min(800px, calc(100vh - 32px)); padding: 0;
    border: 1px solid var(--hairline); border-radius: 2px; color: var(--ink); background: var(--bg-surface-1);
  }
  .cw-dialog::backdrop { background: rgba(0, 0, 0, .7); backdrop-filter: blur(2px); }
  .cw-dialog-head { display: flex; justify-content: space-between; gap: 20px; padding: 22px 24px; border-bottom: 1px solid var(--hairline); }
  .cw-dialog-head span { color: var(--accent-blue); font-size: .7rem; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; }
  .cw-dialog-head h2 { margin: 4px 0; font: 600 1.35rem var(--font-display); }
  .cw-dialog-head a { color: var(--ink-faint); font-size: .75rem; }
  .cw-dialog-head button { align-self: flex-start; border: 0; background: transparent; color: var(--ink-faint); font-size: 1.7rem; cursor: pointer; }
  .cw-dialog-grid { display: grid; grid-template-columns: 1.45fr 1fr; gap: 28px; padding: 24px; overflow-y: auto; }
  .cw-dialog h3 { margin: 0 0 12px; font-size: .84rem; text-transform: uppercase; letter-spacing: .07em; color: var(--ink-faint); }
  .cw-dialog h3:not(:first-child) { margin-top: 24px; }
  .cw-facts { display: grid; grid-template-columns: 1fr 1fr; gap: 9px; margin: 0; }
  .cw-facts div { padding: 10px 12px; background: var(--bg-surface-2); min-width: 0; }
  .cw-facts dt { color: var(--ink-faint); font-size: .68rem; }
  .cw-facts dd { margin: 4px 0 0; color: var(--ink); font-size: .79rem; overflow-wrap: anywhere; }
  .cw-facts code { font-size: .68rem; color: var(--ink-muted); }
  .cw-reasons { margin: 0; padding-left: 20px; color: var(--ink-muted); font-size: .82rem; line-height: 1.65; }
  .cw-keywords { display: flex; flex-direction: column; gap: 1px; }
  .cw-keywords :global(.cw-kw) {
    display: grid; grid-template-columns: 1fr auto auto; gap: 12px; align-items: baseline;
    padding: 7px 10px; background: var(--bg-surface-2); font-size: .79rem;
  }
  .cw-keywords :global(.cw-kw span) { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .cw-keywords :global(.cw-kw b) { color: var(--ink-muted); font-size: .72rem; font-weight: 600; white-space: nowrap; }
  /* Pozycje 11–30 to cel reoptymalizacji – wyróżnione, reszta jest kontekstem. */
  .cw-keywords :global(.cw-kw b.near) { color: var(--status-warn-fg); }
  .cw-keywords :global(.cw-kw small) { color: var(--ink-faint); font-size: .69rem; white-space: nowrap; min-width: 92px; text-align: right; }
  .cw-keywords :global(.cw-kw-empty) { margin: 8px 0 0; color: var(--ink-faint); font-size: .74rem; }
  .cw-score-large { display: flex; align-items: baseline; gap: 6px; margin-bottom: 6px; }
  .cw-score-note {
    margin: 0 0 18px; padding-bottom: 14px; border-bottom: 1px solid var(--hairline);
    color: var(--ink-faint); font-size: .72rem; line-height: 1.5;
  }
  .cw-score-large b { font: 600 3.5rem/1 var(--font-display); }
  .cw-score-large span { color: var(--ink-faint); }
  .cw-breakdown { display: flex; flex-direction: column; gap: 16px; }
  .cw-next { margin-top: 26px; padding: 16px; border: 1px dashed var(--hairline); }
  .cw-next p { color: var(--ink-faint); font-size: .76rem; line-height: 1.5; }
  .cw-next button { width: 100%; opacity: .5; cursor: not-allowed; }
  @media (max-width: 1100px) {
    .cw-kpis { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 700px) {
    .cw-kpis { grid-template-columns: 1fr; }
    .cw-controls { align-items: stretch; }
    .cw-pillar { justify-content: space-between; width: 100%; }
    .cw-pillar select { flex: 1; }
    .cw-dialog-grid { grid-template-columns: 1fr; }
    .cw-facts { grid-template-columns: 1fr; }
    .cw-table { min-width: 0; }
    .cw-table thead { display: none; }
    .cw-table tbody { display: grid; gap: 10px; padding: 10px; }
    .cw-table tbody tr {
      display: grid; grid-template-columns: 54px 1fr auto; gap: 8px 12px; padding: 14px;
      border: 1px solid var(--hairline); background: var(--bg-surface-1);
    }
    .cw-table tbody td { display: none; border: 0; padding: 0; text-align: left; }
    /* Na wąskim ekranie zostaje pilność, treść, data aktualizacji (4) i stan (8). */
    .cw-table tbody .cw-score-cell, .cw-table tbody .cw-content, .cw-table tbody td:nth-child(4),
    .cw-table tbody td:nth-child(8) { display: block; }
    .cw-table tbody .cw-score-cell { grid-row: 1 / span 2; grid-column: 1; }
    .cw-table tbody .cw-content { grid-column: 2 / 4; }
    .cw-table tbody td:nth-child(4) { grid-column: 2; }
    .cw-table tbody td:nth-child(8) { grid-column: 2; }
  }
</style>

<!-- Rozbicie wyniku buduje JS przy otwarciu dialogu, więc te węzły nie mają
     `data-astro-cid` i scoped style ich nie łapie – stąd `is:global`. -->
<style is:global>
  .cw-part { display: flex; flex-direction: column; gap: 6px; font-size: .76rem; }
  .cw-part.unavailable { opacity: .5; }
  .cw-part-head { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }
  .cw-part-head span { color: var(--ink); font-weight: 600; }
  .cw-part-head strong { color: var(--ink-muted); font-size: .72rem; font-weight: 600; white-space: nowrap; }
  .cw-part i { height: 7px; overflow: hidden; background: var(--bg-surface-3); border-radius: 2px; }
  .cw-part i b { display: block; height: 100%; background: var(--accent-blue); }
  .cw-part small { color: var(--ink-faint); font-size: .69rem; line-height: 1.45; }
  /* Dialog scrolluje się w pionie, więc dymek wyrównany do środka badge'a
     wychodziłby poza krawędź i zostałby przycięty – rozwijamy go w prawo. */
  .cw-part .info-tip { left: 0; transform: none; max-width: 300px; font-size: .72rem; }
  .cw-part .info-tip::after { left: 8px; transform: none; }
</style>
