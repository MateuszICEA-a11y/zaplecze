---
/* Content Writer – lista projektów nowych artykułów i formularz frazy.
   Projekty żyją w D1 (Worker, /api/cw/writer/*), więc lista ładuje się
   w przeglądarce; strona z buildu daje tylko szkielet. */
import Layout from '../../layouts/Layout.astro';
import DomainHeader from '../../components/DomainHeader.astro';
import { loadConfig, loadDetails, latestSnapshot } from '../../lib/data';
import { fmtInt } from '../../lib/format';
import { suggestGaps } from '../../lib/writer-gaps.js';
import '../../styles/writer.css';

export function getStaticPaths() {
  return loadConfig()
    .domains.filter((domain) => (domain.content_writer as { enabled?: boolean } | undefined)?.enabled === true)
    .map((domain) => ({ params: { domain: domain.id }, props: { name: domain.name } }));
}

const { domain } = Astro.params;
const { name } = Astro.props;
const latest = latestSnapshot(domain!);
const cfg = (loadConfig().domains.find((item) => item.id === domain)?.content_writer ?? {}) as { exclude_paths?: string[] };
const details = loadDetails(domain!);
const suggestions = suggestGaps(details, { excludePaths: cfg.exclude_paths ?? [] });
const measuredAt = (details as { date?: string }).date ?? null;
---

<Layout title={`${name} – Content Writer`}>
  <DomainHeader domain={domain!} name={name} active="content-writer" latest={latest} themeToggle />

  <div class="wr-page" data-domain={domain}>
    <p class="wr-lede">
      Nowy artykuł od frazy do szkicu w WordPressie: sprawdzamy konkurencję w wynikach wyszukiwania, przygotowujemy brief
      do akceptacji, piszemy tekst i dopracowujemy go w edytorze.
    </p>

    <section class="wr-section">
      <div class="wr-section-head"><h2>Nowy artykuł</h2></div>
      <div class="wr-panel">
        <form class="wr-form" id="wr-new" autocomplete="off">
          <input class="wr-input" id="wr-keyword" name="keyword" maxlength="120" required
            placeholder="Fraza główna, np. audyt seo sklepu internetowego" aria-label="Fraza główna" />
          <button class="wr-btn primary" type="submit" id="wr-create">Załóż projekt</button>
        </form>
        <div id="wr-check" hidden></div>
        <p class="wr-msg" id="wr-new-msg" role="status"></p>
      </div>
    </section>

    <section class="wr-section">
      <div class="wr-section-head">
        <h2>Podpowiedzi z danych</h2>
        <span class="wr-note">{measuredAt ? `dane z ${measuredAt}` : ''}</span>
      </div>
      <p class="wr-lede">
        Frazy, na które {domain} wyświetla się w Google, ale dopiero na pozycjach 11–50 – czyli bez realnego ruchu.
        Źródła: Senuto (frazy z co najmniej 30 wyszukiwaniami miesięcznie) i Search Console (pytania z co najmniej
        100 wyświetleniami w 28 dni). Odpadają frazy, które już mają wpis z tą frazą w tytule, oraz frazy z nazwą marki.
      </p>
      <div class="wr-panel">
        <ul class="wr-rec-legend" aria-label="Co oznaczają rekomendacje">
          <li><span class="wr-status ok">Napisz nowy</span>blog nie ma wpisu o tym temacie – żaden tytuł nie jest wystarczająco podobny</li>
          <li><span class="wr-status warn">Odśwież</span>jest już wpis o tym samym temacie – rozbuduj go w Content Watcherze zamiast pisać drugi</li>
          <li><span class="wr-status mid">Sprawdź</span>jest wpis pokrewny – model ocenił, czy to ten sam temat; uzasadnienie pod rekomendacją</li>
        </ul>
        <div class="wr-rec-bar">
          <div class="wr-seg" role="group" aria-label="Filtr rekomendacji" id="wr-rec-filter">
            <button type="button" class="on" data-rec-filter="all">Wszystkie</button>
            <button type="button" data-rec-filter="new">Napisz nowy</button>
            <button type="button" data-rec-filter="refresh">Odśwież</button>
            <button type="button" data-rec-filter="check">Sprawdź</button>
          </div>
          <span class="wr-note" id="wr-index-state">sprawdzam indeks wpisów…</span>
          <button class="wr-btn small" type="button" id="wr-reindex" title="Tytuły wpisów zamieniane są na wektory (bge-m3) raz dziennie o 5:20 UTC. Przelicz, jeśli właśnie dodano wpisy.">Przelicz indeks</button>
        </div>
        {
          suggestions.length ? (
            <div class="wr-table-wrap">
              <table class="wr-table" id="wr-suggestions">
                <thead>
                  <tr>
                    <th>Fraza</th>
                    <th class="num">Wyszukiwań / mies.</th>
                    <th class="num">Wyświetleń / 28 dni</th>
                    <th class="num">Nasza pozycja</th>
                    <th>Nasza strona na tę frazę</th>
                    <th>Rekomendacja</th>
                    <th />
                  </tr>
                </thead>
                <tbody>
                  {suggestions.map((row) => (
                    <tr data-phrase={row.keyword}>
                      <td>{row.keyword}</td>
                      <td class="num">{row.searches !== null ? fmtInt(row.searches) : '–'}</td>
                      <td class="num">{row.impressions !== null ? fmtInt(row.impressions) : '–'}</td>
                      <td class="num">{row.position}</td>
                      <td>
                        {row.ranking_url ? (
                          <a href={row.ranking_url} target="_blank" rel="noopener">
                            {row.ranking_title ?? (row.ranking_url.replace(/^https?:\/\/(www\.)?[^/]+/, '').replace(/^\/$/, 'strona główna'))}
                          </a>
                        ) : (
                          row.sources.join(' + ')
                        )}
                      </td>
                      <td class="wr-rec" data-rec><span class="muted">…</span></td>
                      <td class="num">
                        <button class="wr-btn small" type="button" data-pick={row.keyword}>Wybierz</button>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          ) : (
            <p class="wr-empty">Brak podpowiedzi – w danych nie ma fraz z pozycją 11–50 bez własnego wpisu.</p>
          )
        }
      </div>
    </section>

    <section class="wr-section">
      <div class="wr-section-head">
        <h2>Konkurencja</h2>
        <span class="wr-note">sitemapy odczytywane codziennie rano</span>
      </div>
      <p class="wr-lede">
        Wpisy z sitemap konkurentów, porównane z naszymi wpisami po znaczeniu tytułu (embeddingi, te same progi co wyżej).
        Tytuł bierzemy z adresu, a dla nowych wpisów – ze strony. Kliknij konkurenta, żeby zawęzić listę.
      </p>
      <div id="wr-competitors"><p class="wr-empty">Wczytuję wpisy konkurencji…</p></div>
    </section>

    <section class="wr-section">
      <div class="wr-section-head">
        <h2>Projekty</h2>
        <span class="wr-note" id="wr-count"></span>
      </div>
      <div class="wr-panel">
        <div class="wr-table-wrap" id="wr-projects"><p class="wr-empty">Wczytuję projekty…</p></div>
      </div>
    </section>
  </div>
</Layout>

<script>
  import { api, esc, fmtDateTime, STATUS_LABEL, STATUS_TONE } from '../../lib/writer-client';
  import { cannibalization } from '../../lib/writer-gaps.js';
  import { mountCompetitors } from '../../lib/writer-competitors';

  const root = document.querySelector<HTMLElement>('.wr-page')!;
  const domain = root.dataset.domain!;
  const list = document.getElementById('wr-projects')!;
  const count = document.getElementById('wr-count')!;
  const form = document.getElementById('wr-new') as HTMLFormElement;
  const input = document.getElementById('wr-keyword') as HTMLInputElement;
  const message = document.getElementById('wr-new-msg')!;
  const projectUrl = (id: number) => `/${domain}/content-writer/projekt/?id=${id}`;

  async function loadProjects() {
    try {
      const { data } = await api<{ projects: any[] }>(`/api/cw/writer/projects?domain=${encodeURIComponent(domain)}`);
      const rows = data.projects ?? [];
      count.textContent = rows.length ? `${rows.length} w toku i gotowych` : '';
      if (!rows.length) {
        list.innerHTML = '<p class="wr-empty">Nie ma jeszcze projektów. Wpisz frazę powyżej.</p>';
        return;
      }
      list.innerHTML = `<table class="wr-table">
        <thead><tr><th>Fraza</th><th>Tytuł roboczy</th><th>Stan</th><th>Szkic w WP</th><th class="num">Ostatnia zmiana</th></tr></thead>
        <tbody>${rows.map((row) => `<tr>
          <td><a href="${projectUrl(row.id)}">${esc(row.keyword)}</a></td>
          <td class="muted">${esc(row.title || '–')}</td>
          <td><span class="wr-status ${STATUS_TONE[row.status] ?? 'idle'}">${esc(STATUS_LABEL[row.status] ?? row.status)}</span></td>
          <td>${row.wp_draft_url ? `<a href="${esc(row.wp_draft_url)}" target="_blank" rel="noopener">podgląd</a>` : '<span class="muted">–</span>'}</td>
          <td class="num muted">${fmtDateTime(row.updated_at)}</td>
        </tr>`).join('')}</tbody></table>`;
    } catch (error) {
      list.innerHTML = `<p class="wr-msg err">${esc((error as Error).message)}</p>`;
    }
  }

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    const keyword = input.value.trim();
    if (!keyword) return;
    const button = document.getElementById('wr-create') as HTMLButtonElement;
    button.disabled = true;
    message.className = 'wr-msg';
    message.textContent = 'Zakładam projekt…';
    try {
      const { data } = await api<{ project: { id: number } }>('/api/cw/writer/projects', {
        method: 'POST',
        body: { domain, keyword },
      });
      location.href = projectUrl(data.project.id);
    } catch (error) {
      const err = error as Error & { code?: string; data?: any };
      message.className = 'wr-msg err';
      message.innerHTML = err.code === 'duplicate' && err.data?.project_id
        ? `Ta fraza ma już projekt – <a href="${projectUrl(err.data.project_id)}">otwórz go</a>.`
        : esc(err.message);
      button.disabled = false;
    }
  });

  /* „Odśwież czy nowy": decyzja z Workera (embeddingi wpisów + ranking).
     Gdy indeks jest pusty albo Worker nie odpowiada – dawna kontrola po
     słowach (tytuły wpisów i frazy w TOP 20). */
  const check = document.getElementById('wr-check')!;
  let writerData: any = null;
  let checkTimer: number | undefined;
  let checkSeq = 0;
  const editorUrl = (id: string) => `/${domain}/content-watcher/edytor/?id=${encodeURIComponent(id)}`;
  const pct = (score: number | null | undefined) => (typeof score === 'number' ? `${Math.round(score * 100)}%` : '–');
  const REC_LABEL: Record<string, string> = { new: 'Napisz nowy', refresh: 'Odśwież', check: 'Sprawdź' };
  const REC_TONE: Record<string, string> = { new: 'ok', refresh: 'warn', check: 'mid' };

  async function classify(phrases: string[]) {
    const { data } = await api<{ results: any[] }>('/api/cw/writer/classify', { method: 'POST', body: { domain, phrases } });
    return data.results ?? [];
  }

  const targetLink = (target: any) => target?.catalog_id
    ? `<a href="${editorUrl(target.catalog_id)}">${esc(target.title)}</a>`
    : target?.url ? `<a href="${esc(target.url)}" target="_blank" rel="noopener">${esc(target.title ?? target.url)}</a>` : '';

  const judgeNote = (result: any) => result.judge?.basis ? `<small class="wr-judge" title="${esc(result.judge.basis)}">${esc(result.judge.basis)}</small>` : '';

  function recCell(result: any) {
    const badge = `<span class="wr-status ${REC_TONE[result.action] ?? 'idle'}">${REC_LABEL[result.action] ?? result.action}</span>`;
    if (result.action === 'new') {
      const why = result.ranking
        ? `rankuje ${result.ranking.score === null ? 'strona spoza bloga' : `wpis o innym temacie (${pct(result.ranking.score)})`}`
        : 'brak bliskiego wpisu';
      const near = result.candidates?.[0] ? ` · najbliżej: ${esc(result.candidates[0].title)} (${pct(result.candidates[0].score)})` : '';
      return `${badge}<small>${why}${near}</small>${judgeNote(result)}`;
    }
    const ranked = String(result.reason ?? '').startsWith('ranking') ? ` · rankuje #${esc(result.target?.position)}` : '';
    return `${badge}<small>${targetLink(result.target)} · ${pct(result.target?.score)}${ranked}</small>${judgeNote(result)}`;
  }

  async function runCheck() {
    const keyword = input.value.trim();
    const seq = ++checkSeq;
    if (keyword.length < 3) { check.hidden = true; return; }
    try {
      const [result] = await classify([keyword]);
      if (seq !== checkSeq || !result) return;
      if (result.action === 'new') {
        const near = result.candidates?.[0]
          ? ` – najbliżej jest „${esc(result.candidates[0].title)}" (${pct(result.candidates[0].score)})`
          : '';
        const ranks = result.ranking
          ? `, a na frazę rankuje dziś ${result.ranking.score === null ? 'strona spoza bloga' : 'wpis o innym temacie'} (pozycja ${esc(result.ranking.position)})`
          : '';
        check.className = 'wr-alert ok';
        check.innerHTML = `<strong>Nowy temat.</strong> <span>Na blogu nie ma wpisu bliskiego tej frazie${near}${ranks}.</span>${judgeNote(result)}`;
      } else {
        const refresh = result.action === 'refresh';
        const ranksHere = String(result.reason ?? '').startsWith('ranking')
          || (result.ranking?.post_id && result.ranking.post_id === result.target?.post_id)
          ? `, rankuje na pozycji ${esc(result.ranking.position)}`
          : '';
        const others = (result.candidates ?? []).slice(1)
          .map((row: any) => `<li class="muted">${targetLink(row)} – ${pct(row.score)}</li>`).join('');
        check.className = 'wr-alert';
        check.innerHTML = `<strong>${refresh ? 'Ten temat ma już wpis – odśwież go zamiast pisać od nowa.' : 'Jest wpis o pokrewnym temacie.'}</strong>
          <ul>
            <li>${targetLink(result.target)} – podobieństwo ${pct(result.target?.score)}${ranksHere}${result.target?.catalog_id ? ' <span class="muted">– otwórz w Content Watcherze</span>' : ''}</li>
            ${others}
          </ul>
          <span>${refresh
            ? 'Nowy tekst na ten sam temat będzie konkurował z istniejącym. Załóż projekt tylko, jeśli celujesz w inną intencję.'
            : 'Sprawdź, czy wystarczy dopisać sekcję do istniejącego wpisu – jeśli intencja jest inna, pisz nowy.'}</span>${judgeNote(result)}`;
      }
      check.hidden = false;
    } catch {
      if (seq === checkSeq) await lexicalCheck(keyword);
    }
  }

  async function lexicalCheck(keyword: string) {
    if (!writerData) {
      try {
        writerData = await (await fetch(`/${domain}/content-writer/data.json`)).json();
      } catch {
        return;
      }
    }
    const result = cannibalization(keyword, writerData);
    if (!result.pages.length && !result.rankings.length) { check.hidden = true; return; }
    const link = (row: any) => row.id
      ? `<a href="${editorUrl(row.id)}">${esc(row.title)}</a> <span class="muted">– odśwież w Content Watcherze</span>`
      : esc(row.path);
    check.className = 'wr-alert';
    check.innerHTML = `<strong>Ta fraza może mieć już swoją stronę.</strong>
      <ul>
        ${result.pages.map((row: any) => `<li>Wpis z tą frazą w tytule: ${link(row)}</li>`).join('')}
        ${result.rankings.map((row: any) => `<li>„${esc(row.keyword)}" – pozycja ${esc(row.position)}: ${link(row)}</li>`).join('')}
      </ul>
      <span>Kontrola po słowach – indeks znaczeniowy jest niedostępny. Nowy tekst na tę samą frazę będzie konkurował z istniejącym.</span>`;
    check.hidden = false;
  }
  input.addEventListener('input', () => {
    clearTimeout(checkTimer);
    checkTimer = window.setTimeout(runCheck, 600);
  });
  const pickPhrase = (phrase: string) => {
    input.value = phrase;
    input.focus();
    input.scrollIntoView({ block: 'center', behavior: 'smooth' });
    runCheck();
  };
  document.querySelectorAll<HTMLButtonElement>('#wr-suggestions [data-pick]').forEach((button) => button.addEventListener('click', () => pickPhrase(button.dataset.pick ?? '')));

  /* Rekomendacje dla podpowiedzi – jedno wywołanie na całą listę. */
  const rows = [...document.querySelectorAll<HTMLTableRowElement>('#wr-suggestions tr[data-phrase]')];
  const indexState = document.getElementById('wr-index-state')!;
  const filterLabels = new Map<string, string>();
  let activeFilter = 'all';

  function applyFilter() {
    for (const row of rows) row.hidden = activeFilter !== 'all' && row.dataset.action !== activeFilter;
  }
  document.querySelectorAll<HTMLButtonElement>('[data-rec-filter]').forEach((button) => {
    filterLabels.set(button.dataset.recFilter!, button.textContent ?? '');
    button.addEventListener('click', () => {
      activeFilter = button.dataset.recFilter ?? 'all';
      document.querySelectorAll('[data-rec-filter]').forEach((item) => item.classList.toggle('on', item === button));
      applyFilter();
    });
  });

  async function loadRecommendations() {
    try {
      const { data: state } = await api<{ indexed: number; indexed_at: string | null }>(`/api/cw/writer/index/${domain}`);
      indexState.textContent = state.indexed
        ? `porównano z ${state.indexed} wpisami bloga (indeks z ${fmtDateTime(state.indexed_at)})`
        : 'indeks wpisów jest pusty – kliknij „Przelicz indeks”';
      if (!state.indexed || !rows.length) {
        rows.forEach((row) => { row.querySelector('[data-rec]')!.innerHTML = '<span class="muted">–</span>'; });
        return;
      }
      const results = await classify(rows.map((row) => row.dataset.phrase!));
      const byPhrase = new Map(results.map((result) => [result.phrase, result]));
      const counts: Record<string, number> = { new: 0, refresh: 0, check: 0 };
      for (const row of rows) {
        const result = byPhrase.get(row.dataset.phrase!);
        if (!result) continue;
        row.dataset.action = result.action;
        counts[result.action] = (counts[result.action] ?? 0) + 1;
        row.querySelector('[data-rec]')!.innerHTML = recCell(result);
      }
      document.querySelectorAll<HTMLButtonElement>('[data-rec-filter]').forEach((button) => {
        const key = button.dataset.recFilter!;
        if (key !== 'all') button.textContent = `${filterLabels.get(key)} ${counts[key] ?? 0}`;
      });
      applyFilter();
    } catch (error) {
      indexState.textContent = (error as Error).message;
    }
  }

  document.getElementById('wr-reindex')!.addEventListener('click', async (event) => {
    const button = event.currentTarget as HTMLButtonElement;
    button.disabled = true;
    indexState.textContent = 'przeliczam indeks…';
    try {
      // Pierwsze pełne przeliczenie idzie porcjami – wołamy, aż nic nie zostanie.
      for (let round = 0; round < 5; round++) {
        const { data } = await api<{ embedded: number; remaining: number }>('/api/cw/writer/reindex', { method: 'POST', body: { domain } });
        if (!data.remaining) break;
      }
      await loadRecommendations();
    } catch (error) {
      indexState.textContent = (error as Error).message;
    } finally {
      button.disabled = false;
    }
  });

  loadProjects();
  loadRecommendations();
  mountCompetitors(document.getElementById('wr-competitors')!, { domain, pick: pickPhrase });
</script>
