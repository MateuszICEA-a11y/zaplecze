---
/* Asystent treści – kreator „co chcesz zrobić?”. Zamiast tabel z danymi
   prowadzi redaktora pytaniami do jednej decyzji: nowy tekst (projekt w
   Content Writerze), odświeżenie (edytor Content Watchera) albo luka względem
   konkurencji. Dane: scoring Content Watchera i podpowiedzi fraz z buildu,
   konkurencja i „odśwież czy nowy” z API Workera (jak na stronach modułów). */
import Layout from '../../layouts/Layout.astro';
import DomainHeader from '../../components/DomainHeader.astro';
import { loadConfig, loadDetails, loadContentCatalog, latestSnapshot } from '../../lib/data';
import { scoreContent } from '../../lib/watcher-scoring';
import { suggestGaps } from '../../lib/writer-gaps.js';
import '../../styles/writer.css';
import '../../styles/assistant.css';

export function getStaticPaths() {
  const on = (feature: unknown) => (feature as { enabled?: boolean } | undefined)?.enabled === true;
  return loadConfig()
    .domains.filter((domain) => on(domain.content_watcher) && on(domain.content_writer))
    .map((domain) => ({ params: { domain: domain.id }, props: { name: domain.name } }));
}

const { domain } = Astro.params;
const { name } = Astro.props;
const domainConfig = loadConfig().domains.find((item) => item.id === domain)!;
const latest = latestSnapshot(domain!);
const details = loadDetails(domain!);
const asOf = latest?.date ?? new Date().toISOString().slice(0, 10);
const { sortedItems, byUrgency } = scoreContent({
  domainConfig,
  details,
  catalog: loadContentCatalog(domainConfig),
  asOf,
});
const writerCfg = (domainConfig.content_writer ?? {}) as { exclude_paths?: string[] };
const ideas = suggestGaps(details, { excludePaths: writerCfg.exclude_paths ?? [] });

// Do przeglądarki tylko to, co pokazuje kreator – pełny payload listy CW to megabajty.
const payload = {
  asOf,
  urgency: byUrgency,
  posts: sortedItems.map((item) => ({
    id: item.id,
    title: item.title,
    url: item.url,
    urgency: item.urgency,
    age_days: item.age_days,
    clicks: item.clicks,
    impressions: item.impressions,
    reasons: item.reasons.slice(0, 3),
    keyword: item.senuto_top_keywords[0]?.keyword ?? null,
  })),
  ideas: ideas.map((row) => ({
    keyword: row.keyword,
    searches: row.searches,
    impressions: row.impressions,
    position: row.position,
    ranking_title: row.ranking_title,
  })),
};
---

<Layout title={`${name} – Asystent treści`}>
  <DomainHeader domain={domain!} name={name} active="asystent" latest={latest} themeToggle />

  <div class="as-page wr-page" data-domain={domain}>
    <aside class="as-path" aria-label="Twoja ścieżka">
      <ol id="as-path"></ol>
      <p class="as-keys">Klawisze 1–3 wybierają odpowiedź, Esc cofa o krok.</p>
    </aside>
    <section class="as-screen" id="as-screen" aria-live="polite"></section>
  </div>

  <script id="as-data" type="application/json" set:html={JSON.stringify(payload).replace(/</g, '\\u003c')} />

  <script>
    import { api, esc, fmtInt } from '../../lib/writer-client';
    import { createGrid, hasGrid } from '../../lib/grid';

    type Any = any;
    const root = document.querySelector<HTMLElement>('.as-page')!;
    const domain = root.dataset.domain!;
    const screen = document.getElementById('as-screen')!;
    const pathList = document.getElementById('as-path')!;
    const DATA = JSON.parse(document.getElementById('as-data')!.textContent!);
    const NEW_DAYS = 30;

    const editorUrl = (id: string) => `/${domain}/content-watcher/edytor/?id=${encodeURIComponent(id)}`;
    const projectUrl = (id: number) => `/${domain}/content-writer/projekt/?id=${id}`;
    const pct = (score: unknown) => (typeof score === 'number' ? `${Math.round(score * 100)}%` : '–');
    const favicon = (host: string) => `<img class="as-fav" src="https://www.google.com/s2/favicons?domain=${encodeURIComponent(host)}&sz=32" alt="" width="14" height="14" loading="lazy" />`;

    /* ---------- trasa w #hash: „konkurencja/lista?h=delante.pl&co=new” ---------- */
    type Route = { path: string; q: URLSearchParams };
    const route = (): Route => {
      const [path, query] = decodeURIComponent(location.hash.slice(1)).split('?');
      return { path: (path ?? '').replace(/^\/+|\/+$/g, ''), q: new URLSearchParams(query ?? '') };
    };
    const link = (path: string, params: Record<string, string> = {}) => {
      const query = new URLSearchParams(params).toString();
      return `#${path}${query ? `?${query}` : ''}`;
    };
    const go = (path: string, params: Record<string, string> = {}) => { location.hash = link(path, params).slice(1); };

    /* ---------- intencje: kolor prowadzi przez całą ścieżkę ---------- */
    const INTENT: Record<string, { label: string; tone: string }> = {
      nowy: { label: 'Napisać nową treść', tone: 'nowy' },
      odswiez: { label: 'Odświeżyć wpis', tone: 'odswiez' },
      konkurencja: { label: 'Sprawdzić, czego brakuje', tone: 'konkurencja' },
    };

    /* ---------- typy stron konkurencji (klasyfikator LLM w collectorze) ---------- */
    const TYPES: { key: string; label: string; content: boolean }[] = [
      { key: 'poradnik', label: 'Poradnik', content: true },
      { key: 'slownik', label: 'Słownik', content: true },
      { key: 'news', label: 'News', content: false },
      { key: 'firmowe', label: 'O agencji', content: false },
      { key: 'case_study', label: 'Case study', content: false },
      { key: 'oferta', label: 'Oferta', content: false },
      { key: 'niepewne', label: 'Niepewne', content: false },
    ];
    const TYPE_LABEL = Object.fromEntries(TYPES.map((type) => [type.key, type.label]));
    // Strona jeszcze bez oceny liczy się jak poradnik – lista nie może być pusta przed klasyfikacją.
    const typeOf = (item: Any) => item.kind ?? 'poradnik';
    const isContent = (item: Any) => TYPES.find((type) => type.key === typeOf(item))?.content ?? true;

    const cutoff = new Date(Date.now() - NEW_DAYS * 86_400_000).toISOString().slice(0, 10);
    const isFresh = (item: Any) => !item.baseline && String(item.first_seen ?? '') >= cutoff;
    const SEEK: Record<string, { label: string; answer: string; test: (item: Any) => boolean; contentOnly: boolean }> = {
      new: { label: 'Tematy, których nie mamy', answer: 'Tematów, których nie mamy', test: (item) => item.action === 'new', contentOnly: true },
      check: { label: 'Tematy, które mamy tylko częściowo', answer: 'Tematów pokrewnych', test: (item) => item.action === 'check', contentOnly: true },
      fresh: { label: 'Nowości u konkurencji', answer: `Nowości z ${NEW_DAYS} dni`, test: isFresh, contentOnly: false },
    };
    const inSeek = (seek: string, item: Any) => SEEK[seek].test(item) && (!SEEK[seek].contentOnly || isContent(item));
    const hostsOf = (q: URLSearchParams) => (q.get('h') && q.get('h') !== 'all' ? q.get('h')!.split(',') : null);

    const URGENCY: { key: string; label: string }[] = [
      { key: 'critical', label: 'Krytyczny' },
      { key: 'high', label: 'Wysoki' },
      { key: 'normal', label: 'Normalny' },
      { key: 'low', label: 'Niski' },
      { key: 'none', label: 'Bez oceny' },
    ];
    const URGENCY_LABEL = Object.fromEntries(URGENCY.map((level) => [level.key, level.label]));
    const URGENCY_RANK: Record<string, number> = { critical: 4, high: 3, normal: 2, low: 1, none: 0 };

    /* ---------- ścieżka decyzji (lewa kolumna) ---------- */
    type Step = { q: string; a: string | null; href: string };
    function steps({ path, q }: Route): { tone: string; list: Step[] } {
      const [intent, sub] = path.split('/');
      const tone = INTENT[intent]?.tone ?? '';
      const list: Step[] = [{ q: 'Co chcesz zrobić?', a: INTENT[intent]?.label ?? null, href: link('') }];
      if (intent === 'nowy') {
        list.push({ q: 'Masz już temat?', a: sub === 'fraza' ? 'Mam frazę' : sub === 'propozycje' ? 'Zaproponuj temat' : null, href: link('nowy') });
        if (sub === 'propozycje') list.push({ q: 'Który temat bierzemy?', a: null, href: '' });
        if (sub === 'fraza') list.push({ q: 'Jaka fraza?', a: q.get('q') && !q.get('z') ? `„${q.get('q')}”` : null, href: link('nowy/fraza', q.get('q') ? { q: q.get('q')! } : {}) });
        if (sub === 'fraza' && q.get('q') && !q.get('z')) list.push({ q: 'Co robimy?', a: null, href: '' });
      } else if (intent === 'odswiez') {
        list.push({ q: 'Który wpis?', a: sub === 'pilne' ? 'Najpilniejsze' : sub === 'szukaj' ? 'Konkretny wpis' : null, href: link('odswiez') });
        if (sub) list.push({ q: sub === 'pilne' ? 'Który z nich?' : 'Znajdź po tytule', a: null, href: '' });
      } else if (intent === 'konkurencja') {
        const hosts = hostsOf(q);
        const h = q.get('h') ?? 'all';
        const who = sub === 'co' || sub === 'lista' ? (hosts ? hosts.join(', ') : 'Wszyscy razem') : sub === 'wybierz' ? 'Wybrani' : null;
        list.push({ q: 'Z kim się porównujemy?', a: who, href: link('konkurencja') });
        if (sub === 'wybierz') list.push({ q: 'Których konkurentów?', a: null, href: '' });
        if (sub === 'co' || sub === 'lista') {
          const seek = SEEK[q.get('co') ?? ''];
          list.push({ q: 'Czego szukamy?', a: sub === 'lista' && seek ? seek.answer : null, href: link('konkurencja/co', { h }) });
        }
        if (sub === 'lista') list.push({ q: 'Który temat?', a: null, href: '' });
      }
      return { tone, list };
    }
    let lastDepth = 0;
    function paintPath(current: Route) {
      const { tone, list } = steps(current);
      const answered = list.filter((step) => step.a).length;
      pathList.dataset.tone = tone;
      pathList.innerHTML = list.map((step, index) => {
        const done = Boolean(step.a);
        const isNew = done && index === answered - 1 && answered > lastDepth;
        return `<li class="${done ? 'done' : 'now'}${isNew ? ' fresh' : ''}">
          ${done ? `<a href="${step.href}"><span class="as-path-q">${esc(step.q)}</span><span class="as-path-a">${esc(step.a!)}</span></a>`
            : `<span class="as-path-q" aria-current="step">${esc(step.q)}</span>`}
        </li>`;
      }).join('');
      lastDepth = answered;
    }

    /* ---------- klocki ekranu ---------- */
    /* Karta wyboru jak katalog w scrape300 (/co-mierzymy): tytuł + plakietka,
       opis, wyciszone linie „skąd dane / co dalej”. */
    type Choice = { href: string; title: string; desc: string; tone?: string; badge?: string; meta?: string[] };
    const question = (title: string, lede = '') =>
      `<header class="as-q"><h2 tabindex="-1">${title}</h2>${lede ? `<p>${lede}</p>` : ''}</header>`;
    const choices = (items: Choice[]) => `<div class="as-choices">${items.map((item, index) => `
      <a class="as-choice" href="${item.href}" data-key="${index + 1}" ${item.tone ? `data-tone="${item.tone}"` : ''}>
        <span class="as-choice-head"><strong>${item.title}</strong>${item.badge !== undefined ? `<span class="as-badge" data-badge>${item.badge}</span>` : ''}</span>
        <span class="as-desc">${item.desc}</span>
        ${item.meta?.length ? `<span class="as-choice-meta">${item.meta.map((line) => `<span>${line}</span>`).join('')}</span>` : ''}
      </a>`).join('')}</div>`;
    const back = (href: string) => `<a class="as-back" href="${href}">Wróć</a>`;
    const loading = (text: string) => `<p class="as-loading"><span class="as-spin" aria-hidden="true"></span>${text}</p>`;
    const fail = (error: unknown) => `<p class="wr-msg err">${esc((error as Error)?.message ?? String(error))}</p>`;

    /* ---------- AG Grid (lib/grid.ts): motyw z tokenów, układ kolumn zapamiętany ---------- */
    const grids = new Set<{ destroy: () => void }>();
    function mountGrid(el: HTMLElement, key: string, options: Any) {
      const handle = createGrid(el, { rowHeight: 52, paginationPageSizeSelector: [25, 50, 100, 500], ...options }, `asystent:${key}`);
      grids.add(handle);
      el.closest('.as-grid-wrap')?.querySelector('[data-reset]')?.addEventListener('click', handle.resetLayout);
      return handle.grid;
    }
    const gridShell = (id: string, chips: string) => `
      <div class="as-grid-wrap">
        <div class="as-toolbar">${chips}<button type="button" class="as-reset" data-reset>Przywróć układ kolumn</button></div>
        <div id="${id}" class="as-grid"></div>
      </div>`;
    /* Przełączniki nad siatką (typ treści, pilność) – filtr zewnętrzny AG Grid. */
    const chipBar = (label: string, attr: string, items: { key: string; label: string; count: number }[], active: Set<string>) =>
      `<div class="as-types" role="group" aria-label="${label}">${items.filter((item) => item.count).map((item) => `
        <button type="button" class="as-type" ${attr}="${item.key}" data-chip="${item.key}" aria-pressed="${active.has(item.key)}">
          <i aria-hidden="true"></i>${item.label}<b>${fmtInt(item.count)}</b>
        </button>`).join('')}</div>`;
    function bindChips(grid: Any, active: Set<string>, onChange?: () => void) {
      screen.querySelectorAll<HTMLButtonElement>('[data-chip]').forEach((button) => button.addEventListener('click', () => {
        const key = button.dataset.chip!;
        if (active.has(key)) active.delete(key); else active.add(key);
        button.setAttribute('aria-pressed', String(active.has(key)));
        grid.onFilterChanged();
        onChange?.();
      }));
    }

    /* ---------- konkurencja: jedno pobranie na wizytę ---------- */
    let competitors: Promise<Any> | null = null;
    const loadCompetitors = (force = false) => {
      if (!competitors || force) competitors = api<Any>(`/api/cw/writer/competitors/${domain}`).then((res) => {
        // Stare adresy z sitemapy przekierowują na ten sam wpis (ten sam tytuł) – jeden temat raz.
        const seen = new Set<string>();
        const items = (res.data.items ?? []).filter((item: Any) => {
          const key = `${item.host}|${String(item.title).toLowerCase()}`;
          if (seen.has(key)) return false;
          seen.add(key);
          return true;
        });
        return { ...res.data, items };
      });
      return competitors;
    };

    /* ---------- ekrany ---------- */
    const SCREENS: Record<string, (r: Route) => void | Promise<void>> = {
      '': () => {
        const urgent = (DATA.urgency.critical ?? 0) + (DATA.urgency.high ?? 0);
        screen.innerHTML = question('Co chcesz dziś zrobić?', 'Wybierz jedną rzecz. Dalej poprowadzę Cię pytaniami aż do konkretnej decyzji.') + choices([
          { href: link('nowy'), tone: 'nowy', title: 'Napisać nową treść', badge: `${fmtInt(DATA.ideas.length)} propozycji`,
            desc: 'Od tematu do szkicu w WordPressie. Najpierw sprawdzimy, czy nie mamy już takiego wpisu.',
            meta: ['Propozycje: frazy z Senuto i Search Console na pozycjach 11–50', 'Dalej: projekt w Content Writerze'] },
          { href: link('odswiez'), tone: 'odswiez', title: 'Odświeżyć istniejący wpis', badge: `${fmtInt(urgent)} pilnych`,
            desc: 'Wpisy, które tracą ruch albo stoją tuż za TOP 10 – z powodem przy każdym.',
            meta: ['Kolejność: pilność z Content Watchera', 'Dalej: edytor wpisu'] },
          { href: link('konkurencja'), tone: 'konkurencja', title: 'Sprawdzić, czego nam brakuje', badge: 'liczę…',
            desc: 'Tematy z blogów konkurencji, których u nas nie ma.',
            meta: ['Konkurenci: widoczni.com, delante.pl, traffictrends.pl', 'Porównanie: tytuły wpisów, codziennie rano'] },
        ]);
        loadCompetitors().then((data) => {
          const badge = screen.querySelector<HTMLElement>('[data-key="3"] [data-badge]');
          if (badge) badge.textContent = `${fmtInt((data.items ?? []).filter((item: Any) => inSeek('new', item)).length)} tematów`;
        }).catch(() => {
          const badge = screen.querySelector<HTMLElement>('[data-key="3"] [data-badge]');
          if (badge) badge.textContent = 'brak danych';
        });
      },

      /* ===== Nowa treść ===== */
      nowy: () => {
        screen.innerHTML = back(link('')) + question('Masz już temat?', 'Jeśli tak, sprawdzimy, czy nie piszemy drugi raz o tym samym. Jeśli nie, zaproponuję tematy.') + choices([
          { href: link('nowy/fraza'), tone: 'nowy', title: 'Tak, podam frazę', desc: 'Frazę, pod którą tekst ma być widoczny w Google.', meta: ['Dalej: sprawdzenie, czy mamy już taki wpis'] },
          { href: link('nowy/propozycje'), tone: 'nowy', title: 'Nie, zaproponuj temat', badge: `${fmtInt(DATA.ideas.length)} propozycji`, desc: 'Frazy, na które już się wyświetlamy, ale na pozycjach 11–50 – bez ruchu.', meta: ['Źródło: Senuto i Search Console'] },
          { href: link('konkurencja'), tone: 'konkurencja', title: 'Pokaż, co piszą konkurenci', desc: 'Tematy z ich blogów, których u nas nie ma.' },
        ]);
      },

      'nowy/fraza': async ({ q }) => {
        const phrase = q.get('q') ?? '';
        const from = q.get('z');
        screen.innerHTML = back(history.length > 1 ? 'javascript:history.back()' : link('nowy')) +
          question('Jaka fraza?', 'Jedna fraza główna – tak, jak wpisałby ją czytelnik w Google.') + `
          <form class="as-form" id="as-phrase" autocomplete="off">
            <input class="wr-input" name="q" maxlength="120" required value="${esc(phrase)}" placeholder="np. audyt seo sklepu internetowego" aria-label="Fraza główna" />
            <button class="wr-btn primary" type="submit">Sprawdź temat</button>
          </form>
          ${from ? `<p class="as-hint">To tytuł wpisu konkurenta (<a href="${esc(from)}" target="_blank" rel="noopener noreferrer">otwórz</a>). Skróć go do frazy, pod którą chcesz być widoczny.</p>` : ''}
          <div id="as-verdict"></div>`;
        const form = document.getElementById('as-phrase') as HTMLFormElement;
        const input = form.elements.namedItem('q') as HTMLInputElement;
        form.addEventListener('submit', (event) => {
          event.preventDefault();
          const value = input.value.trim();
          if (value) go('nowy/fraza', { q: value });
        });
        if (!phrase || from) {
          input.focus();
          if (from) input.select(); // tytuł konkurenta najpierw do skrócenia
          return;
        }
        await verdict(phrase);
      },

      'nowy/propozycje': () => {
        screen.innerHTML = back(link('nowy')) + question('Który temat bierzemy?',
          'Na te frazy Google pokazuje już nasze strony, ale na pozycjach 11–50. Osobny tekst ma szansę wejść do TOP 10.') +
          gridShell('as-grid-ideas', '<span></span>');
        mountGrid(document.getElementById('as-grid-ideas')!, 'ideas', {
          rowData: DATA.ideas,
          columnDefs: [
            { headerName: 'Fraza', field: 'keyword', flex: 2, minWidth: 240, cellRenderer: (p: Any) => `<strong class="as-cell-title">${esc(p.value)}</strong>` },
            { headerName: 'Wyszukiwania/mies.', field: 'searches', width: 160, filter: 'agNumberColumnFilter', sort: 'desc', cellClass: 'as-num-cell', valueFormatter: (p: Any) => (p.value == null ? '–' : fmtInt(p.value)) },
            { headerName: 'Wyświetlenia (28 dni)', field: 'impressions', width: 170, filter: 'agNumberColumnFilter', cellClass: 'as-num-cell', valueFormatter: (p: Any) => (p.value == null ? '–' : fmtInt(p.value)) },
            { headerName: 'Pozycja', field: 'position', width: 110, filter: 'agNumberColumnFilter', cellClass: 'as-num-cell', valueFormatter: (p: Any) => String(Math.round(p.value)) },
            { headerName: 'Dziś rankuje wpis', field: 'ranking_title', flex: 1.5, minWidth: 220, valueFormatter: (p: Any) => p.value ?? '–' },
            { headerName: '', colId: 'act', pinned: 'right', width: 130, sortable: false, filter: false, resizable: false, suppressMovable: true,
              cellRenderer: (p: Any) => `<a class="wr-btn primary small" href="${link('nowy/fraza', { q: p.data.keyword })}">Wybieram</a>` },
          ],
        });
      },

      /* ===== Odświeżenie ===== */
      odswiez: () => {
        screen.innerHTML = back(link('')) + question('Który wpis odświeżamy?') + choices([
          { href: link('odswiez/pilne'), tone: 'odswiez', title: 'Pokaż najpilniejsze', badge: `${fmtInt(DATA.urgency.critical ?? 0)} krytycznych`,
            desc: 'Słaby ruch, dawno bez zmian albo tuż za TOP 10 – od najpilniejszego.', meta: ['Pilność: wyniki z GSC × wiek treści'] },
          { href: link('odswiez/szukaj'), tone: 'odswiez', title: 'Mam konkretny wpis', badge: `${fmtInt(DATA.posts.length)} wpisów`, desc: 'Znajdziesz go po tytule w tabeli wszystkich wpisów.' },
        ]);
      },

      'odswiez/pilne': () => postsScreen(false),
      'odswiez/szukaj': () => postsScreen(true),

      /* ===== Konkurencja ===== */
      konkurencja: async () => {
        screen.innerHTML = back(link('')) + question('Z kim się porównujemy?') + loading('Wczytuję wpisy konkurencji…');
        const data = await loadCompetitors();
        const sites = data.sites ?? [];
        const gaps = (data.items ?? []).filter((item: Any) => inSeek('new', item)).length;
        screen.innerHTML = back(link('')) + question('Z kim się porównujemy?', 'Wpisy z blogów konkurencji zestawione z naszymi po tytułach.') + choices([
          { href: link('konkurencja/co', { h: 'all' }), tone: 'konkurencja', title: 'Ze wszystkimi naraz', badge: `${fmtInt(gaps)} tematów`,
            desc: 'Jedna lista ze wszystkich śledzonych blogów.', meta: sites.map((site: Any) => `${favicon(site.host)} ${esc(site.host)}: ${fmtInt(site.count)} wpisów`) },
          { href: link('konkurencja/wybierz'), tone: 'konkurencja', title: 'Z wybranymi', badge: `${fmtInt(sites.length)} do wyboru`, desc: 'Zaznaczysz konkretnych konkurentów.' },
        ]) + pendingNote(data);
        bindSync();
      },

      'konkurencja/wybierz': async ({ q }) => {
        screen.innerHTML = back(link('konkurencja')) + question('Których konkurentów?') + loading('Wczytuję…');
        const data = await loadCompetitors();
        const preset = new Set(hostsOf(q) ?? []);
        const rows = (data.sites ?? []).map((site: Any) => {
          const items = (data.items ?? []).filter((item: Any) => item.host === site.host);
          return { host: site.host, total: items.length, gaps: items.filter((item: Any) => inSeek('new', item)).length, fresh: items.filter(isFresh).length };
        });
        screen.innerHTML = back(link('konkurencja')) + question('Których konkurentów?', 'Zaznacz jednego albo kilku.') + `
          <form id="as-hosts" data-tone="konkurencja">
            <div class="as-choices">${rows.map((row: Any) => `
              <label class="as-choice as-check" data-tone="konkurencja">
                <span class="as-choice-head"><span class="as-check-name"><input type="checkbox" name="h" value="${esc(row.host)}" ${preset.has(row.host) ? 'checked' : ''} />${favicon(row.host)}<strong>${esc(row.host)}</strong></span><span class="as-badge">${fmtInt(row.gaps)} tematów</span></span>
                <span class="as-choice-meta"><span>Wpisów w sitemapie: ${fmtInt(row.total)}</span>${row.fresh ? `<span>Nowych w ${NEW_DAYS} dni: ${fmtInt(row.fresh)}</span>` : ''}</span>
              </label>`).join('')}
            </div>
            <div class="as-actions"><button class="wr-btn primary" type="submit" disabled>Dalej</button></div>
          </form>`;
        const form = document.getElementById('as-hosts') as HTMLFormElement;
        const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
        const picked = () => [...form.querySelectorAll<HTMLInputElement>('input:checked')].map((box) => box.value);
        const sync = () => { submit.disabled = !picked().length; };
        form.addEventListener('change', sync);
        form.addEventListener('submit', (event) => { event.preventDefault(); go('konkurencja/co', { h: picked().join(',') }); });
        sync();
      },

      'konkurencja/co': async ({ q }) => {
        const hosts = hostsOf(q);
        const backHref = hosts ? link('konkurencja/wybierz', { h: hosts.join(',') }) : link('konkurencja');
        screen.innerHTML = back(backHref) + question('Czego szukamy?') + loading('Liczę…');
        const data = await loadCompetitors();
        const items = (data.items ?? []).filter((item: Any) => !hosts || hosts.includes(item.host));
        const count = (seek: string) => fmtInt(items.filter((item: Any) => inSeek(seek, item)).length);
        const h = q.get('h') ?? 'all';
        screen.innerHTML = back(backHref) + question('Czego szukamy?') + choices([
          { href: link('konkurencja/lista', { h, co: 'new' }), tone: 'konkurencja', title: 'Tematów, których nie mamy', badge: `${count('new')} tematów`,
            desc: 'Konkurent ma poradnik albo hasło, a my nic bliskiego.', meta: ['Dalej: temat do nowego tekstu'] },
          { href: link('konkurencja/lista', { h, co: 'check' }), tone: 'odswiez', title: 'Tematów, które mamy tylko częściowo', badge: `${count('check')} tematów`,
            desc: 'Mamy wpis pokrewny. Zdecydujesz: rozbudować nasz czy napisać osobny.', meta: ['Dalej: edytor naszego wpisu albo nowy tekst'] },
          { href: link('konkurencja/lista', { h, co: 'fresh' }), tone: 'nowy', title: 'Co nowego u konkurencji', badge: `${count('fresh')} wpisów`,
            desc: `Wszystko, co pojawiło się w ich sitemapach w ostatnich ${NEW_DAYS} dniach.` },
        ]) + pendingNote(data);
        bindSync();
      },

      'konkurencja/lista': async ({ q }) => {
        const hosts = hostsOf(q);
        const seek = SEEK[q.get('co') ?? ''] ? q.get('co')! : 'new';
        const h = q.get('h') ?? 'all';
        screen.innerHTML = back(link('konkurencja/co', { h })) + question(SEEK[seek].label) + loading('Wczytuję…');
        const data = await loadCompetitors();
        const rows = (data.items ?? []).filter((item: Any) => (!hosts || hosts.includes(item.host)) && SEEK[seek].test(item));
        // Filtr typów: domyślnie poradnik + słownik przy lukach, wszystko przy nowościach.
        const active = new Set(SEEK[seek].contentOnly ? TYPES.filter((type) => type.content).map((type) => type.key) : TYPES.map((type) => type.key));
        const lede = {
          new: 'Wybierz temat, który napiszemy u nas. Na następnym kroku skrócisz tytuł do frazy i sprawdzimy go jeszcze raz.',
          check: 'Przy każdym temacie nasz najbliższy wpis. Zdecyduj: rozbudować go czy napisać osobny tekst.',
          fresh: 'Świeże wpisy konkurencji i ocena, czy mamy odpowiednik.',
        }[seek];
        const chips = chipBar('Typ treści', 'data-type', TYPES.map((type) => ({ key: type.key, label: type.label, count: rows.filter((item: Any) => typeOf(item) === type.key).length })), active);
        screen.innerHTML = back(link('konkurencja/co', { h })) + question(SEEK[seek].label, lede) + gridShell('as-grid-rivals', chips);
        const grid = mountGrid(document.getElementById('as-grid-rivals')!, `rivals-${seek}`, {
          rowData: rows,
          isExternalFilterPresent: () => true,
          doesExternalFilterPass: (node: Any) => active.has(typeOf(node.data)),
          columnDefs: [
            { headerName: 'Typ', colId: 'kind', width: 130, valueGetter: (p: Any) => TYPE_LABEL[typeOf(p.data)], floatingFilter: false,
              cellRenderer: (p: Any) => `<span class="as-tag" data-type="${typeOf(p.data)}" ${p.data.kind_basis ? `title="${esc(p.data.kind_basis)}"` : ''}>${esc(p.value)}</span>` },
            { headerName: 'Temat u konkurencji', field: 'title', flex: 2, minWidth: 280,
              cellRenderer: (p: Any) => `<a class="as-cell-title" href="${esc(p.data.url)}" target="_blank" rel="noopener noreferrer">${esc(p.value)}</a>${p.data.title_from === 'slug' ? '<small class="as-soft"> z adresu</small>' : ''}` },
            { headerName: 'Konkurent', field: 'host', width: 160, cellRenderer: (p: Any) => `${favicon(p.value)} ${esc(p.value)}` },
            { headerName: 'W sitemapie od', colId: 'seen', width: 150, filter: 'agTextColumnFilter',
              valueGetter: (p: Any) => (p.data.baseline ? '' : p.data.first_seen ?? ''), valueFormatter: (p: Any) => p.value || 'przed śledzeniem',
              sort: seek === 'fresh' ? 'desc' : undefined },
            { headerName: 'Nasz najbliższy wpis', colId: 'ours', flex: 1.5, minWidth: 220, hide: seek === 'new',
              valueGetter: (p: Any) => (p.data.action !== 'new' ? p.data.target?.title ?? '' : ''),
              cellRenderer: (p: Any) => (p.value ? `<a href="${p.data.target.catalog_id ? editorUrl(p.data.target.catalog_id) : esc(p.data.target.url)}">${esc(p.value)}</a>` : '<span class="as-soft">–</span>') },
            { headerName: 'Podobieństwo', field: 'score', width: 130, filter: 'agNumberColumnFilter', hide: seek === 'new', cellClass: 'as-num-cell',
              sort: seek === 'check' ? 'desc' : undefined, valueFormatter: (p: Any) => pct(p.value) },
            { headerName: '', colId: 'act', pinned: 'right', width: seek === 'new' ? 160 : 300, sortable: false, filter: false, resizable: false, suppressMovable: true,
              cellRenderer: (p: Any) => {
                const item = p.data;
                const write = (primary: boolean) => `<a class="wr-btn ${primary ? 'primary ' : ''}small" href="${link('nowy/fraza', { q: item.title, z: item.url })}">Napisz nasz tekst</a>`;
                const refresh = (primary: boolean) => (item.target?.catalog_id && item.action !== 'new'
                  ? `<a class="wr-btn ${primary ? 'primary ' : ''}small" href="${editorUrl(item.target.catalog_id)}">Rozbuduj nasz</a>` : '');
                return `<span class="as-cell-actions">${item.action === 'refresh' ? refresh(true) + write(false) : write(true) + refresh(false)}</span>`;
              } },
          ],
        });
        bindChips(grid, active);
      },
    };

    /* Wpisy do odświeżenia – jedna siatka dla „najpilniejsze” i „konkretny wpis”. */
    function postsScreen(search: boolean) {
      const skipped = new Set<string>(JSON.parse(localStorage.getItem(`as-skip:${domain}`) ?? '[]'));
      const active = new Set(search ? URGENCY.map((level) => level.key) : ['critical', 'high', 'normal']);
      let showSkipped = false;
      const rows = DATA.posts;
      screen.innerHTML = back(link('odswiez')) + question(search ? 'Który wpis?' : 'Te wpisy odśwież najpierw',
        search ? 'Wpisz słowo w filtrze nad kolumną „Wpis”.' : 'Kolejność z Content Watchera: pilność (wyniki × wiek), potem wynik. Przy każdym powód.') +
        gridShell('as-grid-posts', chipBar('Pilność', 'data-urgency', URGENCY.map((level) => ({ ...level, count: rows.filter((post: Any) => post.urgency === level.key).length })), active) +
          `<button type="button" class="as-type as-skipped" aria-pressed="false" data-skipped>Odłożone<b>${fmtInt(skipped.size)}</b></button>`);
      const grid = mountGrid(document.getElementById('as-grid-posts')!, 'posts', {
        rowData: rows,
        getRowId: (p: Any) => p.data.id,
        isExternalFilterPresent: () => true,
        doesExternalFilterPass: (node: Any) => active.has(node.data.urgency) && skipped.has(node.data.id) === showSkipped,
        columnDefs: [
          { headerName: 'Pilność', colId: 'urgency', width: 130, floatingFilter: false, sort: 'desc',
            valueGetter: (p: Any) => URGENCY_RANK[p.data.urgency] ?? 0,
            cellRenderer: (p: Any) => `<span class="as-tag" data-urgency="${esc(p.data.urgency)}">${URGENCY_LABEL[p.data.urgency] ?? p.data.urgency}</span>` },
          { headerName: 'Wpis', field: 'title', flex: 2, minWidth: 280,
            cellRenderer: (p: Any) => `<a class="as-cell-title" href="${esc(p.data.url)}" target="_blank" rel="noopener">${esc(p.value)}</a>` },
          { headerName: 'Dlaczego', colId: 'reasons', flex: 1.6, minWidth: 240, valueGetter: (p: Any) => p.data.reasons.join(', '),
            cellRenderer: (p: Any) => `<span class="as-soft">${esc(p.value || '–')}</span>`, tooltipValueGetter: (p: Any) => p.data.reasons.join('\n') },
          { headerName: 'Kliknięcia (30 dni)', field: 'clicks', width: 150, filter: 'agNumberColumnFilter', cellClass: 'as-num-cell', valueFormatter: (p: Any) => (p.value == null ? '–' : fmtInt(p.value)) },
          { headerName: 'Wyświetlenia', field: 'impressions', width: 130, filter: 'agNumberColumnFilter', cellClass: 'as-num-cell', valueFormatter: (p: Any) => (p.value == null ? '–' : fmtInt(p.value)) },
          { headerName: 'Bez zmian (dni)', field: 'age_days', width: 140, filter: 'agNumberColumnFilter', cellClass: 'as-num-cell', valueFormatter: (p: Any) => fmtInt(p.value) },
          { headerName: 'Fraza z Senuto', field: 'keyword', width: 200, hide: true, valueFormatter: (p: Any) => p.value ?? '–' },
          { headerName: '', colId: 'act', pinned: 'right', width: 250, sortable: false, filter: false, resizable: false, suppressMovable: true,
            cellRenderer: (p: Any) => `<span class="as-cell-actions"><a class="wr-btn primary small" href="${editorUrl(p.data.id)}">Odśwież w edytorze</a>
              <button class="wr-btn small" type="button" data-skip="${esc(p.data.id)}">${skipped.has(p.data.id) ? 'Przywróć' : 'Nie teraz'}</button></span>` },
        ],
      });
      bindChips(grid, active);
      const skippedChip = screen.querySelector<HTMLButtonElement>('[data-skipped]')!;
      skippedChip.addEventListener('click', () => {
        showSkipped = !showSkipped;
        skippedChip.setAttribute('aria-pressed', String(showSkipped));
        grid.onFilterChanged();
        grid.refreshCells({ columns: ['act'], force: true });
      });
      screen.querySelector('#as-grid-posts')!.addEventListener('click', (event) => {
        const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-skip]');
        if (!button) return;
        const id = button.dataset.skip!;
        if (skipped.has(id)) skipped.delete(id); else skipped.add(id);
        localStorage.setItem(`as-skip:${domain}`, JSON.stringify([...skipped]));
        skippedChip.querySelector('b')!.textContent = fmtInt(skipped.size);
        grid.onFilterChanged();
      });
      if (search) setTimeout(() => screen.querySelector<HTMLInputElement>('#as-grid-posts .ag-floating-filter-input input, #as-grid-posts .ag-floating-filter input')?.focus(), 50);
    }

    /* Wpisy bez porównania (nowe adresy, zmienione tytuły) – dokończenie na żądanie. */
    function pendingNote(data: Any) {
      const pending = (data.items ?? []).filter((item: Any) => !item.action).length;
      return pending ? `<div class="as-note">${fmtInt(pending)} wpisów czeka na porównanie z naszymi (robi się samo co rano).
        <button class="wr-btn small" type="button" data-sync>Porównaj teraz</button> <span data-sync-msg></span></div>` : '';
    }
    function bindSync() {
      const button = screen.querySelector<HTMLButtonElement>('[data-sync]');
      if (!button) return;
      button.addEventListener('click', async () => {
        const msg = screen.querySelector<HTMLElement>('[data-sync-msg]')!;
        button.disabled = true;
        try {
          for (let round = 0; round < 60; round += 1) {
            const { data } = await api<Any>(`/api/cw/writer/competitors/${domain}/sync`, { method: 'POST', body: {} });
            msg.textContent = data.remaining ? `zostało ${fmtInt(data.remaining)}…` : 'gotowe';
            if (!data.remaining) break;
          }
          await loadCompetitors(true);
          render();
        } catch (error) {
          msg.textContent = (error as Error).message;
          button.disabled = false;
        }
      });
    }

    /* „Odśwież czy nowy” dla frazy i jedna decyzja na końcu. */
    async function verdict(phrase: string) {
      const box = document.getElementById('as-verdict')!;
      box.innerHTML = loading('Sprawdzam, czy mamy już wpis na ten temat…');
      let result: Any = null;
      try {
        const { data } = await api<Any>('/api/cw/writer/classify', { method: 'POST', body: { domain, phrases: [phrase] } });
        result = data.results?.[0] ?? null;
      } catch (error) {
        box.innerHTML = `<div class="as-verdict" data-verdict="mid"><h3>Nie udało się sprawdzić bloga</h3><p>${esc((error as Error).message)}</p>
          <div class="as-actions"><button class="wr-btn primary" type="button" data-create>Załóż projekt mimo to</button></div></div>`;
        bindCreate(phrase);
        return;
      }
      const target = result?.target ?? null;
      const nearest = target ?? result?.candidates?.[0] ?? null;
      const ourLink = (post: Any) => post?.catalog_id
        ? `<a href="${editorUrl(post.catalog_id)}">${esc(post.title)}</a>`
        : `<a href="${esc(post?.url)}" target="_blank" rel="noopener">${esc(post?.title ?? post?.url)}</a>`;
      const basis = result?.judge?.basis ? `<p class="as-basis">${esc(result.judge.basis)}</p>` : '';
      const action = result?.editor?.verdict === 'different' ? 'new' : result?.action ?? 'new';

      if (action === 'new') {
        box.innerHTML = `<div class="as-verdict" data-verdict="ok">
          <h3>Nie mamy wpisu na ten temat. Możesz pisać.</h3>
          <p>${nearest ? `Najbliżej jest ${ourLink(nearest)} (${pct(nearest.score)} podobieństwa) – to inny temat.` : 'Na blogu nie ma nic bliskiego.'}</p>${basis}
          <div class="as-actions"><button class="wr-btn primary" type="button" data-create>Załóż projekt „${esc(phrase)}”</button></div>
          <p class="as-hint">Dalej: analiza wyników Google i brief do akceptacji w Content Writerze.</p></div>`;
      } else if (action === 'refresh') {
        box.innerHTML = `<div class="as-verdict" data-verdict="warn">
          <h3>Ten temat już mamy</h3>
          <p>${ourLink(target)}${typeof target?.score === 'number' ? ` – ${pct(target.score)} podobieństwa` : ''}${target?.position ? `, rankuje na #${esc(target.position)}` : ''}</p>${basis}
          <p>Drugi tekst o tym samym konkurowałby z pierwszym o tę samą frazę. Lepiej rozbudować istniejący.</p>
          <div class="as-actions">
            ${target?.catalog_id ? `<a class="wr-btn primary" href="${editorUrl(target.catalog_id)}">Rozbuduj istniejący wpis</a>` : ''}
            <button class="wr-btn" type="button" data-create data-choice="different">To jednak inny temat – napisz nowy</button>
          </div></div>`;
      } else {
        box.innerHTML = `<div class="as-verdict" data-verdict="mid">
          <h3>Mamy wpis pokrewny. To ten sam temat?</h3>
          <p>${ourLink(nearest)}${typeof nearest?.score === 'number' ? ` – ${pct(nearest.score)} podobieństwa` : ''}</p>${basis}
          <div class="as-actions">
            <button class="wr-btn primary" type="button" data-same>Tak, rozbuduję istniejący</button>
            <button class="wr-btn" type="button" data-create data-choice="different">Nie, napiszę nowy</button>
          </div>
          <p class="as-hint">Zapamiętam odpowiedź dla tej frazy.</p></div>`;
        box.querySelector<HTMLButtonElement>('[data-same]')?.addEventListener('click', async (event) => {
          (event.currentTarget as HTMLButtonElement).disabled = true;
          await saveVerdict(phrase, 'same', nearest);
          location.href = nearest?.catalog_id ? editorUrl(nearest.catalog_id) : nearest?.url;
        });
      }
      bindCreate(phrase);
    }

    const saveVerdict = (phrase: string, choice: string, target: Any) =>
      api('/api/cw/writer/verdict', { method: 'POST', body: { domain, phrase, verdict: choice, target: choice === 'same' ? target : undefined } })
        .catch(() => null); // decyzja to pomoc na przyszłość – jej brak nie blokuje pracy

    function bindCreate(phrase: string) {
      document.querySelectorAll<HTMLButtonElement>('#as-verdict [data-create]').forEach((button) => button.addEventListener('click', async () => {
        button.disabled = true;
        button.textContent = 'Zakładam projekt…';
        if (button.dataset.choice) await saveVerdict(phrase, button.dataset.choice, null);
        try {
          const { data } = await api<{ project: { id: number } }>('/api/cw/writer/projects', { method: 'POST', body: { domain, keyword: phrase } });
          location.href = projectUrl(data.project.id);
        } catch (error) {
          const err = error as Error & { code?: string; data?: Any };
          button.insertAdjacentHTML('afterend', err.code === 'duplicate' && err.data?.project_id
            ? ` <span class="wr-msg">Ta fraza ma już projekt – <a href="${projectUrl(err.data.project_id)}">otwórz go</a>.</span>`
            : ` <span class="wr-msg err">${esc(err.message)}</span>`);
        }
      }));
    }

    /* ---------- pętla ---------- */
    async function render() {
      const current = route();
      grids.forEach((grid) => grid.destroy());
      grids.clear();
      paintPath(current);
      screen.dataset.tone = steps(current).tone;
      const draw = SCREENS[current.path] ?? SCREENS[''];
      try {
        await draw(current);
      } catch (error) {
        screen.insertAdjacentHTML('beforeend', fail(error));
      }
      screen.querySelector<HTMLElement>('h2')?.focus({ preventScroll: true });
      window.scrollTo({ top: 0 });
    }
    window.addEventListener('hashchange', render);

    /* Skróty: 1–3 wybierają kartę, Esc cofa o krok. */
    document.addEventListener('keydown', (event) => {
      const typing = (event.target as HTMLElement).closest('input, textarea, select, .ag-root-wrapper');
      if (typing || event.metaKey || event.ctrlKey || event.altKey) return;
      if (/^[1-9]$/.test(event.key)) screen.querySelector<HTMLAnchorElement>(`a.as-choice[data-key="${event.key}"]`)?.click();
      if (event.key === 'Escape') screen.querySelector<HTMLAnchorElement>('.as-back')?.click();
    });
    if (hasGrid()) render();
    else document.addEventListener('DOMContentLoaded', () => render(), { once: true });
  </script>
</Layout>
