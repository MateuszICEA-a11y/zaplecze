---
/* Edytor wpisu: dokument artykułu + pipeline reoptymalizacji.
   Treść wpisu jest wczytywana od razu (proxy /api/cw/content), pipeline
   raportuje postęp jednym paskiem, a diff ląduje inline w sekcjach dokumentu.
   Jedna strona dla całej domeny – wpis wskazuje parametr `?id=`. */
import Layout from '../../../layouts/Layout.astro';
import DomainHeader from '../../../components/DomainHeader.astro';
import { loadConfig, latestSnapshot } from '../../../lib/data';

export function getStaticPaths() {
  return loadConfig()
    .domains.filter((domain) => {
      const cfg = domain.content_watcher as { enabled?: boolean; source?: string } | undefined;
      // Edytor ma sens tylko dla domen na CMS-ie – treści z repozytorium
      // poprawia się w plikach, nie przez kolejkę.
      return cfg?.enabled === true && cfg.source === 'wordpress';
    })
    .map((domain) => ({ params: { domain: domain.id }, props: { name: domain.name } }));
}

const { domain } = Astro.params;
const { name } = Astro.props;
const latest = latestSnapshot(domain!);

// Ekspert celowo poza pakietem startowym – to finalny etap po zakończeniu
// pipeline'u (przycisk w podsumowaniu), nie decyzja podejmowana z góry.
const IMPROVEMENTS = [
  { key: 'gaps', label: 'Uzupełnienie luk treści', note: 'research SERP → wytyczne → przepisanie sekcji' },
  { key: 'sources', label: 'Źródła i przypisy', note: 'autorytatywne linki + definicja z Wikipedii' },
  { key: 'internal_links', label: 'Linki wewnętrzne', note: 'dopasowanie z katalogu treści serwisu' },
];

// Lustro config.py: MODEL_RESEARCH / MODEL_WRITER.
const DEFAULT_MODELS = { research: 'perplexity/sonar-pro', writer: 'anthropic/claude-sonnet-5' };
---

<Layout title={`${name} – edytor wpisu`}>
  <DomainHeader domain={domain!} name={name} active="content-watcher" latest={latest} themeToggle />

  <div class="ed-back"><a href={`/${domain}/content-watcher/`}>← wróć do listy priorytetów</a></div>

  <div data-ed-missing class="cw-note" hidden>
    Nie wskazano wpisu. Wejdź tu z listy priorytetów, klikając „Edytor” przy wybranym artykule.
  </div>

  <section data-ed-main hidden>
    <header class="ed-head">
      <div class="ed-head-title">
        <span class="ed-pillar" data-ed-pillar></span>
        <h2 data-ed-title></h2>
        <a class="ed-url" data-ed-url href="#" target="_blank" rel="noopener"></a>
      </div>
      <dl class="ed-meta">
        <div><dt>Publikacja</dt><dd data-ed-published>—</dd></div>
        <div><dt>Zmiana treści</dt><dd data-ed-updated>—</dd></div>
        <div><dt>Objętość</dt><dd data-ed-size>—</dd></div>
        <div><dt>Autor</dt><dd data-ed-author>—</dd></div>
      </dl>
    </header>

    <!-- Belka pipeline: konfiguracja → postęp → podsumowanie (jeden element,
         trzy stany sterowane z JS) -->
    <div class="ed-pipebar">
      <div data-ed-setup>
        <div class="ed-setup-row">
          <div class="ed-improvements" role="group" aria-label="Pakiet ulepszeń">
            {IMPROVEMENTS.map((item) => (
              <label class="fchip ed-improvement" title={item.note}>
                <input type="checkbox" name="improvement" value={item.key} checked />
                {item.label}
              </label>
            ))}
          </div>
          <div class="ed-models">
            <label>
              <span>Research</span>
              <input list="ed-model-list" data-ed-model-research value={DEFAULT_MODELS.research} spellcheck="false" />
            </label>
            <label>
              <span>Pisanie</span>
              <input list="ed-model-list" data-ed-model-writer value={DEFAULT_MODELS.writer} spellcheck="false" />
            </label>
            <datalist id="ed-model-list"></datalist>
            <small class="ed-models-note" data-ed-models-note>modele przez OpenRouter</small>
          </div>
        </div>
        <div class="ed-actions">
          <button type="button" class="ed-run" data-ed-run>Uruchom pipeline</button>
          <span class="ed-hint">
            Koszt: jedno zapytanie SERP (SerpData), frazy z Senuto i kilkadziesiąt
            tysięcy tokenów. Ten sam wpis raz na 30 dni. Wynik to propozycja –
            nic nie trafia do WordPressa automatycznie.
          </span>
        </div>
      </div>

      <div data-ed-progress hidden>
        <div class="ed-progress-head">
          <span class="ed-progress-label" data-ed-progress-label>uruchamianie…</span>
          <span class="ed-progress-meta">
            <span data-ed-progress-count></span>
            <span data-ed-progress-time></span>
            <button type="button" class="ed-cancel" data-ed-cancel>anuluj</button>
          </span>
        </div>
        <div class="ed-progress"><i data-ed-progress-fill style="width:0%"></i></div>
      </div>

      <div data-ed-summary hidden>
        <span class="cw-status" data-ed-summary-status></span>
        <span class="ed-summary-cost" data-ed-summary-cost></span>
        <button type="button" class="ed-rerun" data-ed-rerun hidden>uruchom ponownie</button>
      </div>

      <!-- Etap finalny: porada eksperta – dostępna po zakończeniu pipeline'u,
           generowana z Workera przez OpenRouter (sekundy, nie minuty). -->
      <div class="ed-expert" data-ed-expert hidden>
        <div class="ed-expert-head">
          <span class="ed-expert-label">Etap finalny · porada eksperta</span>
          <span class="ed-expert-note">cytat osoby z ICEA (innej niż autor), wybrany model pisania</span>
        </div>
        <div class="ed-expert-actions" data-ed-expert-actions></div>
        <p class="ed-error" data-ed-expert-error hidden></p>
      </div>

      <details class="ed-steps-details" data-ed-steps-details hidden>
        <summary>szczegóły kroków</summary>
        <ol class="ed-steps" data-ed-steps></ol>
      </details>

      <p class="ed-error" data-ed-error hidden></p>
    </div>

    <details class="ed-brief" data-ed-brief-details hidden>
      <summary>Wytyczne z analizy <span class="section-meta">luki wobec konkurencji i frazy do pokrycia</span></summary>
      <div data-ed-brief></div>
    </details>

    <div class="section-head ed-doc-head">
      <h2>Dokument</h2>
      <span class="section-meta" data-ed-doc-meta>treść wpisu z WordPressa</span>
    </div>
    <div class="ed-doc" data-ed-doc>
      <p class="ed-doc-loading">wczytywanie treści…</p>
    </div>
  </section>
</Layout>

<script>
  type Section = {
    slot: number;
    title_field: string;
    text_field: string;
    operation: string;
    title_before: string | null;
    title_after: string | null;
    text_before: string | null;
    text_after: string | null;
    diff: {
      opcodes: { op: string; before: string; after: string }[];
      stats: { added: number; removed: number; shrunk?: boolean };
    } | null;
    accepted: boolean;
  };
  type Step = { step: string; status: string; payload: any; cost: any; model: string | null; error: string | null };
  type Job = {
    id: string; status: string; error: string | null; cost: any; created_at: string;
    improvements: string[]; models: { research: string; writer: string } | null;
    expert: any; steps: Step[]; sections: Section[];
  };

  // Lustro config.py (STEPS + OPTIONAL_STEPS) – przy zmianie kolejności kroków
  // pipeline'u zaktualizuj oba miejsca.
  const STEP_ORDER = ['fetch', 'keywords_own', 'serp', 'competitors', 'keywords_competitors',
    'brief', 'rewrite', 'expert', 'sources', 'internal_links', 'diff'];
  const OPTIONAL_STEP: Record<string, string> = {
    rewrite: 'gaps', expert: 'expert', sources: 'sources', internal_links: 'internal_links',
  };
  const STEP_LABELS: Record<string, string> = {
    fetch: 'Pobranie treści',
    keywords_own: 'Frazy własne',
    serp: 'Wyniki wyszukiwania',
    competitors: 'Treść konkurencji',
    keywords_competitors: 'Frazy konkurencji',
    brief: 'Wytyczne',
    rewrite: 'Przepisanie sekcji',
    expert: 'Porada eksperta',
    sources: 'Źródła i przypisy',
    internal_links: 'Linki wewnętrzne',
    diff: 'Porównanie zmian',
  };
  const STATUS_LABEL: Record<string, string> = {
    queued: 'w kolejce', dispatching: 'uruchamianie', running: 'w toku', done: 'zakończone',
    failed: 'błąd', cancelled: 'anulowane', stale: 'runner przestał odpowiadać',
    budget_exceeded: 'przerwane – budżet',
  };
  // Lustro DEFAULT_MODELS z cw-api.js / config.py.
  const DEFAULT_MODELS = { research: 'perplexity/sonar-pro', writer: 'anthropic/claude-sonnet-5' };
  const MODEL_ID = /^[a-z0-9-]+\/[a-z0-9.:_-]{1,60}$/i;

  const domain = location.pathname.split('/').filter(Boolean)[0] ?? '';
  const contentId = new URLSearchParams(location.search).get('id') ?? '';
  const $ = <T extends HTMLElement>(selector: string) => document.querySelector<T>(selector);
  const pl = new Intl.NumberFormat('pl-PL');
  const fmtDate = (value: string | null) =>
    value ? new Date(`${value}T00:00:00Z`).toLocaleDateString('pl-PL', { timeZone: 'UTC' }) : '—';

  const api = async (path: string, options: RequestInit = {}) => {
    const response = await fetch(path, {
      ...options,
      headers: { 'X-CW-Request': '1', 'Content-Type': 'application/json', ...(options.headers ?? {}) },
    });
    const data = await response.json().catch(() => ({}));
    if (!response.ok) throw new Error(data?.error ?? `Błąd ${response.status}`);
    return data;
  };

  const showError = (message: string) => {
    const node = $('[data-ed-error]');
    if (!node) return;
    node.textContent = message;
    node.hidden = false;
  };

  /* ---------- sanityzacja HTML ----------
     Treść z WordPressa i z modelu to dane niezaufane – każdy render HTML
     przechodzi przez tę funkcję. Niedozwolone tagi są rozpakowywane
     (dzieci zostają), script/style/iframe znikają w całości. */
  const ALLOWED_TAGS = new Set(['P', 'BR', 'UL', 'OL', 'LI', 'STRONG', 'B', 'EM', 'I', 'A',
    'H2', 'H3', 'H4', 'BLOCKQUOTE', 'FOOTER', 'TABLE', 'THEAD', 'TBODY', 'TR', 'TH', 'TD', 'SPAN']);
  const DROP_TAGS = new Set(['SCRIPT', 'STYLE', 'IFRAME', 'OBJECT', 'EMBED', 'FORM', 'LINK', 'META']);

  function sanitizeInto(host: HTMLElement, html: string | null) {
    const doc = new DOMParser().parseFromString(html ?? '', 'text/html');
    const walk = (node: Element) => {
      for (const child of [...node.children]) {
        if (DROP_TAGS.has(child.tagName)) { child.remove(); continue; }
        walk(child);
        if (!ALLOWED_TAGS.has(child.tagName)) { child.replaceWith(...child.childNodes); continue; }
        const href = child.tagName === 'A' ? child.getAttribute('href') ?? '' : '';
        const expertQuote = child.tagName === 'BLOCKQUOTE' && child.classList.contains('expert');
        for (const attr of [...child.attributes]) child.removeAttribute(attr.name);
        if (expertQuote) child.className = 'expert';
        if (child.tagName === 'A') {
          if (/^https?:\/\//i.test(href)) {
            child.setAttribute('href', href);
            child.setAttribute('target', '_blank');
            child.setAttribute('rel', 'noopener nofollow');
          } else {
            child.replaceWith(...child.childNodes);
          }
        }
      }
    };
    walk(doc.body);
    host.replaceChildren(...doc.body.childNodes);
  }

  /* ---------- stan strony ---------- */

  let entry: any = null;
  let content: { sections: { slot: number; title: string; text: string }[] } | null = null;
  let job: Job | null = null;
  let pollDelay = 3000;
  let pollTimer: number | undefined;
  let clockTimer: number | undefined;
  const sectionMode = new Map<number, string>();

  /* ---------- katalog + treść ---------- */

  async function loadCatalog() {
    const data = await api(`/${domain}/content-watcher/catalog.json`);
    entry = (data.items ?? []).find((item: any) => item.id === contentId) ?? null;
    if (!entry) {
      $('[data-ed-missing]')!.hidden = false;
      return false;
    }
    $('[data-ed-main]')!.hidden = false;
    $('[data-ed-title]')!.textContent = entry.title;
    $('[data-ed-pillar]')!.textContent = entry.pillar ?? '';
    const url = $<HTMLAnchorElement>('[data-ed-url]')!;
    url.href = entry.url;
    url.textContent = new URL(entry.url).pathname;
    $('[data-ed-published]')!.textContent = fmtDate(entry.published_at);
    $('[data-ed-updated]')!.textContent = fmtDate(entry.updated_at);
    $('[data-ed-size]')!.textContent =
      `${pl.format(entry.word_count ?? 0)} słów · ${pl.format(entry.headings ?? 0)} nagłówków`;
    $('[data-ed-author]')!.textContent = entry.author ?? '—';
    return true;
  }

  async function loadContent() {
    const host = $('[data-ed-doc]')!;
    try {
      content = await api(`/api/cw/content/${domain}/${entry.post_type ?? 'posts'}/${entry.post_id}`);
    } catch (error) {
      host.replaceChildren();
      const note = document.createElement('p');
      note.className = 'ed-doc-error';
      note.textContent = `Nie udało się wczytać treści wpisu (${error instanceof Error ? error.message : 'błąd'}). ` +
        'Pipeline można uruchomić mimo to – dokument pojawi się z propozycjami.';
      host.append(note);
      return;
    }
    renderDoc();
    // Zadanie mogło wczytać się szybciej niż treść – nakładamy jego stan
    // (propozycje + cytat eksperta) na świeżo zbudowany dokument.
    if (job) {
      applyJobToDoc(job);
      applyExpertToDoc(job);
    }
  }

  /** Sekcja dokumentu: nagłówek + treść + (po pipelinie) narzędzia i tryby. */
  function docSection(slot: number, title: string, html: string | null) {
    const section = document.createElement('section');
    section.className = 'ed-doc-section';
    section.dataset.slot = String(slot);
    const heading = document.createElement('h2');
    heading.textContent = title || `Sekcja ${slot}`;
    const body = document.createElement('div');
    body.className = 'prose ed-doc-body';
    sanitizeInto(body, html);
    section.append(heading, body);
    return section;
  }

  function renderDoc() {
    const host = $('[data-ed-doc]')!;
    host.replaceChildren();
    if (!content?.sections?.length) {
      const note = document.createElement('p');
      note.className = 'ed-doc-error';
      note.textContent = 'Ten wpis nie ma sekcji ACF (page_text_N) – dokument zostanie zbudowany z wyniku pipeline’u.';
      host.append(note);
      return;
    }
    host.replaceChildren(...content.sections.map((section) => docSection(section.slot, section.title, section.text)));
    $('[data-ed-doc-meta]')!.textContent =
      `${content.sections.length} sekcji · treść z WordPressa`;
  }

  /* ---------- modele (OpenRouter) ---------- */

  async function loadModels() {
    const research = $<HTMLInputElement>('[data-ed-model-research]')!;
    const writer = $<HTMLInputElement>('[data-ed-model-writer]')!;
    try {
      const saved = JSON.parse(localStorage.getItem('cw-models') ?? 'null');
      if (saved?.research) research.value = saved.research;
      if (saved?.writer) writer.value = saved.writer;
    } catch { /* zepsuty localStorage nie blokuje strony */ }
    try {
      const response = await fetch('https://openrouter.ai/api/v1/models');
      if (!response.ok) throw new Error(String(response.status));
      const data = await response.json();
      const ids = (data?.data ?? []).map((model: any) => model?.id).filter(Boolean).sort();
      const list = $('#ed-model-list')!;
      list.replaceChildren(...ids.map((id: string) => {
        const option = document.createElement('option');
        option.value = id;
        return option;
      }));
      $('[data-ed-models-note]')!.textContent = `modele przez OpenRouter · ${pl.format(ids.length)} dostępnych`;
    } catch {
      $('[data-ed-models-note]')!.textContent = 'modele przez OpenRouter · lista niedostępna, wpisz ID ręcznie';
    }
  }

  /* ---------- pasek postępu ---------- */

  function plannedSteps(current: Job) {
    return STEP_ORDER.filter((step) => {
      const improvement = OPTIONAL_STEP[step];
      return !improvement || (current.improvements ?? []).includes(improvement);
    });
  }

  function renderProgress(current: Job) {
    const running = ['queued', 'dispatching', 'running'].includes(current.status);
    $('[data-ed-setup]')!.hidden = running || current.status === 'done';
    $('[data-ed-progress]')!.hidden = !running;
    $('[data-ed-summary]')!.hidden = running;
    $('[data-ed-steps-details]')!.hidden = !current.steps?.length;

    const planned = plannedSteps(current);
    const byName = new Map(current.steps.map((step) => [step.step, step]));
    const finished = planned.filter((name) => ['done', 'skipped', 'failed'].includes(byName.get(name)?.status ?? ''));
    const active = planned.find((name) => byName.get(name)?.status === 'running');

    if (running) {
      const percent = Math.round((finished.length / planned.length) * 100);
      $('[data-ed-progress-fill]')!.style.width = `${Math.max(3, percent)}%`;
      $('[data-ed-progress-label]')!.textContent = active
        ? STEP_LABELS[active] ?? active
        : STATUS_LABEL[current.status] ?? current.status;
      $('[data-ed-progress-count]')!.textContent = `krok ${Math.min(finished.length + 1, planned.length)} z ${planned.length}`;
      startClock(current);
    } else {
      stopClock();
      const status = $('[data-ed-summary-status]')!;
      status.textContent = STATUS_LABEL[current.status] ?? current.status;
      status.className = `cw-status ${current.status === 'done' ? 'recent' : ['failed', 'stale', 'budget_exceeded'].includes(current.status) ? 'not-indexed' : ''}`;
      const tokens = (current.cost?.tokens_total ?? 0) || ((current.cost?.tokens_in ?? 0) + (current.cost?.tokens_out ?? 0));
      const parts = [
        current.models ? `research: ${current.models.research} · pisanie: ${current.models.writer}` : null,
        tokens ? `${pl.format(tokens)} tokenów` : null,
        current.cost?.serp_requests ? `${current.cost.serp_requests} zap. SERP` : null,
        current.error,
      ].filter(Boolean);
      $('[data-ed-summary-cost]')!.textContent = parts.join(' · ');
      $<HTMLButtonElement>('[data-ed-rerun]')!.hidden = !['failed', 'cancelled', 'stale', 'budget_exceeded'].includes(current.status);
    }
    renderSteps(current);
  }

  function startClock(current: Job) {
    stopClock();
    const started = new Date(current.created_at).getTime();
    const tick = () => {
      const seconds = Math.max(0, Math.floor((Date.now() - started) / 1000));
      $('[data-ed-progress-time]')!.textContent =
        `${Math.floor(seconds / 60)}:${String(seconds % 60).padStart(2, '0')}`;
    };
    tick();
    clockTimer = window.setInterval(tick, 1000);
  }
  function stopClock() {
    window.clearInterval(clockTimer);
  }

  function renderSteps(current: Job) {
    const host = $('[data-ed-steps]')!;
    const byName = new Map(current.steps.map((step) => [step.step, step]));
    host.replaceChildren(...plannedSteps(current).map((name) => {
      const step = byName.get(name);
      const li = document.createElement('li');
      li.className = step?.status ?? 'pending';
      const label = document.createElement('span');
      label.className = 'ed-step-name';
      label.textContent = STEP_LABELS[name] ?? name;
      const info = document.createElement('span');
      info.className = 'ed-step-info';
      const cost = step?.cost?.serp_requests
        ? `${step.cost.serp_requests} zap. SERP`
        : step?.cost?.senuto_requests
        ? `${step.cost.senuto_requests} zap. Senuto`
        : step?.cost?.tokens_out
          ? `${pl.format((step.cost.tokens_in ?? 0) + (step.cost.tokens_out ?? 0))} tok.`
          : '';
      info.textContent = step?.error ?? [step?.model, cost].filter(Boolean).join(' · ');
      li.append(label, info);
      return li;
    }));
  }

  /* ---------- wytyczne ---------- */

  function renderBrief(current: Job) {
    const brief = current.steps.find((step) => step.step === 'brief')?.payload;
    const details = $<HTMLDetailsElement>('[data-ed-brief-details]');
    const card = $('[data-ed-brief]');
    if (!brief || !details || !card) return;
    details.hidden = false;
    if (['queued', 'dispatching', 'running'].includes(current.status) && !details.dataset.touched) details.open = true;
    card.replaceChildren();

    const add = (title: string, body: Node) => {
      const wrap = document.createElement('div');
      wrap.className = 'ed-brief-block';
      const heading = document.createElement('h3');
      heading.textContent = title;
      wrap.append(heading, body);
      card.append(wrap);
    };
    if (brief.summary) {
      const p = document.createElement('p');
      p.textContent = brief.summary;
      add('Podsumowanie', p);
    }
    const list = (items: string[]) => {
      const ul = document.createElement('ul');
      for (const item of items) {
        const li = document.createElement('li');
        li.textContent = item;
        ul.append(li);
      }
      return ul;
    };
    if (brief.gaps?.length) add('Luki wobec konkurencji', list(brief.gaps.map((gap: any) => `${gap.topic} – ${gap.why}`)));
    if (brief.keywords_to_cover?.length) {
      add('Frazy do pokrycia', list(brief.keywords_to_cover.map((keyword: any) =>
        `${keyword.keyword}` +
        (keyword.volume ? ` · ${pl.format(keyword.volume)}/mies.` : '') +
        (keyword.current_position ? ` · obecnie ${keyword.current_position}` : ''))));
    }
    if (brief.factual_risks?.length) add('Do weryfikacji faktograficznej', list(brief.factual_risks));
  }

  /* ---------- diff inline w dokumencie ---------- */

  const plain = (html: string | null) =>
    (html ?? '').replace(/<[^>]+>/g, ' ').replace(/&nbsp;/g, ' ').replace(/\s+/g, ' ').trim();

  /** Ile treści sekcji objęła zmiana – przy gruntownym przepisaniu diff inline
      przestaje być czytelny i lepiej od razu pokazać wersję „po". */
  function changeRatio(section: Section) {
    const opcodes = section.diff?.opcodes ?? [];
    const changed = opcodes.filter((op) => op.op !== 'equal')
      .reduce((sum, op) => sum + Math.max(op.before.length, op.after.length), 0);
    const total = opcodes.reduce((sum, op) => sum + Math.max(op.before.length, op.after.length), 0);
    return total ? changed / total : 0;
  }

  /** Diff renderowany wyłącznie przez textContent – w treści siedzą fragmenty
      obcych stron i HTML z modelu, traktujemy je jak dane, nie markup. */
  function renderInlineDiff(section: Section) {
    const wrap = document.createElement('div');
    wrap.className = 'ed-diff';
    for (const op of section.diff?.opcodes ?? []) {
      if (op.op === 'equal') {
        const span = document.createElement('span');
        span.textContent = op.before;
        wrap.append(span);
        continue;
      }
      if (op.before) {
        const del = document.createElement('del');
        del.textContent = op.before;
        wrap.append(del);
      }
      if (op.after) {
        const ins = document.createElement('ins');
        ins.textContent = op.after;
        wrap.append(ins);
      }
    }
    return wrap;
  }

  /** Ten sam format bloku co step_expert w run.py i cw-expert.js. */
  function expertBlockquote(expert: any) {
    return `<blockquote class="expert"><p>${expert.quote}</p><footer>${expert.expert ?? ''}${expert.role ? `, ${expert.role}` : ''}</footer></blockquote>`;
  }

  function activeExpert(current: Job | null) {
    return current?.expert?.status === 'done' ? current.expert : null;
  }

  /** „Kopiuj treść" dokleja cytat eksperta do sekcji, w której ma stanąć –
      text_after w bazie zostaje czystym wynikiem pipeline'u. */
  function sectionCopyText(section: Section) {
    const expert = activeExpert(job);
    const base = section.text_after ?? '';
    return expert && expert.slot === section.slot ? `${base}\n${expertBlockquote(expert)}` : base;
  }

  function renderSectionBody(host: HTMLElement, section: Section, mode: string, onDirty?: () => void) {
    if (mode === 'diff') {
      host.replaceChildren(renderInlineDiff(section));
    } else {
      const body = document.createElement('div');
      body.className = 'prose ed-doc-body';
      sanitizeInto(body, mode === 'before' ? section.text_before : section.text_after);
      // Tryb „podgląd po" jest edytowalny – poprawki zapisują się do zadania
      // i „kopiuj treść" bierze wersję po edycji.
      if (mode === 'after' && onDirty) {
        body.contentEditable = 'true';
        body.classList.add('ed-editable');
        body.addEventListener('input', onDirty);
      }
      host.replaceChildren(body);
    }
  }

  function sectionTools(section: Section, jobId: string, onMode: (mode: string) => void,
    onSave?: (button: HTMLButtonElement) => void) {
    const tools = document.createElement('div');
    tools.className = 'ed-sec-tools';

    const badge = document.createElement('span');
    badge.className = 'ed-sec-badge';
    const stats = section.diff?.stats;
    badge.textContent = (section.operation === 'insert'
      ? 'nowa sekcja'
      : stats ? `+${pl.format(stats.added)} / −${pl.format(stats.removed)} słów` : 'aktualizacja')
      + ((section as any).edited ? ' · ręcznie poprawiona' : '');
    tools.append(badge);

    if (stats?.shrunk) {
      const warn = document.createElement('span');
      warn.className = 'ed-sec-warn';
      warn.textContent = 'model wyciął więcej, niż dopisał';
      warn.title = 'Sprawdź, czy nie zniknęło nic wartościowego.';
      tools.append(warn);
    }

    const seg = document.createElement('span');
    seg.className = 'ed-view-seg';
    const modes: [string, string][] = section.operation === 'insert'
      ? [['after', 'podgląd']]
      : [['diff', 'zmiany'], ['after', 'podgląd po'], ['before', 'oryginał']];
    for (const [mode, label] of modes) {
      const button = document.createElement('button');
      button.type = 'button';
      button.textContent = label;
      button.dataset.mode = mode;
      button.addEventListener('click', () => onMode(mode));
      seg.append(button);
    }
    tools.append(seg);

    const spacer = document.createElement('span');
    spacer.className = 'ed-sec-spacer';
    tools.append(spacer);

    const accept = document.createElement('label');
    accept.className = 'ed-accept';
    const checkbox = document.createElement('input');
    checkbox.type = 'checkbox';
    checkbox.checked = section.accepted;
    checkbox.addEventListener('change', async () => {
      try {
        await api(`/api/cw/jobs/${jobId}/sections/${section.slot}`, {
          method: 'PATCH',
          body: JSON.stringify({ accepted: checkbox.checked }),
        });
      } catch (error) {
        checkbox.checked = !checkbox.checked;
        showError(error instanceof Error ? error.message : 'Nie udało się zapisać decyzji.');
      }
    });
    accept.append(checkbox, document.createTextNode('do wdrożenia'));

    const copyButton = (label: string, value: () => string) => {
      const button = document.createElement('button');
      button.type = 'button';
      button.textContent = label;
      button.addEventListener('click', async () => {
        await navigator.clipboard.writeText(value());
        button.textContent = 'skopiowano';
        setTimeout(() => (button.textContent = label), 1500);
      });
      return button;
    };
    if (onSave) {
      const save = document.createElement('button');
      save.type = 'button';
      save.className = 'ed-save';
      save.textContent = 'zapisz poprawki';
      save.hidden = true;
      save.dataset.save = '1';
      save.addEventListener('click', () => onSave(save));
      tools.append(save);
    }
    tools.append(accept, copyButton('kopiuj nagłówek', () => section.title_after ?? ''),
      copyButton('kopiuj treść', () => sectionCopyText(section)));
    return tools;
  }

  function applyJobToDoc(current: Job) {
    if (!current.sections?.length) return;
    const host = $('[data-ed-doc]')!;
    const bySlot = new Map<number, HTMLElement>();
    host.querySelectorAll<HTMLElement>('.ed-doc-section').forEach((node) => {
      bySlot.set(Number(node.dataset.slot), node);
    });

    for (const section of current.sections) {
      let node = bySlot.get(section.slot);
      if (!node) {
        // Nowa sekcja (wolny slot) – wstawiamy w porządku slotów.
        node = docSection(section.slot, section.title_after ?? '', null);
        const after = [...bySlot.entries()].filter(([slot]) => slot > section.slot).sort((a, b) => a[0] - b[0])[0];
        host.insertBefore(node, after?.[1] ?? null);
        bySlot.set(section.slot, node);
      }
      node.classList.add(section.operation === 'insert' ? 'is-new' : 'is-changed');

      const heading = node.querySelector('h2');
      if (heading && section.title_after && section.title_after !== section.title_before) {
        heading.textContent = section.title_after;
        heading.classList.add('is-retitled');
        heading.title = section.title_before ? `poprzednio: ${section.title_before}` : '';
      }

      let toolsHost = node.querySelector<HTMLElement>('.ed-sec-tools');
      let bodyHost = node.querySelector<HTMLElement>('.ed-sec-body');
      if (!bodyHost) {
        bodyHost = document.createElement('div');
        bodyHost.className = 'ed-sec-body';
        node.querySelector('.ed-doc-body')?.replaceWith(bodyHost);
        node.appendChild(bodyHost);
      }
      const mode = sectionMode.get(section.slot)
        ?? (section.operation === 'insert' || changeRatio(section) > 0.5 ? 'after' : 'diff');
      sectionMode.set(section.slot, mode);
      const onDirty = () => {
        const save = node!.querySelector<HTMLButtonElement>('[data-save]');
        if (save) save.hidden = false;
      };
      const onSave = async (button: HTMLButtonElement) => {
        const body = bodyHost!.querySelector('.prose');
        if (!body) return;
        button.disabled = true;
        try {
          const data = await api(`/api/cw/jobs/${current.id}/sections/${section.slot}`, {
            method: 'PATCH',
            body: JSON.stringify({ text_after: body.innerHTML }),
          });
          // Serwer zwraca wersję po własnej sanityzacji – to ona jest prawdą.
          section.text_after = data.text_after ?? body.innerHTML;
          (section as any).edited = true;
          button.hidden = true;
          const badge = node!.querySelector('.ed-sec-badge');
          if (badge && !badge.textContent!.includes('ręcznie')) badge.textContent += ' · ręcznie poprawiona';
        } catch (error) {
          showError(error instanceof Error ? error.message : 'Nie udało się zapisać poprawek.');
        } finally {
          button.disabled = false;
        }
      };
      const paint = (nextMode: string) => {
        sectionMode.set(section.slot, nextMode);
        renderSectionBody(bodyHost!, section, nextMode, onDirty);
        node!.querySelectorAll<HTMLButtonElement>('.ed-view-seg button').forEach((button) => {
          button.classList.toggle('active', button.dataset.mode === nextMode);
        });
      };
      const tools = sectionTools(section, current.id, paint, onSave);
      if (toolsHost) toolsHost.replaceWith(tools);
      else node.insertBefore(tools, bodyHost);
      paint(mode);
    }

    // Sekcje bez propozycji – przygaszamy, żeby zmiany były widoczne od razu.
    const changed = new Set(current.sections.map((section) => section.slot));
    bySlot.forEach((node, slot) => {
      node.classList.toggle('is-unchanged', !changed.has(slot) && current.status === 'done');
    });
    $('[data-ed-doc-meta]')!.textContent =
      `${bySlot.size} sekcji · ${current.sections.length} z propozycjami zmian`;
  }

  /* ---------- porada eksperta (etap finalny) ---------- */

  let expertBusy = false;

  async function callExpert(method: string, body?: any) {
    if (!job || expertBusy) return;
    expertBusy = true;
    $('[data-ed-expert-error]')!.hidden = true;
    renderExpert(job);
    try {
      await api(`/api/cw/jobs/${job.id}/expert`, { method, body: body ? JSON.stringify(body) : undefined });
      const data = await api(`/api/cw/jobs/${job.id}`);
      expertBusy = false;
      render(data.job);
    } catch (error) {
      expertBusy = false;
      // Stan eksperta mógł się zmienić mimo błędu (np. failed z powodem).
      try {
        const data = await api(`/api/cw/jobs/${job!.id}`);
        job = data.job;
      } catch { /* zostajemy przy tym, co mamy */ }
      renderExpert(job!);
      const node = $('[data-ed-expert-error]')!;
      node.textContent = error instanceof Error ? error.message : 'Nie udało się wygenerować cytatu.';
      node.hidden = false;
    }
  }

  function renderExpert(current: Job) {
    const card = $('[data-ed-expert]')!;
    card.hidden = current.status !== 'done';
    if (card.hidden) return;
    const actions = $('[data-ed-expert-actions]')!;
    actions.replaceChildren();

    const button = (label: string, onClick: () => void, primary = false) => {
      const node = document.createElement('button');
      node.type = 'button';
      node.className = primary ? 'ed-expert-run' : 'ed-expert-secondary';
      node.textContent = label;
      node.addEventListener('click', onClick);
      return node;
    };

    if (expertBusy || current.expert?.status === 'running') {
      const wait = document.createElement('span');
      wait.className = 'ed-expert-wait';
      wait.textContent = 'generowanie cytatu…';
      actions.append(wait);
      return;
    }
    const expert = activeExpert(current);
    if (expert) {
      const quote = document.createElement('div');
      quote.className = 'prose ed-expert-preview';
      sanitizeInto(quote, expertBlockquote(expert));
      const meta = document.createElement('small');
      meta.className = 'ed-expert-meta';
      meta.textContent = [
        expert.slot ? `sekcja ${expert.slot}` : null,
        expert.placement || null,
        expert.model || null,
      ].filter(Boolean).join(' · ');
      actions.append(quote, meta,
        button('kopiuj cytat', async () => { await navigator.clipboard.writeText(expertBlockquote(expert)); }),
        button('wygeneruj ponownie', () => callExpert('POST')),
        button('odrzuć', () => callExpert('PATCH', { rejected: true })));
      return;
    }
    if (current.expert?.status === 'failed' && current.expert?.error) {
      const err = document.createElement('span');
      err.className = 'ed-expert-meta';
      err.textContent = current.expert.error;
      actions.append(err);
    }
    actions.append(button(current.expert ? 'spróbuj ponownie' : 'Dodaj poradę eksperta', () => callExpert('POST'), true));
  }

  /** Cytat wpinamy też inline w dokument – na końcu wskazanej sekcji. */
  function applyExpertToDoc(current: Job) {
    document.querySelectorAll('.ed-doc-expert').forEach((node) => node.remove());
    const expert = activeExpert(current);
    if (!expert) return;
    const host = $('[data-ed-doc]')!;
    const target = expert.slot
      ? host.querySelector(`.ed-doc-section[data-slot="${expert.slot}"]`)
      : host.querySelector('.ed-doc-section:last-child');
    if (!target) return;
    const block = document.createElement('div');
    block.className = 'prose ed-doc-expert';
    sanitizeInto(block, expertBlockquote(expert));
    target.append(block);
  }

  /* ---------- cykl życia zadania ---------- */

  function render(current: Job) {
    job = current;
    renderProgress(current);
    renderBrief(current);
    applyJobToDoc(current);
    renderExpert(current);
    applyExpertToDoc(current);
    const running = ['queued', 'dispatching', 'running'].includes(current.status);
    $<HTMLButtonElement>('[data-ed-run]')?.toggleAttribute('disabled', running);
  }

  /** Polling z narastającym odstępem, wstrzymywany przy ukrytej karcie
      i zatrzymywany w stanie końcowym – zadanie trwa minuty, nie sekundy. */
  function schedulePoll() {
    window.clearTimeout(pollTimer);
    if (!job || !['queued', 'dispatching', 'running'].includes(job.status)) return;
    pollTimer = window.setTimeout(async () => {
      if (document.visibilityState === 'hidden') { schedulePoll(); return; }
      try {
        const data = await api(`/api/cw/jobs/${job!.id}`);
        render(data.job);
      } catch {
        /* chwilowy błąd sieci nie przerywa pollingu */
      }
      pollDelay = Math.min(30000, Math.round(pollDelay * 1.6));
      schedulePoll();
    }, pollDelay);
  }

  async function loadLatestJob() {
    if (!entry?.post_id) return;
    try {
      const data = await api(`/api/cw/jobs?domain=${encodeURIComponent(domain)}&limit=100`);
      const mine = (data.jobs ?? []).find((row: any) => row.post_id === entry.post_id);
      if (!mine) return;
      const full = await api(`/api/cw/jobs/${mine.id}`);
      render(full.job);
      schedulePoll();
    } catch (error) {
      showError(error instanceof Error ? error.message : 'Nie udało się odczytać stanu zadań.');
    }
  }

  async function runPipeline() {
    $('[data-ed-error]')!.hidden = true;
    const improvements = [...document.querySelectorAll<HTMLInputElement>('input[name="improvement"]:checked')]
      .map((input) => input.value);
    if (!improvements.length) return showError('Wybierz przynajmniej jedno ulepszenie.');

    const research = $<HTMLInputElement>('[data-ed-model-research]')!.value.trim() || DEFAULT_MODELS.research;
    const writer = $<HTMLInputElement>('[data-ed-model-writer]')!.value.trim() || DEFAULT_MODELS.writer;
    if (!MODEL_ID.test(research) || !MODEL_ID.test(writer)) {
      return showError('Identyfikator modelu ma format „dostawca/model" (np. anthropic/claude-sonnet-5).');
    }
    localStorage.setItem('cw-models', JSON.stringify({ research, writer }));

    try {
      const data = await api('/api/cw/jobs', {
        method: 'POST',
        body: JSON.stringify({
          domain,
          post_id: entry.post_id,
          post_type: entry.post_type ?? 'posts',
          url: entry.url,
          title: entry.title,
          author: entry.author ?? '',
          improvements,
          models: { research, writer },
        }),
      });
      pollDelay = 3000;
      sectionMode.clear();
      render(data.job);
      schedulePoll();
    } catch (error) {
      showError(error instanceof Error ? error.message : 'Nie udało się zakolejkować zadania.');
    }
  }

  $('[data-ed-run]')?.addEventListener('click', runPipeline);
  $('[data-ed-rerun]')?.addEventListener('click', () => {
    $('[data-ed-setup]')!.hidden = false;
    $('[data-ed-summary]')!.hidden = true;
  });
  $('[data-ed-cancel]')?.addEventListener('click', async () => {
    if (!job) return;
    try {
      await api(`/api/cw/jobs/${job.id}/cancel`, { method: 'POST' });
      const data = await api(`/api/cw/jobs/${job.id}`);
      render(data.job);
    } catch (error) {
      showError(error instanceof Error ? error.message : 'Nie udało się anulować zadania.');
    }
  });
  $('[data-ed-brief-details]')?.addEventListener('toggle', (event) => {
    (event.currentTarget as HTMLElement).dataset.touched = '1';
  });
  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'visible') { pollDelay = 3000; schedulePoll(); }
  });

  loadCatalog().then((ok) => {
    if (!ok) return;
    loadModels();
    loadContent();
    loadLatestJob();
  });
</script>

