<style is:global>
  /* Dokument, kroki i diff powstają w JavaScripcie, więc nie mają atrybutu
     scope'ującego Astro – te reguły muszą być globalne. */
  /* Elementy chowane atrybutem `hidden` mają własne reguły `display: flex`,
     a te biją wbudowane `[hidden] { display: none }` – stąd sekcje, które
     miały zniknąć, zostawały na ekranie (podsumowanie przy błędzie, pasek
     decyzji, filtr sekcji). */
  .ed-pipebar [hidden], .ed-docbar [hidden], .ed-doc [hidden] { display: none !important; }

  /* Frazy z panelu „Frazy do pokrycia" zaznaczone w treści. Podświetlenia idą
     przez CSS Custom Highlight API (zakresy, nie elementy), więc reguła nie
     może być scope'owana – nie ma tu żadnego elementu do oznaczenia. */
  /* „Było w tekście" musi mieć INNY kolor niż „dopisane", nie inny odcień –
     accent-blue w motywie ICEA to limonka, więc zlewała się ze status-ok.
     Stąd klasyczny żółty zakreślacz vs zieleń nowości. */
  ::highlight(cw-keyword) {
    background: color-mix(in srgb, var(--status-warn-fg) 32%, transparent);
    color: var(--ink);
  }
  ::highlight(cw-keyword-new) {
    background: color-mix(in srgb, var(--status-ok) 32%, transparent);
    color: var(--ink);
  }
  /* Wystąpienie, do którego przeskoczyliśmy klikając frazę na liście –
     mocniejsze niż stałe podświetlenie, gaśnie samo po chwili. */
  ::highlight(cw-keyword-focus) {
    background: color-mix(in srgb, var(--accent-blue) 55%, transparent);
    color: var(--ink);
  }

  /* Astro scope'uje też nazwy @keyframes, więc animacja używana w tym bloku
     musi mieć własną definicję globalną. */
  @keyframes ed-spin-global { to { transform: rotate(360deg); } }

  /* ----- oś przebiegu -----
     Kolumna ma stałą szerokość: rozciągnięta na 2000 px lista kroków to
     kilometry pustki między nazwą a kosztem. */
  .ed-timeline-wrap { max-width: 560px; margin-top: 14px; }
  .ed-steps { list-style: none; margin: 0; padding: 0; display: grid; }
  .ed-step { position: relative; display: grid; grid-template-columns: 22px minmax(0, 1fr);
    gap: 12px; padding: 7px 0 7px 2px; }
  /* Pionowa nić łącząca znaczniki – bez niej to zwykła lista, nie przebieg. */
  .ed-step:not(:last-child)::before { content: ''; position: absolute; left: 10px; top: 26px;
    bottom: -4px; width: 1px; background: var(--hairline); }
  .ed-step-mark { width: 19px; height: 19px; margin-top: 1px; display: grid; place-items: center;
    border: 1px solid var(--hairline); border-radius: 50%; background: var(--bg-surface-1);
    color: var(--ink-faint); font-size: .66rem; line-height: 1; }
  .ed-step-body { display: grid; gap: 1px; min-width: 0; }
  .ed-step-name { font-size: .82rem; color: var(--ink-muted); }
  .ed-step-info { font-size: .7rem; color: var(--ink-faint); font-variant-numeric: tabular-nums; }
  .ed-step-info.is-costly { color: var(--status-warn-fg); }
  .ed-step-error { font-size: .72rem; color: var(--status-err-fg); }

  .ed-step.done .ed-step-mark { border-color: var(--status-ok); color: var(--status-ok); }
  .ed-step.done .ed-step-name { color: var(--ink); }
  .ed-step.failed .ed-step-mark { border-color: var(--status-err-fg); color: var(--status-err-fg);
    background: var(--status-err-bg); }
  .ed-step.failed .ed-step-name { color: var(--ink); }
  .ed-step.skipped { opacity: .45; }
  .ed-step.pending { opacity: .45; }
  .ed-step.running .ed-step-name { color: var(--ink); font-weight: 600; }
  /* Krok w toku: kółko kręci się dopóki trwa – widać, że przebieg żyje. */
  .ed-step.running .ed-step-mark { border-color: var(--hairline); border-top-color: var(--accent-blue);
    border-right-color: var(--accent-blue); animation: ed-spin-global .9s linear infinite; }

  /* ----- karta nieudanego przebiegu ----- */
  .ed-fail { margin-top: 12px; padding: 12px 14px; border: 1px solid var(--status-err-fg);
    border-left-width: 3px; border-radius: 2px; background: var(--status-err-bg); max-width: 760px; }
  .ed-fail-head { display: flex; flex-wrap: wrap; gap: 8px 12px; align-items: baseline;
    font-size: .74rem; color: var(--ink-muted); }
  .ed-fail-badge { padding: 2px 8px; border-radius: 999px; background: var(--status-err-fg);
    color: #180404; font-size: .64rem; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; }
  .ed-fail-msg { margin: 8px 0 0; font-size: .85rem; line-height: 1.55; color: var(--ink);
    word-break: break-word; }
  .ed-fail-actions { display: flex; flex-wrap: wrap; gap: 10px 14px; align-items: center; margin-top: 10px; }
  .ed-fail-log { font-size: .75rem; color: var(--accent-blue); }

  .ed-brief-block { margin: 12px 0 0; }
  .ed-brief-block h3 { margin: 0 0 5px; font-size: .72rem; letter-spacing: .06em;
    text-transform: uppercase; color: var(--ink-faint); }
  .ed-brief-block p { margin: 0; font-size: .85rem; line-height: 1.55; color: var(--ink-muted); }
  .ed-brief-block p.ed-brief-warn { color: var(--status-warn-fg); }
  .ed-brief-block ul { margin: 0; padding-left: 18px; display: grid; gap: 3px; font-size: .82rem;
    color: var(--ink-muted); }

  /* ----- dokument artykułu -----
     Układ jest celowo „edytorski": jedna kolumna tekstu o czytelnej mierze,
     po lewej rynienka na typy bloków (h2, p, ul) i przyciski decyzji. */
  /* ----- układ dokument + boczny panel oceny -----
     Na szerokim ekranie ocena treści z frazami stoi w przypiętej kolumnie
     obok dokumentu – decyzje przy sekcjach zapadają bez scrollowania do góry,
     a prawa połowa monitora przestaje być pusta. Poniżej progu wszystko
     wraca do jednej kolumny (aside w DOM stoi przed dokumentem). */
  @media (min-width: 1500px) {
    .ed-workspace { display: flex; flex-direction: row-reverse; gap: 24px; align-items: flex-start; }
    .ed-docwrap { flex: 1; min-width: 0; }
    .ed-side { flex: 0 0 400px; width: 400px; position: sticky; top: 12px;
      max-height: calc(100vh - 24px); overflow-y: auto; align-self: flex-start; }
    .ed-side .ed-score { grid-template-columns: 1fr; }
    .ed-side .ed-score-keywords { border-left: 0; padding-left: 0; margin-top: 4px;
      border-top: 1px solid var(--hairline-soft); padding-top: 14px; }
  }

  /* ----- zwijanie sekcji analitycznych -----
     Po zakończonym przebiegu SERP i treści konkurencji zrobiły swoje –
     zostaje sam nagłówek ze stemplem, treść wraca po „rozwiń". */
  .ed-serp.is-folded > :not(.ed-serp-head) { display: none; }
  .ed-serp.is-folded .ed-serp-head { padding-bottom: 0; border-bottom: 0; }
  .ed-serp.is-folded .ed-serp-lead { display: none; }
  .ed-serp-fold { padding: 4px 11px; border: 1px solid var(--hairline); border-radius: 2px;
    background: transparent; color: var(--ink-muted); font: inherit; font-size: .72rem; cursor: pointer; }
  .ed-serp-fold:hover { color: var(--ink); border-color: var(--accent-blue); }

  .ed-doc { border: 1px solid var(--hairline); border-radius: 2px; background: var(--bg-surface-1); }
  .ed-doc-loading, .ed-doc-error { margin: 0; padding: 18px 22px; color: var(--ink-faint); font-size: .85rem; }
  .ed-doc-section { position: relative; padding: 26px 28px 30px 76px;
    border-bottom: 1px solid var(--hairline-soft); }
  .ed-doc-section:last-child { border-bottom: none; }
  /* Blok FAQ: wspólny nagłówek grupy i węższe wcięcie pytań – na stronie to
     osobna część pod artykułem, a nie kolejne sekcje treści. */
  .ed-faq-head { display: flex; flex-wrap: wrap; gap: 6px 14px; align-items: baseline;
    padding: 26px 28px 0 76px; border-top: 1px solid var(--hairline); }
  .ed-faq-head h2 { margin: 0; font: 600 1.35rem var(--font-display); color: var(--ink); }
  .ed-faq-head span { font-size: .72rem; color: var(--ink-faint); }
  .ed-doc-section.ed-doc-faq { padding-top: 18px; padding-bottom: 20px; }
  .ed-doc-section.ed-doc-faq > .ed-sec-head h3 { margin: 0; font: 600 1.02rem var(--font-display);
    color: var(--ink); line-height: 1.3; }
  .ed-sec-head { display: flex; flex-wrap: wrap; gap: 6px 14px; align-items: baseline; margin: 0 0 14px; }
  .ed-doc-section h1, .ed-doc-section > .ed-sec-head h2 { margin: 0; font-family: var(--font-display);
    color: var(--ink); line-height: 1.25; }
  .ed-doc-section h1 { font-size: 1.7rem; letter-spacing: -.01em; }
  .ed-doc-section > .ed-sec-head h2 { font-size: 1.28rem; }
  .ed-doc-section > .ed-sec-head h2.is-retitled { text-decoration: underline;
    text-decoration-color: var(--accent-blue); text-underline-offset: 5px; }
  .ed-doc-intro { background: color-mix(in srgb, var(--bg-surface-2) 55%, transparent); }

  /* Rynienka: etykieta typu bloku przy każdym akapicie i nagłówku. */
  .ed-doc-section [data-block] { position: relative; }
  .ed-doc-section [data-block]::before { content: attr(data-block); position: absolute;
    left: -54px; top: .35em; width: 34px; text-align: right; font: 500 .66rem var(--font-body);
    letter-spacing: .04em; color: var(--ink-faint); opacity: .45; user-select: none; }
  .ed-doc-section:hover [data-block]::before { opacity: .8; }
  /* W sekcji z propozycją rynienkę zajmują przyciski decyzji – etykieta
     nagłówka wpadłaby dokładnie pod nie. */
  .ed-doc-section:has(.ed-decide) > .ed-sec-head h2::before { display: none; }

  /* Stan sekcji po pipelinie – kolor lewej krawędzi mówi, co się z nią dzieje. */
  .ed-doc-section.is-changed::after, .ed-doc-section.is-new::after {
    content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 3px; background: var(--accent-blue); }
  .ed-doc-section.is-new::after { background: var(--status-ok); }
  .ed-doc-section[data-decision="accepted"]::after { background: var(--status-ok); }
  .ed-doc-section[data-decision="rejected"]::after { background: var(--hairline); }
  .ed-doc-section[data-decision="rejected"] { opacity: .5; }
  .ed-doc-section[data-decision="rejected"]:hover { opacity: 1; }
  .ed-doc-section.is-unchanged { opacity: .72; }
  .ed-doc-section.is-unchanged:hover { opacity: 1; }
  .ed-unchanged-tag { opacity: .9; }

  /* Przyciski decyzji w rynience – ✓ zatwierdza, ✕ odrzuca, klik w aktywny cofa. */
  .ed-decide { position: absolute; left: 16px; top: 24px; display: grid; gap: 8px; }
  .ed-decide-btn { width: 30px; height: 30px; display: grid; place-items: center; padding: 0;
    border: 1px solid var(--hairline); border-radius: 50%; background: var(--bg-surface-2);
    color: var(--ink-faint); font-size: .8rem; line-height: 1; cursor: pointer;
    transition: background .15s, color .15s, border-color .15s; }
  .ed-decide-btn:hover { color: var(--ink); border-color: var(--ink-faint); }
  .ed-decide-btn.ok.active { background: var(--status-ok); border-color: var(--status-ok); color: #05140a; }
  .ed-decide-btn.no.active { background: var(--bg-surface-3); border-color: var(--ink-faint); color: var(--ink); }

  .ed-sec-tags { display: inline-flex; flex-wrap: wrap; gap: 6px; }
  .ed-sec-tag { padding: 2px 8px; border-radius: 999px; background: var(--bg-surface-3);
    color: var(--ink-faint); font-size: .68rem; font-weight: 600; font-variant-numeric: tabular-nums;
    white-space: nowrap; }
  .ed-sec-tag.ok { background: var(--status-ok-bg); color: var(--status-ok); }
  .ed-sec-tag.no { background: var(--bg-surface-3); color: var(--ink-faint); }
  .ed-sec-tag.new { background: var(--accent-blue-soft); color: var(--ink); }
  .ed-sec-tag.warn { background: var(--status-warn-bg); color: var(--status-warn-fg); }

  .ed-sec-tools { display: flex; flex-wrap: wrap; gap: 8px 10px; align-items: center;
    margin: 0 0 14px; font-size: .72rem; color: var(--ink-faint); }
  .ed-sec-spacer { flex: 1; }
  .ed-sec-tools button { padding: 4px 10px; border: 1px solid var(--hairline); border-radius: 2px;
    background: transparent; color: var(--ink-faint); font-size: .7rem; cursor: pointer; }
  .ed-sec-tools button:hover { color: var(--ink); border-color: var(--accent-blue); }
  .ed-view-seg { display: inline-flex; }
  .ed-view-seg button { border-radius: 0; border-right-width: 0; }
  .ed-view-seg button:first-child { border-radius: 2px 0 0 2px; }
  .ed-view-seg button:last-child { border-radius: 0 2px 2px 0; border-right-width: 1px; }
  .ed-view-seg button.active { background: var(--accent-blue-soft); color: var(--ink); border-color: var(--accent-blue); }

  /* Czytelna miara i rytm tekstu – dokument, nie zrzut danych. */
  .ed-doc-body { max-width: 74ch; font-size: 1rem; line-height: 1.75; color: var(--ink-muted); }
  .ed-doc-body > * + * { margin-top: 1em; }
  .ed-doc-body h2, .ed-doc-body h3 { color: var(--ink); font-family: var(--font-display); line-height: 1.3; }
  .ed-doc-body h2 { font-size: 1.15rem; margin-top: 1.6em; }
  .ed-doc-body h3 { font-size: 1rem; margin-top: 1.4em; }
  .ed-doc-body ul, .ed-doc-body ol { padding-left: 22px; }
  .ed-doc-body li + li { margin-top: .4em; }
  .ed-doc-body a { color: var(--accent-blue); }

  /* ----- ocena treści ----- */
  .ed-score { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: 18px;
    padding: 18px 20px; border: 1px solid var(--hairline); background: var(--bg-surface-1);
    margin-bottom: 18px; }
  .ed-score-main { display: flex; gap: 22px; align-items: flex-start; }
  .ed-score-dial { --score: 0; position: relative; flex: 0 0 104px; width: 104px; height: 104px;
    display: grid; place-content: center; justify-items: center; border-radius: 50%;
    background: conic-gradient(var(--status-ok) calc(var(--score) * 1%), var(--bg-surface-3) 0); }
  .ed-score-dial::after { content: ''; position: absolute; inset: 9px; border-radius: 50%;
    background: var(--bg-surface-1); }
  .ed-score-dial.warn { background: conic-gradient(var(--status-warn-fg) calc(var(--score) * 1%), var(--bg-surface-3) 0); }
  .ed-score-dial.low { background: conic-gradient(var(--status-err-fg) calc(var(--score) * 1%), var(--bg-surface-3) 0); }
  .ed-score-dial b { position: relative; z-index: 1; font: 600 1.85rem var(--font-display);
    color: var(--ink); font-variant-numeric: tabular-nums; line-height: 1; }
  .ed-score-dial span { position: relative; z-index: 1; font-size: .64rem; color: var(--ink-faint); }
  .ed-score-parts { flex: 1; display: grid; gap: 9px; align-content: center; min-width: 0; }
  .ed-score-part { display: grid; grid-template-columns: minmax(0, 120px) minmax(0, 1fr) 90px;
    gap: 10px; align-items: center; font-size: .76rem; }
  .ed-score-label { color: var(--ink-muted); }
  .ed-score-detail { color: var(--ink-faint); font-variant-numeric: tabular-nums; text-align: right; order: 3; }
  .ed-score-track { height: 6px; border-radius: 2px; background: var(--bg-surface-3); overflow: hidden; }
  .ed-score-track i { display: block; height: 100%; background: var(--status-ok); }
  .ed-score-track i.warn { background: var(--status-warn-fg); }
  .ed-score-track i.low { background: var(--status-err-fg); }
  .ed-score-keywords { border-left: 1px solid var(--hairline-soft); padding-left: 18px; min-width: 0; }
  .ed-score-kwhead { display: flex; flex-wrap: wrap; gap: 4px 12px; align-items: baseline;
    margin-bottom: 10px; }
  .ed-score-kwhead h3 { margin: 0; font: 600 .84rem var(--font-display); }
  .ed-score-kwhead span { font-size: .7rem; color: var(--ink-faint); }
  .ed-score-kwlist { list-style: none; margin: 0; padding: 0; display: grid; gap: 5px;
    max-height: 190px; overflow-y: auto; }
  .ed-kw-legend { margin: 10px 0 0; font-size: .68rem; line-height: 1.6; color: var(--ink-faint); }
  .ed-kw-swatch { display: inline-block; width: 20px; height: 9px; border-radius: 2px;
    margin: 0 4px 0 10px; vertical-align: baseline; }
  .ed-kw-variant { display: block; font-size: .68rem; color: var(--ink-faint); font-style: italic; }
  .ed-kw-swatch.was { background: color-mix(in srgb, var(--status-warn-fg) 32%, transparent); }
  .ed-kw-swatch.new { background: color-mix(in srgb, var(--status-ok) 32%, transparent); }
  .ed-score-kwlist li { display: grid; grid-template-columns: 16px minmax(0, 1fr) auto; gap: 8px;
    align-items: baseline; font-size: .77rem; color: var(--ink-muted); }
  .ed-score-kwlist li.used .ed-kw-mark { color: var(--status-ok); }
  .ed-score-kwlist li.used .ed-kw-name { color: var(--ink); }
  .ed-score-kwlist li.jump { cursor: pointer; border-radius: 2px; }
  .ed-score-kwlist li.jump:hover, .ed-score-kwlist li.jump:focus-visible {
    background: var(--bg-surface-2); outline: none; }
  .ed-score-kwlist li.jump:hover .ed-kw-name { text-decoration: underline; }
  /* Brak frazy w treści – czerwony minus, żeby odróżniał się od zielonego ✓
     jednym rzutem oka, nie samym kształtem. */
  .ed-kw-mark { color: var(--status-err-fg); font-weight: 700; }
  .ed-kw-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .ed-kw-meta { color: var(--ink-faint); font-size: .68rem; font-variant-numeric: tabular-nums; }

  /* ----- pasek formatowania ----- */
  /* ----- raport linków sekcji ----- */
  .ed-linkdiff { margin: 0 0 12px; padding: 8px 12px; border: 1px solid var(--hairline-soft);
    border-radius: 2px; background: var(--bg-surface-2); font-size: .74rem; display: grid; gap: 4px; }
  .ed-linkdiff-head { font-weight: 600; color: var(--ink-muted); font-size: .7rem;
    letter-spacing: .04em; text-transform: uppercase; }
  .ed-linkdiff-row { display: flex; flex-wrap: wrap; gap: 6px; align-items: baseline; min-width: 0; }
  .ed-linkdiff-row b { font-weight: 700; }
  .ed-linkdiff-row.added b { color: var(--status-ok); }
  .ed-linkdiff-row.removed b { color: var(--status-err-fg); }
  .ed-linkdiff-row.removed span { text-decoration: line-through; color: var(--ink-faint); }
  .ed-linkdiff-row a { color: var(--ink-faint); overflow-wrap: anywhere; }
  .ed-linkdiff-row a:hover { color: var(--accent-blue); }

  /* Pasek formatowania pokazuje się dopiero przy edycji (fokus w treści) –
     dziewięć identycznych pasków nad sekcjami to szum, nie narzędzie.
     mousedown na przyciskach ma preventDefault, więc fokus zostaje w treści
     i pasek nie znika w trakcie klikania. */
  .ed-sec-body > .ed-format, .ed-doc-section > .ed-format { display: none; }
  .ed-sec-body:focus-within > .ed-format, .ed-doc-section:focus-within > .ed-format { display: flex; }
  .ed-format { display: flex; flex-wrap: wrap; gap: 4px; margin: 0 0 10px; padding: 5px 6px;
    border: 1px solid var(--hairline); border-radius: 2px; background: var(--bg-surface-2); }
  .ed-format-btn { padding: 4px 9px; border: 1px solid transparent; border-radius: 2px;
    background: transparent; color: var(--ink-muted); font-size: .74rem; cursor: pointer; }
  .ed-format-btn:hover { background: var(--bg-surface-3); color: var(--ink); }
  .ed-format-btn.bold { font-weight: 700; }
  .ed-format-btn.italic { font-style: italic; }

  /* ----- pasek dokumentu ----- */
  .ed-docbar { position: sticky; top: 0; z-index: 3; display: flex; flex-wrap: wrap;
    gap: 12px 24px; justify-content: space-between; align-items: center;
    padding: 10px 16px; border: 1px solid var(--hairline); border-bottom: none;
    background: var(--bg-surface-2); }
  .ed-docstats { display: flex; flex-wrap: wrap; gap: 6px 22px; }
  .ed-docbar-right { display: flex; flex-wrap: wrap; gap: 10px 16px; align-items: center; }
  .ed-decide-all { display: inline-flex; flex-wrap: wrap; gap: 10px; align-items: center;
    font-size: .74rem; color: var(--ink-muted); }
  .ed-decide-all button { padding: 4px 11px; border: 1px solid var(--hairline); border-radius: 2px;
    background: transparent; color: var(--ink-muted); font-size: .72rem; cursor: pointer; }
  .ed-decide-all button:hover { color: var(--ink); border-color: var(--accent-blue); }
  .ed-only-changed { display: inline-flex; gap: 7px; align-items: center; font-size: .74rem;
    color: var(--ink-faint); cursor: pointer; user-select: none; }
  .ed-only-changed input { accent-color: var(--accent-blue); margin: 0; }
  .ed-docstat { display: inline-flex; gap: 6px; align-items: baseline; }
  .ed-docstat b { font: 600 .95rem var(--font-display); color: var(--ink); font-variant-numeric: tabular-nums; }
  .ed-docstat span { font-size: .7rem; color: var(--ink-faint); }

  /* ----- zapis do WordPressa ----- */
  .ed-wp { display: inline-flex; flex-wrap: wrap; gap: 10px; align-items: center; font-size: .74rem; }
  .ed-wp[hidden] { display: none !important; }
  .ed-wp button { padding: 4px 11px; border: 1px solid var(--hairline); border-radius: 2px;
    background: transparent; color: var(--ink-muted); font: inherit; font-size: .72rem; cursor: pointer; }
  .ed-wp button:hover:not(:disabled) { color: var(--ink); border-color: var(--accent-blue); }
  .ed-wp button:disabled { opacity: .45; cursor: default; }
  /* Wdrożenie podmienia treść na żywej stronie – akcent odróżnia je od
     bezpiecznych akcji podglądowych. */
  .ed-wp .ed-wp-apply { border-color: var(--accent-blue); color: var(--accent-blue); }
  .ed-wp .ed-wp-apply:hover:not(:disabled) { background: var(--accent-blue); color: #fff; }
  .ed-wp a { color: var(--accent-blue); font-size: .72rem; text-decoration: none; }
  .ed-wp a:hover { text-decoration: underline; }
  .ed-wp .ed-wp-note { color: var(--ink-faint); font-size: .72rem; max-width: 32ch; }
  .ed-wp .ed-wp-note.is-error { color: var(--status-err-fg); }

  /* ----- podgląd całości ----- */
  .ed-preview-open { padding: 4px 11px; border: 1px solid var(--hairline); border-radius: 2px;
    background: transparent; color: var(--ink-muted); font: inherit; font-size: .72rem; cursor: pointer; }
  .ed-preview-open:hover { color: var(--ink); border-color: var(--accent-blue); }
  .ed-preview { position: fixed; inset: 0; z-index: 40; display: flex; justify-content: center;
    padding: 4vh 16px; background: color-mix(in srgb, #000 42%, transparent); }
  .ed-preview[hidden] { display: none !important; }
  body.ed-preview-lock { overflow: hidden; }
  .ed-preview-panel { display: flex; flex-direction: column; width: min(860px, 100%); max-height: 92vh;
    background: var(--bg-surface-1); border: 1px solid var(--hairline); border-radius: 2px; }
  .ed-preview-head { display: flex; flex-wrap: wrap; gap: 10px 18px; align-items: center;
    justify-content: space-between; padding: 12px 22px; border-bottom: 1px solid var(--hairline); }
  .ed-preview-title { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 12px; }
  .ed-preview-title h3 { margin: 0; font: 600 .95rem var(--font-display); }
  .ed-preview-note { font-size: .74rem; color: var(--ink-faint); }
  .ed-preview-actions { display: flex; flex-wrap: wrap; gap: 8px; }
  .ed-preview-actions button { padding: 4px 11px; border: 1px solid var(--hairline); border-radius: 2px;
    background: transparent; color: var(--ink-muted); font: inherit; font-size: .72rem; cursor: pointer; }
  .ed-preview-actions button:hover { color: var(--ink); border-color: var(--accent-blue); }
  .ed-preview-body { overflow-y: auto; padding: 8px 30px 36px; }
  .ed-preview-body h1 { font-size: 1.45rem; }
  .ed-preview-body img { display: block; max-width: 100%; height: auto; margin: 10px auto; }
  .ed-preview-body figure { margin: 10px 0; }

  /* ----- rozpoznanie SERP ----- */
  .ed-serp { margin: 0 0 18px; padding: 18px 20px 20px; border: 1px solid var(--hairline);
    background: var(--bg-surface-1); }
  .ed-serp-head { display: flex; flex-wrap: wrap; gap: 12px 24px; justify-content: space-between;
    align-items: flex-start; padding-bottom: 14px; border-bottom: 1px solid var(--hairline-soft); }
  .ed-serp-head h3 { margin: 0 0 5px; font: 600 1rem var(--font-display); }
  .ed-serp-title { max-width: 62ch; }
