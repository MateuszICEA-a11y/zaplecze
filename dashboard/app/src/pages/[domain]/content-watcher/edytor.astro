<style is:global>
  /* Dokument, kroki i diff powstają w JavaScripcie, więc nie mają atrybutu
     scope'ującego Astro – te reguły muszą być globalne. */
  /* Elementy chowane atrybutem `hidden` mają własne reguły `display: flex`,
     a te biją wbudowane `[hidden] { display: none }` – stąd sekcje, które
     miały zniknąć, zostawały na ekranie (podsumowanie przy błędzie, pasek
     decyzji, filtr sekcji). */
  .ed-pipebar [hidden], .ed-docbar [hidden], .ed-doc [hidden] { display: none !important; }

  /* Frazy z panelu „Frazy do pokrycia" zaznaczone w treści. Podświetlenia idą
     przez CSS Custom Highlight API (zakresy, nie elementy), więc reguła nie
     może być scope'owana – nie ma tu żadnego elementu do oznaczenia. */
  ::highlight(cw-keyword) {
    background: color-mix(in srgb, var(--accent-blue) 30%, transparent);
    color: var(--ink);
