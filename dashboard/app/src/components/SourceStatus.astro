---
import type { SourceResult } from '../lib/data';

interface Props {
  name: string;
  result?: SourceResult;
}
const { name, result } = Astro.props;

const STATUS_META: Record<string, { label: string; cls: string }> = {
  ok: { label: '', cls: 'ok' },
  token_expired: { label: 'token wygasł', cls: 'warn' },
  error: { label: 'błąd', cls: 'err' },
  not_configured: { label: 'nieskonfigurowane', cls: 'off' },
};
/* Nazwy źródeł z collectora (klucze snapshotu) → nazwy w interfejsie. */
const LABELS: Record<string, string> = {
  senuto: 'Senuto',
  gsc: 'GSC',
  ga4: 'GA4',
  bing: 'Bing',
  ahrefs: 'Ahrefs',
  dataforseo_backlinks: 'DataForSEO',
  clarity: 'Clarity',
  cloudflare_ai: 'Boty AI',
  indexing: 'Indeksacja',
  leads: 'Leady',
  wordpress: 'WordPress',
  smsapi: 'SMSAPI',
  openrouter: 'OpenRouter',
};
const label = LABELS[name] ?? name;
const meta = STATUS_META[result?.status ?? 'not_configured'] ?? STATUS_META.error;
---

<span class="rstat" title={result?.error ?? (meta.label || 'OK')}>
  <span class={`d ${meta.cls}`} aria-hidden="true"></span>
  <span><b>{label}</b>{meta.label ? ` ${meta.label}` : ''}</span>
</span>

<style>
  .rstat {
    gap: 6px;
    padding: 4px 10px 4px 8px;
  }
  .rstat b {
    color: var(--ink);
    font-weight: 500;
  }
</style>
