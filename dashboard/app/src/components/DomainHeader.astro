---
/* Nagłówek strony sekcji: eyebrow z domeną, duży tytuł sekcji (display font),
   chip z datą pomiaru. Nawigacja sekcji żyje w sidebarze (Layout). */
import type { Snapshot } from '../lib/data';
import { DOMAIN_SECTIONS } from '../lib/data';
import { fmtDate } from '../lib/format';

interface Props {
  domain: string;
  name: string;
  active: string; // slug aktywnej sekcji ('' = przegląd)
  latest: Snapshot | null;
  /* Bez działania – przełącznik motywu jest tylko w sidebarze, a eyebrow nie
     przyjmuje koloru źródła (jeden akcent w systemie). Zostają dla zgodności
     wywołań na stronach. */
  themeToggle?: boolean;
  accent?: string;
  measurementLabel?: string;
  measurementStatus?: 'ok' | 'warn';
}
const {
  name,
  active,
  latest,
  measurementLabel,
  measurementStatus = 'ok',
} = Astro.props;

const TITLES: Record<string, string> = {
  '': 'Przegląd',
  senuto: 'Widoczność · Senuto',
  gsc: 'Google Search Console',
  ga4: 'Ruch · Google Analytics 4',
  bing: 'Bing Webmaster Tools',
  ahrefs: 'Profil linków · Ahrefs',
  clarity: 'Zachowania · Clarity',
  'boty-ai': 'Crawlery AI · Cloudflare',
  matrix: 'Matrix · kondycja stron',
  'content-watcher': 'Content Watcher',
  'content-writer': 'Content Writer',
  leady: 'Leady i użycia narzędzi',
};
const title = TITLES[active] ?? DOMAIN_SECTIONS.find((s) => s.slug === active)?.label ?? '';
---

<header class="page-header">
  <div class="eyebrow">{name}</div>
  <div class="title-row">
    <h1>{title}</h1>
    <div class="header-actions">
      <span class:list={['measured', measurementStatus]} title="Data ostatniego przebiegu collectora">
        <i aria-hidden="true"></i>
        {measurementLabel ?? (latest?.date ? fmtDate(latest.date) : 'brak pomiaru')}
      </span>
    </div>
  </div>
</header>


<style>
  .page-header {
    margin-bottom: 6px;
  }
  .eyebrow {
    color: var(--ink-faint);
    font-size: 0.82rem;
    font-weight: 400;
    margin-bottom: 6px;
  }
  .title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }
  h1 {
    font-size: clamp(1.6rem, 2.6vw, 2rem);
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.15;
    margin: 0;
  }
  .header-actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .measured {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--ink-muted);
    font-size: 0.8rem;
    font-variant-numeric: tabular-nums;
    background: var(--bg-surface-1);
    border: 1px solid var(--hairline);
    border-radius: 999px;
    padding: 5px 13px;
  }
  .measured i {
    width: 6px;
    height: 6px;
    border-radius: 1px;
    background: var(--status-ok);
  }
  .measured.warn i {
    background: var(--status-warn-fg);
  }
</style>
