---
/* Karta tabeli: nagłówek + licznik + filtr + CSV, a sama tabela jako AG Grid
   (przestawianie i przypinanie kolumn, sortowanie, filtry w nagłówkach,
   paginacja, zapamiętany układ). Strona renderuje zwykłą <table class="data-table">
   przez <slot /> – ta tabela zostaje w DOM (ukryta) jako model danych, a siatka
   jest jej widokiem: komórki mają ten sam HTML, kliknięcia wracają do
   oryginalnych elementów, zmiany wierszy (np. przełącznik okna w GSC, szuflada
   pod frazą) odświeżają siatkę. Dzięki temu skrypty stron działają bez zmian. */
interface Props {
  title: string;
  meta?: string;
  count?: number;
  filter?: boolean;
  /* Liczba wierszy na stronę (domyślnie 10); 0 = bez paginacji. */
  pageSize?: number;
  empty?: string;
  /* Tabela może dostać wiersze po starcie strony (np. ręczny import CSV). */
  dynamic?: boolean;
}
const { title, meta, count, filter = false, pageSize = 10, empty = 'Brak danych.', dynamic = false } = Astro.props;
const isEmpty = count === 0 && !dynamic;
const hasActions = Astro.slots.has('actions');
---

<section class="table-card" data-page-size={pageSize}>
  <div class="table-head">
    <h3>
      {title}
      {typeof count === 'number' && <span class="table-meta"> · {count.toLocaleString('pl-PL', { useGrouping: 'always' })}</span>}
    </h3>
    {meta && <span class="table-meta">{meta}</span>}
    {hasActions && <slot name="actions" />}
    {!isEmpty && filter && (
      <input class="table-filter" type="search" placeholder="Filtruj…" data-table-filter aria-label={`Filtruj: ${title}`} />
    )}
    {!isEmpty && (
      <span class="table-tools">
        <button type="button" class="table-reset" data-table-reset title="Kolejność, szerokość i przypięcie kolumn wracają do ustawień domyślnych">Przywróć kolumny</button>
        <button type="button" class="table-export" data-table-export title="Pobierz widoczne wiersze jako CSV">CSV ⤓</button>
      </span>
    )}
  </div>
  {
    isEmpty ? (
      <div class="table-empty">{empty}</div>
    ) : (
      <>
        <div class="table-scroll">
          <slot />
        </div>
        <div class="tc-grid" hidden></div>
      </>
    )
  }
</section>

<script>
  import { createGrid, hasGrid } from '../lib/grid';

  type Any = any;

  /* Liczba z komórki: data-sort wygrywa (kolumny bez liczb, np. kropki
     „Potencjał”), inaczej parsowanie pl-PL z tekstu. */
  const numFrom = (cell: HTMLTableCellElement | undefined): number | null => {
    if (!cell) return null;
    if (cell.dataset.sort !== undefined) {
      const v = parseFloat(cell.dataset.sort);
      return Number.isNaN(v) ? null : v;
    }
    const t = (cell.textContent ?? '').replace(/[\s  ]/g, '').replace(',', '.');
    const m = t.match(/-?\d+(?:\.\d+)?/);
    return m ? parseFloat(m[0]) : null;
  };
  const textOf = (el: Element | undefined | null) => (el?.textContent ?? '').replace(/\s+/g, ' ').trim();

  /* Nagłówek z kontrolką (np. ⓘ „Jak liczymy potencjał?”) – oryginalny HTML,
     klik poza kontrolką sortuje kolumnę. */
  class RichHeader {
    gui!: HTMLElement;
    init(params: Any) {
      const gui = document.createElement('div');
      gui.className = `tc-head${params.numeric ? ' num' : ''}`;
      gui.innerHTML = `<span class="tc-head-label">${params.html}</span><span class="tc-sort" aria-hidden="true"></span>`;
      gui.addEventListener('click', (event) => {
        if ((event.target as HTMLElement).closest('button,a,input,select,summary,[data-no-sort]')) return;
        params.progressSort(event.shiftKey);
      });
      const caret = gui.querySelector<HTMLElement>('.tc-sort')!;
      const paint = () => {
        const sort = params.column.getSort();
        caret.textContent = sort === 'asc' ? '↑' : sort === 'desc' ? '↓' : '';
      };
      params.column.addEventListener('sortChanged', paint);
      paint();
      this.gui = gui;
    }
    getGui() { return this.gui; }
    refresh() { return false; }
  }

  /* Biblioteka ładuje się z defer w <head>; gdyby moduł ruszył przed nią,
     czekamy na DOMContentLoaded – wtedy wszystkie odroczone skrypty już są. */
  const start = () => document.querySelectorAll<HTMLElement>('.table-card').forEach(mountCard);
  if (hasGrid()) start();
  else document.addEventListener('DOMContentLoaded', start, { once: true });

  function mountCard(card: HTMLElement, cardIndex: number) {
    const table = card.querySelector<HTMLTableElement>('table.data-table');
    const body = table?.tBodies[0];
    const gridEl = card.querySelector<HTMLElement>('.tc-grid');
    const source = card.querySelector<HTMLElement>('.table-scroll');
    if (!table || !body || !gridEl || !source || !hasGrid()) return;

    const title = textOf(card.querySelector('.table-head h3')?.childNodes[0] as Element) || 'tabela';
    const pageSize = parseInt(card.dataset.pageSize ?? '10', 10);
    const input = card.querySelector<HTMLInputElement>('[data-table-filter]');

    /* Kontener siatki dziedziczy klasy i atrybuty tabeli (np. data-astro-cid),
       żeby style przypięte do tabeli (.data-table .cell-url, .q-table …) działały. */
    gridEl.classList.add(...Array.from(table.classList));
    for (const attr of Array.from(table.attributes)) {
      if (attr.name.startsWith('data-astro-cid')) gridEl.setAttribute(attr.name, attr.value);
    }

    /* ---------- kolumny z <thead>: ostatni wiersz = kolumny, wcześniejszy = grupy ---------- */
    const headRows = Array.from(table.tHead?.rows ?? []);
    const columnRow = headRows[headRows.length - 1];
    const ths = Array.from(columnRow?.cells ?? []);
    const groupOf: { label: string; cls: string }[] = [];
    if (headRows.length > 1) {
      let index = 0;
      for (const th of Array.from(headRows[0].cells)) {
        for (let k = 0; k < th.colSpan; k += 1) groupOf[index++] = { label: textOf(th), cls: th.className };
      }
    }
    /* Szerokości z danych: kolumna z najdłuższym tekstem (albo td.grow) dostaje
       najwięcej miejsca, pozostałe minimum wg nagłówka i typowej treści. */
    const sample = Array.from(body.rows).filter((tr) => tr.cells.length === ths.length).slice(0, 40);
    const avgLen = ths.map((_, i) => sample.reduce((sum, tr) => sum + textOf(tr.cells[i]).length, 0) / Math.max(1, sample.length));
    const growIndex = (() => {
      const marked = ths.findIndex((_, i) => sample[0]?.cells[i]?.classList.contains('grow'));
      if (marked >= 0) return marked;
      return avgLen.indexOf(Math.max(...avgLen));
    })();
    const columns = ths.map((th, i) => {
      const numeric = th.classList.contains('num');
      const rich = Boolean(th.querySelector('button,a,[popovertarget]'));
      const label = textOf(th);
      const def: Any = {
        colId: `c${i}`,
        headerName: label,
        headerTooltip: th.title || undefined,
        headerClass: numeric ? `${th.className} ag-right-aligned-header` : th.className,
        valueGetter: (p: Any) => {
          const td = p.data?.[`c${i}`];
          if (!td) return null;
          return numeric ? numFrom(td) : textOf(td);
        },
        getQuickFilterText: (p: Any) => textOf(p.data?.[`c${i}`]),
        filter: numeric ? 'agNumberColumnFilter' : 'agTextColumnFilter',
        comparator: numeric ? undefined : (a: string, b: string) => String(a ?? '').localeCompare(String(b ?? ''), 'pl'),
        cellRenderer: (p: Any) => {
          const td = p.data?.[`c${i}`] as HTMLTableCellElement | undefined;
          const wrap = document.createElement('div');
          wrap.className = `tc-c ${td?.className ?? ''}${numeric ? ' tc-num' : ''}`;
          if (td) {
            for (const attr of Array.from(td.attributes)) {
              if (attr.name !== 'class' && attr.name !== 'colspan') wrap.setAttribute(attr.name, attr.value);
            }
            wrap.innerHTML = td.innerHTML;
          }
          return wrap;
        },
        cellClass: numeric ? 'tc-cell tc-cell-num' : 'tc-cell',
        type: numeric ? 'rightAligned' : undefined,
        // Liczby jak w dawnej tabeli: pierwszy klik = od największej.
        sortingOrder: numeric ? ['desc', 'asc', null] : ['asc', 'desc', null],
        flex: i === growIndex ? 3 : 1,
        minWidth: i === growIndex ? 260 : Math.max(96, Math.min(240, Math.max(label.length * 8 + 56, avgLen[i] * 6.5 + 24))),
        // Wysokość wiersza wg treści – komórki bywają wielowierszowe (Content Watcher).
        autoHeight: true,
      };
      if (rich) {
        def.headerComponent = RichHeader;
        def.headerComponentParams = { html: th.innerHTML, numeric };
      }
      return def;
    });
    // Kolejne kolumny z tą samą grupą (Matrix: Senuto / GSC / GA4) → grupa kolumn.
    const columnDefs: Any[] = [];
    columns.forEach((def, i) => {
      const group = groupOf[i];
      if (!group?.label) {
        columnDefs.push(def);
        return;
      }
      const last = columnDefs[columnDefs.length - 1];
      if (last?.children && last.headerName === group.label) last.children.push(def);
      else columnDefs.push({ headerName: group.label, headerClass: `tc-group ${group.cls}`, children: [def] });
    });

    /* ---------- wiersze z <tbody>: wiersz z jedną komórką na całą szerokość =
       szuflada poprzedniego wiersza (GSC) → wiersz pełnej szerokości ---------- */
    const ids = new WeakMap<HTMLTableRowElement, string>();
    let seq = 0;
    const idOf = (tr: HTMLTableRowElement) => {
      let id = ids.get(tr);
      if (!id) {
        id = `r${(seq += 1)}`;
        ids.set(tr, id);
      }
      return id;
    };
    const readRows = () => {
      const rows: Any[] = [];
      let parent: Any = null;
      for (const tr of Array.from(body.rows)) {
        const full = tr.cells.length === 1 && tr.cells[0].colSpan > 1;
        if (full) {
          if (parent) rows.push({ _id: idOf(tr), _tr: tr, _full: true, _parent: parent });
          continue;
        }
        const row: Any = { _id: idOf(tr), _tr: tr };
        Array.from(tr.cells).forEach((td, i) => { row[`c${i}`] = td; });
        rows.push(row);
        parent = row;
      }
      return rows;
    };
    // Sonda z klasą wiersza źródłowego (np. .q-drawer) – style szuflady są do niej przypięte.
    const fullHeight = (td: HTMLTableCellElement) => {
      const probe = document.createElement('div');
      probe.className = `tc-full ${td.parentElement?.className ?? ''}`;
      probe.style.cssText = `position:absolute;visibility:hidden;left:0;top:0;height:auto;width:${gridEl.clientWidth || 800}px`;
      probe.innerHTML = td.innerHTML;
      gridEl.appendChild(probe);
      const height = probe.offsetHeight;
      probe.remove();
      return Math.max(46, height);
    };

    /* Zewnętrzny predykat wierszy (karty TOP 3/10/50, kafle Content Watchera):
       strona dispatchuje CustomEvent('tablecard:refilter', {detail: fn|null}). */
    let rowPredicate: ((row: HTMLTableRowElement) => boolean) | null = null;

    const stateKey = `${location.pathname.replace(/^\/[^/]+/, '')}#${cardIndex}:${title}`;
    const { grid, resetLayout } = createGrid(gridEl, {
      columnDefs,
      rowData: readRows(),
      getRowId: (p: Any) => p.data._id,
      pagination: pageSize > 0,
      paginationPageSize: pageSize > 0 ? pageSize : 25,
      popupParent: document.body,
      isFullWidthRow: (p: Any) => Boolean(p.rowNode.data?._full),
      fullWidthCellRenderer: (p: Any) => {
        const wrap = document.createElement('div');
        wrap.className = 'tc-full';
        wrap.innerHTML = p.data._tr.cells[0].innerHTML;
        return wrap;
      },
      getRowHeight: (p: Any) => (p.data?._full ? fullHeight(p.data._tr.cells[0]) : undefined),
      getRowClass: (p: Any) => (p.data?._tr?.className ? `tc-row ${p.data._tr.className}` : 'tc-row'),
      // Szuflada zawsze tuż pod swoim wierszem, niezależnie od sortowania.
      postSortRows: (params: Any) => {
        const nodes = params.nodes as Any[];
        const drawers = nodes.filter((node) => node.data?._full);
        if (!drawers.length) return;
        const ordered: Any[] = [];
        for (const node of nodes) {
          if (node.data?._full) continue;
          ordered.push(node);
          for (const drawer of drawers) if (drawer.data._parent === node.data) ordered.push(drawer);
        }
        nodes.splice(0, nodes.length, ...ordered);
      },
      isExternalFilterPresent: () => rowPredicate !== null,
      doesExternalFilterPass: (node: Any) => {
        if (!rowPredicate) return true;
        return rowPredicate(node.data._full ? node.data._parent._tr : node.data._tr);
      },
    }, stateKey);

    source.hidden = true;
    gridEl.hidden = false;

    /* Kliknięcie w siatce → ten sam element w oryginalnym wierszu (okno
       szczegółów w Content Watcherze, szuflada w GSC). Linki działają natywnie. */
    gridEl.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;
      if (target.closest('a[href],[popovertarget],.ag-header,.ag-paging-panel,.ag-floating-filter')) return;
      const rowEl = target.closest<HTMLElement>('.ag-row');
      const node = rowEl ? grid.getRowNode(rowEl.getAttribute('row-id')) : null;
      if (!node?.data) return;
      const root = target.closest<HTMLElement>('.tc-c, .tc-full');
      let origin: Element | undefined;
      if (root?.classList.contains('tc-full')) origin = node.data._tr.cells[0];
      else if (root) origin = node.data[target.closest('.ag-cell')?.getAttribute('col-id') ?? ''];
      origin ??= node.data._tr.cells[0] ?? node.data._tr;
      let hit: Element = origin!;
      if (root) {
        const path: number[] = [];
        for (let el: HTMLElement | null = target; el && el !== root; el = el.parentElement) {
          path.unshift(Array.prototype.indexOf.call(el.parentElement?.children ?? [], el));
        }
        for (const index of path) hit = hit.children[index] ?? hit;
      }
      hit.dispatchEvent(new MouseEvent('click', { bubbles: true, cancelable: true }));
    });

    /* Oryginał się zmienił (nowe wiersze, szuflada, podmiana okna) → nowe dane. */
    let queued = false;
    new MutationObserver(() => {
      if (queued) return;
      queued = true;
      queueMicrotask(() => {
        queued = false;
        grid.setGridOption('rowData', readRows());
        grid.resetRowHeights();
      });
    }).observe(body, { childList: true, subtree: true, characterData: true });

    card.addEventListener('tablecard:refilter', (event) => {
      rowPredicate = (event as CustomEvent).detail ?? null;
      grid.onFilterChanged();
    });
    card.addEventListener('tablecard:rows-changed', () => {
      rowPredicate = null;
      grid.setGridOption('rowData', readRows());
    });
    input?.addEventListener('input', () => grid.setGridOption('quickFilterText', input.value));
    card.querySelector('[data-table-reset]')?.addEventListener('click', resetLayout);

    /* CSV: bieżący widok siatki (filtry, predykat, sortowanie), wszystkie strony.
       Separator ';' + BOM = przyjazne polskiemu Excelowi. */
    card.querySelector('[data-table-export]')?.addEventListener('click', () => {
      const cell = (text: string) => (/[";\n]/.test(text) ? `"${text.replace(/"/g, '""')}"` : text);
      const shown = grid.getAllDisplayedColumns().filter((column: Any) => /^c\d+$/.test(column.getColId()));
      const header = shown.map((column: Any) => cell(ths[Number(column.getColId().slice(1))] ? textOf(ths[Number(column.getColId().slice(1))]) : '')).join(';');
      const lines: string[] = [];
      grid.forEachNodeAfterFilterAndSort((node: Any) => {
        if (node.data?._full) return;
        lines.push(shown.map((column: Any) => cell(textOf(node.data[column.getColId()]))).join(';'));
      });
      const slug = title.toLowerCase().replace(/[^a-z0-9ąćęłńóśźż]+/gi, '-').replace(/^-|-$/g, '');
      const blob = new Blob(['﻿' + header + '\n' + lines.join('\n')], { type: 'text/csv;charset=utf-8' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = `${slug}-${new Date().toISOString().slice(0, 10)}.csv`;
      a.click();
      URL.revokeObjectURL(a.href);
    });
  }
</script>

<script>
  /* Info-badge: kliknięcie rozwija/zwija dymek, kliknięcie poza zamyka. */
  document.addEventListener('click', (e) => {
    const badge = (e.target as HTMLElement).closest('.info-badge');
    if (badge) {
      e.stopPropagation();
      const wasOpen = badge.classList.contains('open');
      document.querySelectorAll('.info-badge.open').forEach((b) => b.classList.remove('open'));
      if (!wasOpen) badge.classList.add('open');
    } else {
      document.querySelectorAll('.info-badge.open').forEach((b) => b.classList.remove('open'));
    }
  });
</script>

<style is:global>
  .table-card .tc-grid { border-top: 1px solid var(--hairline); }
  .table-card .tc-grid[hidden],
  .table-card .table-scroll[hidden] { display: none; }
  .table-tools { display: inline-flex; align-items: center; gap: 10px; }
  .table-reset {
    border: 0;
    background: none;
    color: var(--ink-faint);
    font: inherit;
    font-size: 0.82rem;
    cursor: pointer;
  }
  .table-reset:hover { color: var(--ink); }
  /* Komórka = oryginalny HTML <td>, wyśrodkowany w pionie. */
  .tc-grid .tc-cell { display: flex; align-items: center; }
  .tc-grid .tc-cell .ag-cell-wrapper,
  .tc-grid .tc-cell .ag-cell-value { flex: 1 1 auto; width: 100%; min-width: 0; }
  /* Wrapper = zwykły przepływ blokowy jak w <td> (komórki bywają wielowierszowe). */
  .tc-grid .tc-c { display: block; width: 100%; min-width: 0; padding: 12px 0; box-sizing: border-box; overflow: hidden; line-height: 1.4; white-space: normal; }
  .tc-grid .tc-c.tc-num { text-align: right; font-variant-numeric: tabular-nums; }
  .tc-grid .tc-c a { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .tc-grid .ag-row.q-row { cursor: pointer; }
  .tc-grid .tc-full { padding: 12px 18px; box-sizing: border-box; background: var(--bg-surface-2); height: 100%; }
  .tc-grid .tc-head { display: flex; align-items: center; gap: 6px; width: 100%; cursor: pointer; }
  .tc-grid .tc-head.num { justify-content: flex-end; }
  .tc-grid .tc-head-label { display: inline-flex; align-items: center; gap: 6px; }
  .tc-grid .tc-group { font-weight: 500; }
</style>
