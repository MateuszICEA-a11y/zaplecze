---
/**
 * Layout podglądu kierunku D „Instrument”.
 *
 * Daje nawigację, stopkę i przełącznik człowiek/maszyna. Treść widoku
 * maszynowego strona przekazuje w slocie `machine` – to ma być markdown
 * odpowiadający temu, co widzi człowiek, a nie osobny tekst marketingowy.
 *
 * Wszystkie strony podglądu są noindex i wykluczone z sitemapy
 * (filtr w astro.config.mjs).
 */
import '@fontsource-variable/fraunces';
import '@fontsource-variable/fraunces/wght-italic.css';
import '@fontsource/geist-mono/400.css';
import '../styles/kierunek-d.css';
import Layout from './Layout.astro';

interface Props {
  title: string;
  description?: string;
  /** Ścieżka podglądu do podświetlenia w nawigacji */
  current?: string;
}

const { title, description, current } = Astro.props;
const base = '/podglad/kierunek-d';

const nav = [
  { href: `${base}/oferta/`, label: 'pozycjonowanie ai', key: 'oferta' },
  { href: `${base}/narzedzia/`, label: 'narzędzia', key: 'narzedzia' },
  { href: `${base}/blog/`, label: 'magazyn', key: 'blog' },
  { href: `${base}/kontakt/`, label: 'kontakt', key: 'kontakt' },
];
---

<Layout title={title} description={description} noindex={true}>
  <div class="kd">
    <header class="kd-nav">
      <a class="kd-brand" href={`${base}/`}>widocznosc.ai <span>by ICEA</span></a>
      <nav class="kd-nav-links">
        {
          nav.map((n) => (
            <a href={n.href} aria-current={current === n.key ? 'page' : undefined}>
              {n.label}
            </a>
          ))
        }
      </nav>
      <a class="kd-btn kd-btn-sm" href={`${base}/narzedzia/`}>Sprawdź markę</a>
    </header>

    <div class="kd-human">
      <slot />
    </div>

    <footer class="kd-footer kd-human">
      <div class="kd-footer-grid">
        <div>
          <h2>widocznosc.ai</h2>
          <p>
            Pozycjonowanie marek w wyszukiwarkach AI.<br />
            Marka ICEA S.A., Szyperska 14, Poznań.
          </p>
        </div>
        <div>
          <h2>Usługi</h2>
          <a href={`${base}/oferta/`}>Pozycjonowanie pod LLM</a>
          <a href={`${base}/oferta/`}>Audyt widoczności w AI</a>
          <a href={`${base}/oferta/`}>Monitoring cytowań</a>
        </div>
        <div>
          <h2>Zasoby</h2>
          <a href={`${base}/blog/`}>Magazyn</a>
          <a href={`${base}/narzedzia/`}>Narzędzia</a>
        </div>
        <div>
          <h2>Kontakt</h2>
          <a href={`${base}/kontakt/`}>Formularz</a>
          <a href="https://www.linkedin.com/company/icea-group">LinkedIn</a>
        </div>
      </div>
    </footer>

    <div class="kd-toggle" role="group" aria-label="Widok strony">
      <button type="button" data-view="human" class="is-on">człowiek</button>
      <span aria-hidden="true">/</span>
      <button type="button" data-view="machine">maszyna</button>
    </div>

    <div class="kd-machine" hidden>
      <button type="button" class="kd-copy">Kopiuj stronę</button>
      <pre><code><slot name="machine" /></code></pre>
    </div>
  </div>
</Layout>

<script>
  function boot() {
    const root = document.querySelector<HTMLElement>('.kd');
    if (!root) return;
    const machine = root.querySelector<HTMLElement>('.kd-machine');
    const buttons = root.querySelectorAll<HTMLButtonElement>('.kd-toggle button');
    const human = root.querySelectorAll<HTMLElement>('.kd-human');

    buttons.forEach((b) =>
      b.addEventListener('click', () => {
        const machineOn = b.dataset.view === 'machine';
        buttons.forEach((x) => x.classList.toggle('is-on', x === b));
        human.forEach((el) => (el.hidden = machineOn));
        if (machine) machine.hidden = !machineOn;
      }),
    );

    const copy = root.querySelector<HTMLButtonElement>('.kd-copy');
    const pre = root.querySelector('.kd-machine code');
    copy?.addEventListener('click', async () => {
      if (!pre) return;
      await navigator.clipboard.writeText(pre.textContent || '');
      const prev = copy.textContent;
      copy.textContent = 'Skopiowano';
      setTimeout(() => (copy.textContent = prev), 1600);
    });
  }

  boot();
  document.addEventListener('astro:page-load', boot);
</script>
