---
/**
 * Process – redesign 2026-09. Cztery etapy jako numerowana siatka
 * na liniach (bez kolorowych kart). Dużo przestrzeni, jeden kolor.
 */

interface Step {
  num: string;
  title: string;
  body: string;
  list: string[];
}

const steps: Step[] = [
  {
    num: '01',
    title: 'Mapa pytań',
    body: 'Tworzymy 32–48 zapytań z trzech warstw: brandowych, ogólnych i porównawczych. Lista wynika z Twojej kategorii, nie z generatora.',
    list: [
      'Spotkanie strategiczne',
      'Analiza intencji kupujących',
      'Lista konkurentów do benchmarku',
    ],
  },
  {
    num: '02',
    title: 'Test pięciu silników AI',
    body: 'Zapytania trafiają równolegle do ChatGPT, Claude, Gemini, Perplexity i Copilota. Świeże sesje, bez personalizacji.',
    list: ['Standaryzacja promptów', 'Wielokrotne sesje', 'Pomiar wariancji odpowiedzi'],
  },
  {
    num: '03',
    title: 'Audyt techniczny i treści',
    body: 'Struktura, schema, llms.txt i dane źródłowe. Mapujemy luki w treści pod pytania, które ludzie zadają AI.',
    list: ['Schema i semantyka', 'Dostęp botów AI', 'Mapowanie luk treści'],
  },
  {
    num: '04',
    title: 'Raport i plan',
    body: 'Pokazujemy, gdzie marka jest dziś, gdzie może być za pół roku i jakie kroki tam prowadzą. Co dalej, decydujesz sam.',
    list: ['Warsztat z omówieniem wyników', 'Strategia widoczności', 'Briefy na treści'],
  },
];
---

<section class="process-section" id="proces" aria-labelledby="process-title">
  <div class="container">
    <header class="section-head">
      <div class="head-left">
        <div class="head-meta">
          <span class="eyebrow">Jak pracujemy</span>
        </div>
        <h2 id="process-title" class="display-xl">
          Cztery etapy. Każdy z&nbsp;mierzalnym wynikiem.
        </h2>
      </div>
      <div class="head-right">
        <p class="subhead">
          Najpierw pomiar, potem rekomendacje. Po audycie wiesz, gdzie Twoja marka jest
          w&nbsp;wyszukiwarkach AI i&nbsp;co konkretnie zmienić w&nbsp;pierwszej kolejności.
        </p>
      </div>
    </header>

    <ol class="process-grid">
      {
        steps.map((step) => (
          <li class="process-step">
            <span class="process-num">{step.num}</span>
            <h3 class="process-title">{step.title}</h3>
            <p class="process-body">{step.body}</p>
            <ul class="process-list">
              {step.list.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .process-section {
    padding: 96px 0;
    background: var(--bg-canvas);
    border-top: 1px solid var(--hairline-soft);
  }

  @media (min-width: 980px) {
    .process-section {
      padding: 128px 0;
    }
  }

  .process-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    border-top: 1px solid var(--hairline);
  }

  @media (min-width: 720px) {
    .process-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1100px) {
    .process-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .process-step {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 32px 0;
    border-bottom: 1px solid var(--hairline);
  }

  @media (min-width: 720px) {
    .process-step {
      padding: 36px 28px 36px 0;
    }
    .process-step:nth-child(even) {
      padding-left: 28px;
      border-left: 1px solid var(--hairline);
    }
  }

  @media (min-width: 1100px) {
    .process-step {
      padding: 40px 28px 40px 0;
      border-bottom: 0;
    }
    .process-step:nth-child(even) {
      padding-left: 0;
      border-left: 0;
    }
    .process-step + .process-step {
      padding-left: 28px;
      border-left: 1px solid var(--hairline);
    }
  }

  .process-num {
    font-family: var(--font-display);
    font-size: 48px;
    font-weight: 600;
    letter-spacing: -0.05em;
    line-height: 1;
    color: var(--ink-faint);
    font-variant-numeric: tabular-nums;
  }

  .process-title {
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.12;
    color: var(--ink);
    margin: 0;
  }

  .process-body {
    font-size: 14px;
    color: var(--ink-muted);
    line-height: 1.5;
    margin: 0;
  }

  .process-list {
    list-style: none;
    margin: auto 0 0;
    padding: 12px 0 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 13px;
    color: var(--ink);
    border-top: 1px solid var(--hairline-soft);
  }

  .process-list li {
    display: flex;
    gap: 10px;
    align-items: baseline;
  }

  .process-list li::before {
    content: '';
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--ink-faint);
    flex-shrink: 0;
    transform: translateY(-2px);
  }
</style>
