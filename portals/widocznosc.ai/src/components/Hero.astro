---
/**
 * Hero – kierunek A „Raport w ramce” (wybrany 2026-09-02).
 * Split: nagłówek + formularz testu marki po lewej, raport narzędzia
 * brand-check w ramce przeglądarki po prawej (wychodzi poza kontener).
 * Formularz to GET na /narzedzia/brand-check/ (?brand=&domain=).
 * Ref. 21st: Hero with Dashboard Mockup; Dayos: produkt na pierwszym ekranie.
 */
import ReportMock from './ReportMock.astro';
---

<section class="hero-section" id="home">
  <div class="hero-grid container">
    <div class="hero-copy">
      <span class="eyebrow">Pomiar widoczności marki w&nbsp;AI</span>
      <h1 class="display-xxl hero-headline">Sprawdź, czy AI poleca Twoją markę.</h1>
      <p class="hero-lead hero-sub">
        Odpytujemy ChatGPT, Claude, Gemini i&nbsp;Perplexity o&nbsp;Twoją firmę i&nbsp;pokazujemy,
        co odpowiadają: czy znają markę, jak o&nbsp;niej mówią i&nbsp;kogo polecają zamiast Ciebie.
        Wynik w&nbsp;około minutę, bez rejestracji.
      </p>
      <form class="hero-form" action="/narzedzia/brand-check/" method="get">
        <label class="hero-field">
          <span class="sr-only">Nazwa marki</span>
          <input
            type="text"
            name="brand"
            placeholder="Nazwa marki"
            autocomplete="organization"
            maxlength="80"
          />
        </label>
        <label class="hero-field">
          <span class="sr-only">Domena</span>
          <input
            type="text"
            name="domain"
            placeholder="twojadomena.pl"
            autocomplete="url"
            spellcheck="false"
            inputmode="url"
            required
            maxlength="200"
          />
        </label>
        <button type="submit" class="btn-primary hero-submit">
          Sprawdź widoczność marki <span aria-hidden="true">→</span>
        </button>
      </form>
      <p class="hero-note">
        <a href="/kontakt/?type=konsultacja">Porozmawiaj z&nbsp;ekspertem ICEA</a>
        <span aria-hidden="true">·</span>
        <span class="hero-by">widocznosc.ai by ICEA</span>
      </p>
    </div>

    <div class="hero-product">
      <ReportMock frame compact />
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    background: var(--bg-canvas);
    padding: 112px 0 72px;
    overflow: hidden;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 44px;
    align-items: center;
  }

  @media (min-width: 1024px) {
    .hero-section {
      padding: 152px 0 96px;
    }
    .hero-grid {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      gap: 56px;
    }
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 26px;
  }

  .hero-headline {
    margin: 0;
    max-width: 11ch;
    text-wrap: balance;
  }

  .hero-sub {
    max-width: 46ch;
    color: var(--ink-muted);
  }

  .hero-form {
    display: grid;
    grid-template-columns: 1fr;
    gap: 8px;
    width: 100%;
    max-width: 460px;
  }

  .hero-field {
    display: block;
  }

  .hero-field input {
    width: 100%;
    min-height: 46px;
    padding: 10px 16px;
    background: var(--bg-surface-1);
    color: var(--ink);
    font-family: var(--font-sans);
    font-size: 15px;
    letter-spacing: -0.01em;
    border: 1px solid var(--hairline);
    border-radius: var(--r-md);
    outline: none;
    transition: border-color 0.15s ease;
  }

  .hero-field input::placeholder {
    color: var(--ink-faint);
  }

  .hero-field input:focus-visible {
    border-color: var(--ink-faint);
    box-shadow: var(--shadow-l3);
  }

  .hero-submit {
    min-height: 46px;
    border-radius: var(--r-md);
  }

  .hero-note {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    color: var(--ink-faint);
  }

  .hero-note a {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--hairline);
  }

  .hero-note a:hover {
    text-decoration-color: currentColor;
  }

  .hero-by {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 11px;
  }

  .hero-product {
    min-width: 0;
  }

  /* Na szerokich ekranach raport wychodzi poza kontener – produkt dominuje */
  @media (min-width: 1280px) {
    .hero-product {
      width: calc(100% + 120px);
    }
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 639px) {
    .hero-section {
      padding: 96px 0 56px;
    }
    .hero-headline {
      max-width: 100%;
    }
    .hero-form {
      max-width: 100%;
    }
    .hero-note {
      flex-wrap: wrap;
    }
  }
</style>
