---
/**
 * CTABand / Final CTA – redesign 2026-09.
 * Jedna główna akcja w serwisie: „Sprawdź widoczność swojej marki”.
 * Druga, cichsza: „Porozmawiaj z ekspertem ICEA”. Bez orba i gradientów;
 * po prawej ICEA jako gwarant kompetencji.
 */

interface Props {
  eyebrow?: string;
  title?: string;
  titleHtml?: string;
  subtitle?: string;
  primaryLabel?: string;
  primaryHref?: string;
  ghostLabel?: string;
  ghostHref?: string;
  rightLabel?: string;
  quote?: string;
  author?: string;
  meta?: string[];
  compactTop?: boolean;
}

const {
  eyebrow = 'Następny krok',
  title,
  titleHtml = 'Sprawdź widoczność swojej marki w&nbsp;AI.',
  subtitle = 'Test trwa około minuty i&nbsp;nie wymaga rejestracji. Jeśli wynik pokaże luki, omówisz go z&nbsp;ekspertem ICEA na bezpłatnej, 30&#8209;minutowej konsultacji.',
  primaryLabel = 'Sprawdź widoczność marki',
  primaryHref = '/narzedzia/brand-check/',
  ghostLabel = 'Porozmawiaj z ekspertem ICEA',
  ghostHref = '/kontakt/?type=konsultacja',
  rightLabel = 'widocznosc.ai by ICEA',
  quote = 'Za pomiarem stoi zespół ICEA: ponad 15 lat pracy nad widocznością marek w&nbsp;wyszukiwarkach i&nbsp;500+ wdrożonych projektów SEO.',
  author = 'ICEA S.A. · Poznań',
  meta = ['Bez rejestracji', 'Wynik w ok. 60 s', 'Konsultacja bez zobowiązań'],
  compactTop = false,
} = Astro.props;
---

<section
  class:list={['final-cta-section', { 'final-cta-section--compact-top': compactTop }]}
  id="cta"
  aria-labelledby="final-cta-title"
>
  <div class="container">
    <div class="final-cta-card">
      <div class="final-cta-left">
        <span class="eyebrow">{eyebrow}</span>
        <h2 id="final-cta-title" class="display-xl">
          {title ? title : <Fragment set:html={titleHtml} />}
        </h2>
        <p class="subhead final-cta-sub" set:html={subtitle} />
        <div class="final-cta-actions">
          <a class="btn-primary" href={primaryHref}>
            {primaryLabel}
            <span aria-hidden="true">→</span>
          </a>
          <a class="btn-secondary" href={ghostHref}>
            {ghostLabel}
          </a>
        </div>
        <p class="final-cta-meta">
          {meta.map((item) => <span>{item}</span>)}
        </p>
      </div>

      <aside class="final-cta-right">
        <span class="final-cta-label">{rightLabel}</span>
        <p class="final-cta-quote" set:html={quote} />
        <span class="final-cta-author" set:html={author} />
      </aside>
    </div>
  </div>
</section>

<style>
  .final-cta-section {
    padding: 96px 0;
    background: var(--bg-canvas);
    border-top: 1px solid var(--hairline-soft);
  }

  @media (min-width: 980px) {
    .final-cta-section {
      padding: 128px 0;
    }
  }

  .final-cta-section--compact-top {
    padding-top: 40px;
  }

  @media (min-width: 980px) {
    .final-cta-section--compact-top {
      padding-top: 56px;
    }
  }

  .final-cta-card {
    background: var(--bg-surface-1);
    border: 1px solid var(--hairline);
    border-radius: var(--r-xl);
    padding: 44px 28px;
    display: grid;
    grid-template-columns: 1fr;
    align-items: end;
    gap: 40px;
  }

  @media (min-width: 980px) {
    .final-cta-card {
      grid-template-columns: 1.5fr 1fr;
      padding: 72px 64px;
      gap: 64px;
    }
  }

  .final-cta-left {
    display: flex;
    flex-direction: column;
    gap: 24px;
    max-width: 620px;
  }

  .final-cta-sub {
    color: var(--ink-muted);
    max-width: 520px;
  }

  .final-cta-actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .final-cta-meta {
    font-size: 12px;
    color: var(--ink-faint);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin: 0;
  }

  .final-cta-meta span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .final-cta-meta span::before {
    content: '·';
    color: var(--ink-faint);
  }

  .final-cta-meta span:first-child::before {
    display: none;
  }

  .final-cta-right {
    display: flex;
    flex-direction: column;
    gap: 10px;
    align-items: flex-start;
    font-size: 13px;
    color: var(--ink-muted);
    padding-top: 28px;
    border-top: 1px solid var(--hairline);
  }

  @media (min-width: 980px) {
    .final-cta-right {
      padding-top: 0;
      padding-left: 40px;
      border-top: 0;
      border-left: 1px solid var(--hairline);
      align-self: stretch;
      justify-content: flex-end;
    }
  }

  .final-cta-label {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink);
  }

  .final-cta-quote {
    font-family: var(--font-display);
    font-size: 20px;
    letter-spacing: -0.02em;
    line-height: 1.3;
    color: var(--ink);
    font-weight: 500;
    margin: 0;
    text-wrap: pretty;
  }

  .final-cta-author {
    font-size: 12px;
    color: var(--ink-faint);
    margin-top: 6px;
  }
</style>
