---
/**
 * Industries – redesign 2026-09. Sześć branż jako lista na liniach
 * w dwóch kolumnach, bez kolorowych kropek i kart.
 */

interface Industry {
  name: string;
  desc: string;
}

const industries: Industry[] = [
  {
    name: 'B2B SaaS i Tech',
    desc: 'Decydent pyta ChatGPT o „najlepsze narzędzie X dla zespołu Y”. Chcesz być w tej odpowiedzi.',
  },
  {
    name: 'Finanse i Prawo',
    desc: 'AI bywa pierwszym doradcą klienta. Wzmianka w odpowiedzi to rozmowa z kimś, kto już wie, czego szuka.',
  },
  {
    name: 'Medycyna i Zdrowie',
    desc: 'Pacjenci pytają AI o objawy, leki i miejsca leczenia, zanim otworzą klasyczną wyszukiwarkę.',
  },
  {
    name: 'E-commerce i DTC',
    desc: 'Pytania porównawcze: „X vs Y”, „tańszy zamiennik Z”. Użytkownik jest w końcowej fazie wyboru.',
  },
  {
    name: 'Edukacja i Szkolenia',
    desc: 'Kursanci pytają AI o „najlepszy kurs X” miesiące przed zapisem. Długa droga, wiele punktów styku.',
  },
  {
    name: 'Usługi B2B',
    desc: 'Konsulting, agencje, software house’y. Klient pyta AI o polecanych dostawców przed pierwszym mailem.',
  },
];
---

<section class="industries-section" id="branze" aria-labelledby="industries-title">
  <div class="container">
    <header class="section-head">
      <div class="head-left">
        <div class="head-meta">
          <span class="eyebrow">Dla kogo</span>
        </div>
        <h2 id="industries-title" class="display-xl">
          Branże, w&nbsp;których klient zaczyna od pytania do&nbsp;AI
        </h2>
      </div>
      <div class="head-right">
        <p class="subhead">
          Tam, gdzie decyzja zakupowa wymaga rozeznania, wyszukiwarki AI mają dziś największy wpływ.
          To branże, w&nbsp;których widzimy najwięcej danych, nie jedyne, z&nbsp;którymi pracujemy.
        </p>
      </div>
    </header>

    <ul class="industries-list">
      {
        industries.map((it, i) => (
          <li class="industry-row">
            <span class="industry-idx">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3 class="industry-name">{it.name}</h3>
              <p class="industry-desc">{it.desc}</p>
            </div>
          </li>
        ))
      }
    </ul>

    <p class="process-footer">
      Twojej branży nie ma na liście? <a href="/kontakt/">Sprawdzimy potencjał →</a>
    </p>
  </div>
</section>

<style>
  .industries-section {
    padding: 96px 0;
    background: var(--bg-canvas);
    border-top: 1px solid var(--hairline-soft);
  }

  @media (min-width: 980px) {
    .industries-section {
      padding: 128px 0;
    }
  }

  .industries-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0 64px;
    border-top: 1px solid var(--hairline);
  }

  @media (min-width: 820px) {
    .industries-list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .industry-row {
    display: grid;
    grid-template-columns: 36px 1fr;
    gap: 16px;
    padding: 26px 0;
    border-bottom: 1px solid var(--hairline);
  }

  .industry-idx {
    font-family: ui-monospace, 'JetBrains Mono', monospace;
    font-size: 12px;
    color: var(--ink-faint);
    padding-top: 6px;
  }

  .industry-name {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.025em;
    color: var(--ink);
    margin: 0 0 8px;
    line-height: 1.15;
  }

  .industry-desc {
    font-size: 14px;
    color: var(--ink-muted);
    line-height: 1.5;
    margin: 0;
    max-width: 48ch;
  }
</style>
