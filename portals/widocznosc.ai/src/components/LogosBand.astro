---
/**
 * LogosBand – pasek logotypów silników AI w monochromie
 * (biały w dark, czarny w light – jeden kolor marki, reszta bez koloru).
 */

const aiEngines = [
  { name: 'ChatGPT', file: 'chatgpt' },
  { name: 'Claude', file: 'claude' },
  { name: 'Gemini', file: 'gemini' },
  { name: 'Perplexity', file: 'perplexity' },
  { name: 'Microsoft Copilot', file: 'copilot' },
];
---

<section class="logos-section" aria-label="Mierzymy widoczność w silnikach AI">
  <div class="logos-inner container">
    <span class="logos-label">Mierzymy widoczność w</span>
    <ul class="logos-row">
      {
        aiEngines.map((e) => (
          <li>
            <img
              src={`/logos/ai-engines/${e.file}.png`}
              alt={e.name}
              height="22"
              loading="lazy"
              decoding="async"
            />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .logos-section {
    padding: 26px 0;
    border-top: 1px solid var(--hairline-soft);
    border-bottom: 1px solid var(--hairline-soft);
    background: var(--bg-canvas);
  }

  .logos-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px 40px;
    flex-wrap: wrap;
  }

  .logos-label {
    font-size: 11px;
    text-transform: uppercase;
    color: var(--ink-faint);
    letter-spacing: 0.08em;
  }

  .logos-row {
    display: flex;
    gap: 24px 36px;
    align-items: center;
    flex-wrap: wrap;
    justify-content: center;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .logos-row img {
    display: block;
    height: 22px;
    width: auto;
    /* monochrom: dark → biały, light → czarny */
    filter: brightness(0) invert(1);
    opacity: 0.72;
    transition: opacity 0.2s ease;
  }

  :root[data-theme='light'] .logos-row img {
    filter: brightness(0);
  }

  .logos-row li:hover img {
    opacity: 1;
  }

  @media (max-width: 639px) {
    .logos-row img {
      height: 18px;
    }
  }
</style>
