---
/**
 * HalftoneSentence – rastrowana ilustracja hero w kierunku D.
 *
 * Motyw: znak widocznosc.ai rozpada się w chmurę kropek i scala po drugiej
 * stronie w logotyp iCEA – wizualne domknięcie relacji marka → grupa.
 *
 * Nie jest to plik graficzny. Każda strona (lockup) jest rysowana do offscreen
 * canvasu – SVG jako maska alfa plus opcjonalny napis – a potem próbkowana co
 * `step` pikseli na cząstki. Podmiana ilustracji to podmiana propsa.
 *
 * Rozkład wzdłuż toru A→B: 40% cząstek przypiętych twardo do t=0, 40% do t=1,
 * 20% w chmurze pośredniej. Przypięcie musi być twarde – przy torze długim na
 * ~1600 px cząstki „prawie na końcu” rozmazują znak w nieczytelny pył.
 */
interface Props {
  /** Lewa strona: ścieżka do SVG/PNG (maska alfa) */
  fromSrc?: string;
  /** Lewa strona: napis rysowany obok maski */
  fromText?: string;
  /** Prawa strona: ścieżka do SVG/PNG */
  toSrc?: string;
  /** Prawa strona: napis rysowany obok maski */
  toText?: string;
  /** Proporcja canvasu na desktopie; wysokość liczona z szerokości */
  ratio?: number;
  /** Opis dla czytników ekranu */
  alt: string;
  class?: string;
}

const {
  fromSrc,
  fromText,
  toSrc,
  toText,
  ratio = 0.3,
  alt,
  class: className = '',
} = Astro.props;
---

<canvas
  class:list={['halftone', className]}
  data-from-src={fromSrc}
  data-from-text={fromText}
  data-to-src={toSrc}
  data-to-text={toText}
  data-ratio={ratio}
  aria-label={alt}
  role="img"></canvas>

<style>
  .halftone {
    display: block;
    width: 100%;
    height: auto;
    touch-action: none;
  }
</style>

<script>
  const INK = [250, 250, 250];
  const ACCENT = [87, 104, 255];
  const MUTE = [113, 113, 122];

  function mix(a: number[], b: number[], t: number) {
    return [
      Math.round(a[0] + (b[0] - a[0]) * t),
      Math.round(a[1] + (b[1] - a[1]) * t),
      Math.round(a[2] + (b[2] - a[2]) * t),
    ];
  }

  const imgCache = new Map<string, Promise<HTMLImageElement | null>>();
  function loadImage(src: string) {
    if (!imgCache.has(src)) {
      imgCache.set(
        src,
        new Promise((resolve) => {
          const im = new Image();
          im.onload = () => resolve(im);
          im.onerror = () => resolve(null);
          im.src = src;
        }),
      );
    }
    return imgCache.get(src)!;
  }

  type Side = { src?: string; text?: string };

  /**
   * Rysuje lockup (maska SVG + opcjonalny napis) wyśrodkowany w (cx, cy)
   * i zwraca jego punkty alfa jako listę cząstek.
   */
  async function sampleSide(
    side: Side,
    w: number,
    h: number,
    cx: number,
    cy: number,
    step: number,
    widthProp: number,
  ): Promise<{ x: number; y: number }[]> {
    const off = document.createElement('canvas');
    off.width = w;
    off.height = h;
    const c = off.getContext('2d', { willReadFrequently: true });
    if (!c) return [];

    const targetW = w * widthProp;
    const img = side.src ? await loadImage(side.src) : null;

    // Wysokość znaku wyznacza stopień pisma, żeby logotyp i napis stały
    // na jednej linii optycznej.
    const markH = h * 0.16;
    const markW = img ? (img.width / img.height) * markH : 0;
    const gap = side.text && img ? markH * 0.45 : 0;

    let fontSize = Math.round(markH * 1.02);
    let textW = 0;
    if (side.text) {
      c.font = `500 ${fontSize}px 'Mona Sans Variable', 'Mona Sans', Inter, sans-serif`;
      textW = c.measureText(side.text).width;
    }

    // Cały lockup skalujemy do zadanego ułamka szerokości płótna.
    const rawW = markW + gap + textW;
    const scale = rawW > 0 ? targetW / rawW : 1;
    const sMarkW = markW * scale;
    const sMarkH = markH * scale;
    const sGap = gap * scale;
    fontSize = Math.round(fontSize * scale);

    c.fillStyle = '#fff';
    let x = cx - targetW / 2;
    if (img) {
      c.drawImage(img, x, cy - sMarkH / 2, sMarkW, sMarkH);
      x += sMarkW + sGap;
    }
    if (side.text) {
      c.font = `500 ${fontSize}px 'Mona Sans Variable', 'Mona Sans', Inter, sans-serif`;
      c.textAlign = 'left';
      c.textBaseline = 'middle';
      c.fillText(side.text, x, cy);
    }

    const data = c.getImageData(0, 0, w, h).data;
    const pts: { x: number; y: number }[] = [];
    for (let y = 0; y < h; y += step) {
      for (let px = 0; px < w; px += step) {
        if (data[(y * w + px) * 4 + 3] > 120) pts.push({ x: px, y });
      }
    }
    return pts;
  }

  type P = {
    ax: number; ay: number; bx: number; by: number;
    t: number; nx: number; ny: number;
    x: number; y: number; vx: number; vy: number;
    r: number; col: string;
  };

  async function init(canvas: HTMLCanvasElement) {
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const sideA: Side = {
      src: canvas.dataset.fromSrc || undefined,
      text: canvas.dataset.fromText || undefined,
    };
    const sideB: Side = {
      src: canvas.dataset.toSrc || undefined,
      text: canvas.dataset.toText || undefined,
    };
    const ratio = Number(canvas.dataset.ratio || 0.3);
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

    try {
      await (document as any).fonts.ready;
    } catch {
      /* brak Font Loading API – rysujemy fallbackiem */
    }

    let particles: P[] = [];
    let dpr = 1;
    let W = 0;
    let H = 0;
    let raf = 0;
    let interactive = false;
    let building = false;
    const pointer = { x: -9999, y: -9999 };

    async function build() {
      if (building) return;
      building = true;
      try {
        const cssW = canvas.clientWidth;
        if (!cssW) return;

        // Na wąskim ekranie znaki idą jeden pod drugim i są proporcjonalnie
        // większe – obok siebie na 390 px robi się z nich pył.
        const narrow = cssW < 768;
        const cssH = Math.round(cssW * (narrow ? 0.5 : ratio));
        dpr = Math.min(window.devicePixelRatio || 1, 2);
        W = Math.round(cssW * dpr);
        H = Math.round(cssH * dpr);
        canvas.width = W;
        canvas.height = H;
        canvas.style.height = cssH + 'px';

        const step = Math.max(2, Math.round((narrow ? 2 : 3) * dpr));
        const widthProp = narrow ? 0.62 : 0.28;
        const A = await sampleSide(
          sideA, W, H,
          narrow ? W * 0.5 : W * 0.2,
          narrow ? H * 0.24 : H * 0.5,
          step, widthProp,
        );
        const B = await sampleSide(
          sideB, W, H,
          narrow ? W * 0.5 : W * 0.8,
          narrow ? H * 0.76 : H * 0.5,
          step, widthProp,
        );
        if (!A.length || !B.length) return;

        // Bierzemy DŁUŻSZĄ listę i zawijamy krótszą modulo. Wcześniejsze
        // podpróbkowanie dłuższej co k-ty punkt wycinało z logotypu całe
        // pionowe pasy (punkty są w porządku wierszowym) – znak rozpadał się
        // na fragmenty. Powtórzone punkty tylko nakładają się na siebie.
        const n = Math.max(A.length, B.length);

        particles = new Array(n);
        for (let i = 0; i < n; i++) {
          const a = A[i % A.length];
          const b = B[i % B.length];

          // Ciąg złotego podziału – równomierny, bez klastrów, deterministyczny.
          const u = (i * 0.6180339887) % 1;

          let t: number;
          let spread: number;
          if (u < 0.4) {
            t = 0;
            spread = 0;
          } else if (u > 0.6) {
            t = 1;
            spread = 0;
          } else {
            t = 0.12 + 0.76 * ((u - 0.4) / 0.2);
            spread = 4 * t * (1 - t);
          }

          const jitter = ((i * 2654435761) % 1000) / 1000;
          const ang = u * Math.PI * 2 * 7.3;
          const mag = spread * H * 0.3 * (0.3 + jitter);

          const col = t === 0 ? INK : t === 1 ? ACCENT : mix(MUTE, ACCENT, t);
          const alpha = spread === 0 ? 0.95 : 0.34 + (1 - spread) * 0.38;

          particles[i] = {
            ax: a.x, ay: a.y, bx: b.x, by: b.y, t,
            nx: Math.cos(ang) * mag * (narrow ? 0.55 : 1),
            ny: Math.sin(ang) * mag * (narrow ? 1 : 0.55),
            x: 0, y: 0, vx: 0, vy: 0,
            r: (spread === 0 ? 1.15 : 0.8) * dpr,
            col: `rgba(${col[0]}, ${col[1]}, ${col[2]}, ${alpha.toFixed(2)})`,
          };
        }

        for (const p of particles) {
          p.x = p.ax + (p.bx - p.ax) * p.t + p.nx;
          p.y = p.ay + (p.by - p.ay) * p.t + p.ny;
        }
        draw();
      } finally {
        building = false;
      }
    }

    function draw() {
      ctx.clearRect(0, 0, W, H);
      for (const p of particles) {
        ctx.fillStyle = p.col;
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
        ctx.fill();
      }
    }

    function frame() {
      const rad = 110 * dpr;
      const rad2 = rad * rad;
      for (const p of particles) {
        const hx = p.ax + (p.bx - p.ax) * p.t + p.nx;
        const hy = p.ay + (p.by - p.ay) * p.t + p.ny;

        // sprężyna do pozycji spoczynkowej
        p.vx += (hx - p.x) * 0.06;
        p.vy += (hy - p.y) * 0.06;

        // odpychanie od kursora
        const dx = p.x - pointer.x;
        const dy = p.y - pointer.y;
        const d2 = dx * dx + dy * dy;
        if (d2 < rad2 && d2 > 0.01) {
          const f = (1 - d2 / rad2) * 2.6;
          const d = Math.sqrt(d2);
          p.vx += (dx / d) * f;
          p.vy += (dy / d) * f;
        }

        p.vx *= 0.86;
        p.vy *= 0.86;
        p.x += p.vx;
        p.y += p.vy;
      }
      draw();
      raf = requestAnimationFrame(frame);
    }

    function start() {
      if (raf || reduced || !interactive) return;
      raf = requestAnimationFrame(frame);
    }
    function stop() {
      if (!raf) return;
      cancelAnimationFrame(raf);
      raf = 0;
    }

    await build();

    // Animujemy tylko gdy płótno jest w kadrze – poza nim pętla stoi.
    const io = new IntersectionObserver(
      ([e]) => (e.isIntersecting ? start() : stop()),
      { threshold: 0 },
    );
    io.observe(canvas);

    if (!reduced && matchMedia('(pointer: fine)').matches) {
      canvas.addEventListener('pointerenter', () => {
        interactive = true;
        start();
      });
      canvas.addEventListener('pointermove', (e) => {
        const r = canvas.getBoundingClientRect();
        pointer.x = (e.clientX - r.left) * dpr;
        pointer.y = (e.clientY - r.top) * dpr;
      });
      canvas.addEventListener('pointerleave', () => {
        pointer.x = -9999;
        pointer.y = -9999;
        // domykamy ruch, żeby cząstki wróciły na miejsce, potem gasimy pętlę
        setTimeout(() => {
          interactive = false;
          stop();
          void build();
        }, 1200);
      });
    }

    let rt: number;
    window.addEventListener('resize', () => {
      clearTimeout(rt);
      rt = window.setTimeout(() => void build(), 180);
    });
  }

  function boot() {
    document
      .querySelectorAll<HTMLCanvasElement>('canvas.halftone')
      .forEach((c) => void init(c));
  }

  boot();
  document.addEventListener('astro:page-load', boot);
</script>
