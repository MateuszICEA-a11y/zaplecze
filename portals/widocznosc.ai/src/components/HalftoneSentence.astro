---
/**
 * HalftoneSentence – rastrowana ilustracja hero w kierunku D.
 *
 * Motyw: znak widocznosc.ai rozpada się w chmurę kropek i scala po drugiej
 * stronie w logotyp iCEA – wizualne domknięcie relacji marka → grupa.
 *
 * Nie jest to plik graficzny. Każda strona (lockup) jest rysowana do offscreen
 * canvasu – SVG jako maska alfa plus opcjonalny napis – a potem próbkowana co
 * `step` pikseli na cząstki. Podmiana ilustracji to podmiana propsa.
 *
 * Rozkład wzdłuż toru A→B: 35% cząstek przypiętych twardo do t=0, 35% do t=1,
 * 30% płynie w pętli jako spleciona wstęga (biel → akcent). Przypięcie końców
 * musi być twarde – przy torze długim na ~1000 px cząstki „prawie na końcu”
 * rozmazują znak w nieczytelny pył. Pętla animacji chodzi, gdy płótno jest
 * w kadrze; przy prefers-reduced-motion zostaje jedna statyczna klatka.
 */
interface Props {
  /** Lewa strona: ścieżka do SVG/PNG (maska alfa) */
  fromSrc?: string;
  /** Lewa strona: napis rysowany obok maski */
  fromText?: string;
  /** Prawa strona: ścieżka do SVG/PNG */
  toSrc?: string;
  /** Prawa strona: napis rysowany obok maski */
  toText?: string;
  /** Proporcja canvasu na desktopie; wysokość liczona z szerokości */
  ratio?: number;
  /** Opis dla czytników ekranu */
  alt: string;
  class?: string;
}

const {
  fromSrc,
  fromText,
  toSrc,
  toText,
  ratio = 0.24,
  alt,
  class: className = '',
} = Astro.props;
---

<canvas
  class:list={['halftone', className]}
  data-from-src={fromSrc}
  data-from-text={fromText}
  data-to-src={toSrc}
  data-to-text={toText}
  data-ratio={ratio}
  aria-label={alt}
  role="img"></canvas>

<style>
  .halftone {
    display: block;
    width: 100%;
    height: auto;
    touch-action: none;
  }
</style>

<script>
  const INK = [250, 250, 250];
  const ACCENT = [87, 104, 255];
  const MUTE = [113, 113, 122];

  function mix(a: number[], b: number[], t: number) {
    return [
      Math.round(a[0] + (b[0] - a[0]) * t),
      Math.round(a[1] + (b[1] - a[1]) * t),
      Math.round(a[2] + (b[2] - a[2]) * t),
    ];
  }

  // Paleta 32 kroków biel → akcent; cząstki wstęgi zmieniają kolor co klatkę,
  // więc nie składamy stringów rgba w pętli.
  const PAL = Array.from({ length: 32 }, (_, i) => {
    const c = mix(INK, ACCENT, i / 31);
    return `rgba(${c[0]}, ${c[1]}, ${c[2]}, 0.85)`;
  });

  const imgCache = new Map<string, Promise<HTMLImageElement | null>>();
  function loadImage(src: string) {
    if (!imgCache.has(src)) {
      imgCache.set(
        src,
        new Promise((resolve) => {
          const im = new Image();
          im.onload = () => resolve(im);
          im.onerror = () => resolve(null);
          im.src = src;
        }),
      );
    }
    return imgCache.get(src)!;
  }

  type Side = { src?: string; text?: string };

  /**
   * Rysuje lockup (maska SVG + opcjonalny napis) wyśrodkowany w (cx, cy)
   * i zwraca jego punkty alfa jako listę cząstek.
   */
  async function sampleSide(
    side: Side,
    w: number,
    h: number,
    cx: number,
    cy: number,
    step: number,
    widthProp: number,
  ): Promise<{ x: number; y: number }[]> {
    const off = document.createElement('canvas');
    off.width = w;
    off.height = h;
    const c = off.getContext('2d', { willReadFrequently: true });
    if (!c) return [];

    const targetW = w * widthProp;
    const img = side.src ? await loadImage(side.src) : null;

    // Wysokość znaku wyznacza stopień pisma, żeby logotyp i napis stały
    // na jednej linii optycznej.
    const markH = h * 0.16;
    const markW = img ? (img.width / img.height) * markH : 0;
    const gap = side.text && img ? markH * 0.45 : 0;

    let fontSize = Math.round(markH * 1.02);
    let textW = 0;
    if (side.text) {
      c.font = `500 ${fontSize}px 'Mona Sans Variable', 'Mona Sans', Inter, sans-serif`;
      textW = c.measureText(side.text).width;
    }

    // Cały lockup skalujemy do zadanego ułamka szerokości płótna.
    const rawW = markW + gap + textW;
    const scale = rawW > 0 ? targetW / rawW : 1;
    const sMarkW = markW * scale;
    const sMarkH = markH * scale;
    const sGap = gap * scale;
    fontSize = Math.round(fontSize * scale);

    c.fillStyle = '#fff';
    let x = cx - targetW / 2;
    if (img) {
      c.drawImage(img, x, cy - sMarkH / 2, sMarkW, sMarkH);
      x += sMarkW + sGap;
    }
    if (side.text) {
      c.font = `500 ${fontSize}px 'Mona Sans Variable', 'Mona Sans', Inter, sans-serif`;
      c.textAlign = 'left';
      c.textBaseline = 'middle';
      c.fillText(side.text, x, cy);
    }

    const data = c.getImageData(0, 0, w, h).data;
    const pts: { x: number; y: number }[] = [];
    for (let y = 0; y < h; y += step) {
      for (let px = 0; px < w; px += step) {
        if (data[(y * w + px) * 4 + 3] > 120) pts.push({ x: px, y });
      }
    }
    return pts;
  }

  type P = {
    ax: number; ay: number; bx: number; by: number;
    t: number; nx: number; ny: number;
    x: number; y: number; vx: number; vy: number;
    r: number; col: string;
    /** cząstka wstęgi: płynie A→B w pętli */
    trail: boolean; ph: number; amp: number; lane: number;
  };

  async function init(canvas: HTMLCanvasElement) {
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const sideA: Side = {
      src: canvas.dataset.fromSrc || undefined,
      text: canvas.dataset.fromText || undefined,
    };
    const sideB: Side = {
      src: canvas.dataset.toSrc || undefined,
      text: canvas.dataset.toText || undefined,
    };
    const ratio = Number(canvas.dataset.ratio || 0.24);
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

    try {
      await (document as any).fonts.ready;
    } catch {
      /* brak Font Loading API – rysujemy fallbackiem */
    }

    let particles: P[] = [];
    let dpr = 1;
    let W = 0;
    let H = 0;
    let raf = 0;
    let building = false;
    let isNarrow = false;
    const pointer = { x: -9999, y: -9999 };

    async function build() {
      if (building) return;
      building = true;
      try {
        const cssW = canvas.clientWidth;
        if (!cssW) return;

        // Na wąskim ekranie znaki idą jeden pod drugim i są proporcjonalnie
        // większe – obok siebie na 390 px robi się z nich pył.
        const narrow = cssW < 768;
        const cssH = Math.round(cssW * (narrow ? 0.5 : ratio));
        dpr = Math.min(window.devicePixelRatio || 1, 2);
        W = Math.round(cssW * dpr);
        H = Math.round(cssH * dpr);
        canvas.width = W;
        canvas.height = H;
        canvas.style.height = cssH + 'px';

        const step = Math.max(2, Math.round((narrow ? 2 : 3) * dpr));
        isNarrow = narrow;
        // Znaki zsunięte do 0.3 / 0.7 szerokości – wstęga między nimi ma być
        // łącznikiem, nie przestrzenią do pokonania.
        const widthProp = narrow ? 0.62 : 0.24;
        const A = await sampleSide(
          sideA, W, H,
          narrow ? W * 0.5 : W * 0.3,
          narrow ? H * 0.24 : H * 0.5,
          step, widthProp,
        );
        const B = await sampleSide(
          sideB, W, H,
          narrow ? W * 0.5 : W * 0.7,
          narrow ? H * 0.76 : H * 0.5,
          step, widthProp,
        );
        if (!A.length || !B.length) return;

        // Bierzemy DŁUŻSZĄ listę i zawijamy krótszą modulo. Wcześniejsze
        // podpróbkowanie dłuższej co k-ty punkt wycinało z logotypu całe
        // pionowe pasy (punkty są w porządku wierszowym) – znak rozpadał się
        // na fragmenty. Powtórzone punkty tylko nakładają się na siebie.
        const n = Math.max(A.length, B.length);

        particles = new Array(n);
        for (let i = 0; i < n; i++) {
          const a = A[i % A.length];
          const b = B[i % B.length];

          // Ciąg złotego podziału – równomierny, bez klastrów, deterministyczny.
          const u = (i * 0.6180339887) % 1;

          let t: number;
          let spread: number;
          if (u < 0.35) {
            t = 0;
            spread = 0;
          } else if (u > 0.65) {
            t = 1;
            spread = 0;
          } else {
            t = (u - 0.35) / 0.3;
            spread = 4 * t * (1 - t);
          }
          const trail = spread > 0;

          const jitter = ((i * 2654435761) % 1000) / 1000;
          const col = t === 0 ? INK : ACCENT;

          particles[i] = {
            ax: a.x, ay: a.y, bx: b.x, by: b.y, t,
            nx: 0,
            ny: 0,
            x: 0, y: 0, vx: 0, vy: 0,
            r: (trail ? 0.85 : 1.15) * dpr,
            col: trail ? PAL[Math.floor(t * 31)] : `rgba(${col[0]}, ${col[1]}, ${col[2]}, 0.95)`,
            trail,
            ph: t,
            // amplituda splotu: kilka pasm o różnej wysokości
            amp: H * (0.05 + 0.13 * jitter),
            lane: jitter * Math.PI * 2,
          };
        }

        for (const p of particles) {
          const h = home(p, p.t);
          p.x = h[0];
          p.y = h[1];
        }
        draw();
      } finally {
        building = false;
      }
    }

    /**
     * Pozycja spoczynkowa dla parametru toru tt. Wstęga biegnie po prostej
     * A→B, spleciona sinusoidą o amplitudzie gasnącej na końcach, więc
     * cząstki „wypływają” z jednego znaku i „wsiąkają” w drugi.
     */
    function home(p: P, tt: number): [number, number] {
      const x = p.ax + (p.bx - p.ax) * tt;
      const y = p.ay + (p.by - p.ay) * tt;
      if (!p.trail) return [x, y];
      const env = Math.sin(tt * Math.PI); // 0 na końcach, 1 w środku
      const wave = Math.sin(tt * Math.PI * 2 * 1.5 + p.lane) * p.amp * env;
      return isNarrow ? [x + wave, y] : [x, y + wave];
    }

    function draw() {
      ctx.clearRect(0, 0, W, H);
      for (const p of particles) {
        ctx.fillStyle = p.col;
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
        ctx.fill();
      }
    }

    function frame(now: number) {
      const rad = 110 * dpr;
      const rad2 = rad * rad;
      const T = now / 1000;
      for (const p of particles) {
        let hx: number;
        let hy: number;
        if (p.trail) {
          // pętla A→B, ~14 s na przejście; kolor podąża za położeniem
          const tt = (p.ph + T * 0.07) % 1;
          [hx, hy] = home(p, tt);
          p.col = PAL[Math.floor(tt * 31)];
          // cząstka, która właśnie „urodziła się” w A, dogania tor bez smugi
          if (tt < 0.02) {
            p.x = hx;
            p.y = hy;
            p.vx = 0;
            p.vy = 0;
          }
        } else {
          hx = p.ax + (p.bx - p.ax) * p.t;
          hy = p.ay + (p.by - p.ay) * p.t;
        }

        // sprężyna do pozycji spoczynkowej
        p.vx += (hx - p.x) * 0.06;
        p.vy += (hy - p.y) * 0.06;

        // odpychanie od kursora
        const dx = p.x - pointer.x;
        const dy = p.y - pointer.y;
        const d2 = dx * dx + dy * dy;
        if (d2 < rad2 && d2 > 0.01) {
          const f = (1 - d2 / rad2) * 2.6;
          const d = Math.sqrt(d2);
          p.vx += (dx / d) * f;
          p.vy += (dy / d) * f;
        }

        p.vx *= 0.86;
        p.vy *= 0.86;
        p.x += p.vx;
        p.y += p.vy;
      }
      draw();
      raf = requestAnimationFrame(frame);
    }

    function start() {
      if (raf || reduced) return;
      raf = requestAnimationFrame(frame);
    }
    function stop() {
      if (!raf) return;
      cancelAnimationFrame(raf);
      raf = 0;
    }

    await build();

    // Animujemy tylko gdy płótno jest w kadrze – poza nim pętla stoi.
    const io = new IntersectionObserver(
      ([e]) => (e.isIntersecting ? start() : stop()),
      { threshold: 0 },
    );
    io.observe(canvas);

    if (!reduced && matchMedia('(pointer: fine)').matches) {
      canvas.addEventListener('pointermove', (e) => {
        const r = canvas.getBoundingClientRect();
        pointer.x = (e.clientX - r.left) * dpr;
        pointer.y = (e.clientY - r.top) * dpr;
      });
      canvas.addEventListener('pointerleave', () => {
        pointer.x = -9999;
        pointer.y = -9999;
      });
    }

    let rt: number;
    window.addEventListener('resize', () => {
      clearTimeout(rt);
      rt = window.setTimeout(() => void build(), 180);
    });
  }

  function boot() {
    document
      .querySelectorAll<HTMLCanvasElement>('canvas.halftone')
      .forEach((c) => void init(c));
  }

  boot();
  document.addEventListener('astro:page-load', boot);
</script>
