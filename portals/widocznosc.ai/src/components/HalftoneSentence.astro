---
/**
 * HalftoneSentence – rastrowana ilustracja hero w kierunku D.
 *
 * Motyw: zdanie w języku naturalnym rozpada się w chmurę kropek i scala po
 * prawej w kształt odpowiedzi AI. Nie jest to plik graficzny – tekst jest
 * renderowany do offscreen canvasu, próbkowany co `step` pikseli, a każda
 * próbka staje się cząstką. Zmiana napisu = zmiana propsa, nie nowy asset.
 *
 * Rozkład cząstek wzdłuż toru A→B jest U-kształtny (gęsto na końcach, rzadko
 * w środku), więc oba napisy są czytelne, a między nimi zostaje rozproszenie.
 * Amplituda szumu i kolor idą tą samą krzywą: biel → szarość → akcent.
 */
interface Props {
  /** Tekst źródłowy (lewa strona, biel) */
  from?: string;
  /** Tekst docelowy (prawa strona, akcent) */
  to?: string;
  /** Proporcja canvasu; wysokość liczona z szerokości */
  ratio?: number;
  class?: string;
}

const {
  from = 'Twoja treść',
  to = 'Odpowiedź AI',
  ratio = 0.3,
  class: className = '',
} = Astro.props;
---

<canvas
  class:list={['halftone', className]}
  data-from={from}
  data-to={to}
  data-ratio={ratio}
  aria-label={`Ilustracja: napis „${from}” rozsypuje się w chmurę kropek i scala po prawej w napis „${to}”`}
  role="img"></canvas>

<style>
  .halftone {
    display: block;
    width: 100%;
    height: auto;
    touch-action: none;
  }
</style>

<script>
  const INK = [250, 250, 250];
  const ACCENT = [47, 140, 255];
  const MUTE = [113, 113, 122];

  function mix(a: number[], b: number[], t: number) {
    return [
      Math.round(a[0] + (b[0] - a[0]) * t),
      Math.round(a[1] + (b[1] - a[1]) * t),
      Math.round(a[2] + (b[2] - a[2]) * t),
    ];
  }

  /** Próbkuje napis do listy punktów w układzie canvasu. */
  function samplePoints(
    text: string,
    w: number,
    h: number,
    cx: number,
    cy: number,
    step: number,
    widthProp: number,
  ): { x: number; y: number }[] {
    const off = document.createElement('canvas');
    off.width = w;
    off.height = h;
    const c = off.getContext('2d', { willReadFrequently: true });
    if (!c) return [];

    // Stopień dobrany tak, by napis zajął zadany ułamek szerokości płótna.
    let size = Math.round(h * 0.34);
    c.font = `400 ${size}px Fraunces, Georgia, serif`;
    const target = w * widthProp;
    const measured = c.measureText(text).width;
    if (measured > 0) size = Math.max(18, Math.round((size * target) / measured));
    c.font = `400 ${size}px Fraunces, Georgia, serif`;

    c.fillStyle = '#fff';
    c.textAlign = 'center';
    c.textBaseline = 'middle';
    c.fillText(text, cx, cy);

    const data = c.getImageData(0, 0, w, h).data;
    const pts: { x: number; y: number }[] = [];
    for (let y = 0; y < h; y += step) {
      for (let x = 0; x < w; x += step) {
        if (data[(y * w + x) * 4 + 3] > 140) pts.push({ x, y });
      }
    }
    return pts;
  }

  type P = {
    ax: number; ay: number; bx: number; by: number;
    t: number; nx: number; ny: number;
    x: number; y: number; vx: number; vy: number;
    r: number; col: string;
  };

  async function init(canvas: HTMLCanvasElement) {
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const from = canvas.dataset.from || '';
    const to = canvas.dataset.to || '';
    const ratio = Number(canvas.dataset.ratio || 0.3);
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

    try {
      await (document as any).fonts.ready;
    } catch {
      /* brak Font Loading API – rysujemy fallbackiem */
    }

    let particles: P[] = [];
    let dpr = 1;
    let W = 0;
    let H = 0;
    let raf = 0;
    let interactive = false;
    const pointer = { x: -9999, y: -9999 };

    function build() {
      const cssW = canvas.clientWidth;
      if (!cssW) return;
      // Na wąskim ekranie napisy muszą być proporcjonalnie większe i gęściej
      // próbkowane, inaczej z 390 px szerokości zostaje kilkanaście kropek.
      const narrow = cssW < 768;
      const cssH = Math.round(cssW * (narrow ? 0.5 : ratio));
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      W = Math.round(cssW * dpr);
      H = Math.round(cssH * dpr);
      canvas.width = W;
      canvas.height = H;
      canvas.style.height = cssH + 'px';

      // Na telefonie napisy idą jeden pod drugim i zajmują 70% szerokości –
      // obok siebie na 390 px robi się z nich nieczytelny pył.
      const step = Math.max(2, Math.round((narrow ? 2 : 3) * dpr));
      const widthProp = narrow ? 0.7 : 0.3;
      const ax = narrow ? W * 0.5 : W * 0.2;
      const bx = narrow ? W * 0.5 : W * 0.8;
      const ay = narrow ? H * 0.24 : H * 0.5;
      const by = narrow ? H * 0.76 : H * 0.5;
      const A = samplePoints(from, W, H, ax, ay, step, widthProp);
      const B = samplePoints(to, W, H, bx, by, step, widthProp);
      const n = Math.min(A.length, B.length);
      if (!n) return;

      particles = new Array(n);
      for (let i = 0; i < n; i++) {
        const a = A[i];
        const b = B[Math.floor((i / n) * B.length)];

        // Ciąg złotego podziału – równomierny, bez klastrów, deterministyczny.
        const u = (i * 0.6180339887) % 1;

        // Końce toru są przypięte TWARDO do t=0 i t=1. Bez tego cząstki
        // „prawie na końcu” lądują kilkadziesiąt pikseli w bok (tor ma ~1600 px)
        // i rozmazują litery w nieczytelną smugę. Środkowa mniejszość niesie
        // chmurę rozproszenia między napisami.
        let t: number;
        let spread: number;
        if (u < 0.4) {
          t = 0;
          spread = 0;
        } else if (u > 0.6) {
          t = 1;
          spread = 0;
        } else {
          t = 0.12 + 0.76 * ((u - 0.4) / 0.2);
          spread = 4 * t * (1 - t);
        }

        const jitter = ((i * 2654435761) % 1000) / 1000;
        const ang = u * Math.PI * 2 * 7.3;
        const mag = spread * H * 0.3 * (0.3 + jitter);

        const col = t === 0 ? INK : t === 1 ? ACCENT : mix(MUTE, ACCENT, t);
        const alpha = spread === 0 ? 0.95 : 0.34 + (1 - spread) * 0.38;

        particles[i] = {
          ax: a.x, ay: a.y, bx: b.x, by: b.y, t,
          nx: Math.cos(ang) * mag * (narrow ? 0.55 : 1),
          ny: Math.sin(ang) * mag * (narrow ? 1 : 0.55),
          x: 0, y: 0, vx: 0, vy: 0,
          r: (spread === 0 ? 1.15 : 0.8) * dpr,
          col: `rgba(${col[0]}, ${col[1]}, ${col[2]}, ${alpha.toFixed(2)})`,
        };
      }

      for (const p of particles) {
        p.x = p.ax + (p.bx - p.ax) * p.t + p.nx;
        p.y = p.ay + (p.by - p.ay) * p.t + p.ny;
      }
      draw();
    }

    function draw() {
      ctx.clearRect(0, 0, W, H);
      for (const p of particles) {
        ctx.fillStyle = p.col;
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
        ctx.fill();
      }
    }

    function frame() {
      const rad = 110 * dpr;
      const rad2 = rad * rad;
      for (const p of particles) {
        const hx = p.ax + (p.bx - p.ax) * p.t + p.nx;
        const hy = p.ay + (p.by - p.ay) * p.t + p.ny;

        // sprężyna do pozycji spoczynkowej
        p.vx += (hx - p.x) * 0.06;
        p.vy += (hy - p.y) * 0.06;

        // odpychanie od kursora
        const dx = p.x - pointer.x;
        const dy = p.y - pointer.y;
        const d2 = dx * dx + dy * dy;
        if (d2 < rad2 && d2 > 0.01) {
          const f = (1 - d2 / rad2) * 2.6;
          const d = Math.sqrt(d2);
          p.vx += (dx / d) * f;
          p.vy += (dy / d) * f;
        }

        p.vx *= 0.86;
        p.vy *= 0.86;
        p.x += p.vx;
        p.y += p.vy;
      }
      draw();
      raf = requestAnimationFrame(frame);
    }

    function start() {
      if (raf || reduced || !interactive) return;
      raf = requestAnimationFrame(frame);
    }
    function stop() {
      if (!raf) return;
      cancelAnimationFrame(raf);
      raf = 0;
    }

    build();

    // Animujemy tylko gdy płótno jest w kadrze – poza nim pętla stoi.
    const io = new IntersectionObserver(
      ([e]) => (e.isIntersecting ? start() : stop()),
      { threshold: 0 },
    );
    io.observe(canvas);

    if (!reduced && matchMedia('(pointer: fine)').matches) {
      canvas.addEventListener('pointerenter', () => {
        interactive = true;
        start();
      });
      canvas.addEventListener('pointermove', (e) => {
        const r = canvas.getBoundingClientRect();
        pointer.x = (e.clientX - r.left) * dpr;
        pointer.y = (e.clientY - r.top) * dpr;
      });
      canvas.addEventListener('pointerleave', () => {
        pointer.x = -9999;
        pointer.y = -9999;
        // domykamy ruch, żeby cząstki wróciły na miejsce, potem gasimy pętlę
        setTimeout(() => {
          interactive = false;
          stop();
          build();
        }, 1200);
      });
    }

    let rt: number;
    window.addEventListener('resize', () => {
      clearTimeout(rt);
      rt = window.setTimeout(build, 180);
    });
  }

  function boot() {
    document
      .querySelectorAll<HTMLCanvasElement>('canvas.halftone')
      .forEach((c) => init(c));
  }

  boot();
  document.addEventListener('astro:page-load', boot);
</script>
