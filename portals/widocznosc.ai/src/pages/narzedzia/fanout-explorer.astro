---
import { readFileSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import ScrollUpButton from '../../components/ScrollUpButton.astro';
import { buildGraph, softwareApplicationNode, breadcrumbNode } from '../../lib/schema';

// Bookmarklety budowane skryptem scripts/build-fanout-bookmarklet.mjs z tools-src/fanout-explorer.js.
const read = (name: string) =>
  readFileSync(
    fileURLToPath(new URL(`../../../public/tools/${name}`, import.meta.url)),
    'utf8'
  ).trim();
const standalone = read('fanout-explorer.bookmarklet.txt');
const source = read('fanout-explorer.js');
const version = (source.match(/VERSION = '([^']+)'/) || [])[1] || '1.0.0';
const standaloneKb = (Buffer.byteLength(standalone, 'utf8') / 1024).toFixed(0);

const columns = [
  ['nr', 'Kolejność, w jakiej ChatGPT wysyłał zapytania do wyszukiwarki.'],
  [
    'runda',
    'Numer partii. ChatGPT szuka iteracyjnie: wysyła kilka zapytań, analizuje wyniki i często generuje kolejną partię zapytań.',
  ],
  [
    'zapytanie',
    'Dokładna fraza wysłana do wyszukiwarki, łącznie z operatorem site: i cudzysłowami.',
  ],
  [
    'domena',
    'Witryna wskazana operatorem site: w zapytaniu. Pokazuje, gdzie model postanowił szukać w tej rozmowie; nie jest miarą zaufania do witryny.',
  ],
  [
    'wyniki',
    'Liczba stron z puli wyników rundy przypisanej do wiersza. Zapytania bez ograniczenia domeny dzielą wspólną pulę; przy site: panel filtruje ją po domenie.',
  ],
  [
    'cytowane',
    'Liczba stron z tej puli oznaczonych jako cytowane w odpowiedzi. Zero oznacza brak cytowania; sama obecność w wynikach nie dowodzi przeczytania pełnej treści strony.',
  ],
];

const faq = [
  {
    q: 'Czy bookmarklet przesyła moje rozmowy na zewnątrz?',
    a: 'Nie. Bookmarklet pobiera rozmowę z tego samego adresu co aplikacja ChatGPT, korzystając z Twojej aktywnej sesji. Tabelę generuje lokalnie w przeglądarce, a kopię czatu zapisuje w jej pamięci (localStorage), dzięki czemu kolejne otwarcie panelu może korzystać z lokalnych danych. Cały kod znajduje się w zakładce, która komunikuje się wyłącznie z domeną chatgpt.com. Bookmarklet nie przekazuje danych do widocznosc.ai ani do podmiotów trzecich.',
  },
  {
    q: 'Dlaczego treść zapytań jest niedostępna mimo otwartego panelu?',
    a: 'Od wersji 1.4.0 panel czyta rozmowę tym samym adresem co aplikacja ChatGPT (od września 2026), a on zawiera treść zapytań także w zapisanych czatach, na koncie Free i Business. Nagrywanie strumienia zostaje jako zapas. Jeśli zapytań nadal brakuje, możliwe, że ChatGPT w danej odpowiedzi ich nie udostępnił albo zmienił format. Pod komunikatem o brakach panel pokazuje liczniki strumieni, zdarzeń i zapisanych partii. Przekaż je razem z planem konta, bez treści rozmowy. Po aktualizacji zakładki przeładuj chatgpt.com.'',
  },
  {
    q: 'Dlaczego kolumny „wyniki” i „cytowane” bywają puste?',
    a: 'W starszych czatach z kolumną „typ” wyszukiwania typu business i image mogą nie mieć wyników, ponieważ w danych rozmowy brakuje listy zwróconych stron. Kolumna „cytowane” pokazuje wielokropek, dopóki odpowiedź nie zostanie w pełni wygenerowana i zapisana. Zero oznacza, że panel zweryfikował dostępne dane i żadna strona z puli przypisanej do wiersza nie została oznaczona jako cytowana w ostatecznej odpowiedzi.',
  },
  {
    q: 'Co oznacza komunikat o limicie (Błąd 429)?',
    a: 'Kod 429 (Too Many Requests) oznacza, że ChatGPT blokuje zbyt częste pobieranie danych. Od wersji 1.4.0 panel nie pobiera rozmowy w trakcie generowania, tylko raz po zakończeniu odpowiedzi. Zakończona rozmowa wymaga zwykle jednego pobrania, a jeśli dostępna jest jej lokalna kopia, panel może wczytać ją bez ponownego pobierania. Jeśli limit zostanie przekroczony, panel zachowuje dotychczasowe dane i wstrzymuje wszystkie odczyty rozmowy, także z przycisku Odśwież. Pierwsza przerwa trwa co najmniej minutę; kolejne rosną do 10 minut. Jeśli serwer poda dłuższy czas w Retry-After, panel go respektuje. Komunikat pokazuje godzinę kolejnej próby.',
  },
  {
    q: 'Czy narzędzie działa w aplikacji desktopowej ChatGPT, w Safari albo w Claude i Gemini?',
    a: 'Narzędzie analizuje specyficzny format rozmów ChatGPT. Testowaliśmy je na stronie chatgpt.com w przeglądarkach Chrome, Edge i Brave na komputerach osobistych. Aplikacja desktopowa nie obsługuje tej metody uruchamiania przez pasek zakładek. Przeglądarek Safari i Firefox nie testowaliśmy. Claude i Gemini korzystają z innych formatów danych, których narzędzie nie obsługuje.',
  },
  {
    q: 'Czym to się różni od narzędzia „Analiza zapytań AI”?',
    a: 'Analiza zapytań AI odpytuje model przez API OpenAI i pokazuje, jak model szuka, gdy ma włączony moduł wyszukiwania – bez logowania i na podaną frazę. Bookmarklet analizuje Twoje rzeczywiste rozmowy na chatgpt.com: zapytania, rundy, strony i cytowania udostępnione w danych czatu. Pierwsze narzędzie to szybki sondaż przez API, drugie to zapis obserwacji z Twojego własnego konta. Wyniki obu narzędzi mogą się różnić.',
  },
];

const schema = buildGraph(
  softwareApplicationNode({
    slug: 'fanout-explorer',
    name: 'Fan-out Explorer – bookmarklet do ChatGPT – widocznosc.ai',
    description:
      'Bezpłatny bookmarklet widocznosc.ai do chatgpt.com: pokazuje przechwycone zapytania, zwrócone strony i cytowania. Działa na nowych promptach i zapisanych czatach. Nie przekazuje danych do widocznosc.ai ani podmiotów trzecich.',
    featureList: [
      'Tabela wyszukiwań ChatGPT: runda, zapytanie, domena, wyniki, cytowania',
      'Lista stron z rundy wyszukiwania z oznaczeniem cytowanych',
      'Podsumowanie udziału forów (Reddit, Wykop, Quora, GoWork)',
      'Zakładka Domeny: witryny pogrupowane w kategorie (fora, opinie, sklepy, media, dokumentacja, instytucje, firmy) z liczbą zwróconych i cytowanych stron',
      'Nagrywanie zapytań ze strumienia odpowiedzi, odczyt zapisanych czatów',
      'Eksport: kopiowanie zapytań, tabela do arkusza, CSV wyszukiwań i CSV źródeł',
      'Tylko odczyt, dane zostają w przeglądarce',
    ],
  }),
  breadcrumbNode([
    { name: 'Strona główna', path: '/' },
    { name: 'Narzędzia', path: '/narzedzia/' },
    { name: 'Fan-out Explorer', path: '/narzedzia/fanout-explorer/' },
  ]),
  {
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  }
);
---

<Layout
  title="Fan-out Explorer – zobacz, czego ChatGPT szuka w sieci, zanim wygeneruje odpowiedź"
  description="Darmowy bookmarklet do chatgpt.com: zapytania na żywo, zwrócone strony i cytowania także w historii czatu. Bez przekazywania danych do widocznosc.ai."
>
  <script type="application/ld+json" is:inline set:html={schema} />

  <Navbar />

  <div class="flex-grow">
    <section class="tool-hero">
      <div class="content-container tool-hero-inner">
        <nav class="tool-breadcrumb" aria-label="Ścieżka nawigacji">
          <a href="/narzedzia/" class="tool-breadcrumb-link">Narzędzia</a>
          <span class="tool-breadcrumb-sep" aria-hidden="true">/</span>
          <span class="tool-breadcrumb-current">Fan-out Explorer</span>
        </nav>

        <header class="tool-hero-header">
          <span class="eyebrow tool-eyebrow">Bookmarklet · bezpłatny · wersja {version}</span>
          <h1 class="tool-hero-title display-xxl">
            Fan-out Explorer – zobacz, czego <span class="tool-hero-accent">ChatGPT szuka</span> w sieci,
            zanim wygeneruje odpowiedź
          </h1>
          <p class="tool-hero-copy">
            Zanim ChatGPT odpowie na pytanie, często przeszukuje sieć, korzystając z funkcji ChatGPT
            Search. Może rozbić Twój prompt na kilka lub kilkanaście zapytań (to tzw. <em
              >query fan-out</em
            >), przeanalizować wyniki z dziesiątek stron, a w odpowiedzi zacytować zaledwie kilka z
            nich. Fan-out Explorer to zakładka w przeglądarce, która pokazuje zapytania udostępnione
            przez ChatGPT, strony zwrócone w wynikach i te oznaczone jako cytowane. Działa na
            nowym prompcie i na czatach z historii: zapytania, domeny, strony i cytowania. Niczego nie instalujesz, a bookmarklet nie
            przekazuje Twoich danych poza chatgpt.com.
          </p>
        </header>

        <div class="install" id="instalacja">
          <div class="install-drag">
            <p class="install-step"><span>1</span> Przeciągnij przycisk na pasek zakładek</p>
            <a
              class="install-button"
              href={standalone}
              draggable="true"
              title="Przeciągnij mnie na pasek zakładek"
              onclick="return false"
            >
              ⚡ Fan-out Explorer
            </a>
            <p class="install-hint">
              Pasek zakładek włączysz skrótem <kbd>Ctrl</kbd>+<kbd>Shift</kbd>+<kbd>B</kbd> (Mac: <kbd
                >Cmd</kbd
              >+<kbd>Shift</kbd>+<kbd>B</kbd>). Zakładka zawiera cały kod ({standaloneKb} KB) i nie łączy
              się z żadnymi serwerami poza chatgpt.com. Gdy wydamy nową wersję, numer na tej stronie się
              zmieni, a Ty po prostu przeciągniesz przycisk jeszcze raz.
            </p>
          </div>
          <div class="install-copy">
            <p class="install-step"><span>2</span> Albo skopiuj i wklej jako adres zakładki</p>
            <div class="install-copy-row">
              <button type="button" class="btn-secondary" data-copy="standalone"
                >Kopiuj kod zakładki ({standaloneKb} KB)</button
              >
            </div>
            <p class="install-hint">
              Dodaj zakładkę do dowolnej strony, kliknij ją prawym przyciskiem myszy, wybierz
              „Edytuj” i wklej skopiowany tekst w pole adresu. W systemie Windows długie zakładki
              nie zawsze dają się poprawnie przeciągnąć; w takiej sytuacji skorzystaj z kopiowania
              kodu.
            </p>
          </div>
          <div class="install-copy">
            <p class="install-step"><span>3</span> Przeglądarka firmowa blokuje zakładki?</p>
            <p class="install-hint">
              Jeśli masz dostęp do narzędzi deweloperskich, otwórz czat na chatgpt.com, naciśnij <kbd
                >F12</kbd
              >, przejdź do karty Console, wklej skopiowany kod zakładki i zatwierdź Enterem. Chrome
              może wyświetlić ostrzeżenie i poprosić o wpisanie <code>allow pasting</code>. Przed
              uruchomieniem przeanalizuj kod:
              <a href="/tools/fanout-explorer.js" target="_blank" rel="noopener"
                >fanout-explorer.js</a
              >.
            </p>
          </div>
          <textarea id="copy-standalone" class="sr-only" readonly aria-hidden="true"
            >{standalone}</textarea
          >
        </div>

        <ol class="usage">
          <li>
            <b>Nowy prompt</b> – otwórz pusty czat na chatgpt.com, kliknij zakładkę, upewnij się, że tryb
            „na żywo” jest włączony, i wyślij prompt. Panel odczyta zapytania i wyniki,
            gdy ChatGPT skończy odpowiadać.
          </li>
          <li>
            <b>Zapisany czat</b> – otwórz dowolną rozmowę z historii i kliknij zakładkę. Zobaczysz zapytania,
            rundy, domeny, strony i cytowania. Pierwszy odczyt wymaga
            pobrania rozmowy, kolejne mogą korzystać z lokalnej kopii.
          </li>
        </ol>
      </div>
    </section>

    <section class="tool-overview">
      <div class="content-container">
        <h2 class="display-xl tool-overview-title">Co pokazuje panel</h2>
        <p class="text-ink tool-overview-copy mt-6 max-w-3xl text-lg leading-relaxed">
          Nad tabelą widzisz swój prompt i podsumowanie: ile wyszukiwań zostało zarejestrowanych w
          ilu rundach, ile stron zwróciła wyszukiwarka i ile z nich ChatGPT zacytował. Osobne
          statystyki dotyczą platform UGC i forów (m.in. Reddit, Wykop, Quora, GoWork). Poniżej
          znajduje się tabela (jeden wiersz na zarejestrowane zapytanie lub na rundę, jeśli treść
          zapytań nie jest dostępna) z możliwością sortowania każdej kolumny. Plus przy wierszu
          rozwija listę stron pogrupowaną według witryn, ze znacznikiem przy każdej zacytowanej
          stronie. Kolumny bez danych w danym czacie panel ukrywa automatycznie.
        </p>
        <p class="text-ink tool-overview-copy mt-4 max-w-3xl text-lg leading-relaxed">
          Zakładka <b>Domeny</b> agreguje wszystkie strony z czatu dla danej witryny: ile adresów URL
          znalazło się w wynikach, ile zostało zacytowanych i w ilu wyszukiwaniach ChatGPT ograniczył
          się do tej witryny operatorem
          <code class="font-mono text-sm">site:</code>. Witryny są wstępnie pogrupowane w siedem
          kategorii (fora i społeczności, opinie i rankingi, sklepy, media, dokumentacja
          producentów, instytucje, strony firmowe), z filtrem „tylko cytowane” i opcją eksportu do
          pliku CSV. Kategoryzacja opiera się na heurystyce adresów, więc traktuj ją jako wstępne
          sortowanie.
        </p>

        <div class="columns-table-wrap mt-10">
          <table class="columns-table">
            <thead>
              <tr><th>Kolumna</th><th>Co pokazuje</th></tr>
            </thead>
            <tbody>
              {
                columns.map(([name, desc]) => (
                  <tr>
                    <>
                      <td>
                        <code>{name}</code>
                      </td>
                      <td>{desc}</td>
                    </>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
        <p class="text-ink tool-overview-copy mt-4 max-w-3xl text-base leading-relaxed">
          W starszych czatach mogą pojawić się dwie dodatkowe kolumny: <code>typ</code> (rodzaj wyszukiwania,
          np. fast, slow, business, image) oraz <code>dni</code> (okno czasowe, np. 365 oznacza ostatni
          rok). ChatGPT zapisywał je w rozmowach, zanim zmienił format. W sprawdzonych nowych czatach
          te dane nie są dostępne, więc panel ukrywa obie kolumny. Pojawią się ponownie, jeśli dane będą
          dostępne w obsługiwanym przez panel formacie.
        </p>
        <p class="text-ink tool-overview-copy mt-4 max-w-3xl text-base leading-relaxed">
          Wyniki są zapisywane raz na rundę. Wiersze zapytań mogą więc pokazywać te same strony i
          cytowania — nie sumuj ich, aby obliczyć liczbę unikalnych stron w czacie. Przykłady
          odczytu i interpretacji danych znajdziesz we wpisie
          <a href="/geo/fanout-explorer-chatgpt/">Fan-out Explorer na polskich zapytaniach</a>.
        </p>

        <div class="mt-12 grid gap-4 lg:grid-cols-2">
          <div class="info-card">
            <h3 class="info-card-title">Eksport</h3>
            <ul class="info-list">
              <li>
                <b>Kopiuj zapytania</b> – kopiuje samą kolumnę zapytań (jedno na wiersz). Możesz sprawdzić
                w narzędziach SEO, czy dana fraza ma wolumen wyszukiwań, lub opracować pod nią osobny
                artykuł.
              </li>
              <li>
                <b>Kopiuj tabelę</b> – kopiuje całość rozdzieloną tabulatorami, gotową do wklejenia w
                Arkuszach Google lub Excelu.
              </li>
              <li>
                <b>Pobierz CSV</b> – wiersz na wyszukiwanie, strony w dodatkowych kolumnach, identyfikator
                czatu i data odczytu w nagłówku.
              </li>
              <li>
                <b>Pobierz CSV źródeł</b> – wiersz na stronę, z hostem, tytułem i flagą cytowania.
              </li>
            </ul>
          </div>
          <div class="info-card">
            <h3 class="info-card-title">Jak wykorzystać to w pracy nad widocznością (GEO/SEO)</h3>
            <ul class="info-list">
              <li>
                <b>Frazy generowane przez ChatGPT</b> – zapytania z tabeli to punkt wyjścia do planu treści;
                często zawierają bieżący rok, słowo „opinie” lub „oficjalny”.
              </li>
              <li>
                <b>Witryny wskazane w zapytaniach</b> – kolumna „domena” pokazuje, do których witryn ChatGPT
                zawęził wyszukiwanie operatorem <code>site:</code>. Obecność konkurencji może
                wskazywać obszar do dalszej analizy; sprawdź też wyniki i cytowania Twojej marki.
              </li>
              <li>
                <b>W wynikach, ale bez cytowania</b> – strona, która pojawia się w wynikach, ale nie jest
                cytowana w odpowiedzi AI, wymaga innej analizy niż ta, której w wynikach nie ma. Sam panel
                nie wyjaśnia przyczyny braku cytowania.
              </li>
              <li>
                <b>Ten sam prompt za miesiąc</b> – eksport zawiera datę i identyfikator czatu, więc porównanie
                dwóch sesji to po prostu zestawienie dwóch plików obok siebie.
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="tool-overview tool-overview--alt">
      <div class="content-container">
        <h2 class="display-xl tool-overview-title">Pytania i odpowiedzi</h2>
        <div class="faq mt-8">
          {
            faq.map((f) => (
              <details class="faq-item">
                <summary>{f.q}</summary>
                <p>{f.a}</p>
              </details>
            ))
          }
        </div>
        <p class="tool-overview-copy mt-12 max-w-3xl text-lg leading-relaxed">
          Narzędzie powstało z inspiracji bookmarkletem Orit Mutznik oraz rozszerzeniami FanoutFox
          (Suganthan Mohanadasan) i narzędziami Natiego Elimelecha. Kod napisaliśmy z myślą o
          polskich promptach: uwzględnia Wykop i GoWork obok Reddita. Jeśli OpenAI zmieni format
          rozmów i tabela przestanie się wypełniać,
          <a href="/kontakt/">daj nam znać</a>.
        </p>
        <div class="mt-10">
          <a href="/kontakt/" class="btn-primary"
            >Chcesz przełożyć fan-outy na plan treści? Porozmawiajmy</a
          >
        </div>
      </div>
    </section>
  </div>

  <Footer />
  <ScrollUpButton />
</Layout>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const ta = document.getElementById('copy-' + btn.dataset.copy) as HTMLTextAreaElement | null;
      if (!ta) return;
      const label = btn.textContent;
      try {
        await navigator.clipboard.writeText(ta.value);
      } catch {
        ta.classList.remove('sr-only');
        ta.select();
        document.execCommand('copy');
        ta.classList.add('sr-only');
      }
      btn.textContent = 'Skopiowano – wklej jako adres zakładki';
      setTimeout(() => (btn.textContent = label), 2200);
    });
  });
</script>

<style>
  .tool-hero {
    position: relative;
    overflow: hidden;
    padding: 104px 0 88px;
    background:
      radial-gradient(
        circle at 50% 12%,
        color-mix(in srgb, var(--accent-blue) 12%, transparent) 0%,
        transparent 34%
      ),
      linear-gradient(180deg, var(--bg-surface-1) 0%, var(--bg-canvas) 78%);
    border-bottom: 1px solid var(--hairline-soft);
  }

  .tool-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(var(--hairline-soft) 1px, transparent 1px),
      linear-gradient(90deg, var(--hairline-soft) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.16), transparent 62%);
    pointer-events: none;
  }

  .tool-hero-inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
  }

  .tool-breadcrumb {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 36px;
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 500;
    color: var(--ink-muted);
  }

  .tool-breadcrumb-link {
    color: var(--ink-muted);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .tool-breadcrumb-link:hover {
    color: var(--ink);
  }

  .tool-breadcrumb-sep {
    color: var(--ink-faint);
  }

  .tool-breadcrumb-current {
    color: var(--ink);
  }

  .tool-eyebrow {
    margin-bottom: 28px;
  }

  .tool-hero-title {
    max-width: 980px;
    margin: 0;
    font-size: clamp(36px, 4.1vw, 56px);
    line-height: 0.96;
    letter-spacing: -0.045em;
    color: var(--ink);
    text-wrap: balance;
  }

  .tool-hero-accent {
    color: var(--accent-blue);
  }

  .tool-hero-copy {
