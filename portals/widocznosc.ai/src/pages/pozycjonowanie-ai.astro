---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import ScrollUpButton from '../components/ScrollUpButton.astro';
import CTABand from '../components/CTABand.astro';
import { AI_MODELS } from '../data/aiModels';
import { faqPageNode } from '../lib/schema';

const services = [
  {
    id: 'audyt',
    title: 'Audyt widoczności w AI',
    desc: 'Sprawdzamy, jak Twoja marka jest obecnie cytowana w 5 głównych modelach AI. Budujemy mapę cytowań oraz przeprowadzamy analizę luk (gap analysis) i porównanie z działaniami Twojej konkurencji.',
    variant: 'violet',
  },
  {
    id: 'content',
    title: 'Optymalizacja treści pod modele językowe',
    desc: 'Optymalizujemy istniejące teksty pod kątem gęstości faktów i danych strukturalnych (Schema), by stały się idealnym źródłem do cytowania dla sztucznej inteligencji. Tworzymy precyzyjne wytyczne (briefy) dla copywriterów.',
    variant: 'cyan',
  },
  {
    id: 'monitoring',
    title: 'Stały monitoring cytowań',
    desc: 'Regularnie, z tygodnia na tydzień, śledzimy od 50 do 200 najważniejszych zapytań dla Twojej firmy. Otrzymujesz alerty o działaniach konkurencji oraz dostęp do panelu analitycznego (dashboardu) z historią widoczności.',
    variant: 'green',
  },
  {
    id: 'strategia',
    title: 'Strategia GEO na 12 miesięcy',
    desc: 'Tworzymy kompleksowy plan widoczności na cały rok: mapę fraz, kalendarz publikacji treści, plan dystrybucji oraz strategię pozyskiwania wzmianek marki.',
    variant: 'blue',
  },
] as const;

const gradientStyle = (variant: string) => {
  if (variant === 'violet')
    return 'background: var(--grad-violet); background-size: 130% 130%; background-position: 25% 30%;';
  if (variant === 'cyan')
    return 'background: var(--grad-cyan); background-size: 130% 130%; background-position: 30% 30%;';
  if (variant === 'green')
    return 'background: var(--grad-green); background-size: 130% 130%; background-position: 70% 30%;';
  return 'background: var(--grad-blue); background-size: 130% 130%; background-position: 70% 25%;';
};

const heroStats = [
  { value: '5', label: 'modeli AI', detail: 'ChatGPT · Claude · Gemini · Perplexity · Copilot' },
  { value: '500+', label: 'projektów SEO', detail: 'wdrożonych przez zespół' },
  { value: '15+', label: 'lat doświadczenia', detail: 'SEO, content, analityka' },
  { value: '#1', label: 'SEMKRK', detail: 'najwyżej oceniona prezentacja 2024' },
] as const;

const modelHooks: Record<string, { value: string; label: string }> = {
  chatgpt: { value: '140', label: 'wysz./mc' },
  claude: { value: '30', label: 'wysz./mc' },
  gemini: { value: '50', label: 'wysz./mc' },
  perplexity: { value: '40', label: 'wysz./mc' },
  'bing-copilot': { value: '20', label: 'wysz./mc' },
};

const decisionRows = [
  {
    model: 'ChatGPT',
    icp: 'B2C, edukacja, usługi masowe',
    usage: 'Najszerszy punkt wejścia dla zapytań poradnikowych i rekomendacyjnych.',
    roi: 'Pierwszy wybór, gdy liczy się skala zapytań i świadomość marki.',
  },
  {
    model: 'Claude',
    icp: 'technologie B2B, SaaS, doradztwo',
    usage: 'Dłuższe analizy, badania, porównania ofert i dokumentów.',
    roi: 'Najlepszy przy droższych usługach i dłuższym procesie decyzyjnym.',
  },
  {
    model: 'Gemini',
    icp: 'E-commerce, lokalne usługi, marki z SEO',
    usage: 'Odpowiedzi powiązane z indeksem Google i AI Overviews.',
    roi: 'Dobry wybór, gdy masz już mocny content i autorytet w Google.',
  },
  {
    model: 'Perplexity',
    icp: 'Finanse, medycyna, prawo, badania B2B',
    usage: 'Zapytania wymagające jawnych źródeł i szybkiej weryfikacji.',
    roi: 'Wysoki, gdy masz cytowalne raporty, dane i eksperckie strony ofertowe.',
  },
  {
    model: 'Microsoft Copilot',
    icp: 'Enterprise, Microsoft 365, Windows',
    usage: 'Środowiska firmowe, Edge, Bing i asystenci w pakiecie Microsoft.',
    roi: 'Najlepszy jako kanał wspierający dla segmentu korporacyjnego.',
  },
] as const;

const processSteps = [
  {
    phase: 'Tydzień 1–2',
    title: 'Audyt i punkt zerowy',
    desc: 'Odpytujemy pięć modeli powtarzalnym zestawem promptów z Twojej kategorii i liczymy, w jakim odsetku odpowiedzi pada nazwa Twojej marki. Sprawdzamy też, czy modele opisują firmę zgodnie z prawdą i kto jest polecany zamiast Ciebie. Wynik to liczba, do której wracamy w każdym kolejnym pomiarze.',
  },
  {
    phase: 'Tydzień 2–3',
    title: 'Dostęp dla botów i encja marki',
    desc: 'Odblokowanie GPTBota, OAI-SearchBota, ClaudeBota, PerplexityBota i Google-Extended w robots.txt oraz na firewallu, wdrożenie Schema.org Organization i Person z sameAs, uspójnienie danych o firmie w sieci. Bez tego kroku reszta prac nie ma jak zadziałać.',
  },
  {
    phase: 'Tydzień 3–6',
    title: 'Przebudowa treści pod cytowalność',
    desc: 'Fakty, liczby i jednoznaczne definicje w pierwszych akapitach, akapity domykane tak, by dało się je wyciąć jako samodzielny cytat, tabele porównawcze i sekcje FAQ. Zaczynamy od stron, które już mają widoczność w Google i Bingu – tam efekt przychodzi najszybciej.',
  },
  {
    phase: 'Miesiąc 2–3',
    title: 'Wzmianki marki poza własną domeną',
    desc: 'Modele cytują to, co powtarza się w wielu źródłach. Planujemy obecność w mediach branżowych, katalogach, zestawieniach i materiałach eksperckich – to jedyny kanał, który wpływa na dane treningowe modelu, a nie tylko na generowanie wspomagane wyszukiwaniem (RAG).',
  },
  {
    phase: 'Od miesiąca 2, stale',
    title: 'Monitoring i korekta kursu',
    desc: 'Cotygodniowe pomiary 50–200 zapytań, alerty o ruchach konkurencji i panel z historią widoczności. Co miesiąc porównujemy udział marki w odpowiedziach z punktem zerowym i przenosimy budżet tam, gdzie cytowania w odpowiedziach AI rosną najszybciej.',
  },
] as const;

const timingNotes = [
  {
    label: 'Generowanie wspomagane wyszukiwaniem',
    value: 'dni',
    desc: 'ChatGPT Search, Perplexity i Copilot pobierają treść w momencie zapytania – poprawiona strona może zostać zacytowana w odpowiedziach AI w ciągu kilku dni od zaindeksowania.',
  },
  {
    label: 'Dane treningowe',
    value: 'miesiące',
    desc: 'Wzmianki marki w źródłach zewnętrznych działają dopiero, gdy trafią do korpusu treningowego kolejnej wersji modelu. To inwestycja liczona w kwartałach, nie tygodniach.',
  },
  {
    label: 'Pierwszy wiarygodny pomiar',
    value: '4–6 tygodni',
    desc: 'Wcześniejsze odczyty są zbyt zaszumione – generowanie odpowiedzi jest niedeterministyczne, więc trend widać dopiero po kilku seriach pomiarów.',
  },
] as const;

const proofKpis = [
  { value: '2 296', label: 'cytowań w odpowiedziach AI', detail: 'na sześciu platformach generatywnych' },
  { value: '213', label: 'cytowanych podstron', detail: 'ruch nie opiera się na jednym tekście' },
  { value: '~480', label: 'pobrań dziennie przez ChatGPT', detail: '3 340 żądań ChatGPT-User w 7 dni' },
  { value: '4,5', label: 'miesiąca od startu', detail: 'od pierwszej indeksacji do tych wyników' },
] as const;

const proofPlatforms = [
  { platform: 'ChatGPT', citations: '716', pages: '213' },
  { platform: 'Microsoft Copilot', citations: '526', pages: '160' },
  { platform: 'Perplexity', citations: '510', pages: '139' },
  { platform: 'Google AI Mode', citations: '260', pages: '108' },
  { platform: 'Google AI Overviews', citations: '249', pages: '103' },
  { platform: 'Gemini', citations: '35', pages: '23' },
] as const;

const faqItems = [
  {
    q: 'Jak pozycjonować stronę w AI?',
    a: 'Pozycjonowanie w AI opiera się na trzech grupach działań. Po pierwsze, dostęp: modele muszą móc pobrać stronę, więc GPTBot, OAI-SearchBot, ClaudeBot, PerplexityBot i Google-Extended nie mogą być blokowane. Po drugie, cytowalność: treść musi zawierać fakty, liczby i definicje w pierwszych akapitach oraz dać się wyciąć jako samodzielny fragment. Po trzecie, encja: spójne dane o firmie, Schema.org i wzmianki marki w źródłach zewnętrznych, z których modele budują wiedzę o marce.',
  },
  {
    q: 'Czym pozycjonowanie AI różni się od klasycznego SEO?',
    a: 'Klasyczne SEO walczy o pozycję adresu URL w rankingu, pozycjonowanie AI – o wzmiankę marki lub cytowanie w odpowiedziach AI. Jednostką nie jest strona, tylko fragment treści i encja marki. Metryką nie jest pozycja i CTR, tylko udział marki w odpowiedziach (Share of Model) i liczba cytowań. Pozycjonowanie AI nie zastępuje SEO – korzysta z jego fundamentów, czyli indeksacji, szybkości i autorytetu domeny.',
  },
  {
    q: 'Ile trwa, zanim marka zacznie pojawiać się w odpowiedziach AI?',
    a: 'To zależy od kanału. W trybie generowania wspomaganego wyszukiwaniem (RAG) poprawiona strona może zostać zacytowana w ciągu kilku dni od zaindeksowania w Bingu lub Google. Dane treningowe modelu aktualizują się dopiero przy jego kolejnej wersji, więc efekt wzmianek marki w źródłach zewnętrznych liczy się w miesiącach. Pierwszy wiarygodny pomiar trendu robimy po 4–6 tygodniach, bo generowanie odpowiedzi jest niedeterministyczne i pojedynczy odczyt niczego nie dowodzi.',
  },
  {
    q: 'Czy widoczność w AI da się w ogóle zmierzyć?',
    a: 'Tak, ale nie pojedynczym pytaniem w czacie. Model generuje kolejne tokeny niedeterministycznie, więc dwa przebiegi tego samego promptu dają różne odpowiedzi. Pomiar polega na powtarzalnym odpytywaniu stałego zestawu zapytań w wielu seriach i liczeniu, w jakim odsetku odpowiedzi pada nazwa marki oraz jak często strona jest cytowana jako źródło. Punkt startowy sprawdzisz sam w narzędziu Widoczność marki w AI, które odpytuje cztery silniki naraz.',
  },
  {
    q: 'Od którego modelu zacząć?',
    a: 'Od tego, w którym Twoi klienci już zadają pytania. ChatGPT ma najszerszy zasięg i sprawdza się przy zapytaniach poradnikowych i rekomendacyjnych, Perplexity przy branżach wymagających jawnych źródeł (finanse, medycyna, prawo), Gemini przy markach z mocnym SEO w Google, Copilot w segmencie korporacyjnym z pakietem Microsoft 365. Monitoring warto od razu ustawić na wszystkie pięć, żeby porównać koszt treści z realną szansą na cytowanie.',
  },
  {
    q: 'Czy trzeba mieć dobre SEO, żeby AI cytowało markę?',
    a: 'W trybie generowania wspomaganego wyszukiwaniem (RAG) – praktycznie tak, bo modele sięgają po strony z indeksów Binga i Google (w przypadku Google AI Mode kluczowe jest szerokie pokrycie semantyczne, tzw. <em>semantic completeness</em>, ze względu na wykorzystywaną przez Google technikę <em>query fan out</em>). Strona niezaindeksowana albo ładująca się zbyt wolno zwykle nie trafia do zestawu pobranych źródeł. Dane treningowe działają inaczej: tu liczą się wzmianki marki w mediach, katalogach i encyklopediach, więc marka może być wymieniana przez model nawet bez wysokich pozycji w Google.',
  },
  {
    q: 'Ile kosztuje pozycjonowanie AI?',
    a: 'Nie publikujemy cennika – wycena jest indywidualna i ustalamy ją po rozmowie. Zakres zależy od liczby monitorowanych modeli i zapytań, stanu wyjściowego strony oraz tego, ile treści trzeba przebudować. Punktem wyjścia jest audyt widoczności: daje liczbę, od której zaczynamy, i listę prac uszeregowaną według kosztu do efektu. Budżet ustalamy dopiero na jego podstawie, bo bez pomiaru każda oferta jest zgadywaniem.',
  },
] as const;

const siteUrl = 'https://widocznosc.ai';
const pageUrl = `${siteUrl}/pozycjonowanie-ai/`;
const pageDescription =
  'Pozycjonowanie pod LLM – widoczność marki w ChatGPT, Claude, Gemini, Perplexity i Microsoft Copilot. Audyt cytowań, optymalizacja treści pod modele językowe, monitoring, strategia GEO.';

const serviceSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': `${pageUrl}#webpage`,
      url: pageUrl,
      name: 'Pozycjonowanie pod LLM – pozycjonowanie AI',
      description: pageDescription,
      isPartOf: {
        '@type': 'WebSite',
        name: 'widocznosc.ai',
        url: siteUrl,
      },
      breadcrumb: {
        '@id': `${pageUrl}#breadcrumb`,
      },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${pageUrl}#breadcrumb`,
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Strona główna',
          item: `${siteUrl}/`,
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Pozycjonowanie AI',
          item: pageUrl,
        },
      ],
    },
    {
      '@type': 'Service',
      '@id': `${pageUrl}#service`,
      serviceType: 'Generative Engine Optimization',
      name: 'Pozycjonowanie w wyszukiwarkach AI',
      description: pageDescription,
      provider: {
        '@type': 'Organization',
        name: 'widocznosc.ai',
        url: siteUrl,
        parentOrganization: {
          '@type': 'Organization',
          name: 'ICEA',
          url: 'https://grupa-icea.pl',
        },
      },
      areaServed: {
        '@type': 'Country',
        name: 'Polska',
      },
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'Pozycjonowanie w wyszukiwarkach AI',
        itemListElement: services.map((service) => ({
          '@type': 'Offer',
          itemOffered: {
            '@type': 'Service',
            name: service.title,
            description: service.desc,
          },
        })),
      },
    },
    faqPageNode([...faqItems], pageUrl),
  ],
};
---

<Layout
  title="Pozycjonowanie pod LLM – widoczność marki w ChatGPT, Gemini, Perplexity"
  description={pageDescription}
>
  <Navbar />
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />

  <section class="pillar-hero">
    <div class="content-container">
      <div class="pillar-hero-inner">
        <span class="eyebrow pillar-hero-eyebrow">Usługi · Generative Engine Optimization</span>
        <h1 class="display-xxl pillar-hero-title">
          Pozycjonowanie pod&nbsp;<span class="accent">LLM</span>
        </h1>
        <p class="pillar-hero-lead">
          Pozycjonowanie AI to budowanie widoczności marki w ChatGPT, Claude'zie, Gemini, Perplexity
          i Microsoft Copilocie – tam, gdzie odpowiedzi generują duże modele językowe (LLM-y). W
          nowym standardzie wyszukiwania nie walczymy o pozycje w rankingu – walczymy o bycie
          cytowanym źródłem. Ponieważ każdy model AI wymaga innego podejścia, wybierz konkretny
          silnik poniżej lub zacznij od kompleksowego audytu wszystkich pięciu.
        </p>
        <div class="pillar-hero-actions">
          <a class="btn-primary" href="/kontakt/?type=audyt-ai">Zamów audyt wszystkich modeli</a>
          <a class="btn-secondary" href="/narzedzia/brand-check/">Sprawdź widoczność · 60s</a>
        </div>
      </div>
    </div>
  </section>

  <section class="hero-stat-strip" aria-label="Liczby dla pozycjonowania AI">
    <div class="content-container">
      <dl class="hero-stat-grid">
        {
          heroStats.map((stat) => (
            <div class="hero-stat-cell">
              <dt>{stat.label}</dt>
              <dd>{stat.value}</dd>
              <p>{stat.detail}</p>
            </div>
          ))
        }
      </dl>
    </div>
  </section>


  <nav class="service-toc" aria-label="Spis treści strony">
    <div class="content-container service-toc-inner">
      <a href="#definicja">Czym jest</a>
      <a href="#modele">5 modeli</a>
      <a href="#metodologia">Zakres prac</a>
      <a href="#proces">Przebieg wdrożenia</a>
      <a href="#dowod">Efekty</a>
      <a href="#decyzja">Od czego zacząć</a>
      <a href="#faq">FAQ</a>
    </div>
  </nav>

  <!-- Definicja – pozycjonowanie pod LLM -->
  <section id="definicja" class="pillar-section" aria-labelledby="llm-title">
    <div class="content-container">
      <header class="section-head">
        <div class="head-left">
          <div class="head-meta">
            <span class="section-index">P/01</span>
            <span class="eyebrow">Definicja</span>
          </div>
          <h2 id="llm-title" class="display-xl">Czym jest pozycjonowanie pod LLM?</h2>
        </div>
        <div class="head-right">
          <p class="subhead">
            Pozycjonowanie pod LLM (ang. LLM SEO, GEO – Generative Engine Optimization) to zestaw
            działań, dzięki którym duże modele językowe wymieniają, polecają i cytują Twoją markę,
            gdy użytkownik pyta o produkty, usługi lub rozwiązania z Twojej kategorii.
          </p>
        </div>
      </header>

      <div class="llm-grid">
        <div class="llm-copy">
          <p>
            Model językowy nie ma rankingu stron. Odpowiedź buduje z dwóch źródeł: z danych
            treningowych zamrożonych w wagach modelu oraz z fragmentów stron pobranych w czasie
            rzeczywistym przez generowanie wspomagane wyszukiwaniem (RAG – np. ChatGPT Search,
            Gemini z indeksem Google, Perplexity, Copilot z indeksem Binga). <strong>Pozycjonowanie pod LLM działa więc na obu ścieżkach
            naraz:</strong> długofalowo – przez obecność marki w źródłach, które trafiają do korpusów
            treningowych; krótkofalowo – przez treści, które da się wyciąć jako samodzielny,
            faktograficzny fragment i zacytować w odpowiedzi z przypisem.
          </p>
          <p>
            W praktyce oznacza to inne priorytety niż w klasycznym SEO. Zamiast pozycji URL-a
            liczy się udział marki w odpowiedziach (Share of Model), liczba cytowań i to, czy model
            opisuje firmę zgodnie z prawdą. Zamiast profilu linków – wzmianki marki w wiarygodnych
            źródłach i spójność danych o firmie w sieci. Zamiast nasycenia frazami – gęstość
            faktów, liczb i jednoznacznych stwierdzeń w pierwszych akapitach, dane strukturalne
            Schema.org i dostęp dla botów AI w robots.txt.
          </p>
          <p>
            Pozycjonowanie pod LLM nie zastępuje SEO – korzysta z jego fundamentów (indeksacja,
            szybkość, autorytet domeny), ale mierzy inny wynik: czy w rozmowie z AI Twoja marka
            pojawia się jako odpowiedź. Jak to działa po stronie modelu, tłumaczymy w artykule
            <a href="/modele-llm/jak-dziala-chatgpt/">jak działa ChatGPT</a>, a definicję
            dyscypliny rozwija <a href="/geo/przewodnik/">przewodnik po GEO</a>.
          </p>
        </div>
        <aside class="llm-aside" aria-label="Pozycjonowanie pod LLM w liczbach i zadaniach">
          <div class="llm-aside-block">
            <span class="eyebrow">SEO vs. LLM</span>
            <dl class="llm-compare">
              <div><dt>Cel</dt><dd>pozycja URL-a → wzmianka marki lub cytowanie w odpowiedziach AI</dd></div>
              <div><dt>Metryka</dt><dd>pozycja i CTR → Share of Model, Citation Rate</dd></div>
              <div><dt>Jednostka</dt><dd>strona → fragment (chunk) i encja (marka)</dd></div>
              <div><dt>Czas efektu</dt><dd>tygodnie → dni (RAG) lub miesiące (dane treningowe)</dd></div>
            </dl>
          </div>
          <div class="llm-aside-block">
            <span class="eyebrow">Na co wpływamy</span>
            <ul class="llm-list">
              <li>Cytowalność treści – fakty, liczby, definicje w pierwszych 200 słowach</li>
              <li>Encja marki – spójne dane, Schema.org Organization + Person + sameAs</li>
              <li>Dostęp botów – GPTBot, OAI-SearchBot, ClaudeBot, PerplexityBot, Google-Extended</li>
              <li>Wzmianki marki – obecność w mediach, katalogach i źródłach cytowanych przez modele</li>
              <li>Pomiar – powtarzalne testy promptów i monitoring udziału w odpowiedziach</li>
            </ul>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- 5 modeli AI – grid z linkami do podstron -->
  <section id="modele" class="pillar-section" aria-labelledby="models-title">
    <div class="content-container">
      <header class="section-head">
        <div class="head-left">
          <div class="head-meta">
            <span class="section-index">P/02</span>
            <span class="eyebrow">5 modeli</span>
          </div>
          <h2 id="models-title" class="display-xl">
            Wybierz silnik AI, w którym chcesz być widoczny
          </h2>
        </div>
        <div class="head-right">
          <p class="subhead">
            Każdy model AI inaczej buduje swoje odpowiedzi: ChatGPT łączy dane treningowe z
            generowaniem wspomaganym wyszukiwaniem (RAG), Gemini cytuje bezpośrednio z indeksu
            Google, a Perplexity stawia na maksymalną transparentność źródeł. Optymalizacja pod tylko jeden model to dziś za
