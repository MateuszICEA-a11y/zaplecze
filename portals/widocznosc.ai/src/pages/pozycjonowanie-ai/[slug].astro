  }

  .chatgpt-msg--user {
    justify-self: end;
    max-width: 82%;
    padding: 0.7rem 1rem;
    border-radius: 1.15rem;
    border-bottom-right-radius: 0.35rem;
    background: var(--bg-surface-2);
    color: var(--ink);
    font-size: 0.94rem;
    line-height: 1.5;
  }

  .chatgpt-search-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    justify-self: start;
    padding: 0.4rem 0.75rem;
    border: 1px solid var(--hairline-soft);
    border-radius: var(--r-pill);
    background: var(--bg-canvas);
    color: var(--ink-muted);
    font-size: 0.8rem;
  }

  .chatgpt-search-spinner {
    width: 0.75rem;
    height: 0.75rem;
    border: 2px solid var(--hairline-soft);
    border-top-color: var(--citation-brand);
    border-radius: 50%;
    animation: chatgpt-spin 0.9s linear infinite;
  }

  @keyframes chatgpt-spin {
    to {
      transform: rotate(360deg);
    }
  }

  .chatgpt-msg--assistant {
    display: grid;
    gap: 0.85rem;
    color: var(--ink);
    font-size: 0.94rem;
    line-height: 1.6;
  }

  .chatgpt-msg--assistant p {
    margin: 0;
  }

  .chatgpt-reco {
    position: relative;
    display: grid;
    gap: 0.6rem;
    padding: 0.9rem 1rem;
    border: 1px solid var(--hairline-soft);
    border-radius: var(--r-md);
    background: color-mix(in srgb, var(--bg-canvas) 72%, var(--bg-surface-1));
  }

  .chatgpt-reco p {
    color: var(--ink-muted);
    font-size: 0.88rem;
  }

  .chatgpt-reco-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
  }

  .chatgpt-reco-name {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.55rem;
  }

  .chatgpt-redacted {
    min-width: 11rem;
    height: 1.35em;
    transform: none;
  }

  .chatgpt-reco-badge {
    padding: 0.28rem 0.5rem;
    border-radius: var(--r-pill);
    background: color-mix(in srgb, var(--citation-brand) 12%, transparent);
    color: var(--citation-brand);
    font-size: 0.68rem;
    font-weight: 800;
    line-height: 1;
  }

  .chatgpt-reco-rating {
    color: var(--ink);
    font-size: 0.82rem;
    font-weight: 650;
    white-space: nowrap;
  }

  .chatgpt-caret {
    position: absolute;
    right: 0.8rem;
    bottom: 0.7rem;
    width: 0.52rem;
    height: 1.05em;
    background: var(--ink);
    animation: chatgpt-blink 1.05s steps(1) infinite;
  }

  @keyframes chatgpt-blink {
    50% {
      opacity: 0;
    }
  }

  .chatgpt-sources {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
  }

  .chatgpt-sources-label {
    color: var(--ink-faint);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .chatgpt-source-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.32rem 0.65rem;
    border: 1px solid color-mix(in srgb, var(--citation-brand) 28%, var(--hairline-soft));
    border-radius: var(--r-pill);
    background: color-mix(in srgb, var(--citation-brand) 8%, var(--bg-canvas));
    color: var(--citation-brand);
    font-family: ui-monospace, 'JetBrains Mono', monospace;
    font-size: 0.76rem;
  }

  .chatgpt-source-chip::before {
    content: '';
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 50%;
    background: var(--citation-brand);
    opacity: 0.7;
  }

  .chatgpt-inputbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin: 0.35rem 1.2rem 1.1rem;
    padding: 0.75rem 0.85rem 0.75rem 1.05rem;
    border: 1px solid var(--hairline-soft);
    border-radius: var(--r-pill);
    background: var(--bg-canvas);
    color: var(--ink-faint);
    font-size: 0.88rem;
  }

  .chatgpt-inputbar-send {
    display: grid;
    place-items: center;
    width: 1.85rem;
    height: 1.85rem;
    border-radius: 50%;
    background: var(--ink);
    color: var(--bg-canvas);
    font-size: 0.95rem;
    font-weight: 700;
  }

  /* Animacja „streamowania" – elementy wjeżdżają po wejściu okna w viewport */
  .chatgpt-window[data-armed]:not(.is-on) .cg-reveal {
    opacity: 0;
    transform: translateY(8px);
  }

  .chatgpt-window .cg-reveal {
    transition:
      opacity 0.45s ease var(--d, 0ms),
      transform 0.45s ease var(--d, 0ms);
  }

  @media (prefers-reduced-motion: reduce) {
    .chatgpt-window .cg-reveal {
      transition: none;
    }

    .chatgpt-window[data-armed]:not(.is-on) .cg-reveal {
      opacity: 1;
      transform: none;
    }

    .chatgpt-search-spinner,
    .chatgpt-caret {
      animation: none;
    }
  }

  .citation-answer--claude {
    display: grid;
    gap: 1rem;
    background: var(--bg-canvas);
    color: var(--ink);
  }

  .citation-answer--copilot {
    background: var(--bg-canvas);
    color: var(--ink);
    font-size: clamp(1rem, 1.35vw, 1.18rem);
    line-height: 1.78;
  }

  .citation-answer--copilot p {
    margin: 0;
  }

  .citation-answer--gemini {
    display: grid;
    gap: 1.2rem;
    background: var(--bg-canvas);
    color: var(--ink);
    font-size: clamp(0.98rem, 1.25vw, 1.1rem);
    line-height: 1.65;
  }

  .citation-answer--gemini p {
    margin: 0;
  }

  .citation-gemini-section {
    display: grid;
    gap: 0.8rem;
  }

  .citation-gemini-section h3 {
    margin: 0;
    color: var(--ink);
    font-family: var(--font-sans);
    font-size: clamp(1rem, 1.4vw, 1.16rem);
    font-weight: 800;
    line-height: 1.35;
  }

  .citation-restaurant-list,
  .citation-restaurant-list ul {
    display: grid;
    gap: 0.7rem;
    margin: 0;
    padding-left: 1.2rem;
  }

  .citation-restaurant-list ul {
    gap: 0.55rem;
    padding-left: 1.1rem;
    color: var(--ink-muted);
  }

  .citation-restaurant-name {
    display: inline-flex;
    min-width: 9rem;
    height: 1.28em;
    transform: translateY(0.14em);
    border-radius: var(--r-xs);
    background:
      repeating-linear-gradient(
        135deg,
        color-mix(in srgb, var(--citation-brand) 28%, transparent) 0 8px,
        color-mix(in srgb, var(--citation-brand) 16%, transparent) 8px 16px
      ),
      color-mix(in srgb, var(--citation-brand) 10%, var(--bg-surface-2));
    color: transparent;
    user-select: none;
  }

  .citation-answer--perplexity {
    display: grid;
    gap: 1.15rem;
    background: var(--bg-canvas);
    color: var(--ink);
    font-size: clamp(0.98rem, 1.28vw, 1.12rem);
    line-height: 1.7;
  }

  .citation-answer--perplexity p {
    margin: 0;
  }

  .citation-perplexity-section {
    display: grid;
    gap: 0.7rem;
  }

  .citation-perplexity-section h3 {
    margin: 0;
    color: var(--ink);
    font-family: var(--font-sans);
    font-size: clamp(1rem, 1.35vw, 1.14rem);
    font-weight: 800;
    line-height: 1.3;
  }

  .citation-perplexity-list {
    display: grid;
    gap: 0.6rem;
    margin: 0;
    padding-left: 1.2rem;
    color: var(--ink-muted);
  }

  .citation-reference-chip {
    display: inline-flex;
    align-items: center;
    width: 4.2rem;
    height: 1.25em;
    transform: translateY(0.14em);
    border-radius: var(--r-xs);
    background:
      repeating-linear-gradient(
        135deg,
        color-mix(in srgb, var(--citation-brand) 24%, transparent) 0 7px,
        color-mix(in srgb, var(--citation-brand) 13%, transparent) 7px 14px
      ),
      color-mix(in srgb, var(--citation-brand) 8%, var(--bg-surface-2));
    color: transparent;
    user-select: none;
  }

  .citation-redacted-inline {
    display: inline-flex;
    align-items: center;
    min-width: 5.7rem;
    height: 1.25em;
    transform: translateY(0.12em);
    border-radius: var(--r-xs);
    background:
      repeating-linear-gradient(
        135deg,
        color-mix(in srgb, var(--citation-brand) 28%, transparent) 0 8px,
        color-mix(in srgb, var(--citation-brand) 16%, transparent) 8px 16px
      ),
      color-mix(in srgb, var(--citation-brand) 10%, var(--bg-surface-2));
    color: transparent;
    user-select: none;
  }

  .citation-tools {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    gap: 0.4rem;
    color: var(--ink-muted);
    font-size: 0.9rem;
  }

  .citation-tools::after {
    content: '›';
    font-size: 1.1rem;
    line-height: 1;
  }

  .citation-local-pack {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(13.5rem, 0.72fr);
    overflow: hidden;
    min-height: 17.5rem;
    border: 1px solid var(--hairline-soft);
    border-radius: var(--r-lg);
    background: color-mix(in srgb, var(--bg-surface-2) 70%, var(--bg-canvas));
  }

  .citation-map {
    position: relative;
    min-height: 17.5rem;
    overflow: hidden;
    background:
      linear-gradient(35deg, transparent 0 46%, rgba(35, 122, 255, 0.22) 46% 48%, transparent 48%),
      linear-gradient(112deg, transparent 0 38%, rgba(35, 122, 255, 0.18) 38% 40%, transparent 40%),
      linear-gradient(0deg, rgba(34, 197, 94, 0.13) 0 34%, transparent 34% 100%),
      linear-gradient(90deg, rgba(56, 189, 248, 0.1) 0 28%, transparent 28% 100%),
      var(--bg-surface-1);
  }

  .citation-road {
    position: absolute;
    border-radius: var(--r-pill);
    background: color-mix(in srgb, var(--citation-brand) 40%, #9ca3af);
    opacity: 0.72;
  }

  .citation-road--a {
    width: 120%;
    height: 0.7rem;
    left: -12%;
    top: 35%;
    transform: rotate(17deg);
  }

  .citation-road--b {
    width: 0.7rem;
    height: 125%;
    left: 52%;
    top: -10%;
    transform: rotate(14deg);
  }

  .citation-road--c {
    width: 96%;
    height: 0.55rem;
    left: 5%;
    top: 72%;
    transform: rotate(-9deg);
    opacity: 0.46;
  }

  .citation-map-label,
  .citation-rating {
    position: absolute;
    z-index: 2;
    font-weight: 800;
  }

  .citation-map-label {
    color: var(--ink-muted);
    font-size: 0.74rem;
    letter-spacing: 0.08em;
  }

  .citation-map-label--top {
    left: 54%;
    top: 9%;
  }

  .citation-map-label--mid {
    left: 34%;
    top: 45%;
  }

  .citation-map-label--low {
    left: 45%;
    bottom: 19%;
  }

  .citation-rating {
    display: grid;
    place-items: center;
    min-width: 2.35rem;
    height: 2rem;
    border: 1px solid var(--hairline-soft);
    border-radius: var(--r-sm);
    background: var(--bg-canvas);
    color: var(--ink);
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.18);
  }

  .citation-rating--one {
    right: 18%;
    top: 33%;
  }

  .citation-rating--two {
    right: 13%;
    top: 49%;
  }

  .citation-rating--three {
    left: 24%;
    bottom: 22%;
  }

  .citation-local-results {
    display: grid;
    align-content: start;
    gap: 0.65rem;
    padding: 1rem;
    background: color-mix(in srgb, var(--bg-canvas) 92%, var(--bg-surface-1));
  }

  .citation-local-results h3 {
    margin: 0;
    color: var(--ink);
    font-family: var(--font-sans);
    font-size: clamp(1.05rem, 1.55vw, 1.35rem);
    line-height: 1.18;
  }

  .citation-local-results button {
    width: fit-content;
    border: 1px solid var(--hairline-soft);
    border-radius: var(--r-sm);
    background: var(--bg-surface-1);
    color: var(--ink);
    padding: 0.45rem 0.75rem;
    font: inherit;
  }

  .citation-place-card {
    display: grid;
    grid-template-columns: 3.25rem 1fr;
    gap: 0.65rem;
    padding: 0.65rem;
    border-radius: var(--r-md);
    background: var(--bg-surface-1);
  }

  .citation-place-thumb {
    min-height: 3.25rem;
    border-radius: var(--r-sm);
    background:
      linear-gradient(145deg, rgba(255, 255, 255, 0.2), transparent),
      color-mix(in srgb, var(--citation-brand) 18%, var(--bg-surface-2));
  }

  .citation-place-thumb--blue {
    background:
      linear-gradient(145deg, rgba(255, 255, 255, 0.22), transparent),
      color-mix(in srgb, var(--accent-blue) 35%, var(--bg-surface-2));
  }

  .citation-place-card strong {
    display: block;
    color: var(--ink);
    font-size: 0.9rem;
    line-height: 1.2;
  }

  .citation-place-name-redacted {
    display: inline-flex;
    min-width: 7.25rem;
    height: 1.15em;
    transform: translateY(0.12em);
    border-radius: var(--r-xs);
    background:
      repeating-linear-gradient(
        135deg,
        color-mix(in srgb, var(--citation-brand) 28%, transparent) 0 7px,
        color-mix(in srgb, var(--citation-brand) 15%, transparent) 7px 14px
      ),
      color-mix(in srgb, var(--citation-brand) 9%, var(--bg-surface-2));
    color: transparent;
    user-select: none;
  }

  .citation-place-card p {
    margin: 0.2rem 0 0;
    color: var(--ink-muted);
    font-size: 0.76rem;
    line-height: 1.35;
  }

  .citation-source {
    border: 1px solid color-mix(in srgb, var(--citation-brand) 34%, var(--hairline-soft));
    background: color-mix(in srgb, var(--citation-brand) 9%, var(--bg-canvas));
  }

  .model-differentiator {
    display: inline-flex;
    align-self: flex-start;
    margin-top: 0.65rem;
    padding: 0.28rem 0.5rem;
    border-radius: var(--r-pill);
    background: var(--bg-canvas);
    color: var(--accent-blue);
    font-size: 0.72rem;
    font-weight: 800;
  }

  .other-model-card {
    --other-accent: var(--accent-blue);
    border-radius: 15px;
    padding: 24px;
    background:
      radial-gradient(
        circle at 14% 0%,
        color-mix(in srgb, var(--other-accent) 13%, transparent) 0%,
        transparent 34%
      ),
      var(--bg-surface-1);
  }

  .other-model-card--claude {
    --other-accent: #4ade80;
  }

  .other-model-card--gemini {
    --other-accent: #fbbf24;
  }

  .other-model-card--perplexity {
    --other-accent: #a78bfa;
  }

  .other-model-card--bing-copilot {
    --other-accent: #22d3ee;
  }

  :global(:root[data-theme='light']) .other-model-card--claude {
    --other-accent: #16a34a;
  }

  :global(:root[data-theme='light']) .other-model-card--gemini {
    --other-accent: #d97706;
  }

  :global(:root[data-theme='light']) .other-model-card--perplexity {
    --other-accent: #7c3aed;
  }

  .other-model-card .model-differentiator {
    color: var(--other-accent);
  }

  .model-comparison {
    margin-top: 1.25rem;
    padding: clamp(1.1rem, 2.5vw, 1.65rem);
    border: 1px solid var(--hairline-soft);
    border-radius: 22px;
    background: color-mix(in srgb, var(--bg-surface-1) 82%, var(--bg-canvas));
    overflow-x: auto;
  }

  .comparison-head {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(18rem, 0.75fr);
    align-items: end;
    gap: 1.5rem;
    margin-bottom: 1.25rem;
    padding-bottom: 1.15rem;
    border-bottom: 1px solid var(--hairline-soft);
  }

  .comparison-head span {
    display: block;
    color: var(--ink-muted);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .comparison-head strong {
    display: block;
    margin-top: 0.35rem;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2vw, 1.7rem);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.05;
  }

  .comparison-head p {
    max-width: 46rem;
    color: var(--ink-muted);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .comparison-table {
    display: grid;
    grid-template-columns: minmax(11rem, 1.05fr) repeat(5, minmax(8.5rem, 1fr));
    min-width: 940px;
    overflow: hidden;
    border: 1px solid var(--hairline-soft);
    border-radius: 18px;
    color: var(--ink-muted);
    background: var(--bg-canvas);
  }

  .comparison-row {
    display: contents;
  }

  .comparison-cell {
    min-width: 0;
    padding: 1rem 1.05rem;
    border-top: 1px solid var(--hairline-soft);
    border-left: 1px solid var(--hairline-soft);
    font-size: 0.9rem;
    line-height: 1.4;
  }

  .comparison-cell--empty,
  .comparison-model {
    border-top: 0;
    background: color-mix(in srgb, var(--bg-surface-1) 74%, var(--bg-canvas));
  }

  .comparison-cell--empty,
  .comparison-metric {
    border-left: 0;
  }

  .comparison-model {
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .comparison-metric {
    color: var(--ink);
    font-weight: 650;
  }

  .comparison-value {
    font-weight: 560;
  }

  .comparison-cell.is-active {
    color: var(--ink);
    background: color-mix(in srgb, var(--accent-blue) 10%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--accent-blue) 26%, transparent);
  }

  .service-section-title {
    text-wrap: balance;
  }

  /* Lejek zapytań (TOFU/MOFU/BOFU) */
  .funnel-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  .funnel-card {
    --funnel-accent: var(--accent-blue);
    display: flex;
    flex-direction: column;
    padding: 1.75rem;
    border: 1px solid var(--hairline-soft);
    border-radius: 15px;
    background:
      radial-gradient(
        circle at 12% 0%,
        color-mix(in srgb, var(--funnel-accent) 12%, transparent) 0%,
        transparent 34%
      ),
      var(--bg-surface-1);
  }

  .funnel-card--mofu {
    --funnel-accent: #fbbf24;
  }

  .funnel-card--bofu {
    --funnel-accent: #4ade80;
  }

  :global(:root[data-theme='light']) .funnel-card--mofu {
    --funnel-accent: #d97706;
  }

  :global(:root[data-theme='light']) .funnel-card--bofu {
    --funnel-accent: #16a34a;
  }

  .funnel-stage {
    display: inline-flex;
    align-self: flex-start;
    padding: 0.3rem 0.6rem;
    border-radius: var(--r-pill);
    background: color-mix(in srgb, var(--funnel-accent) 14%, transparent);
    color: var(--funnel-accent);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  .funnel-label {
    margin: 0.9rem 0 0.6rem;
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 500;
    letter-spacing: -0.4px;
    color: var(--ink);
  }

  .funnel-desc {
    margin: 0 0 1.1rem;
    color: var(--ink-muted);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .funnel-list-head {
    margin: 0.35rem 0 0.5rem;
    color: var(--ink-faint);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .funnel-list {
    display: grid;
    gap: 0.45rem;
    margin: 0 0 1rem;
    padding-left: 1.1rem;
    color: var(--ink-muted);
    font-size: 0.88rem;
    line-height: 1.5;
  }

  .funnel-list--onpage {
    margin-bottom: 0;
  }

  /* Samodzielny test – prompt + interpretacja */
  .prompt-check {
    background: var(--bg-canvas);
    border-top: 1px solid var(--hairline-soft);
    border-bottom: 1px solid var(--hairline-soft);
  }

  .prompt-box {
    overflow: hidden;
    border: 1px solid var(--hairline-soft);
    border-radius: 15px;
    background: var(--bg-surface-1);
  }

  .prompt-box-head {
    padding: 0.75rem 1.15rem;
    border-bottom: 1px solid var(--hairline-soft);
    color: var(--ink-faint);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .prompt-box-body {
    margin: 0;
    padding: 1.15rem 1.25rem;
    overflow-x: auto;
    color: var(--ink);
    font-family: ui-monospace, 'JetBrains Mono', monospace;
    font-size: 0.88rem;
    line-height: 1.65;
    white-space: pre-wrap;
  }

  .verdict-grid {
    display: grid;
    grid-template-columns: 1fr;
