<script>
  // Symulacja streamowania w oknie ChatGPT – start po wejściu okna w viewport.
  const initChatgptMock = () => {
    const win = document.querySelector('.chatgpt-window');
    if (!(win instanceof HTMLElement) || win.dataset.armed) return;
    win.dataset.armed = '1';
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            win.classList.add('is-on');
            io.disconnect();
          }
        }
      },
      { threshold: 0.35 }
    );
    io.observe(win);
  };
  document.addEventListener('astro:page-load', initChatgptMock);
</script>
