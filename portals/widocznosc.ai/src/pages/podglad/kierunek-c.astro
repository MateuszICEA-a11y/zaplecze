---
/**
 * Podgląd kierunku C – „Manifest w liczbach” (editorial poster).
 * Ref. 21st: Minimalist Hero (ravikatiyar162), Number Ticker (shadcnspace),
 * Ticker (haydenbleasel). Dayos: jedna teza na ekran, dużo powietrza.
 */
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import ReportMock from '../../components/ReportMock.astro';
import CTABand from '../../components/CTABand.astro';

const ticker = [
  { v: '+40%', t: 'widoczności w AI po metodach GEO', s: 'Princeton, KDD 2024' },
  { v: '8×', t: 'podzapytań z jednego pytania w Google AI Mode', s: 'patent Google' },
  { v: '+357%', t: 'ruchu z silników AI rok do roku', s: 'Authoritas' },
  { v: '84%', t: 'rekomendacji AI pochodzi z ChatGPT', s: 'Previsible 2025' },
  { v: '25,2×', t: 'wzrost ruchu z Copilota', s: 'Previsible 2025' },
  { v: '13', t: 'botów AI sprawdzanych w robots.txt', s: 'widocznosc.ai' },
];
---

<Layout title="Podgląd C – Manifest w liczbach | widocznosc.ai" noindex>
  <Navbar />

  <section class="hc">
    <div class="container hc-inner">
      <h1 class="hc-h1">
        <span class="hc-line">AI już poleca.</span>
        <span class="hc-line">Pytanie, czy poleca Ciebie</span>
        <span class="hc-line"><span class="hc-rot" aria-hidden="true"><i>w ChatGPT.</i><i>w Claude.</i><i>w Gemini.</i><i>w Perplexity.</i><i>w Copilocie.</i></span><span class="sr-only">w ChatGPT, Claude, Gemini, Perplexity i Copilocie.</span></span>
      </h1>
      <form class="hc-form" action="/narzedzia/brand-check/" method="get">
        <input type="text" name="domain" placeholder="Wpisz swoją domenę" required maxlength="200" inputmode="url" />
        <button type="submit" class="btn-primary">Sprawdź widoczność marki <span aria-hidden="true">→</span></button>
      </form>
      <p class="hc-note">Bezpłatny pomiar w&nbsp;czterech modelach AI, bez rejestracji. <span>widocznosc.ai by ICEA</span></p>
    </div>
  </section>

  <!-- Ticker liczb z badań -->
  <section class="tk" aria-label="Liczby z badań o widoczności w AI">
    <div class="tk-track">
      {[...ticker, ...ticker].map((it) => (
        <div class="tk-item">
          <span class="tk-v">{it.v}</span>
          <span class="tk-t">{it.t}</span>
          <span class="tk-s">{it.s}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- Rozdział 01 – jasny pas -->
  <section class="ch ch--light" id="pomiar">
    <div class="container ch-grid">
      <div class="ch-copy">
        <span class="ch-num">01</span>
        <h2 class="display-xl">Najpierw pomiar. Potem wszystko inne.</h2>
        <p class="ch-lead">Nie opowiadamy o&nbsp;rewolucji AI. Zadajemy modelom te same pytania, które zadają Twoi klienci, i&nbsp;pokazujemy, co odpowiadają: czy znają markę, jak o&nbsp;niej mówią i&nbsp;kogo polecają zamiast Ciebie.</p>
        <a class="ch-link" href="/narzedzia/brand-check/">Sprawdź widoczność marki →</a>
      </div>
      <div class="ch-product">
        <ReportMock compact />
      </div>
    </div>
  </section>

  <!-- Rozdział 02 – ciemny -->
  <section class="ch" id="plan">
    <div class="container ch-grid ch-grid--rev">
      <div class="ch-copy">
        <span class="ch-num">02</span>
        <h2 class="display-xl">Z wyniku powstaje plan, nie prezentacja.</h2>
        <p class="ch-lead">Pełny raport GEO obejmuje 25–50 adresów i&nbsp;cztery obszary. Kończy się listą działań ułożoną według priorytetu, którą omawiasz z&nbsp;ekspertem ICEA.</p>
        <a class="ch-link" href="/kontakt/?type=full-report">Zamów pełny raport →</a>
      </div>
      <div class="ch-product">
        <div class="ch-plan">
          <div class="ch-plan-head"><span>GEO Score · twojadomena.pl</span><span>13 / 25 adresów</span></div>
          <div class="ch-plan-big">38<small>%</small></div>
          <ul class="ch-plan-rows">
            <li><span>Spójność tematyczna</span><i><b style="width:56%"></b></i><span>56%</span></li>
            <li><span>Sygnały autorytetu</span><i><b style="width:42%"></b></i><span>42%</span></li>
            <li><span>Dostępność dla AI</span><i><b style="width:68%"></b></i><span>68%</span></li>
            <li><span>Widoczność w&nbsp;AI</span><i><b style="width:30%"></b></i><span>30%</span></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <CTABand compactTop />
  <Footer />
</Layout>

<style>
  .hc {
    padding: 150px 0 80px;
  }
  @media (min-width: 980px) {
    .hc {
      padding: 190px 0 110px;
    }
  }
  .hc-inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 36px;
  }
  .hc-h1 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2.6rem, 7.2vw, 7rem);
    line-height: 0.98;
    letter-spacing: -0.045em;
    color: var(--ink);
    max-width: 14ch;
  }
  .hc-line {
    display: block;
  }
  .hc-rot {
    display: inline-grid;
    color: var(--brand);
    vertical-align: top;
  }
  .hc-rot i {
    grid-area: 1 / 1;
    font-style: normal;
    opacity: 0;
    animation: hc-rot 12.5s infinite;
  }
  .hc-rot i:nth-child(2) { animation-delay: 2.5s; }
  .hc-rot i:nth-child(3) { animation-delay: 5s; }
  .hc-rot i:nth-child(4) { animation-delay: 7.5s; }
  .hc-rot i:nth-child(5) { animation-delay: 10s; }
  @keyframes hc-rot {
    0% { opacity: 0; transform: translateY(0.25em); }
    4%, 18% { opacity: 1; transform: none; }
    22%, 100% { opacity: 0; transform: translateY(-0.25em); }
  }
  @media (prefers-reduced-motion: reduce) {
    .hc-rot i { animation: none; }
    .hc-rot i:first-child { opacity: 1; }
  }
  .hc-form {
    display: flex;
    gap: 8px;
    width: 100%;
    max-width: 620px;
    padding: 6px;
    background: var(--bg-surface-1);
    border: 1px solid var(--hairline);
    border-radius: var(--r-pill);
    flex-wrap: wrap;
  }
  .hc-form input {
    flex: 1;
    min-width: 200px;
    min-height: 46px;
    padding: 10px 18px;
    background: transparent;
    color: var(--ink);
    border: 0;
    font-size: 16px;
    outline: none;
    border-radius: var(--r-pill);
  }
  .hc-form input:focus-visible {
    background: var(--bg-surface-2);
  }
  .hc-note {
    margin: -12px 0 0;
    font-size: 13px;
    color: var(--ink-faint);
  }
  .hc-note span {
    margin-left: 10px;
    padding-left: 10px;
    border-left: 1px solid var(--hairline);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 11px;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  .tk {
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
    overflow: hidden;
    padding: 28px 0;
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .tk-track {
    display: flex;
    gap: 64px;
    width: max-content;
    animation: tk 60s linear infinite;
  }
  .tk:hover .tk-track {
    animation-play-state: paused;
  }
  @keyframes tk {
    to { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .tk-track { animation: none; flex-wrap: wrap; width: auto; }
  }
  .tk-item {
    display: flex;
    align-items: baseline;
    gap: 14px;
    white-space: nowrap;
  }
  .tk-v {
    font-family: var(--font-display);
    font-size: 40px;
    font-weight: 600;
    letter-spacing: -0.045em;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }
  .tk-t {
    font-size: 14px;
    color: var(--ink-muted);
  }
  .tk-s {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-faint);
  }

  .ch {
    padding: 110px 0;
  }
  @media (min-width: 980px) {
    .ch {
      padding: 150px 0;
    }
  }
  .ch--light {
    background: var(--bg-inverse);
    color: var(--ink-inverse);
  }
  .ch--light .display-xl,
  .ch--light .ch-link {
    color: var(--ink-inverse);
  }
  .ch--light .ch-lead {
    color: var(--ink-inverse-muted);
  }
  .ch-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
  }
  @media (min-width: 980px) {
    .ch-grid {
      grid-template-columns: 0.9fr 1.1fr;
      gap: 80px;
      align-items: center;
    }
    .ch-grid--rev .ch-copy {
      order: 2;
    }
  }
  .ch-copy {
    display: flex;
    flex-direction: column;
    gap: 22px;
    align-items: flex-start;
  }
  .ch-copy h2 {
    margin: 0;
    max-width: 14ch;
  }
  .ch-num {
    font-family: var(--font-display);
    font-size: 56px;
    font-weight: 600;
    letter-spacing: -0.05em;
    line-height: 1;
    opacity: 0.35;
  }
  .ch-lead {
    margin: 0;
    font-size: clamp(16px, 1.35vw, 19px);
    line-height: 1.5;
    color: var(--ink-muted);
    max-width: 46ch;
  }
  .ch-link {
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 5px;
    color: var(--ink);
  }
  .ch--light :global(.rm) {
    box-shadow: 0 30px 60px -30px rgba(0, 0, 0, 0.35);
  }
  .ch-plan {
    background: var(--bg-surface-1);
    border: 1px solid var(--hairline);
    border-radius: var(--r-xl);
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .ch-plan-head {
    display: flex;
    justify-content: space-between;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-faint);
  }
  .ch-plan-big {
    font-family: var(--font-display);
    font-size: 72px;
    font-weight: 600;
    letter-spacing: -0.05em;
    line-height: 1;
  }
  .ch-plan-big small {
    font-size: 28px;
    color: var(--ink-muted);
  }
  .ch-plan-rows {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .ch-plan-rows li {
    display: grid;
    grid-template-columns: 150px 1fr 44px;
    gap: 12px;
    align-items: center;
    padding: 10px 0;
    border-top: 1px solid var(--hairline-soft);
    font-size: 13px;
  }
  .ch-plan-rows li span:last-child {
    text-align: right;
    color: var(--ink-muted);
  }
  .ch-plan-rows i {
    display: block;
    height: 4px;
    background: var(--bg-surface-3);
    border-radius: 2px;
    overflow: hidden;
  }
  .ch-plan-rows b {
    display: block;
    height: 100%;
    background: var(--ink);
  }
</style>
