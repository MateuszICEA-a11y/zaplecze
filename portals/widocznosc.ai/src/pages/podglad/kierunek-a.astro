---
/**
 * Podgląd kierunku A – „Raport w ramce” (product-first, split hero).
 * Ref. 21st: Hero with Dashboard Mockup (felipemenezes098/hero-02),
 * Sticky Scroll (uilayout.contact/sticky-scroll). Dayos: MacBook z produktem.
 */
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import ReportMock from '../../components/ReportMock.astro';
import CTABand from '../../components/CTABand.astro';

const steps = [
  {
    n: '01',
    t: 'Podajesz markę i domenę',
    d: 'Bez rejestracji. Narzędzie odpytuje ChatGPT, Claude, Gemini i Perplexity świeżymi sesjami, bez personalizacji.',
    k: 'form',
  },
  {
    n: '02',
    t: 'Dostajesz wynik per model',
    d: 'Czy model zna markę, jak o niej mówi, czy cytuje Twoją domenę i jakie fakty zmyśla. Każdy model osobno, bo cytują inaczej.',
    k: 'models',
  },
  {
    n: '03',
    t: 'Widzisz konkurentów i plan',
    d: 'Lista firm polecanych zamiast Ciebie i trzy pierwsze działania ułożone według priorytetu. Resztę omawiasz z ekspertem ICEA.',
    k: 'plan',
  },
];
---

<Layout title="Podgląd A – Raport w ramce | widocznosc.ai" noindex>
  <Navbar />

  <section class="ha">
    <div class="container ha-grid">
      <div class="ha-copy">
        <span class="eyebrow">Pomiar widoczności marki w&nbsp;AI</span>
        <h1 class="display-xxl ha-h1">Sprawdź, czy AI poleca Twoją markę.</h1>
        <p class="hero-lead ha-lead">
          Odpytujemy ChatGPT, Claude, Gemini i&nbsp;Perplexity o&nbsp;Twoją firmę i&nbsp;pokazujemy,
          co odpowiadają. Wynik w&nbsp;około minutę, bez rejestracji.
        </p>
        <form class="ha-form" action="/narzedzia/brand-check/" method="get">
          <input type="text" name="brand" placeholder="Nazwa marki" maxlength="80" />
          <input type="text" name="domain" placeholder="twojadomena.pl" required maxlength="200" inputmode="url" />
          <button type="submit" class="btn-primary">Sprawdź widoczność marki <span aria-hidden="true">→</span></button>
        </form>
        <p class="ha-note">
          <a href="/kontakt/?type=konsultacja">Porozmawiaj z&nbsp;ekspertem ICEA</a>
          <span>·</span> widocznosc.ai by ICEA
        </p>
      </div>
      <div class="ha-product">
        <ReportMock frame compact />
      </div>
    </div>
  </section>

  <section class="la" aria-label="Mierzymy widoczność w silnikach AI">
    <div class="container la-inner">
      <span class="la-label">Mierzymy widoczność w</span>
      <div class="la-logos">
        <img src="/logos/ai-engines/chatgpt.png" alt="ChatGPT" height="22" loading="lazy" />
        <img src="/logos/ai-engines/claude.png" alt="Claude" height="22" loading="lazy" />
        <img src="/logos/ai-engines/gemini.png" alt="Gemini" height="22" loading="lazy" />
        <img src="/logos/ai-engines/perplexity.png" alt="Perplexity" height="22" loading="lazy" />
        <img src="/logos/ai-engines/copilot.png" alt="Microsoft Copilot" height="22" loading="lazy" />
      </div>
    </div>
  </section>

  <!-- Sticky scroll: kroki po lewej, produkt po prawej podmienia widok -->
  <section class="sa" id="jak-to-dziala" aria-labelledby="sa-title">
    <div class="container">
      <header class="section-head">
        <div class="head-left">
          <div class="head-meta"><span class="eyebrow">Jak to działa</span></div>
          <h2 id="sa-title" class="display-xl">Od domeny do planu działań w&nbsp;trzech krokach.</h2>
        </div>
      </header>
      <div class="sa-grid">
        <ol class="sa-steps">
          {steps.map((s, i) => (
            <li class:list={['sa-step', { 'is-active': i === 0 }]} data-step={s.k}>
              <span class="sa-num">{s.n}</span>
              <h3 class="sa-t">{s.t}</h3>
              <p class="sa-d">{s.d}</p>
            </li>
          ))}
        </ol>
        <div class="sa-stage">
          <div class="sa-panel" data-panel="form">
            <div class="sa-mockform">
              <span class="rm-lbl">Narzędzie · widoczność marki w&nbsp;AI</span>
              <div class="sa-field"><span>Nazwa marki</span><b>Twoja Marka</b></div>
              <div class="sa-field"><span>Domena</span><b>twojamarka.pl</b></div>
              <div class="sa-field"><span>Kategoria</span><b>np. producent mebli</b></div>
              <span class="btn-primary sa-fakebtn">Sprawdź markę</span>
              <span class="sa-progress"><i></i></span>
              <span class="rm-lbl">Odpytywanie 4 modeli · ok. 60 s</span>
            </div>
          </div>
          <div class="sa-panel is-active" data-panel="models">
            <ReportMock compact />
          </div>
          <div class="sa-panel" data-panel="plan">
            <div class="sa-plan">
              <span class="rm-lbl">Konkurenci polecani zamiast marki</span>
              <ul class="sa-rows">
                <li><span>konkurent-a.pl</span><i style="width:75%"></i><span>3 modele</span></li>
                <li><span>konkurent-b.pl</span><i style="width:50%"></i><span>2 modele</span></li>
                <li><span>marketplace-x.com</span><i style="width:50%"></i><span>2 modele</span></li>
              </ul>
              <span class="rm-lbl">Priorytety działań</span>
              <ol class="sa-actions">
                <li><b>P0</b>Strona „O firmie” z&nbsp;faktami, które modele mylą</li>
                <li><b>P0</b>Schema Organization + sameAs na stronie głównej</li>
                <li><b>P1</b>Porównanie z&nbsp;konkurentami cytowanymi przez AI</li>
                <li><b>P2</b>FAQ pod pytania zadawane AI</li>
              </ol>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CTABand compactTop />
  <Footer />
</Layout>

<script>
  const init = () => {
    const steps = Array.from(document.querySelectorAll<HTMLElement>('.sa-step'));
    const panels = Array.from(document.querySelectorAll<HTMLElement>('.sa-panel'));
    if (!steps.length) return;
    const activate = (k: string) => {
      steps.forEach((s) => s.classList.toggle('is-active', s.dataset.step === k));
      panels.forEach((p) => p.classList.toggle('is-active', p.dataset.panel === k));
    };
    const obs = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) activate((e.target as HTMLElement).dataset.step || '');
        });
      },
      { rootMargin: '-45% 0px -45% 0px', threshold: 0 }
    );
    steps.forEach((s) => obs.observe(s));
    steps.forEach((s) => s.addEventListener('click', () => activate(s.dataset.step || '')));
  };
  init();
  document.addEventListener('astro:page-load', init);
</script>

<style>
  .ha {
    padding: 120px 0 72px;
    overflow: hidden;
  }
  .ha-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 48px;
    align-items: center;
  }
  @media (min-width: 1024px) {
    .ha {
      padding: 150px 0 96px;
    }
    .ha-grid {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      gap: 56px;
    }
  }
  .ha-copy {
    display: flex;
    flex-direction: column;
    gap: 26px;
    align-items: flex-start;
  }
  .ha-h1 {
    margin: 0;
    max-width: 11ch;
    text-wrap: balance;
  }
  .ha-lead {
    max-width: 46ch;
    color: var(--ink-muted);
  }
  .ha-form {
    display: grid;
    grid-template-columns: 1fr;
    gap: 8px;
    width: 100%;
    max-width: 460px;
  }
  .ha-form input {
    min-height: 46px;
    padding: 10px 16px;
    background: var(--bg-surface-1);
    color: var(--ink);
    border: 1px solid var(--hairline);
    border-radius: var(--r-md);
    font-size: 15px;
    outline: none;
  }
  .ha-form input:focus-visible {
    border-color: var(--ink-faint);
  }
  .ha-form .btn-primary {
    min-height: 46px;
    border-radius: var(--r-md);
  }
  .ha-note {
    margin: 0;
    font-size: 13px;
    color: var(--ink-faint);
    display: flex;
    gap: 8px;
  }
  .ha-note a {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--hairline);
  }
  .ha-product {
    min-width: 0;
  }
  @media (min-width: 1280px) {
    .ha-product {
      width: calc(100% + 120px);
    }
  }

  .la {
    padding: 26px 0;
    border-top: 1px solid var(--hairline-soft);
    border-bottom: 1px solid var(--hairline-soft);
  }
  .la-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px 40px;
    flex-wrap: wrap;
  }
  .la-label {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-faint);
  }
  .la-logos {
    display: flex;
    gap: 36px;
    align-items: center;
    flex-wrap: wrap;
    justify-content: center;
  }
  .la-logos img {
    height: 22px;
    width: auto;
    filter: grayscale(1) brightness(2.2) contrast(0.9);
    opacity: 0.7;
    transition: opacity 0.2s ease;
  }
  :root[data-theme='light'] .la-logos img {
    filter: grayscale(1) brightness(0.3);
  }
  .la-logos img:hover {
    opacity: 1;
  }

  .sa {
    padding: 96px 0;
  }
  @media (min-width: 980px) {
    .sa {
      padding: 128px 0;
    }
  }
  .sa-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
  }
  @media (min-width: 980px) {
    .sa-grid {
      grid-template-columns: 0.8fr 1.2fr;
      gap: 64px;
      align-items: start;
    }
    .sa-stage {
      position: sticky;
      top: 96px;
    }
  }
  .sa-steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .sa-step {
    padding: 36px 0 36px 28px;
    border-left: 2px solid var(--hairline);
    cursor: pointer;
    transition: border-color 0.2s ease;
  }
  @media (min-width: 980px) {
    .sa-step {
      min-height: 46vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
  }
  .sa-step.is-active {
    border-left-color: var(--ink);
  }
  .sa-num {
    font-family: ui-monospace, 'JetBrains Mono', monospace;
    font-size: 12px;
    color: var(--ink-faint);
  }
  .sa-t {
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: 600;
    letter-spacing: -0.03em;
    margin: 10px 0 12px;
    color: var(--ink-muted);
    transition: color 0.2s ease;
  }
  .sa-step.is-active .sa-t {
    color: var(--ink);
  }
  .sa-d {
    margin: 0;
    font-size: 15px;
    line-height: 1.5;
    color: var(--ink-muted);
    max-width: 40ch;
  }
  .sa-stage {
    display: grid;
  }
  .sa-panel {
    grid-area: 1 / 1;
    opacity: 0;
    transform: translateY(12px);
    transition:
      opacity 0.35s ease,
      transform 0.35s ease;
    pointer-events: none;
  }
  .sa-panel.is-active {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }
  .sa-mockform,
  .sa-plan {
    background: var(--bg-surface-1);
    border: 1px solid var(--hairline);
    border-radius: var(--r-xl);
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .rm-lbl {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-faint);
  }
  .sa-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 12px 14px;
    background: var(--bg-canvas);
    border: 1px solid var(--hairline-soft);
    border-radius: var(--r-md);
    font-size: 14px;
  }
  .sa-field span {
    font-size: 11px;
    color: var(--ink-faint);
  }
  .sa-fakebtn {
    align-self: flex-start;
  }
  .sa-progress {
    height: 4px;
    background: var(--bg-surface-3);
    border-radius: 2px;
    overflow: hidden;
  }
  .sa-progress i {
    display: block;
    height: 100%;
    width: 62%;
    background: var(--ink);
  }
  .sa-rows,
  .sa-actions {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .sa-rows li {
    display: grid;
    grid-template-columns: 150px 1fr 70px;
    align-items: center;
    gap: 12px;
    padding: 10px 0;
    border-top: 1px solid var(--hairline-soft);
    font-size: 13px;
  }
  .sa-rows li span:last-child {
    text-align: right;
    color: var(--ink-muted);
  }
  .sa-rows i {
    display: block;
    height: 4px;
    background: var(--ink);
    border-radius: 2px;
  }
  .sa-actions li {
    display: flex;
    gap: 12px;
    align-items: center;
    padding: 10px 0;
    border-top: 1px solid var(--hairline-soft);
    font-size: 14px;
  }
  .sa-actions b {
    font-family: ui-monospace, monospace;
    font-size: 10px;
    padding: 3px 6px;
    border-radius: 4px;
    background: var(--ink);
    color: var(--bg-canvas);
  }
  .sa-actions li:nth-child(n + 3) b {
    background: var(--bg-surface-3);
    color: var(--ink);
  }
</style>
