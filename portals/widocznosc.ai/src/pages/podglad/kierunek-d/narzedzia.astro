---
/**
 * Podgląd kierunku D – narzędzia.
 * Trzy testy z Audits.astro plus makieta wyniku brand-checka w systemie D.
 */
import KierunekD from '../../../layouts/KierunekD.astro';

const base = '/podglad/kierunek-d';

const tools = [
  {
    n: '01',
    t: 'Widoczność marki w AI',
    meta: 'bezpłatnie · ok. 60 s',
    d: 'Odpytujemy pięć modeli o Twoją markę i pokazujemy, co odpowiadają: czy ją znają, jak o niej mówią i kogo polecają zamiast Ciebie.',
  },
  {
    n: '02',
    t: 'Cytowalność strony',
    meta: 'bezpłatnie · ok. 30 s',
    d: 'Sprawdzamy, czy pojedyncze akapity nadają się na cytat: gęstość faktów, strukturę nagłówków i dane strukturalne.',
  },
  {
    n: '03',
    t: 'Dostęp botów AI',
    meta: 'bezpłatnie · natychmiast',
    d: 'Weryfikujemy, czy GPTBot, ClaudeBot, PerplexityBot i Google-Extended w ogóle wchodzą na Twoją domenę.',
  },
];

const results = [
  { model: 'ChatGPT', zna: 'tak', cytuje: 'tak', stan: 'ok' },
  { model: 'Perplexity', zna: 'tak', cytuje: 'tak', stan: 'ok' },
  { model: 'Gemini', zna: 'tak', cytuje: 'nie', stan: 'warn' },
  { model: 'Claude', zna: 'częściowo', cytuje: 'nie', stan: 'warn' },
  { model: 'Microsoft Copilot', zna: 'nie', cytuje: 'nie', stan: 'bad' },
];
---

<KierunekD title="Podgląd D: narzędzia – widocznosc.ai" current="narzedzia">
  <section class="kd-wrap" style="padding-top:72px">
    <span class="kd-eyebrow">Narzędzia · bez rejestracji</span>
    <h1 class="kd-d2" style="margin-top:20px">Trzy testy za darmo.<br />Jeden pełny <em>raport</em>.</h1>
    <p class="kd-lead" style="margin-top:20px">
      Każdy test odpowiada na jedno pytanie i kończy się liczbą, nie opinią.
      Pełny raport z rekomendacjami omawiasz z ekspertem ICEA.
    </p>
  </section>

  <section class="kd-section kd-wrap">
    <div class="kd-grid-3">
      {
        tools.map((t) => (
          <div class="kd-card kd-step">
            <span class="kd-step-n">{t.n}</span>
            <h3>{t.t}</h3>
            <p>{t.d}</p>
            <p class="kd-micro" style="margin-top:14px">{t.meta}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="kd-section kd-wrap">
    <div class="kd-section-head">
      <span class="kd-eyebrow">Przykładowy wynik</span>
      <h2 class="kd-title">Każdy model osobno.</h2>
    </div>
    <div class="kd-result">
      <div class="kd-result-head kd-micro">
        <span>model</span><span>zna markę</span><span>cytuje domenę</span><span>stan</span>
      </div>
      {
        results.map((r) => (
          <div class="kd-result-row">
            <span class="kd-result-model">{r.model}</span>
            <span class="kd-micro">{r.zna}</span>
            <span class="kd-micro">{r.cytuje}</span>
            <span class:list={['kd-dot', `is-${r.stan}`]} aria-label={r.stan} />
          </div>
        ))
      }
    </div>
    <p class="kd-note" style="margin-top:16px">
      pięć silników · świeże sesje, bez personalizacji · pomiar demonstracyjny
    </p>
  </section>

  <fragment slot="machine">{`# Narzędzia – widocznosc.ai

Trzy testy za darmo. Jeden pełny raport. Bez rejestracji.

${tools.map((t) => `## ${t.n}. ${t.t}\n\n${t.meta}\n\n${t.d}`).join('\n\n')}

## Przykładowy wynik

| Model | Zna markę | Cytuje domenę |
|---|---|---|
${results.map((r) => `| ${r.model} | ${r.zna} | ${r.cytuje} |`).join('\n')}

Pomiar demonstracyjny na pięciu silnikach, świeże sesje, bez personalizacji.

widocznosc.ai by ICEA S.A.
`}</fragment>
</KierunekD>

<style>
  .kd-result {
    border-top: 1px solid var(--kd-line);
  }
  .kd-result-head,
  .kd-result-row {
    display: grid;
    grid-template-columns: 1fr 140px 140px 40px;
    gap: 16px;
    align-items: center;
    padding: 14px 0;
    border-bottom: 1px solid var(--kd-line);
  }
  .kd-result-model {
    font-family: var(--kd-serif);
    font-size: 22px;
    line-height: 28px;
    letter-spacing: -0.4px;
  }
  .kd-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    display: block;
    justify-self: end;
  }
  .kd-dot.is-ok {
    background: #4ade80;
  }
  .kd-dot.is-warn {
    background: #fbbf24;
  }
  .kd-dot.is-bad {
    background: #f87171;
  }

  @media (max-width: 767px) {
    .kd-result-head {
      display: none;
    }
    .kd-result-row {
      grid-template-columns: 1fr 70px 70px 20px;
      gap: 8px;
    }
    .kd-result-model {
      font-size: 17px;
      line-height: 22px;
    }
  }
</style>
