---
/**
 * Podgląd kierunku D – narzędzia. Trzy testy z Audits.astro w karcie
 * o strukturze karty cennika wzorca + makieta wyniku per silnik.
 */
import KierunekD from '../../../layouts/KierunekD.astro';

const base = '/podglad/kierunek-d';

const tools = [
  {
    t: 'Widoczność marki w AI',
    dots: 20,
    micro: '4 silniki · świeże sesje',
    num: '60',
    unit: 's',
    meta: 'bezpłatnie · bez rejestracji',
    list: ['ChatGPT, Claude, Gemini, Perplexity', 'Sentyment i lista halucynacji', 'Konkurenci polecani zamiast Ciebie'],
    hot: true,
  },
  {
    t: 'Cytowalność strony',
    dots: 10,
    micro: 'jeden adres · wynik 0–100',
    num: '30',
    unit: 's',
    meta: 'bezpłatnie · bez rejestracji',
    list: ['Pięć priorytetowych zmian', 'Według badań Princeton', 'Analiza 1,2 mln cytowań ChatGPT'],
  },
  {
    t: 'Dostęp botów AI',
    dots: 2,
    micro: 'robots.txt i WAF',
    num: '<1',
    unit: 's',
    meta: 'bezpłatnie · natychmiast',
    list: ['GPTBot, ClaudeBot, PerplexityBot', 'Google-Extended i 9 innych botów', 'Dostęp albo blokada per bot'],
  },
];

const results = [
  { model: 'ChatGPT', zna: 'zna · cytuje', stan: 'ok' },
  { model: 'Perplexity', zna: 'zna · neutralny', stan: 'ok' },
  { model: 'Gemini', zna: 'zna częściowo', stan: 'warn' },
  { model: 'Claude', zna: 'zna częściowo', stan: 'warn' },
  { model: 'Microsoft Copilot', zna: 'poleca konkurenta', stan: 'bad' },
];

const DOTS = 24;
---

<KierunekD title="Podgląd D: narzędzia – widocznosc.ai" current="narzedzia">
  <section class="kd-section">
    <div class="kd-wrap">
      <span class="kd-caption">Narzędzia · bez rejestracji</span>
      <h1 class="kd-text-title" style="margin-top:16px">Trzy testy za darmo.<br />Jeden pełny <em>raport</em>.</h1>
      <p class="kd-lead" style="margin-top:24px">
        Każdy test odpowiada na jedno pytanie i kończy się liczbą, nie opinią.
        Pełny raport z rekomendacjami omawiasz z ekspertem ICEA.
      </p>
    </div>
  </section>

  <section class="kd-section">
    <div class="kd-wrap">
      <div class="kd-grid-3">
        {
          tools.map((a) => (
            <div class:list={['kd-card', a.hot && 'is-hot']}>
              <h3 class="kd-text-heading">{a.t}</h3>
              <div class="kd-dots" aria-hidden="true">
                {Array.from({ length: DOTS }, (_, i) => <i class:list={[i < a.dots && 'on']} />)}
              </div>
              <span class="kd-micro">{a.micro}</span>
              <div class="kd-text-num">{a.num}<i>{a.unit}</i></div>
              <span class="kd-meta">{a.meta}</span>
              <ul class="kd-list">{a.list.map((l) => <li>{l}</li>)}</ul>
              <div class="kd-card-foot">
                <a class:list={['kd-btn', 'kd-btn-block', !a.hot && 'kd-btn-2']} href="#wynik">
                  Uruchom test
                </a>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="kd-section" id="wynik">
    <div class="kd-wrap">
      <div class="kd-section-head">
        <span class="kd-label">Przykładowy wynik</span>
        <h2 class="kd-text-title">Każdy model osobno.</h2>
      </div>
      <div class="kd-result">
        <div class="kd-result-row kd-result-head">
          <span class="kd-label">model</span>
          <span class="kd-label">odczyt</span>
          <span class="kd-label" style="text-align:right">stan</span>
        </div>
        {
          results.map((r) => (
            <div class="kd-result-row">
              <span class="kd-text-sub">{r.model}</span>
              <span class="kd-meta">{r.zna}</span>
              <span class:list={['kd-dot', `is-${r.stan}`]} aria-label={r.stan} />
            </div>
          ))
        }
      </div>
      <p class="kd-meta" style="margin-top:16px">
        pięć silników · świeże sesje, bez personalizacji · pomiar demonstracyjny
      </p>
    </div>
  </section>

  <fragment slot="machine">{`# Narzędzia – widocznosc.ai

Trzy testy za darmo. Jeden pełny raport. Bez rejestracji.

${tools.map((t) => `## ${t.t}\n\n${t.meta} · ok. ${t.num} ${t.unit}\n\n${t.list.map((l) => `- ${l}`).join('\n')}`).join('\n\n')}

## Przykładowy wynik

| Model | Odczyt |
|---|---|
${results.map((r) => `| ${r.model} | ${r.zna} |`).join('\n')}

Pomiar demonstracyjny na pięciu silnikach, świeże sesje, bez personalizacji.

widocznosc.ai by ICEA S.A.
`}</fragment>
</KierunekD>

<style>
  .kd-result {
    border-top: 1px solid var(--kd-line);
  }
  .kd-result-row {
    display: grid;
    grid-template-columns: 1fr 220px 40px;
    gap: 16px;
    align-items: center;
    padding: 16px 0;
    border-bottom: 1px solid var(--kd-line);
  }
  .kd-result-head {
    padding: 10px 0;
  }
  .kd-dot {
    width: 8px;
    height: 8px;
    display: block;
    justify-self: end;
  }
  .kd-dot.is-ok {
    background: var(--kd-ok);
  }
  .kd-dot.is-warn {
    background: var(--kd-warn);
  }
  .kd-dot.is-bad {
    background: var(--kd-bad);
  }
  @media (max-width: 767px) {
    .kd-result-head {
      display: none;
    }
    .kd-result-row {
      grid-template-columns: 1fr 120px 20px;
      gap: 8px;
    }
  }
</style>
