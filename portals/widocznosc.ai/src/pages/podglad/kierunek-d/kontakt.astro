---
/**
 * Podgląd kierunku D – kontakt.
 * Formularz leadowy w systemie D; pola jak na produkcyjnym /kontakt/.
 */
import KierunekD from '../../../layouts/KierunekD.astro';

const types = [
  { v: 'audyt-ai', l: 'Audyt widoczności w AI' },
  { v: 'konsultacja', l: 'Konsultacja z ekspertem' },
  { v: 'wspolpraca', l: 'Stała współpraca GEO' },
];
---

<KierunekD title="Podgląd D: kontakt – widocznosc.ai" current="kontakt">
  <section class="kd-wrap kd-contact" style="padding-top:72px">
    <div>
      <span class="kd-eyebrow">Kontakt</span>
      <h1 class="kd-d2" style="margin-top:20px">Porozmawiajmy o <em>cytowaniach</em>.</h1>
      <p class="kd-lead" style="margin-top:20px">
        Odpowiadamy w jeden dzień roboczy. Jeśli wolisz zacząć od liczb, uruchom
        najpierw bezpłatny test widoczności – rozmowa będzie krótsza.
      </p>

      <dl class="kd-contact-meta">
        <div><dt>Firma</dt><dd>ICEA S.A.</dd></div>
        <div><dt>Adres</dt><dd>Szyperska 14, Poznań</dd></div>
        <div><dt>Odpowiedź</dt><dd>1 dzień roboczy</dd></div>
      </dl>
    </div>

    <form class="kd-card kd-contact-form">
      <label>
        <span class="kd-micro">rodzaj sprawy</span>
        <select>
          {types.map((t) => <option value={t.v}>{t.l}</option>)}
        </select>
      </label>
      <label>
        <span class="kd-micro">imię i nazwisko</span>
        <input type="text" placeholder="Jan Kowalski" />
      </label>
      <label>
        <span class="kd-micro">adres e-mail</span>
        <input type="email" placeholder="jan@twojafirma.pl" />
      </label>
      <label>
        <span class="kd-micro">domena</span>
        <input type="text" placeholder="twojafirma.pl" spellcheck="false" />
      </label>
      <label>
        <span class="kd-micro">wiadomość</span>
        <textarea rows="4" placeholder="Czego chcesz się dowiedzieć?"></textarea>
      </label>
      <button type="button" class="kd-btn">Wyślij wiadomość</button>
      <p class="kd-micro">
        Podgląd – formularz nie wysyła zgłoszeń.
      </p>
    </form>
  </section>

  <fragment slot="machine">{`# Kontakt – widocznosc.ai

Porozmawiajmy o cytowaniach. Odpowiadamy w jeden dzień roboczy.

Rodzaje spraw: audyt widoczności w AI, konsultacja z ekspertem,
stała współpraca GEO.

- Firma: ICEA S.A.
- Adres: Szyperska 14, Poznań
- Czas odpowiedzi: 1 dzień roboczy

Zanim napiszesz, możesz uruchomić bezpłatny test widoczności:
/narzedzia/brand-check/

widocznosc.ai by ICEA S.A.
`}</fragment>
</KierunekD>

<style>
  .kd-contact {
    display: grid;
    grid-template-columns: 1fr 420px;
    gap: 48px;
    align-items: start;
  }
  .kd-contact-meta {
    margin: 40px 0 0;
    border-top: 1px solid var(--kd-line);
    font-family: var(--kd-mono);
    font-size: 12px;
    line-height: 16px;
  }
  .kd-contact-meta > div {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 16px;
    padding: 12px 0;
    border-bottom: 1px solid var(--kd-line);
  }
  .kd-contact-meta dt {
    color: var(--kd-mute);
  }
  .kd-contact-meta dd {
    margin: 0;
    color: var(--kd-body);
  }

  .kd-contact-form {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 24px;
  }
  .kd-contact-form label {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .kd-contact-form input,
  .kd-contact-form select,
  .kd-contact-form textarea {
    background: var(--kd-canvas);
    border: 1px solid var(--kd-line);
    border-radius: 4px;
    color: var(--kd-ink);
    padding: 11px 12px;
    font-size: 15px;
    font-family: inherit;
  }
  .kd-contact-form input::placeholder,
  .kd-contact-form textarea::placeholder {
    color: var(--kd-mute);
  }
  .kd-contact-form :is(input, select, textarea):focus-visible {
    outline: none;
    border-color: var(--kd-accent);
  }

  @media (max-width: 1023px) {
    .kd-contact {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
</style>
