---
/**
 * Podgląd kierunku D – kontakt. Pola jak na produkcyjnym /kontakt/.
 */
import KierunekD from '../../../layouts/KierunekD.astro';

const types = [
  { v: 'audyt-ai', l: 'Audyt widoczności w AI' },
  { v: 'konsultacja', l: 'Konsultacja z ekspertem' },
  { v: 'wspolpraca', l: 'Stała współpraca GEO' },
];
---

<KierunekD title="Podgląd D: kontakt – widocznosc.ai" current="kontakt">
  <section class="kd-section">
    <div class="kd-wrap kd-contact">
      <div>
        <span class="kd-caption">Kontakt</span>
        <h1 class="kd-text-title" style="margin-top:16px">Porozmawiajmy o <em>cytowaniach</em>.</h1>
        <p class="kd-lead" style="margin-top:24px">
          Odpowiadamy w jeden dzień roboczy. Jeśli wolisz zacząć od liczb, uruchom
          najpierw bezpłatny test widoczności – rozmowa będzie krótsza.
        </p>
        <dl class="kd-stats" style="margin-top:48px">
          <div><dd class="kd-text-num-sm">ICEA S.A.</dd><dt class="kd-label">Firma</dt></div>
          <div><dd class="kd-text-num-sm">Poznań</dd><dt class="kd-label">Szyperska 14</dt></div>
          <div><dd class="kd-text-num-sm">1 dzień</dd><dt class="kd-label">Czas odpowiedzi</dt></div>
        </dl>
      </div>

      <form class="kd-card kd-contact-form">
        <label>
          <span class="kd-label">rodzaj sprawy</span>
          <select class="kd-input">{types.map((t) => <option value={t.v}>{t.l}</option>)}</select>
        </label>
        <label>
          <span class="kd-label">imię i nazwisko</span>
          <input class="kd-input" type="text" placeholder="Jan Kowalski" />
        </label>
        <label>
          <span class="kd-label">adres e-mail</span>
          <input class="kd-input" type="email" placeholder="jan@twojafirma.pl" />
        </label>
        <label>
          <span class="kd-label">domena</span>
          <input class="kd-input" type="text" placeholder="twojafirma.pl" spellcheck="false" />
        </label>
        <label>
          <span class="kd-label">wiadomość</span>
          <textarea class="kd-input" rows="4" placeholder="Czego chcesz się dowiedzieć?"></textarea>
        </label>
        <button type="button" class="kd-btn kd-btn-block">Wyślij wiadomość</button>
        <span class="kd-micro">Podgląd – formularz nie wysyła zgłoszeń.</span>
      </form>
    </div>
  </section>

  <fragment slot="machine">{`# Kontakt – widocznosc.ai

Porozmawiajmy o cytowaniach. Odpowiadamy w jeden dzień roboczy.

Rodzaje spraw: audyt widoczności w AI, konsultacja z ekspertem,
stała współpraca GEO.

- Firma: ICEA S.A.
- Adres: Szyperska 14, Poznań
- Czas odpowiedzi: 1 dzień roboczy

Zanim napiszesz, możesz uruchomić bezpłatny test widoczności:
/narzedzia/brand-check/

widocznosc.ai by ICEA S.A.
`}</fragment>
</KierunekD>

<style>
  .kd-contact {
    display: grid;
    grid-template-columns: 1fr 400px;
    gap: 64px;
    align-items: start;
  }
  .kd-contact-form {
    gap: 16px;
  }
  .kd-contact-form label {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .kd-contact-form .kd-input {
    width: 100%;
  }
  .kd-contact-form .kd-micro {
    margin-top: 0;
  }
  @media (max-width: 1023px) {
    .kd-contact {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }
</style>
