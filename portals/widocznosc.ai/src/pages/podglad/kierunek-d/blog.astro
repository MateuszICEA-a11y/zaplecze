---
/**
 * Podgląd kierunku D – magazyn bloga. Wpisy z realnej kolekcji `blog`.
 */
import KierunekD from '../../../layouts/KierunekD.astro';
import { getCollection } from 'astro:content';
import { PILLAR_LABELS } from '../../../content.config';

const base = '/podglad/kierunek-d';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const [lead, ...rest] = posts;

const fmt = (d: Date) =>
  d.toLocaleDateString('pl-PL', { day: '2-digit', month: '2-digit', year: 'numeric' });

const counts = Object.entries(PILLAR_LABELS).map(([key, label]) => ({
  label,
  n: posts.filter((p) => p.data.pillar === key).length,
}));
---

<KierunekD title="Podgląd D: magazyn – widocznosc.ai" current="blog">
  <section class="kd-section">
    <div class="kd-wrap">
      <span class="kd-label">Baza wiedzy · {posts.length} wpisów</span>
      <h1 class="kd-text-title" style="margin-top:16px">Baza wiedzy o <em>AI</em></h1>
      <p class="kd-lead" style="margin-top:24px">
        Poradniki, analizy i&nbsp;case studies o&nbsp;ChatGPT, Claude, Gemini, Perplexity,
        automatyzacji, SEO i&nbsp;widoczności marek w&nbsp;wyszukiwarkach AI.
      </p>
      <div class="kd-tags" style="margin-top:32px">
        <span class="is-on">wszystkie<i>{posts.length}</i></span>
        {counts.map((c) => <span>{c.label}<i>{c.n}</i></span>)}
      </div>
    </div>
  </section>

  {
    lead && (
      <section class="kd-section">
        <div class="kd-wrap">
          <a class="kd-card is-hot" href={`${base}/wpis/`}>
            <span class="kd-tag">
              wyróżnione · {PILLAR_LABELS[lead.data.pillar]} · {fmt(lead.data.date)} · {lead.data.readTime}
            </span>
            <h2 class="kd-text-heading" style="margin-top:12px">{lead.data.title}</h2>
            <p class="kd-body" style="margin-top:12px;max-width:64ch">{lead.data.description}</p>
            <span class="kd-micro">{lead.data.author.name} · {lead.data.author.role}</span>
          </a>
        </div>
      </section>
    )
  }

  <section class="kd-section">
    <div class="kd-wrap">
      <div class="kd-section-head">
        <span class="kd-label">Wszystkie wpisy</span>
        <h2 class="kd-text-title">Najnowsze</h2>
      </div>
      <div class="kd-grid-3">
        {
          rest.slice(0, 12).map((p) => (
            <a class="kd-card" href={`${base}/wpis/`}>
              <span class="kd-tag">{PILLAR_LABELS[p.data.pillar]}</span>
              <h3 class="kd-text-sub" style="margin-top:10px">{p.data.title}</h3>
              <p class="kd-body-sm kd-clamp" style="margin-top:10px">{p.data.description}</p>
              <span class="kd-micro" style="margin-top:auto;padding-top:20px">
                {fmt(p.data.date)} · {p.data.readTime} · {p.data.author.name}
              </span>
            </a>
          ))
        }
      </div>
      <p class="kd-meta" style="margin-top:16px">
        {posts.length} wpisów · sześć filarów · sortowanie po dacie publikacji
      </p>
    </div>
  </section>

  <fragment slot="machine">{`# Baza wiedzy o AI – widocznosc.ai

Poradniki, analizy i case studies o ChatGPT, Claude, Gemini, Perplexity,
automatyzacji, SEO i widoczności marek w wyszukiwarkach AI.

Filary: GEO, Modele LLM, Prompty, Agenci AI, RAG, AI w biznesie.

## Wpisy

${posts
  .slice(0, 20)
  .map(
    (p) =>
      `- [${p.data.title}](/blog/${p.id}/) – ${PILLAR_LABELS[p.data.pillar]}, ${fmt(p.data.date)}, ${p.data.readTime}. ${p.data.description}`,
  )
  .join('\n')}

widocznosc.ai by ICEA S.A.
`}</fragment>
</KierunekD>

<style>
  .kd-clamp {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
