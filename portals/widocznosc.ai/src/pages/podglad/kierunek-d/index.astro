---
/**
 * Podgląd kierunku D – strona główna.
 * Treść 1:1 z produkcji: Hero, HowItWorks, Audits, ProofData, Industries, FAQ.
 * Karty narzędzi odwzorowują strukturę karty cennika wzorca:
 * tytuł → pasek kropek → mono → duża liczba → mono → lista na hairline → przycisk.
 */
import KierunekD from '../../../layouts/KierunekD.astro';
import HalftoneSentence from '../../../components/HalftoneSentence.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { PILLAR_LABELS } from '../../../content.config';
import { homepageFaq } from '../../../data/homepageFaq';

const steps = [
  {
    n: '01',
    stage: 'Etap 1',
    t: 'Mapa pytań',
    d: 'Tworzymy 32–48 zapytań z trzech warstw – brandowych, ogólnych i porównawczych. Lista wynika z Twojej kategorii, nie z generatora.',
    list: ['Spotkanie strategiczne z zespołem', 'Analiza intencji kupujących', 'Lista benchmarkowych konkurentów'],
  },
  {
    n: '02',
    stage: 'Etap 2',
    t: 'Test 5 silników AI',
    d: 'Zapytania trafiają równolegle do ChatGPT, Claude, Gemini, Perplexity i Copilot – ze świeżymi sesjami i bez personalizacji.',
    list: ['Standaryzacja promptów', 'Wielokrotne sesje', 'Pomiar wariancji odpowiedzi'],
  },
  {
    n: '03',
    stage: 'Etap 3',
    t: 'Audyt techniczny + content',
    d: 'Analiza struktury, schema, llms.txt i danych źródłowych. Mapujemy luki contentu pod konwersacyjne zapytania.',
    list: ['Schema & semantyka', 'Audyt llms.txt', 'Mapowanie luk treści'],
  },
  {
    n: '04',
    stage: 'Etap 4',
    t: 'Raport + kierunek dalszych działań',
    d: 'Raport z wnioskami i konkretnymi rekomendacjami. Pokazujemy, gdzie marka jest dziś, gdzie może być za pół roku i jakie kroki nas tam zaprowadzą.',
    list: ['Warsztat z omówieniem wyników', 'Strategia na budowanie widoczności', 'Lista briefów na treści'],
  },
];

const audits = [
  {
    t: 'Ocena cytowalności strony',
    description: 'Wskazujesz jeden URL. Wynik 0–100 + lista 5 priorytetowych zmian według badań Princeton i Indiga (1,2 mln cytowań ChatGPT).',
    preview: [['/blog/jak-wybrac-saas', '43 / 100'], ['Front-load', '78%'], ['Schema', '25%'], ['Cytowania', '12%']],
    cta: 'Oceń stronę',
    href: '/narzedzia/url-check/',
  },
  {
    t: 'Widoczność marki w AI',
    description: 'Odpytujemy ChatGPT, Claude, Gemini i Perplexity o Twoją firmę. Dostajesz sentyment, listę halucynacji i konkurentów, których AI poleca zamiast Ciebie.',
    preview: [['twojadomena.pl', '● live'], ['ChatGPT', 'Myli ofertę'], ['Claude', 'Brak danych'], ['Gemini', 'Poleca konkurenta'], ['Perplexity', 'Zna · neutralny']],
    cta: 'Sprawdź widoczność marki',
    href: '/narzedzia/brand-check/',
    hot: true,
  },
  {
    t: 'Dostęp botów AI',
    description: 'Sprawdzamy robots.txt: czy GPTBot, ClaudeBot, PerplexityBot, Google-Extended i 9 innych botów AI ma dostęp do Twojej strony.',
    preview: [['twojadomena.pl/robots.txt', '8 / 13'], ['GPTBot', '✓'], ['ClaudeBot', '✗'], ['PerplexityBot', '✓'], ['Google-Extended', '✗']],
    cta: 'Sprawdź boty AI',
    href: '/narzedzia/ai-bots-check/',
  },
];

const rows = [
  {
    num: '+40',
    unit: '%',
    claim: 'Wzrost widoczności w odpowiedziach silników AI przy zastosowaniu metodyki GEO.',
    detail: 'Pierwsze peer-reviewed badanie z ACM SIGKDD definiujące samą dyscyplinę – nie marketing, tylko akademicki framework.',
    kind: 'Peer-reviewed · Fundament GEO',
    source: 'Princeton · KDD 2024 · Aggarwal et al., GEO Paper',
    href: 'https://arxiv.org/abs/2311.09735',
  },
  {
    num: '8',
    unit: '×',
    claim: 'Tyle różnych podzapytań Google generuje z jednego pytania użytkownika.',
    detail: 'Indeksowanie odbywa się na poziomie pojedynczych fragmentów, nie całych stron – optymalizacja na poziomie strony już nie wystarcza.',
    kind: 'Patent',
    source: 'Google · patent 2024 · query fan-out, passage retrieval',
    href: 'https://searchengineland.com/how-ai-mode-ai-overviews-work-patents-456346',
  },
  {
    num: '+357',
    unit: '%',
    claim: 'Wzrost ruchu z silników AI rok do roku dla najpopularniejszych stron.',
    detail: 'Marki aktywnie optymalizujące pod cytowania AI notują nawet +800% wzrostu ruchu z LLM.',
    kind: 'Dane rynkowe',
    source: 'TechCrunch · Authoritas · 13 miesięcy danych ruchu AI',
    href: 'https://searchengineland.com/what-13-months-of-data-reveals-about-llm-traffic-growth-and-conversions-470115',
  },
  {
    num: '84',
    unit: '%',
    claim: 'Rekomendacji w silnikach AI pochodzi z ChatGPT (rośnie 3,26× YoY).',
    detail: 'Copilot rośnie 25,2×, Claude 12,8× – każdy silnik wymaga innej taktyki cytowania.',
    kind: 'Benchmark',
    source: 'Previsible · 2025 · 1,96 mln sesji LLM',
    href: 'https://previsible.io/seo-strategy/ai-seo-study-2025/',
  },
];

const industries = [
  { name: 'B2B SaaS i Tech', desc: 'Długa droga zakupowa oparta na researchu. Decydent pyta ChatGPT „najlepsze X dla zespołu Y” – warto, żebyście pojawili się w odpowiedzi.' },
  { name: 'Finanse i Prawo', desc: 'Wysoka wartość transakcji, AI bywa pierwszym doradcą klienta. Wzmianka w odpowiedzi AI to rozmowa z osobą, która już wie, czego szuka.' },
  { name: 'Medycyna i Zdrowie', desc: 'Pacjenci pytają AI o objawy, leki i miejsca leczenia. AI Overviews coraz częściej zastępują pierwszy etap szukania w klasycznej wyszukiwarce.' },
  { name: 'E-commerce i DTC', desc: 'Pytania porównawcze („X vs Y”, „tańszy zamiennik dla Z”). Ruch z AI to użytkownicy w końcowej fazie wyboru produktu.' },
  { name: 'Edukacja i Szkolenia', desc: 'Długi proces decyzyjny z wieloma punktami styku. Kursanci pytają AI o „najlepszy kurs X” miesiące przed zapisem.' },
  { name: 'Usługi B2B', desc: 'Konsulting, agencje, software house’y. Klienci pytają AI o polecanych dostawców, zanim wyślą pierwszego maila.' },
];

const engines = [
  { name: 'ChatGPT', file: 'chatgpt' },
  { name: 'Claude', file: 'claude' },
  { name: 'Gemini', file: 'gemini' },
  { name: 'Perplexity', file: 'perplexity' },
  { name: 'Microsoft Copilot', file: 'copilot' },
];

const credentials = [
  { value: '15+', label: 'lat doświadczenia', caption: 'ICEA · agencja SEO i AI' },
  { value: '5', label: 'wyszukiwarek AI', caption: 'ChatGPT · Claude · Gemini · Perplexity · Copilot' },
  { value: '500+', label: 'projektów SEO', caption: 'wdrożonych przez zespół' },
  { value: '#1', label: 'SEMKRK 2024', caption: 'najwyżej oceniona prezentacja' },
];

const team = [
  { name: 'Tomasz Czechowski', role: 'Head of SEO', photo: '/authors/tomasz-czechowski.avif', text: 'Łączy możliwości technologii LLM z celami biznesowymi. Twórca autorskich frameworków pozycjonowania w ekosystemach AI.', href: 'https://www.linkedin.com/in/tomasz-czechowski/' },
  { name: 'Michał Ziach', role: 'CTO', photo: '/authors/michal-ziach.avif', text: 'Chief Technology Officer w ICEA. Architekt rozwiązań AI/ML i systemów wspierających SEO.', href: 'https://www.linkedin.com/in/micha%C5%82-ziach/' },
  { name: 'Piotr Wicenciak', role: 'SEO Operations Manager', photo: '/authors/piotr-wicenciak.avif', text: 'Strateg specjalizujący się w optymalizacji dla generatywnych silników wyszukiwania. Architekt widoczności w erze AI.', href: 'https://www.linkedin.com/in/piotr-wicenciak/' },
  { name: 'Mateusz Wiśniewski', role: 'Ekspert SEO/AI Search', photo: '/authors/mateusz-wisniewski.avif', text: 'Ekspert w inżynierii promptów i analizie semantycznej. Przekłada złożone dane na strategie dominacji w wynikach AI.', href: 'https://www.linkedin.com/in/mateusz-wi%C5%9Bniewski-b23338221/' },
];

const allPosts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const homepagePillars = ['geo', 'modele-llm', 'ai-w-biznesie', 'rag'] as const;
const articles = homepagePillars
  .map((pillar) => allPosts.find((post) => post.data.pillar === pillar))
  .filter((post): post is NonNullable<typeof post> => Boolean(post));
const formatDate = (date: Date) =>
  date.toLocaleDateString('pl-PL', { year: 'numeric', month: 'long', day: 'numeric' });

---

<KierunekD title="Podgląd D: strona główna – widocznosc.ai" current="home">
  <div class="kd-home">
  <section class="kd-hero">
    <div class="kd-wrap kd-hero-copy">
      <span class="kd-caption">Generative Engine Optimization</span>
      <h1 class="kd-text-display">
        <span class="kd-d1">Sprawdź, co ChatGPT, Claude, Gemini</span>
        <span class="kd-d2">i Perplexity mówią o <em>Twojej marce</em>.</span>
      </h1>
      <div class="kd-hero-support">
        <p class="kd-lead">
          Sprawdź już teraz, czy AI poleca Twoją markę, czy boty AI mają dostęp do Twojej
          strony i jak zoptymalizować swój content, aby był cytowany przez wyszukiwarki AI.
        </p>
        <aside class="kd-hero-thesis">
          <span class="kd-label">SEO + GEO · Ewolucja wyszukiwania</span>
          <p class="kd-body">AI zmienia wyszukiwarki w <strong>silniki odpowiedzi</strong>, które eliminują konieczność przeklikiwania się przez wyniki. Marki pominięte przez ChatGPT, Claude czy Perplexity po prostu <strong>przestają istnieć</strong> w decyzji konsumenta.</p>
        </aside>
      </div>

      <div class="kd-actions kd-hero-actions">
        <a class="kd-btn" href="#audyty">Uruchom darmowe testy →</a>
        <a class="kd-btn kd-btn-2" href="/kontakt/?type=full-report">Zamów pełny raport</a>
      </div>
    </div>

    <figure class="kd-figure">
      <HalftoneSentence
        fromSrc="/logos/brand/widocznosc-mark.svg"
        fromText="widocznosc.ai"
        toSrc="/logos/brand/icea-wordmark.svg"
        ratio={0.18}
        alt="Ilustracja: znak widocznosc.ai rozsypuje się w chmurę kropek i scala w logotyp iCEA"
      />
    </figure>
  </section>

  <section class="kd-engine-band" id="silniki-ai" aria-label="Silniki AI objęte pomiarem">
    <div class="kd-wrap kd-engine-band-inner">
      <div class="kd-engine-copy"><span class="kd-label">Audytujemy widoczność w silnikach AI</span></div>
      <div class="kd-logo-slider" aria-label="ChatGPT, Claude, Gemini, Perplexity i Microsoft Copilot">
        <div class="kd-logo-track">
          {[...engines, ...engines].map((engine, i) => <img src={`/logos/ai-engines/${engine.file}.png`} alt={i < engines.length ? engine.name : ''} aria-hidden={i >= engines.length ? 'true' : undefined} loading="lazy" />)}
        </div>
      </div>
    </div>
  </section>

  <section class="kd-cred-section" id="liczby">
    <div class="kd-wrap">
      <dl class="kd-cred-grid" aria-label="Liczby widocznosc.ai">
        {credentials.map((item, i) => (
          <div>
            <dt class="kd-tag">0{i + 1}</dt>
            <dd class="kd-text-num-md">{item.value}</dd>
            <dt class="kd-body-sm"><strong>{item.label}</strong><small>{item.caption}</small></dt>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="kd-section" id="jak-to-dziala">
    <div class="kd-wrap">
      <div class="kd-section-head">
        <span class="kd-label">Jak działamy</span>
        <h2 class="kd-text-title">Cztery etapy budowania widoczności w AI</h2>
      </div>
      <p class="kd-lead kd-process-intro">Pokazujemy, gdzie Twoja marka jest dziś w wyszukiwarkach AI i jakie kroki mogą zwiększyć jej widoczność. Co dalej – decydujesz sam.</p>
      <ol class="kd-grid-4 kd-ol">
        {
          steps.map((s) => (
            <li class="kd-card kd-process-card">
              <span class="kd-tag">{s.n} · {s.stage}</span>
              <h3 class="kd-text-heading kd-process-title">{s.t}</h3>
              <p class="kd-body-sm">{s.d}</p>
              <div class="kd-process-results">
                <span class="kd-label">W tym etapie</span>
                <ul class="kd-list kd-result-list">{s.list.map((item) => <li>{item}</li>)}</ul>
              </div>
            </li>
          ))
        }
      </ol>
      <p class="kd-meta kd-process-footer">Każdy etap z konkretnym rezultatem. Po audycie sam decydujesz, jakiej formy współpracy potrzebujesz.</p>
    </div>
  </section>

  <section class="kd-section" id="pelny-raport">
    <div class="kd-wrap kd-measure-wrap">
      <div class="kd-section-head">
        <span class="kd-label">Pełny raport · 25–50 URL-i · Polecane</span>
        <h2 class="kd-text-title">Rozbudowany raport GEO dla Twojej domeny</h2>
      </div>
      <div class="kd-report">
        <div class="kd-report-copy">
          <p class="kd-lead">Skanujemy 25–50 URL-i z Twojej domeny i analizujemy cztery obszary: spójność tematyczną, sygnały autorytetu, dostępność dla AI oraz widoczność w wyszukiwarkach AI.</p>
          <ul class="kd-list">
            <li>Wynik GEO dla każdego URL-a z konkretnymi problemami i rekomendacjami</li>
            <li>Mapa luk w treści pod konwersacyjne zapytania AI</li>
            <li>Plan działań ułożony wg priorytetu (krytyczne / ważne / średnie)</li>
            <li>Wnioski i kierunek działań w dłuższym horyzoncie</li>
          </ul>
          <div class="kd-actions kd-report-actions">
            <a class="kd-btn" href="/kontakt/?type=full-report">Zamów pełny raport <span aria-hidden="true">→</span></a>
            <a class="kd-btn kd-btn-2" href="/kontakt/?type=konsultacja">Porozmawiaj z ekspertem ICEA</a>
          </div>
        </div>
        <aside class="kd-report-machine" aria-label="Przykładowy wynik raportu GEO">
          <div class="kd-report-top"><span>GEO Score · twojadomena.pl</span><b>38%</b></div>
          <div class="kd-meter"><i style="width:38%"></i></div>
          <dl class="kd-report-bars">
            <div><dt>Spójność tematyczna</dt><span><i style="width:56%"></i></span><dd>56%</dd></div>
            <div><dt>Sygnały autorytetu</dt><span><i style="width:42%"></i></span><dd>42%</dd></div>
            <div><dt>Dostępność dla AI</dt><span><i style="width:68%"></i></span><dd>68%</dd></div>
            <div><dt>Widoczność w AI</dt><span><i style="width:30%"></i></span><dd>30%</dd></div>
          </dl>
          <p><span class="kd-tag">Plan działań</span> 23 zadania · 13 / 25 URL-i</p>
        </aside>
      </div>
    </div>
  </section>

  <section class="kd-section" id="audyty">
    <div class="kd-wrap kd-measure-wrap">
      <div class="kd-section-head">
        <span class="kd-label">Co dostajesz</span>
        <h2 class="kd-text-title">Trzy darmowe testy i pełny raport GEO</h2>
      </div>
      <p class="kd-lead kd-tools-intro">Zacznij od trzech szybkich testów – bez logowania, każdy w kilka sekund. Gdy chcesz głębszy obraz, zamów rozbudowany raport GEO ze skanem 25–50 URL-i Twojej domeny.</p>
      <div class="kd-grid-3">
        {
          audits.map((a, i) => (
            <div class:list={['kd-card', a.hot && 'is-hot']}>
              <div class="kd-audit-kicker"><span class="kd-tag">0{i + 1} / 04</span><span class="kd-micro">darmowe · instant</span></div>
              <h3 class="kd-text-heading">{a.t}</h3>
              <p class="kd-body-sm kd-audit-desc">{a.description}</p>
              <div class="kd-audit-preview" aria-label={`Przykładowy wynik: ${a.t}`}>
                <span class="kd-label">Przykładowy wynik</span>
                {a.preview.map(([label, value]) => <div><span>{label}</span><b>{value}</b></div>)}
              </div>
              <div class="kd-card-foot">
                <a class:list={['kd-btn', 'kd-btn-block', !a.hot && 'kd-btn-2']} href={a.href}>
                  {a.cta}
                </a>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="kd-section" id="zespol">
    <div class="kd-wrap">
      <div class="kd-section-head">
        <span class="kd-label">Zespół</span>
        <h2 class="kd-text-title">Stoi za nami zespół ICEA</h2>
      </div>
      <p class="kd-lead kd-team-intro">Nasze kilkunastoletnie doświadczenie w SEO przekuwamy w skuteczne strategie widoczności w dobie AI Search. Nie teoretyzujemy – każda rekomendacja na tej stronie to wniosek z realnych projektów.</p>
      <div class="kd-team-grid">
        {team.map((person) => (
          <article class="kd-team-card">
            <img src={person.photo} alt={`${person.name} – ${person.role}`} loading="lazy" width="240" height="240" />
            <p class="kd-tag">{person.role}</p>
            <h3 class="kd-text-sub">{person.name}</h3>
            <p class="kd-body-sm">{person.text}</p>
            <a class="kd-meta" href={person.href} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="kd-section" id="wiedza">
    <div class="kd-wrap">
      <div class="kd-section-head kd-articles-head">
        <div class="kd-articles-title"><span class="kd-label">Centrum wiedzy</span><h2 class="kd-text-title">Jak działają modele AI?</h2></div>
        <div class="kd-articles-aside">
          <p class="kd-body-sm">Definicje, case studies i poradniki – dowiedz się, jak modele językowe syntezują odpowiedzi i co decyduje o cytowalności Twojej marki w świecie AI.</p>
          <a class="kd-meta" href="/blog/">Wszystkie artykuły →</a>
        </div>
      </div>
      <div class="kd-grid-4" id="wiedza-grid">
        {articles.map((article) => (
          <a class="kd-card kd-article-card" href={`/${article.id}/`}>
            <div class="kd-article-image">
              <Image
                src={article.data.image}
                alt={article.data.title}
                widths={[360, 540, 720]}
                sizes="(min-width: 1180px) 24vw, (min-width: 700px) 48vw, 100vw"
                loading="lazy"
              />
            </div>
            <div class="kd-article-content">
              <span class="kd-tag">{PILLAR_LABELS[article.data.pillar]}</span>
              <span class="kd-micro">{article.data.readTime} · {formatDate(article.data.date)}</span>
              <h3 class="kd-text-heading">{article.data.title}</h3>
              {article.data.subtitle && <p class="kd-body-sm">{article.data.subtitle}</p>}
              <span class="kd-meta">Czytaj →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="kd-section" id="dane">
    <div class="kd-wrap">
      <div class="kd-section-head">
        <span class="kd-label">Źródła i badania</span>
        <h2 class="kd-text-title">Nie wymyślamy GEO – opieramy się na badaniach</h2>
      </div>
      <div>
        {
          rows.map((r) => (
            <div class="kd-row">
              <span class="kd-text-num-md">{r.num}<i>{r.unit}</i></span>
              <span class="kd-proof-copy"><strong>{r.claim}</strong><small>{r.detail}</small></span>
              <span class="kd-src">
                <span class="kd-label">{r.kind}</span>
                <a href={r.href} target="_blank" rel="noopener noreferrer">{r.source}</a>
              </span>
            </div>
          ))
        }
      </div>
      <p class="kd-lead kd-proof-intro">Każda rekomendacja w naszym audycie ma źródło – akademickie badania, patenty Google, dane rynkowe albo nasze własne testy. Zero marketingowego bełkotu.</p>
      <p class="kd-meta kd-proof-footer">Plus 15+ lat doświadczenia ICEA w klasycznym SEO – te same fundamenty (autorytet, semantyka, struktura) działają w AI inaczej, ale rygor pracy zostaje ten sam.</p>
    </div>
  </section>

  <section class="kd-section" id="branze">
    <div class="kd-wrap">
      <div class="kd-section-head">
        <span class="kd-label">Dla kogo</span>
        <h2 class="kd-text-title">Sześć branż, na których koncentrujemy uwagę</h2>
      </div>
      <p class="kd-lead kd-industry-intro">Tam, gdzie klient zaczyna od pytania zadanego AI, a decyzja zakupowa wymaga rzetelnego rozeznania. To branże, w których widzimy największy wpływ wyszukiwarek AI – nie jedyne, z którymi pracujemy.</p>
      <div class="kd-grid-3">
        {
          industries.map((i) => (
            <div class="kd-card">
