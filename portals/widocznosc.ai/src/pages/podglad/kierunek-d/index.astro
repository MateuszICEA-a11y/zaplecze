---
/**
 * Podgląd kierunku D – strona główna.
 * Treść 1:1 z produkcji: Hero, HowItWorks, Audits, ProofData, Industries, FAQ.
 * Karty narzędzi odwzorowują strukturę karty cennika wzorca:
 * tytuł → pasek kropek → mono → duża liczba → mono → lista na hairline → przycisk.
 */
import KierunekD from '../../../layouts/KierunekD.astro';
import HalftoneSentence from '../../../components/HalftoneSentence.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { PILLAR_LABELS } from '../../../content.config';
import { homepageFaq } from '../../../data/homepageFaq';

const steps = [
  {
    n: '01',
    t: 'Podajesz markę i domenę',
    d: 'Bez rejestracji. Narzędzie odpytuje ChatGPT, Claude, Gemini i Perplexity świeżymi sesjami, bez personalizacji i bez podpowiadania odpowiedzi.',
  },
  {
    n: '02',
    t: 'Dostajesz wynik per model',
    d: 'Czy model zna markę, jak o niej mówi, czy cytuje Twoją domenę i jakie fakty zmyśla. Każdy model osobno, bo każdy cytuje inaczej.',
  },
  {
    n: '03',
    t: 'Widzisz konkurentów i plan',
    d: 'Lista firm polecanych zamiast Ciebie i pierwsze działania ułożone według priorytetu. Resztę omawiasz z ekspertem ICEA.',
  },
];

const audits = [
  {
    t: 'Cytowalność strony',
    dots: 10,
    micro: 'jeden adres · wynik 0–100',
    num: '30',
    unit: 's',
    meta: 'bezpłatnie · bez rejestracji',
    description: 'Wskazujesz jeden adres. Wynik 0–100 i pięć priorytetowych zmian według badań Princeton i analizy 1,2 mln cytowań ChatGPT.',
    list: ['Pięć priorytetowych zmian', 'Według badań Princeton', 'Analiza 1,2 mln cytowań ChatGPT'],
    cta: 'Oceń stronę',
    href: '/narzedzia/url-check/',
  },
  {
    t: 'Widoczność marki w AI',
    dots: 20,
    micro: '4 silniki · świeże sesje',
    num: '60',
    unit: 's',
    meta: 'bezpłatnie · bez rejestracji',
    description: 'Odpytujemy ChatGPT, Claude, Gemini i Perplexity o Twoją firmę. Dostajesz sentyment, listę halucynacji i konkurentów, których AI poleca zamiast Ciebie.',
    list: ['ChatGPT, Claude, Gemini, Perplexity', 'Sentyment i lista halucynacji', 'Konkurenci polecani zamiast Ciebie'],
    cta: 'Sprawdź widoczność marki',
    href: '/narzedzia/brand-check/',
    hot: true,
  },
  {
    t: 'Dostęp botów AI',
    dots: 2,
    micro: 'robots.txt i WAF',
    num: '<1',
    unit: 's',
    meta: 'bezpłatnie · natychmiast',
    description: 'Sprawdzamy robots.txt i WAF: czy GPTBot, ClaudeBot, PerplexityBot, Google-Extended i 9 innych botów AI może czytać Twoją stronę.',
    list: ['GPTBot, ClaudeBot, PerplexityBot', 'Google-Extended i 9 innych botów', 'Dostęp albo blokada per bot'],
    cta: 'Sprawdź boty AI',
    href: '/narzedzia/ai-bots-check/',
  },
];

const rows = [
  {
    num: '+40',
    unit: '%',
    claim: 'wzrost widoczności w odpowiedziach AI po zastosowaniu metod GEO',
    detail: 'Pierwsze recenzowane badanie definiujące dyscyplinę (Princeton, ACM SIGKDD 2024). Z tej pracy wynikają nasze rekomendacje dotyczące treści.',
    kind: 'Badanie peer-reviewed',
    source: 'Aggarwal et al., KDD 2024',
    href: 'https://arxiv.org/abs/2311.09735',
  },
  {
    num: '8',
    unit: '×',
    claim: 'tyle podzapytań Google generuje z jednego pytania w trybie AI',
    detail: 'Indeksowanie odbywa się na poziomie fragmentów, nie całych stron. Dlatego mierzymy cytowalność pojedynczych akapitów, nie tylko adresu.',
    kind: 'Patent Google',
    source: 'Search Engine Land, analiza patentów',
    href: 'https://searchengineland.com/how-ai-mode-ai-overviews-work-patents-456346',
  },
  {
    num: '+357',
    unit: '%',
    claim: 'wzrost ruchu z silników AI rok do roku dla najpopularniejszych stron',
    detail: '13 miesięcy danych o ruchu z LLM. Marki, które optymalizują pod cytowania, notują nawet +800%.',
    kind: 'Dane rynkowe',
    source: 'Authoritas / Search Engine Land',
    href: 'https://searchengineland.com/what-13-months-of-data-reveals-about-llm-traffic-growth-and-conversions-470115',
  },
  {
    num: '84',
    unit: '%',
    claim: 'rekomendacji w silnikach AI pochodzi z ChatGPT',
    detail: '1,96 mln sesji z LLM. Copilot rośnie 25,2×, Claude 12,8×. Każdy silnik cytuje inaczej, więc testujemy je osobno.',
    kind: 'Benchmark',
    source: 'Previsible, AI SEO Study 2025',
    href: 'https://previsible.io/seo-strategy/ai-seo-study-2025/',
  },
];

const industries = [
  { name: 'B2B SaaS i Tech', desc: 'Decydent pyta ChatGPT o „najlepsze narzędzie X dla zespołu Y”. Chcesz być w tej odpowiedzi.' },
  { name: 'Finanse i Prawo', desc: 'AI bywa pierwszym doradcą klienta. Wzmianka w odpowiedzi to rozmowa z kimś, kto już wie, czego szuka.' },
  { name: 'Medycyna i Zdrowie', desc: 'Pacjenci pytają AI o objawy, leki i miejsca leczenia, zanim otworzą klasyczną wyszukiwarkę.' },
  { name: 'E-commerce i DTC', desc: 'Pytania porównawcze: „X vs Y”, „tańszy zamiennik Z”. Użytkownik jest w końcowej fazie wyboru.' },
  { name: 'Edukacja i Szkolenia', desc: 'Kursanci pytają AI o „najlepszy kurs X” miesiące przed zapisem. Długa droga, wiele punktów styku.' },
  { name: 'Usługi B2B', desc: 'Konsulting, agencje, software house’y. Klient pyta AI o polecanych dostawców przed pierwszym mailem.' },
];

const engines = [
  { name: 'ChatGPT', file: 'chatgpt' },
  { name: 'Claude', file: 'claude' },
  { name: 'Gemini', file: 'gemini' },
  { name: 'Perplexity', file: 'perplexity' },
  { name: 'Microsoft Copilot', file: 'copilot' },
];

const credentials = [
  { value: '15+', label: 'lat doświadczenia', caption: 'ICEA · agencja SEO i AI' },
  { value: '5', label: 'wyszukiwarek AI', caption: 'ChatGPT · Claude · Gemini · Perplexity · Copilot' },
  { value: '500+', label: 'projektów SEO', caption: 'wdrożonych przez zespół' },
  { value: '#1', label: 'SEMKRK 2024', caption: 'najwyżej oceniona prezentacja' },
];

const measurementFacts = [
  { value: '4', label: 'modele AI odpytywane w teście marki' },
  { value: '13', label: 'botów AI sprawdzanych w robots.txt' },
  { value: '0–100', label: 'wynik cytowalności pojedynczej strony' },
  { value: '25–50', label: 'adresów w pełnym raporcie GEO' },
];

const team = [
  { name: 'Tomasz Czechowski', role: 'Head of SEO', photo: '/authors/tomasz-czechowski.avif', text: 'Łączy możliwości technologii LLM z celami biznesowymi. Twórca autorskich frameworków pozycjonowania w ekosystemach AI.', href: 'https://www.linkedin.com/in/tomasz-czechowski/' },
  { name: 'Michał Ziach', role: 'CTO', photo: '/authors/michal-ziach.avif', text: 'Chief Technology Officer w ICEA. Architekt rozwiązań AI/ML i systemów wspierających SEO.', href: 'https://www.linkedin.com/in/micha%C5%82-ziach/' },
  { name: 'Piotr Wicenciak', role: 'SEO Operations Manager', photo: '/authors/piotr-wicenciak.avif', text: 'Strateg specjalizujący się w optymalizacji dla generatywnych silników wyszukiwania. Architekt widoczności w erze AI.', href: 'https://www.linkedin.com/in/piotr-wicenciak/' },
  { name: 'Mateusz Wiśniewski', role: 'Ekspert SEO/AI Search', photo: '/authors/mateusz-wisniewski.avif', text: 'Ekspert w inżynierii promptów i analizie semantycznej. Przekłada złożone dane na strategie dominacji w wynikach AI.', href: 'https://www.linkedin.com/in/mateusz-wi%C5%9Bniewski-b23338221/' },
];

const allPosts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const homepagePillars = ['geo', 'modele-llm', 'ai-w-biznesie', 'rag'] as const;
const articles = homepagePillars
  .map((pillar) => allPosts.find((post) => post.data.pillar === pillar))
  .filter((post): post is NonNullable<typeof post> => Boolean(post));
const formatDate = (date: Date) =>
  date.toLocaleDateString('pl-PL', { year: 'numeric', month: 'long', day: 'numeric' });

const DOTS = 24;
---

<KierunekD title="Podgląd D: strona główna – widocznosc.ai" current="home">
  <div class="kd-home">
  <section class="kd-hero">
    <div class="kd-wrap">
      <span class="kd-caption">Pomiar widoczności marki w AI</span>
      <h1 class="kd-text-display">
        <span class="kd-d1">Sprawdź, czy AI</span>
        <span class="kd-d2">poleca <em>Twoją markę</em>.</span>
      </h1>
      <p class="kd-lead">
        Odpytujemy ChatGPT, Claude, Gemini i Perplexity o Twoją firmę i pokazujemy,
        co odpowiadają: czy znają markę, jak o niej mówią i kogo polecają zamiast Ciebie.
        Wynik w około minutę, bez rejestracji.
      </p>

      <form class="kd-form" action="/narzedzia/brand-check/" method="get">
        <input class="kd-input" type="text" name="brand" placeholder="Nazwa marki" autocomplete="organization" maxlength="80" aria-label="Nazwa marki" />
        <input class="kd-input" type="text" name="domain" placeholder="twojadomena.pl" autocomplete="url" maxlength="200" inputmode="url" spellcheck="false" required aria-label="Domena" />
        <button type="submit" class="kd-btn">Sprawdź widoczność marki <span aria-hidden="true">→</span></button>
      </form>
      <p class="kd-meta kd-hero-note"><a href="/kontakt/?type=konsultacja">Porozmawiaj z ekspertem ICEA</a> · widocznosc.ai by ICEA</p>
    </div>

    <figure class="kd-figure">
      <HalftoneSentence
        fromSrc="/logos/brand/widocznosc-mark.svg"
        fromText="widocznosc.ai"
        toSrc="/logos/brand/icea-wordmark.svg"
        alt="Ilustracja: znak widocznosc.ai rozsypuje się w chmurę kropek i scala w logotyp iCEA"
      />
    </figure>
  </section>

  <section class="kd-engine-band" aria-label="Silniki AI objęte pomiarem">
    <div class="kd-wrap kd-engine-band-inner">
      <div class="kd-engine-copy"><span class="kd-label">Mierzymy widoczność w</span><span class="kd-micro">5 silników · świeże sesje</span></div>
      <div class="kd-logo-slider" aria-label="ChatGPT, Claude, Gemini, Perplexity i Microsoft Copilot">
        <div class="kd-logo-track">
          {[...engines, ...engines].map((engine, i) => <img src={`/logos/ai-engines/${engine.file}.png`} alt={i < engines.length ? engine.name : ''} aria-hidden={i >= engines.length ? 'true' : undefined} loading="lazy" />)}
        </div>
      </div>
    </div>
  </section>

  <section class="kd-cred-section">
    <div class="kd-wrap">
      <dl class="kd-cred-grid" aria-label="Liczby widocznosc.ai">
        {credentials.map((item, i) => (
          <div>
            <dt class="kd-tag">0{i + 1}</dt>
            <dd class="kd-text-num-md">{item.value}</dd>
            <dt class="kd-body-sm"><strong>{item.label}</strong><small>{item.caption}</small></dt>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="kd-section" id="jak-to-dziala">
    <div class="kd-wrap">
      <div class="kd-section-head">
        <span class="kd-label">Jak to działa</span>
        <h2 class="kd-text-title">Od domeny do planu działań w trzech krokach.</h2>
      </div>
      <p class="kd-lead kd-process-intro">To samo narzędzie, które widzisz wyżej. Każdy krok pokazuje realny fragment raportu, nie ilustrację.</p>
      <ol class="kd-grid-3 kd-ol">
        {
          steps.map((s) => (
            <li class="kd-card">
              <span class="kd-tag">{s.n}</span>
              <h3 class="kd-text-heading" style="margin-top:12px">{s.t}</h3>
              <p class="kd-body-sm">{s.d}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="kd-section" id="pelny-raport">
    <div class="kd-wrap">
      <div class="kd-section-head">
        <span class="kd-label">Pełny obraz</span>
        <h2 class="kd-text-title">Raport GEO dla całej domeny.</h2>
      </div>
      <div class="kd-report">
        <div class="kd-report-copy">
          <p class="kd-lead">Skanujemy 25–50 adresów i oceniamy cztery obszary: spójność tematyczną, sygnały autorytetu, dostępność dla AI i widoczność w wyszukiwarkach AI. Dostajesz plan działań ułożony według priorytetu.</p>
          <ul class="kd-list">
            <li>Wynik GEO dla każdego adresu z konkretnymi problemami</li>
            <li>Mapa luk w treści pod pytania zadawane AI</li>
            <li>Plan działań: krytyczne, ważne, średnie</li>
            <li>Omówienie wyników z ekspertem ICEA</li>
          </ul>
          <div class="kd-actions kd-report-actions">
            <a class="kd-btn" href="/kontakt/?type=full-report">Zamów pełny raport <span aria-hidden="true">→</span></a>
            <a class="kd-btn kd-btn-2" href="/kontakt/?type=konsultacja">Porozmawiaj z ekspertem ICEA</a>
          </div>
        </div>
        <aside class="kd-report-machine" aria-label="Przykładowy wynik raportu GEO">
          <div class="kd-report-top"><span>GEO Score · twojadomena.pl</span><b>38%</b></div>
          <div class="kd-meter"><i style="width:38%"></i></div>
          <dl>
            <div><dt>Spójność tematyczna</dt><dd>56%</dd></div>
            <div><dt>Sygnały autorytetu</dt><dd>42%</dd></div>
            <div><dt>Dostępność dla AI</dt><dd>68%</dd></div>
            <div><dt>Widoczność w AI</dt><dd>30%</dd></div>
          </dl>
          <p><span class="kd-tag">Plan działań</span> 23 zadania · 2 krytyczne</p>
        </aside>
      </div>
    </div>
  </section>

  <section class="kd-section" id="audyty">
    <div class="kd-wrap">
      <div class="kd-section-head">
        <span class="kd-label">Narzędzia</span>
        <h2 class="kd-text-title">Trzy testy za darmo. Jeden pełny raport.</h2>
      </div>
      <p class="kd-lead kd-tools-intro">Każdy test działa bez logowania i daje wynik w kilkadziesiąt sekund. Gdy chcesz pełny obraz domeny, zamawiasz raport GEO z analizą 25–50 adresów.</p>
      <div class="kd-grid-3">
        {
          audits.map((a) => (
            <div class:list={['kd-card', a.hot && 'is-hot']}>
              <h3 class="kd-text-heading">{a.t}</h3>
              <div class="kd-dots" aria-hidden="true">
                {Array.from({ length: DOTS }, (_, i) => <i class:list={[i < a.dots && 'on']} />)}
              </div>
              <span class="kd-micro">{a.micro}</span>
              <p class="kd-body-sm kd-audit-desc">{a.description}</p>
              <div class="kd-text-num">{a.num}<i>{a.unit}</i></div>
              <span class="kd-meta">{a.meta}</span>
              <ul class="kd-list">{a.list.map((l) => <li>{l}</li>)}</ul>
              <div class="kd-card-foot">
                <a class:list={['kd-btn', 'kd-btn-block', !a.hot && 'kd-btn-2']} href={a.href}>
                  {a.cta}
                </a>
              </div>
            </div>
          ))
        }
      </div>
      <p class="kd-meta" style="margin-top:16px">
        trzy testy · każdy kończy się liczbą, nie opinią · <a href="/narzedzia/">wszystkie narzędzia</a>
      </p>
    </div>
  </section>

  <section class="kd-section" id="zespol">
    <div class="kd-wrap">
      <div class="kd-section-head">
        <span class="kd-label">widocznosc.ai by ICEA</span>
        <h2 class="kd-text-title">Za pomiarem stoi zespół ICEA</h2>
      </div>
      <p class="kd-lead kd-team-intro">widocznosc.ai to marka agencji ICEA S.A. Kilkunastoletnie doświadczenie w SEO przekładamy na pomiar i budowanie widoczności w wyszukiwarkach AI. Każda rekomendacja na tej stronie to wniosek z realnych projektów.</p>
      <div class="kd-team-grid">
        {team.map((person) => (
          <article class="kd-team-card">
            <img src={person.photo} alt={`${person.name} – ${person.role}`} loading="lazy" width="240" height="240" />
            <p class="kd-tag">{person.role}</p>
            <h3 class="kd-text-sub">{person.name}</h3>
            <p class="kd-body-sm">{person.text}</p>
            <a class="kd-meta" href={person.href} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="kd-section" id="wiedza">
    <div class="kd-wrap">
      <div class="kd-section-head kd-articles-head">
        <div class="kd-articles-title"><span class="kd-label">Baza wiedzy</span><h2 class="kd-text-title">Jak działają modele AI i co decyduje o cytowaniu</h2></div>
        <div class="kd-articles-aside">
          <p class="kd-body-sm">Definicje, case studies i poradniki – dowiedz się, jak modele językowe syntezują odpowiedzi i co decyduje o cytowalności Twojej marki w świecie AI.</p>
          <a class="kd-meta" href="/blog/">Wszystkie artykuły →</a>
        </div>
      </div>
      <div class="kd-grid-4">
        {articles.map((article) => (
          <a class="kd-card kd-article-card" href={`/${article.id}/`}>
            <div class="kd-article-image">
              <Image
                src={article.data.image}
                alt={article.data.title}
                widths={[360, 540, 720]}
                sizes="(min-width: 1180px) 24vw, (min-width: 700px) 48vw, 100vw"
                loading="lazy"
              />
            </div>
            <div class="kd-article-content">
              <span class="kd-tag">{PILLAR_LABELS[article.data.pillar]}</span>
              <span class="kd-micro">{article.data.readTime} · {formatDate(article.data.date)}</span>
              <h3 class="kd-text-heading">{article.data.title}</h3>
              {article.data.subtitle && <p class="kd-body-sm">{article.data.subtitle}</p>}
              <span class="kd-meta">Czytaj →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="kd-section" id="dane">
    <div class="kd-wrap">
      <div class="kd-section-head">
        <span class="kd-label">Dane, nie deklaracje</span>
        <h2 class="kd-text-title">Widoczność w AI da się zmierzyć.</h2>
      </div>
      <div>
        {
          rows.map((r) => (
            <div class="kd-row">
              <span class="kd-text-num-md">{r.num}<i>{r.unit}</i></span>
              <span class="kd-proof-copy"><strong>{r.claim}</strong><small>{r.detail}</small></span>
              <span class="kd-src">
                <span class="kd-label">{r.kind}</span>
                <a href={r.href} target="_blank" rel="noopener noreferrer">{r.source}</a>
              </span>
            </div>
          ))
        }
      </div>
      <p class="kd-lead kd-proof-intro">Nie opowiadamy o rewolucji AI. Opieramy się na badaniach, patentach i danych rynkowych, a potem mierzymy te same zjawiska dla Twojej marki.</p>
      <dl class="kd-cred-grid kd-proof-facts" aria-label="Zakres pomiaru">
        {measurementFacts.map((item, i) => (
          <div>
            <dt class="kd-tag">0{i + 1}</dt>
            <dd class="kd-text-num-md">{item.value}</dd>
            <dt class="kd-body-sm">{item.label}</dt>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="kd-section" id="branze">
    <div class="kd-wrap">
      <div class="kd-section-head">
        <span class="kd-label">Dla kogo</span>
        <h2 class="kd-text-title">Branże, w których klient zaczyna od pytania do AI.</h2>
      </div>
      <p class="kd-lead kd-industry-intro">Tam, gdzie decyzja zakupowa wymaga rozeznania, wyszukiwarki AI mają dziś największy wpływ. To branże, w których widzimy najwięcej danych, nie jedyne, z którymi pracujemy.</p>
      <div class="kd-grid-3">
        {
          industries.map((i) => (
            <div class="kd-card">
              <h3 class="kd-text-sub">{i.name}</h3>
              <p class="kd-body-sm">{i.desc}</p>
            </div>
          ))
        }
      </div>
      <p class="kd-meta kd-industry-footer">Twojej branży nie ma na liście? <a href="/kontakt/">Sprawdzimy potencjał →</a></p>
    </div>
  </section>

  <section class="kd-section" id="faq">
    <div class="kd-wrap kd-faq">
      <div class="kd-section-head">
        <span class="kd-label">FAQ</span>
        <h2 class="kd-text-title">Najczęściej zadawane pytania</h2>
      </div>
      {
        homepageFaq.map((f, i) => (
          <details open={i === 0}>
