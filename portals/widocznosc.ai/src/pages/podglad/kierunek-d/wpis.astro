---
/**
 * Podgląd kierunku D – strona wpisu.
 * Bierze najnowszy realny artykuł z kolekcji i renderuje jego pełną treść,
 * żeby ocenić typografię tekstu długiego, a nie atrapę.
 */
import KierunekD from '../../../layouts/KierunekD.astro';
import { getCollection, render } from 'astro:content';
import { PILLAR_LABELS } from '../../../content.config';

const base = '/podglad/kierunek-d';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const post = posts[0];
const { Content, headings } = await render(post);

const related = posts.filter((p) => p.data.pillar === post.data.pillar && p.id !== post.id).slice(0, 3);

const fmt = (d: Date) =>
  d.toLocaleDateString('pl-PL', { day: '2-digit', month: '2-digit', year: 'numeric' });

const toc = headings.filter((h) => h.depth === 2);
---

<KierunekD title={`Podgląd D: wpis – ${post.data.title}`} current="blog">
  <article>
    <header class="kd-article kd-post-head">
      <p class="kd-eyebrow">
        <a href={`${base}/blog/`}>magazyn</a> / {PILLAR_LABELS[post.data.pillar]}
      </p>
      <h1 class="kd-post-title">{post.data.title}</h1>
      <p class="kd-lead">{post.data.subtitle}</p>
      <p class="kd-micro kd-byline">
        {post.data.author.name} · {post.data.author.role} · {fmt(post.data.date)} ·
        {post.data.readTime}
        {post.data.updated && <> · aktualizacja {fmt(post.data.updated)}</>}
      </p>
    </header>

    {
      toc.length > 0 && (
        <nav class="kd-article kd-toc" aria-label="Spis treści">
          <span class="kd-micro">w tym wpisie</span>
          <ol>
            {toc.map((h, i) => (
              <li>
                <span>{String(i + 1).padStart(2, '0')}</span>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      )
    }

    <div class="kd-article kd-article-body">
      <Content />
    </div>

    <aside class="kd-article kd-cta">
      <h2 class="kd-sub">Sprawdź, czy AI poleca Twoją markę.</h2>
      <p class="kd-micro">bezpłatnie · ok. 60 s · bez rejestracji</p>
      <a class="kd-btn" href={`${base}/narzedzia/`}>Sprawdź widoczność marki</a>
    </aside>

    {
      related.length > 0 && (
        <section class="kd-wrap kd-section">
          <div class="kd-section-head">
            <span class="kd-eyebrow">Z tego samego filaru</span>
            <h2 class="kd-title">{PILLAR_LABELS[post.data.pillar]}</h2>
          </div>
          <div class="kd-grid-3">
            {related.map((p) => (
              <a class="kd-card" href={`${base}/wpis/`}>
                <span class="kd-micro">{fmt(p.data.date)} · {p.data.readTime}</span>
                <h3 class="kd-rel-title">{p.data.title}</h3>
              </a>
            ))}
          </div>
        </section>
      )
    }
  </article>

  <fragment slot="machine">{`# ${post.data.title}

${post.data.subtitle}

Autor: ${post.data.author.name}, ${post.data.author.role}
Filar: ${PILLAR_LABELS[post.data.pillar]}
Opublikowano: ${fmt(post.data.date)}${post.data.updated ? `\nAktualizacja: ${fmt(post.data.updated)}` : ''}
Czas czytania: ${post.data.readTime}

## Spis treści

${toc.map((h, i) => `${i + 1}. ${h.text}`).join('\n')}

---

${post.body}
`}</fragment>
</KierunekD>

<style>
  .kd-post-head {
    padding-top: 72px;
  }
  .kd-post-head .kd-eyebrow a {
    color: var(--kd-chrome);
  }
  .kd-post-title {
    font-size: 52px;
    line-height: 54px;
    letter-spacing: -1.4px;
    margin: 20px 0 20px;
  }
  .kd-byline {
    margin-top: 24px;
    padding-top: 16px;
    border-top: 1px solid var(--kd-line);
  }

  .kd-toc {
    margin-top: 48px;
  }
  .kd-toc ol {
    list-style: none;
    margin: 12px 0 0;
    padding: 0;
    border-top: 1px solid var(--kd-line);
  }
  .kd-toc li {
    display: grid;
    grid-template-columns: 32px 1fr;
    gap: 8px;
    padding: 9px 0;
    border-bottom: 1px solid var(--kd-line);
    font-family: var(--kd-mono);
    font-size: 12px;
    line-height: 18px;
  }
  .kd-toc span {
    color: var(--kd-mute);
  }
  .kd-toc a {
    color: var(--kd-chrome);
    text-decoration: none;
  }
  .kd-toc a:hover {
    color: var(--kd-ink);
  }

  .kd-article-body {
    margin-top: 56px;
  }

  .kd-cta {
    margin-top: 72px;
    border-top: 1px solid var(--kd-line);
    padding-top: 32px;
  }
  .kd-cta .kd-micro {
    margin: 8px 0 20px;
  }

  .kd-rel-title {
    font-size: 18px;
    line-height: 24px;
    letter-spacing: -0.3px;
    margin-top: 10px;
  }

  @media (max-width: 767px) {
    .kd-post-title {
      font-size: 32px;
      line-height: 36px;
      letter-spacing: -0.9px;
    }
  }
</style>
