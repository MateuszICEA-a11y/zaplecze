---
/**
 * Podgląd kierunku D – strona wpisu. Najnowszy realny artykuł z kolekcji,
 * wyrenderowany w całości – ocena typografii tekstu długiego.
 */
import KierunekD from '../../../layouts/KierunekD.astro';
import { getCollection, render } from 'astro:content';
import { PILLAR_LABELS } from '../../../content.config';

const base = '/podglad/kierunek-d';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const post = posts[0];
const { Content, headings } = await render(post);

const related = posts
  .filter((p) => p.data.pillar === post.data.pillar && p.id !== post.id)
  .slice(0, 3);

const fmt = (d: Date) =>
  d.toLocaleDateString('pl-PL', { day: '2-digit', month: '2-digit', year: 'numeric' });

const toc = headings.filter((h) => h.depth === 2);
---

<KierunekD title={`Podgląd D: wpis – ${post.data.title}`} current="blog">
  <article>
    <header class="kd-article kd-post-head">
      <p class="kd-tag"><a href={`${base}/blog/`}>magazyn</a> / {PILLAR_LABELS[post.data.pillar]}</p>
      <h1 class="kd-text-title" style="margin-top:16px">{post.data.title}</h1>
      <p class="kd-lead" style="margin-top:20px">{post.data.subtitle}</p>
      <p class="kd-micro kd-byline">
        {post.data.author.name} · {post.data.author.role} · {fmt(post.data.date)} · {post.data.readTime}
        {post.data.updated && <> · aktualizacja {fmt(post.data.updated)}</>}
      </p>
    </header>

    {
      toc.length > 0 && (
        <nav class="kd-article kd-toc" aria-label="Spis treści">
          <span class="kd-label">W tym wpisie</span>
          <ol>
            {toc.map((h, i) => (
              <li>
                <span class="kd-micro">{String(i + 1).padStart(2, '0')}</span>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      )
    }

    <div class="kd-article kd-article-body">
      <Content />
    </div>

    <aside class="kd-article kd-cta">
      <div class="kd-strip">
        <div>
          <span class="kd-tag">Narzędzie</span>
          <h2 class="kd-text-sub">Sprawdź, czy AI poleca Twoją markę.</h2>
          <span class="kd-micro" style="display:block;margin-top:6px">bezpłatnie · ok. 60 s · bez rejestracji</span>
        </div>
        <a class="kd-btn" href={`${base}/narzedzia/`}>Uruchom test</a>
      </div>
    </aside>

    {
      related.length > 0 && (
        <section class="kd-section">
          <div class="kd-wrap">
            <div class="kd-section-head">
              <span class="kd-label">Z tego samego filaru</span>
              <h2 class="kd-text-title">{PILLAR_LABELS[post.data.pillar]}</h2>
            </div>
            <div class="kd-grid-3">
              {related.map((p) => (
                <a class="kd-card" href={`${base}/wpis/`}>
                  <span class="kd-tag">{fmt(p.data.date)} · {p.data.readTime}</span>
                  <h3 class="kd-text-sub" style="margin-top:10px">{p.data.title}</h3>
                </a>
              ))}
            </div>
          </div>
        </section>
      )
    }
  </article>

  <fragment slot="machine">{`# ${post.data.title}

${post.data.subtitle}

Autor: ${post.data.author.name}, ${post.data.author.role}
Filar: ${PILLAR_LABELS[post.data.pillar]}
Opublikowano: ${fmt(post.data.date)}${post.data.updated ? `\nAktualizacja: ${fmt(post.data.updated)}` : ''}
Czas czytania: ${post.data.readTime}

## Spis treści

${toc.map((h, i) => `${i + 1}. ${h.text}`).join('\n')}

---

${post.body}
`}</fragment>
</KierunekD>

<style>
  .kd-post-head {
    padding-top: 96px;
  }
  .kd-post-head .kd-tag a {
    color: inherit;
    text-decoration: none;
  }
  .kd-byline {
    display: block;
    margin-top: 24px;
    padding-top: 16px;
    border-top: 1px solid var(--kd-line);
  }
  .kd-toc {
    margin-top: 48px;
  }
  .kd-toc ol {
    list-style: none;
    margin: 12px 0 0;
    padding: 0;
    border-top: 1px solid var(--kd-line);
  }
  .kd-toc li {
    display: grid;
    grid-template-columns: 32px 1fr;
    gap: 8px;
    padding: 9px 0;
    border-bottom: 1px solid var(--kd-line);
  }
  .kd-toc a {
    font-family: var(--kd-mono);
    font-size: 12px;
    line-height: 18px;
    color: var(--kd-chrome);
    text-decoration: none;
  }
  .kd-toc a:hover {
    color: var(--kd-ink);
  }
  .kd-article-body {
    margin-top: 56px;
  }
  .kd-cta {
    margin-top: 72px;
  }
  @media (max-width: 767px) {
    .kd-post-head {
      padding-top: 56px;
    }
    .kd-strip {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
