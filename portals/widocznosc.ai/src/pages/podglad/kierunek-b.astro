---
/**
 * Podgląd kierunku B – „Tablica danych” (strona główna wygląda jak produkt).
 * Ref. 21st: Stats Bento (uilayout.contact/stats-bento), Bento Product Features.
 * Index: dane jako pierwszy plan; Planhat: uporządkowane moduły + sekcja leadowa.
 */
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import CTABand from '../../components/CTABand.astro';
---

<Layout title="Podgląd B – Tablica danych | widocznosc.ai" noindex>
  <Navbar />

  <section class="hb">
    <div class="container">
      <div class="hb-head">
        <span class="eyebrow">Pomiar widoczności marki w&nbsp;AI · by ICEA</span>
        <h1 class="display-xl hb-h1">Ile Twojej marki jest w&nbsp;odpowiedziach AI?</h1>
        <form class="hb-form" action="/narzedzia/brand-check/" method="get">
          <input type="text" name="brand" placeholder="Nazwa marki" maxlength="80" />
          <input type="text" name="domain" placeholder="twojadomena.pl" required maxlength="200" inputmode="url" />
          <button type="submit" class="btn-primary">Sprawdź widoczność marki <span aria-hidden="true">→</span></button>
        </form>
      </div>

      <div class="bento" aria-label="Przykładowe wyniki narzędzi widocznosc.ai">
        <!-- 1. Score -->
        <article class="bt bt--score">
          <span class="bt-label">Widoczność marki w&nbsp;AI · przykład</span>
          <div class="bt-score">
            <span class="bt-big">41</span>
            <span class="bt-of">/100</span>
          </div>
          <p class="bt-copy">2&nbsp;z&nbsp;4 modeli zna markę bezpośrednio. Domena cytowana 2 razy. Sentyment neutralny.</p>
          <ul class="bt-models">
            <li><span>ChatGPT</span><span class="tag ok">zna · cytuje</span></li>
            <li><span>Claude</span><span class="tag warn">zna częściowo</span></li>
            <li><span>Gemini</span><span class="tag bad">nie zna</span></li>
            <li><span>Perplexity</span><span class="tag ok">zna · cytuje</span></li>
          </ul>
          <a class="bt-link" href="/narzedzia/brand-check/">Sprawdź swoją markę →</a>
        </article>

        <!-- 2. Badanie (jasny kafel) -->
        <article class="bt bt--inverse">
          <span class="bt-label">Badanie · Princeton, KDD 2024</span>
          <div class="bt-score"><span class="bt-big">+40</span><span class="bt-of">%</span></div>
          <p class="bt-copy">wzrost widoczności w&nbsp;odpowiedziach AI po zastosowaniu metod GEO. Z&nbsp;tej pracy wynikają nasze rekomendacje.</p>
          <a class="bt-link" href="https://arxiv.org/abs/2311.09735" target="_blank" rel="noopener noreferrer">arxiv.org/abs/2311.09735 ↗</a>
        </article>

        <!-- 3. Boty AI -->
        <article class="bt">
          <span class="bt-label">Dostęp botów AI · przykład</span>
          <div class="bt-score"><span class="bt-big">8</span><span class="bt-of">/13</span></div>
          <ul class="bt-bots">
            <li><span>GPTBot</span><i class="ok"></i></li>
            <li><span>ClaudeBot</span><i class="bad"></i></li>
            <li><span>PerplexityBot</span><i class="ok"></i></li>
            <li><span>Google-Extended</span><i class="bad"></i></li>
            <li><span>CCBot</span><i class="bad"></i></li>
            <li><span>Bingbot</span><i class="ok"></i></li>
          </ul>
          <a class="bt-link" href="/narzedzia/ai-bots-check/">Sprawdź boty AI →</a>
        </article>

        <!-- 4. Cytowalność -->
        <article class="bt">
          <span class="bt-label">Cytowalność strony · przykład</span>
          <div class="bt-score"><span class="bt-big">43</span><span class="bt-of">/100</span></div>
          <ul class="bt-bars">
            <li><span>Front-load</span><i><b style="width:78%"></b></i><span>78%</span></li>
            <li><span>Schema</span><i><b style="width:25%"></b></i><span>25%</span></li>
            <li><span>Cytowania</span><i><b style="width:12%"></b></i><span>12%</span></li>
            <li><span>FAQ</span><i><b style="width:40%"></b></i><span>40%</span></li>
          </ul>
          <a class="bt-link" href="/narzedzia/url-check/">Oceń stronę →</a>
        </article>

        <!-- 5. Rynek -->
        <article class="bt">
          <span class="bt-label">Dane rynkowe · 13 miesięcy ruchu z LLM</span>
          <div class="bt-score"><span class="bt-big">+357</span><span class="bt-of">%</span></div>
          <p class="bt-copy">wzrost ruchu z&nbsp;silników AI rok do roku dla najpopularniejszych stron.</p>
          <span class="bt-src">Authoritas / Search Engine Land</span>
        </article>

        <!-- 6. Konkurenci -->
        <article class="bt bt--wide">
          <span class="bt-label">Konkurenci polecani zamiast marki · przykład</span>
          <ul class="bt-rows">
            <li><span>konkurent-a.pl</span><i><b style="width:75%"></b></i><span>3 modele</span></li>
            <li><span>konkurent-b.pl</span><i><b style="width:50%"></b></i><span>2 modele</span></li>
            <li><span>marketplace-x.com</span><i><b style="width:50%"></b></i><span>2 modele</span></li>
            <li><span>twojamarka.pl</span><i><b class="me" style="width:50%"></b></i><span>2 modele</span></li>
          </ul>
        </article>

        <!-- 7. ICEA -->
        <article class="bt bt--icea">
          <span class="bt-label">widocznosc.ai by ICEA</span>
          <div class="bt-icea">
            <div><span class="bt-big">15+</span><span class="bt-mini">lat w&nbsp;SEO</span></div>
            <div><span class="bt-big">500+</span><span class="bt-mini">projektów</span></div>
          </div>
          <a class="bt-link" href="/kontakt/?type=konsultacja">Porozmawiaj z&nbsp;ekspertem ICEA →</a>
        </article>
      </div>
    </div>
  </section>

  <!-- Sekcja leadowa w stylu Planhat: moduły + ekspert -->
  <section class="lb" aria-labelledby="lb-title">
    <div class="container lb-grid">
      <div class="lb-copy">
        <span class="eyebrow">Pełny raport GEO</span>
        <h2 id="lb-title" class="display-xl">Cała domena. Cztery obszary. Plan według priorytetu.</h2>
        <p class="subhead">Skanujemy 25–50 adresów i&nbsp;oceniamy spójność tematyczną, sygnały autorytetu, dostępność dla AI i&nbsp;widoczność w&nbsp;wyszukiwarkach AI.</p>
        <div class="lb-actions">
          <a class="btn-primary" href="/kontakt/?type=full-report">Zamów pełny raport →</a>
          <a class="btn-secondary" href="/kontakt/?type=konsultacja">Porozmawiaj z&nbsp;ekspertem ICEA</a>
        </div>
      </div>
      <ol class="lb-modules">
        <li><b>01</b><span><strong>Spójność tematyczna</strong>Czy domena mówi jednym głosem o&nbsp;tym, w&nbsp;czym chce być cytowana.</span><em>56%</em></li>
        <li><b>02</b><span><strong>Sygnały autorytetu</strong>Autorzy, źródła, dane strukturalne, wzmianki poza domeną.</span><em>42%</em></li>
        <li><b>03</b><span><strong>Dostępność dla AI</strong>robots.txt, WAF, renderowanie i&nbsp;llms.txt dla 13 botów.</span><em>68%</em></li>
        <li><b>04</b><span><strong>Widoczność w&nbsp;AI</strong>32–48 zapytań w&nbsp;pięciu silnikach, wariancja odpowiedzi.</span><em>30%</em></li>
      </ol>
    </div>
  </section>

  <CTABand compactTop />
  <Footer />
</Layout>

<style>
  .hb {
    padding: 120px 0 72px;
  }
  @media (min-width: 980px) {
    .hb {
      padding: 140px 0 96px;
    }
  }
  .hb-head {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 22px;
    margin-bottom: 40px;
  }
  .hb-h1 {
    margin: 0;
    max-width: 18ch;
    text-wrap: balance;
  }
  .hb-form {
    display: grid;
    grid-template-columns: 1fr;
    gap: 6px;
    width: 100%;
    max-width: 700px;
    padding: 6px;
    background: var(--bg-surface-1);
    border: 1px solid var(--hairline);
    border-radius: 18px;
  }
  @media (min-width: 720px) {
    .hb-form {
      grid-template-columns: 1fr 1.1fr auto;
      border-radius: var(--r-pill);
    }
  }
  .hb-form input {
    min-height: 44px;
    padding: 10px 16px;
    background: transparent;
    color: var(--ink);
    border: 0;
    border-radius: var(--r-pill);
    font-size: 15px;
    outline: none;
  }
  .hb-form input:focus-visible {
    background: var(--bg-surface-2);
  }

  .bento {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }
  @media (min-width: 980px) {
    .bento {
      grid-template-columns: repeat(4, 1fr);
      grid-auto-rows: minmax(200px, auto);
    }
    .bt--score {
      grid-column: span 2;
      grid-row: span 2;
    }
    .bt--wide {
      grid-column: span 2;
    }
  }
  @media (max-width: 979px) {
    .bt--score,
    .bt--wide {
      grid-column: span 2;
    }
  }
  .bt {
    background: var(--bg-surface-1);
    border: 1px solid var(--hairline);
    border-radius: var(--r-xl);
    padding: 22px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-width: 0;
    font-size: 13px;
    color: var(--ink);
  }
  .bt--inverse {
    background: var(--bg-inverse);
    color: var(--ink-inverse);
    border-color: transparent;
  }
  .bt--inverse .bt-label,
  .bt--inverse .bt-of,
  .bt--inverse .bt-copy {
    color: var(--ink-inverse-muted);
  }
  .bt--inverse .bt-link {
    color: var(--ink-inverse);
  }
  .bt-label {
    font-size: 10.5px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-faint);
  }
  .bt-score {
    display: flex;
    align-items: baseline;
    gap: 2px;
  }
  .bt-big {
    font-family: var(--font-display);
    font-size: clamp(40px, 4vw, 56px);
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .bt--score .bt-big {
    font-size: clamp(64px, 7vw, 112px);
  }
  .bt-of {
    font-family: var(--font-display);
    font-size: 20px;
    color: var(--ink-muted);
    font-weight: 600;
  }
  .bt-copy {
    margin: 0;
    line-height: 1.5;
    color: var(--ink-muted);
    max-width: 40ch;
  }
  .bt-link {
    margin-top: auto;
    font-weight: 500;
    color: var(--ink);
    text-decoration: none;
    font-size: 13px;
  }
  .bt-link:hover {
    color: var(--brand);
  }
  .bt-src {
    margin-top: auto;
    font-size: 11px;
    color: var(--ink-faint);
  }
  .bt-models,
  .bt-bots,
  .bt-bars,
  .bt-rows {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .bt-models li {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 9px 0;
    border-top: 1px solid var(--hairline-soft);
    font-weight: 500;
  }
  .tag {
    font-size: 10.5px;
    font-weight: 500;
    padding: 3px 8px;
    border-radius: var(--r-pill);
    background: var(--bg-surface-2);
    color: var(--ink-muted);
  }
  .tag.ok {
    color: var(--ok-fg);
    background: var(--ok-bg);
  }
  .tag.warn {
    color: var(--warn-fg);
    background: var(--warn-bg);
  }
  .tag.bad {
    color: var(--bad-fg);
    background: var(--bad-bg);
  }
  .bt-bots li {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 6px 0;
    border-top: 1px solid var(--hairline-soft);
    font-size: 12px;
  }
  .bt-bots i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }
  .bt-bots i.ok {
    background: var(--ok-fg);
  }
  .bt-bots i.bad {
    background: var(--bad-fg);
  }
  .bt-bars li,
  .bt-rows li {
    display: grid;
    grid-template-columns: 90px 1fr 44px;
    align-items: center;
    gap: 10px;
    padding: 7px 0;
    border-top: 1px solid var(--hairline-soft);
    font-size: 12px;
  }
  .bt-rows li {
    grid-template-columns: 150px 1fr 70px;
    font-size: 13px;
  }
  .bt-bars li span:last-child,
  .bt-rows li span:last-child {
    text-align: right;
    color: var(--ink-muted);
    font-variant-numeric: tabular-nums;
  }
  .bt-bars i,
  .bt-rows i {
    display: block;
    height: 4px;
    background: var(--bg-surface-3);
    border-radius: 2px;
    overflow: hidden;
  }
  .bt-bars b,
  .bt-rows b {
    display: block;
    height: 100%;
    background: var(--ink);
  }
  .bt-rows b.me {
    background: var(--brand);
  }
  .bt-icea {
    display: flex;
    gap: 28px;
  }
  .bt-icea > div {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .bt-mini {
    font-size: 12px;
    color: var(--ink-muted);
  }

  .lb {
    padding: 96px 0;
    border-top: 1px solid var(--hairline-soft);
  }
  .lb-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
  }
  @media (min-width: 980px) {
    .lb {
      padding: 128px 0;
    }
    .lb-grid {
      grid-template-columns: 1fr 1fr;
      gap: 80px;
      align-items: center;
    }
  }
  .lb-copy {
    display: flex;
    flex-direction: column;
    gap: 20px;
    align-items: flex-start;
  }
  .lb-copy h2 {
    margin: 0;
    max-width: 16ch;
  }
  .lb-actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }
  .lb-modules {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--hairline);
  }
  .lb-modules li {
    display: grid;
    grid-template-columns: 36px 1fr 60px;
    gap: 16px;
    padding: 22px 0;
    border-bottom: 1px solid var(--hairline);
    align-items: center;
  }
  .lb-modules b {
    font-family: ui-monospace, monospace;
    font-size: 12px;
    color: var(--ink-faint);
    font-weight: 500;
  }
  .lb-modules span {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 14px;
    color: var(--ink-muted);
    line-height: 1.45;
  }
  .lb-modules strong {
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .lb-modules em {
    font-style: normal;
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 600;
    text-align: right;
    font-variant-numeric: tabular-nums;
    color: var(--ink);
  }
</style>
