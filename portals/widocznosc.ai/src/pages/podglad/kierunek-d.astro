---
/**
 * Podgląd kierunku D „Instrument”.
 *
 * System z DESIGN.md: antykwa w nagłówkach, monospace w całym chromie,
 * jeden akcent, promień 4 px, zero cieni i gradientów.
 *
 * Treść jest 1:1 z produkcji – hero z Hero.astro, liczby z ProofData.astro,
 * FAQ z data/homepageFaq. Podgląd ma pokazywać kierunek wizualny na naszym
 * tekście, a nie na wypełniaczu.
 *
 * Strona jest noindex i wykluczona z sitemapy (astro.config.mjs).
 */
import '@fontsource-variable/fraunces';
import '@fontsource-variable/fraunces/wght-italic.css';
import '@fontsource/geist-mono/400.css';
import Layout from '../../layouts/Layout.astro';
import HalftoneSentence from '../../components/HalftoneSentence.astro';

// Liczby przepisane 1:1 z ProofData.astro (produkcja).
const rows = [
  {
    num: '+40',
    unit: '%',
    claim: 'wzrost widoczności w odpowiedziach AI po zastosowaniu metod GEO',
    kind: 'Badanie peer-reviewed',
    source: 'Aggarwal et al., KDD 2024',
    href: 'https://arxiv.org/abs/2311.09735',
  },
  {
    num: '8',
    unit: '×',
    claim: 'tyle podzapytań Google generuje z jednego pytania w trybie AI',
    kind: 'Patent Google',
    source: 'Search Engine Land, analiza patentów',
    href: 'https://searchengineland.com/how-ai-mode-ai-overviews-work-patents-456346',
  },
  {
    num: '+357',
    unit: '%',
    claim: 'wzrost ruchu z silników AI rok do roku dla najpopularniejszych stron',
    kind: 'Dane rynkowe',
    source: 'Authoritas / Search Engine Land',
    href: 'https://searchengineland.com/what-13-months-of-data-reveals-about-llm-traffic-growth-and-conversions-470115',
  },
  {
    num: '84',
    unit: '%',
    claim: 'rekomendacji w silnikach AI pochodzi z ChatGPT',
    kind: 'Benchmark',
    source: 'Previsible, AI SEO Study 2025',
    href: 'https://previsible.io/seo-strategy/ai-seo-study-2025/',
  },
];
---

<Layout
  title="Podgląd: kierunek D „Instrument” – widocznosc.ai"
  description="Wewnętrzny podgląd kierunku redesignu. Nie do publikacji."
  noindex={true}
>
  <div class="kd">
    <header class="kd-nav">
      <span class="kd-brand">widocznosc.ai <span>by ICEA</span></span>
      <nav class="kd-nav-links">
        <a href="/pozycjonowanie-ai/">pozycjonowanie ai</a>
        <a href="/narzedzia/">narzędzia</a>
        <a href="/blog/">blog</a>
        <a href="/o-nas/">o nas</a>
        <a href="/kontakt/">kontakt</a>
      </nav>
      <a class="kd-nav-cta" href="/narzedzia/brand-check/">Sprawdź markę</a>
    </header>

    <section class="kd-hero">
      <span class="kd-eyebrow">Pomiar widoczności marki w AI</span>
      <h1>
        <span class="kd-d1">Sprawdź, czy AI</span>
        <span class="kd-d2">poleca <em>Twoją markę</em>.</span>
      </h1>
      <p class="kd-lead">
        Odpytujemy ChatGPT, Claude, Gemini i&nbsp;Perplexity o&nbsp;Twoją firmę
        i&nbsp;pokazujemy, co odpowiadają: czy znają markę, jak o&nbsp;niej mówią
        i&nbsp;kogo polecają zamiast Ciebie. Wynik w&nbsp;około minutę, bez rejestracji.
      </p>

      <form class="kd-form" action="/narzedzia/brand-check/" method="get">
        <input type="text" name="brand" placeholder="Nazwa marki" maxlength="80" aria-label="Nazwa marki" />
        <input
          type="text"
          name="domain"
          placeholder="twojadomena.pl"
          maxlength="200"
          inputmode="url"
          spellcheck="false"
          aria-label="Domena"
          required
        />
        <button type="submit">Sprawdź widoczność marki <span aria-hidden="true">→</span></button>
      </form>

      <p class="kd-note">
        <a href="/kontakt/?type=konsultacja">Porozmawiaj z ekspertem ICEA</a>
        <span aria-hidden="true">·</span> widocznosc.ai by ICEA
      </p>

      <figure class="kd-figure">
        <HalftoneSentence
          fromSrc="/logos/brand/widocznosc-mark.svg"
          fromText="widocznosc.ai"
          toSrc="/logos/brand/icea-wordmark.svg"
          alt="Ilustracja: znak widocznosc.ai rozsypuje się w chmurę kropek i scala w logotyp iCEA"
        />
        <figcaption>
          <span>widocznosc.ai</span>
          <span>część grupy iCEA</span>
        </figcaption>
      </figure>
    </section>

    <section class="kd-proof">
      <h2>
        <span>Dane, nie deklaracje.</span>
      </h2>

      <div class="kd-table">
        {
          rows.map((r) => (
            <div class="kd-row">
              <span class="kd-num">
                {r.num}
                <i>{r.unit}</i>
              </span>
              <span class="kd-claim">{r.claim}</span>
              <span class="kd-src">
                <span class="kd-kind">{r.kind}</span>
                <a href={r.href} target="_blank" rel="noopener noreferrer">
                  {r.source}
                </a>
              </span>
            </div>
          ))
        }
      </div>
      <p class="kd-tablenote">
        cztery źródła zewnętrzne · badanie, patent, dane rynkowe, benchmark ·
        <a href="/pozycjonowanie-ai/">jak to mierzymy</a>
      </p>
    </section>

    <div class="kd-toggle" role="group" aria-label="Widok strony">
      <button type="button" data-view="human" class="is-on">człowiek</button>
      <span aria-hidden="true">/</span>
      <button type="button" data-view="machine">maszyna</button>
    </div>

    <div class="kd-machine" hidden>
      <button type="button" class="kd-copy">Kopiuj stronę</button>
      <pre><code># widocznosc.ai – pozycjonowanie marek w AI

Pomiar widoczności marki w AI.

## Sprawdź, czy AI poleca Twoją markę

Odpytujemy ChatGPT, Claude, Gemini i Perplexity o Twoją firmę i pokazujemy,
co odpowiadają: czy znają markę, jak o niej mówią i kogo polecają zamiast
Ciebie. Wynik w około minutę, bez rejestracji.

- [Sprawdź widoczność marki](/narzedzia/brand-check/)
- [Porozmawiaj z ekspertem ICEA](/kontakt/?type=konsultacja)

## Dane, nie deklaracje

| Liczba | Twierdzenie | Rodzaj | Źródło |
|---|---|---|---|
| +40% | wzrost widoczności w odpowiedziach AI po zastosowaniu metod GEO | Badanie peer-reviewed | Aggarwal et al., KDD 2024 |
| 8× | tyle podzapytań Google generuje z jednego pytania w trybie AI | Patent Google | Search Engine Land |
| +357% | wzrost ruchu z silników AI rok do roku | Dane rynkowe | Authoritas / Search Engine Land |
| 84% | rekomendacji w silnikach AI pochodzi z ChatGPT | Benchmark | Previsible, AI SEO Study 2025 |

widocznosc.ai by ICEA S.A.
</code></pre>
    </div>
  </div>
</Layout>

<style>
  .kd {
    --kd-canvas: #0a0a0a;
    --kd-ink: #fafafa;
    --kd-body: #a1a1aa;
    --kd-mute: #71717a;
    --kd-chrome: rgba(255, 255, 255, 0.5);
    --kd-line: #27272a;
    --kd-accent: #5768ff;
    --kd-serif: 'Fraunces Variable', Georgia, serif;
    --kd-mono: 'Geist Mono', ui-monospace, monospace;

    background: var(--kd-canvas);
    color: var(--kd-ink);
    min-height: 100vh;
    padding-bottom: 128px;
  }

  /* --- chrom: monospace, małą literą --- */
  .kd-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 20px 32px;
    border-bottom: 1px solid var(--kd-line);
    font-family: var(--kd-mono);
    font-size: 12px;
    line-height: 16px;
  }
  .kd-brand span {
    color: var(--kd-mute);
  }
  .kd-nav-links {
    display: flex;
    gap: 24px;
  }
  .kd-nav-links a {
    color: var(--kd-chrome);
    text-decoration: none;
    transition: color 0.15s;
  }
  .kd-nav-links a:hover {
    color: var(--kd-ink);
  }
  .kd-nav-cta {
    background: var(--kd-accent);
    color: #fff;
    padding: 8px 14px;
    border-radius: 4px;
    text-decoration: none;
  }

  /* --- hero --- */
  .kd-hero {
    max-width: 1440px;
    margin: 0 auto;
    padding: 88px 32px 0;
    text-align: center;
  }
  .kd-eyebrow {
    display: block;
    font-family: var(--kd-mono);
    font-size: 12px;
    line-height: 16px;
    color: var(--kd-mute);
    margin-bottom: 28px;
  }
  .kd-hero h1 {
    font-family: var(--kd-serif);
    font-weight: 400;
    margin: 0;
    display: flex;
    flex-direction: column;
  }
  .kd-d1 {
    font-size: 88px;
    line-height: 86.24px;
    letter-spacing: -2.64px;
  }
  .kd-d2 {
    font-size: 68px;
    line-height: 70.72px;
    letter-spacing: -1.768px;
  }
  .kd-d2 em {
    font-style: italic;
    color: var(--kd-accent);
  }
  .kd-lead {
    max-width: 58ch;
    margin: 28px auto 0;
    font-size: 18px;
    line-height: 27px;
    letter-spacing: -0.09px;
    color: var(--kd-body);
  }

  .kd-form {
    display: flex;
    gap: 8px;
    justify-content: center;
    margin-top: 32px;
    flex-wrap: wrap;
  }
  .kd-form input {
    background: rgba(255, 255, 255, 0.016);
    border: 1px solid var(--kd-line);
    border-radius: 4px;
    color: var(--kd-ink);
    padding: 13px 14px;
    font-size: 15px;
    min-width: 200px;
  }
  .kd-form input::placeholder {
    color: var(--kd-mute);
  }
  .kd-form input:focus-visible {
    outline: none;
    border-color: var(--kd-accent);
  }
  .kd-form button {
    background: var(--kd-accent);
    color: #fff;
    border: 0;
    border-radius: 4px;
    padding: 14px 20px;
    font-size: 16px;
    cursor: pointer;
  }
  .kd-note {
    margin-top: 16px;
    font-family: var(--kd-mono);
    font-size: 12px;
    color: var(--kd-mute);
  }
  .kd-note a {
    color: var(--kd-body);
  }

  .kd-figure {
    margin: 72px 0 0;
  }
  .kd-figure figcaption {
    display: flex;
    justify-content: space-between;
    max-width: 62%;
    margin: 8px auto 0;
    font-family: var(--kd-mono);
    font-size: 10px;
    line-height: 14px;
    color: var(--kd-mute);
  }

  /* --- sekcja dowodowa: tabela liczb --- */
  .kd-proof {
    max-width: 1000px;
    margin: 128px auto 0;
    padding: 0 32px;
  }
  .kd-proof h2 {
    font-family: var(--kd-serif);
    font-weight: 400;
    font-size: 52px;
    line-height: 55.12px;
    letter-spacing: -1.144px;
    margin: 0 0 48px;
  }
  .kd-row {
    display: grid;
    grid-template-columns: 132px 1fr 230px;
    align-items: baseline;
    gap: 24px;
    padding: 20px 0;
    border-bottom: 1px solid var(--kd-line);
  }
  .kd-num {
    font-family: var(--kd-serif);
    font-size: 44px;
    line-height: 44px;
    letter-spacing: -1.2px;
    color: var(--kd-accent);
  }
  .kd-num i {
    font-size: 22px;
    font-style: normal;
    color: var(--kd-mute);
  }
  .kd-claim {
    font-size: 16px;
    line-height: 24px;
    color: var(--kd-body);
  }
  .kd-src {
    display: flex;
    flex-direction: column;
    gap: 3px;
    font-family: var(--kd-mono);
    font-size: 11px;
    line-height: 15px;
    text-align: right;
  }
  .kd-kind {
    color: var(--kd-mute);
  }
  .kd-src a {
    color: var(--kd-chrome);
  }
  .kd-tablenote {
    margin-top: 16px;
    font-family: var(--kd-mono);
    font-size: 12px;
    line-height: 16px;
    color: var(--kd-mute);
  }
  .kd-tablenote a {
    color: var(--kd-body);
  }

  /* --- przełącznik człowiek / maszyna --- */
  .kd-toggle {
    position: fixed;
    right: 20px;
    bottom: 20px;
    z-index: 40;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 12px;
    background: #131313;
    border: 1px solid var(--kd-line);
    border-radius: 4px;
    font-family: var(--kd-mono);
    font-size: 12px;
    line-height: 16px;
  }
  .kd-toggle > span {
    color: var(--kd-mute);
  }
  .kd-toggle button {
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    color: var(--kd-chrome);
    font: inherit;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .kd-toggle button::before {
    content: '';
    width: 6px;
    height: 6px;
    background: var(--kd-mute);
  }
  .kd-toggle button.is-on {
    color: var(--kd-ink);
  }
  .kd-toggle button.is-on::before {
    background: var(--kd-accent);
  }

  /* --- widok maszynowy --- */
  .kd-machine {
    position: relative;
    max-width: 1000px;
    margin: 0 auto;
    padding: 48px 32px;
  }
  .kd-machine[hidden] {
    display: none;
  }
  .kd-machine pre {
    margin: 0;
    font-family: var(--kd-mono);
    font-size: 13px;
    line-height: 20px;
    color: var(--kd-body);
    white-space: pre-wrap;
  }
  .kd-copy {
    position: absolute;
    top: 24px;
    right: 32px;
    background: #131313;
    border: 1px solid var(--kd-line);
    border-radius: 4px;
    color: var(--kd-ink);
    font-family: var(--kd-mono);
    font-size: 12px;
    padding: 8px 12px;
    cursor: pointer;
  }

  @media (max-width: 1023px) {
    .kd-d1 {
      font-size: 56px;
      line-height: 56px;
      letter-spacing: -1.7px;
    }
    .kd-d2 {
      font-size: 44px;
      line-height: 46px;
      letter-spacing: -1.1px;
    }
    .kd-proof h2 {
      font-size: 36px;
      line-height: 40px;
      letter-spacing: -0.8px;
    }
    .kd-row {
      grid-template-columns: 100px 1fr;
    }
    .kd-src {
      grid-column: 2;
      text-align: left;
    }
  }

  @media (max-width: 767px) {
    .kd-nav-links {
      display: none;
    }
    .kd-hero {
      padding-top: 56px;
    }
    .kd-d1 {
      font-size: 40px;
      line-height: 42px;
      letter-spacing: -1.2px;
    }
    .kd-d2 {
      font-size: 34px;
      line-height: 36px;
      letter-spacing: -0.9px;
    }
    .kd-form {
      flex-direction: column;
    }
    .kd-form input,
    .kd-form button {
      width: 100%;
    }
    .kd-row {
      grid-template-columns: 1fr;
      gap: 8px;
    }
    .kd-src {
      grid-column: 1;
    }
    /* Ilustracja jest na mobile pionowa – podpisy też. */
    .kd-figure figcaption {
      max-width: none;
      flex-direction: column;
      align-items: center;
      gap: 2px;
    }
  }
</style>

<script>
  function boot() {
    const root = document.querySelector<HTMLElement>('.kd');
    if (!root) return;
    const machine = root.querySelector<HTMLElement>('.kd-machine');
    const buttons = root.querySelectorAll<HTMLButtonElement>('.kd-toggle button');
    const hidable = [
      root.querySelector('.kd-hero'),
      root.querySelector('.kd-proof'),
    ].filter(Boolean) as HTMLElement[];

    buttons.forEach((b) =>
      b.addEventListener('click', () => {
        const machineOn = b.dataset.view === 'machine';
        buttons.forEach((x) => x.classList.toggle('is-on', x === b));
        hidable.forEach((el) => (el.hidden = machineOn));
        if (machine) machine.hidden = !machineOn;
      }),
    );

    const copy = root.querySelector<HTMLButtonElement>('.kd-copy');
    const pre = root.querySelector('.kd-machine code');
    copy?.addEventListener('click', async () => {
      if (!pre) return;
      await navigator.clipboard.writeText(pre.textContent || '');
      const prev = copy.textContent;
      copy.textContent = 'Skopiowano';
      setTimeout(() => (copy.textContent = prev), 1600);
    });
  }

  boot();
  document.addEventListener('astro:page-load', boot);
</script>
